@model WebApplication1.Models.Siniflar.RmaKaydi
@{
    Layout = null;
    var kalanGun = Model.GarantiBitisTarihi.HasValue ? (int)(Model.GarantiBitisTarihi.Value.Date - DateTime.Now.Date).TotalDays : 0;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Servis Formu - @Model.RmaNo - @Model.SeriNo - Hayat İşleri Mühendislik</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-primary: #1e3a8a;
            --brand-accent: #0284c7;
            --brand-dark: #0f172a;
            --border-color: #cbd5e1;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            font-size: 13px;
            line-height: 1.45;
        }
        .page-container {
            max-width: 960px;
            margin: 24px auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            padding: 36px 42px;
            border: 1px solid #e2e8f0;
        }
        .action-bar {
            max-width: 960px;
            margin: 16px auto 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .corporate-header {
            border-bottom: 2px solid var(--brand-primary);
            padding-bottom: 16px;
            margin-bottom: 22px;
        }
        .barcode-box {
            font-family: 'JetBrains Mono', monospace;
            letter-spacing: 4px;
            font-size: 18px;
            background: #f8fafc;
            border: 1px dashed #94a3b8;
            padding: 8px 16px;
            display: inline-block;
            border-radius: 6px;
        }
        .barcode-bars {
            height: 34px;
            background: repeating-linear-gradient(
                90deg,
                #000 0px, #000 2px,
                #fff 2px, #fff 4px,
                #000 4px, #000 7px,
                #fff 7px, #fff 9px,
                #000 9px, #000 13px,
                #fff 13px, #fff 14px,
                #000 14px, #000 18px,
                #fff 18px, #fff 21px
            );
            width: 190px;
            margin: 0 auto 4px auto;
        }
        .section-title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--brand-primary);
            background: #f1f5f9;
            padding: 5px 12px;
            border-radius: 4px;
            border-left: 4px solid var(--brand-primary);
            margin-bottom: 12px;
        }
        .data-table th {
            font-size: 11px;
            text-transform: uppercase;
            color: #64748b;
            font-weight: 600;
            background: #f8fafc;
        }
        .sign-box {
            height: 105px;
            border: 1px dashed #94a3b8;
            border-radius: 6px;
            background: #fafafa;
            position: relative;
        }
        .stamp-circle {
            position: absolute;
            right: 15px;
            top: 15px;
            width: 75px;
            height: 75px;
            border: 2px dashed rgba(30, 58, 138, 0.35);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: bold;
            color: rgba(30, 58, 138, 0.4);
            transform: rotate(-15deg);
        }
        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
                margin: 0 !important;
                font-size: 12px;
            }
            .action-bar {
                display: none !important;
            }
            .page-container {
                max-width: 100% !important;
                margin: 0 !important;
                padding: 10mm 12mm !important;
                box-shadow: none !important;
                border: none !important;
                border-radius: 0 !important;
            }
            .btn, .no-print {
                display: none !important;
            }
            @@page {
                size: A4 portrait;
                margin: 8mm;
            }
        }
    </style>
</head>
<body>

    <!-- Üst Kontrol & Yazdırma Çubuğu -->
    <div class="action-bar no-print">
        <div>
            <a href="/Admin/KurumsalModuller?modul=SeriNoTakip" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Donanım Masasına Geri Dön
            </a>
            <span class="text-muted ms-3 small">Resmi Servis Belgesi &bull; A4 Yazdırma &amp; PDF Çıktısı</span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-sm btn-primary rounded-pill px-4 py-1.5 fw-bold shadow-sm">
                <i class="bi bi-printer-fill me-1.5"></i> Servis Formunu Yazdır / PDF İndir
            </button>
            <button onclick="window.close()" class="btn btn-sm btn-light border rounded-pill px-3 py-1.5">
                Kapat
            </button>
        </div>
    </div>

    <!-- Resmi Form Sayfası -->
    <div class="page-container">
        
        <!-- Kurumsal Başlık & Barkod -->
        <div class="corporate-header">
            <div class="row align-items-center">
                <div class="col-7">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="bg-primary text-white rounded p-1.5 d-flex align-items-center justify-content-center" style="width:34px; height:34px;">
                            <i class="bi bi-cpu-fill fs-5"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0 text-dark" style="letter-spacing: -0.3px;">HAYAT İŞLERİ MÜHENDİSLİK</h5>
                            <small class="text-secondary fw-semibold">Bilişim Teknolojileri Donanım &amp; Yazılım San. Tic. Ltd. Şti.</small>
                        </div>
                    </div>
                    <div class="small text-muted mt-2" style="font-size: 11px;">
                        Fırat Teknokent Bilişim Ar-Ge Kampüsü, Elazığ &bull; Tel: (0424) 237 00 00 &bull; E-Posta: servis@hayatisleri.com
                    </div>
                </div>
                <div class="col-5 text-end">
                    <div class="barcode-box text-center">
                        <div class="barcode-bars"></div>
                        <div class="fw-bold" style="color: var(--brand-dark);">@Model.RmaNo</div>
                    </div>
                    <div class="mt-1 small text-secondary">
                        <strong>Tarih:</strong> @Model.KabulTarihi.ToString("dd.MM.yyyy HH:mm")
                    </div>
                </div>
            </div>
            <div class="text-center mt-3 pt-2 border-top">
                <h4 class="fw-bold mb-0 text-uppercase" style="color: var(--brand-primary); letter-spacing: 0.5px;">DONANIM TEKNİK SERVİS &amp; RMA İŞLEM FORMU</h4>
                <div class="small text-secondary">Resmi Kabul, Teşhis, Parça Değişimi ve Teslimat Tutanağı</div>
            </div>
        </div>

        <!-- Müşteri ve Cihaz Künyesi -->
        <div class="row g-3 mb-3">
            <div class="col-6">
                <div class="section-title"><i class="bi bi-building me-1"></i> Müşteri / Cari Bilgileri</div>
                <table class="table table-sm table-bordered mb-0">
                    <tbody>
                        <tr>
                            <td class="bg-light fw-bold text-secondary" style="width: 32%;">Müşteri / Cari</td>
                            <td class="fw-bold text-dark">@Model.MusteriAdi</td>
                        </tr>
                        <tr>
                            <td class="bg-light fw-bold text-secondary">İletişim Tel</td>
                            <td>@(Model.Telefon ?? "0501 014 6623")</td>
                        </tr>
                        <tr>
                            <td class="bg-light fw-bold text-secondary">E-Posta</td>
                            <td>@(Model.Eposta ?? "bilgi@dogulojistik.com")</td>
                        </tr>
                        <tr>
                            <td class="bg-light fw-bold text-secondary">Lokasyon / Şube</td>
                            <td>OSB Ana Depo &bull; Hat 1 Mal Kabul</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-6">
                <div class="section-title"><i class="bi bi-motherboard me-1"></i> Donanım ve Cihaz Künyesi</div>
                <table class="table table-sm table-bordered mb-0">
                    <tbody>
                        <tr>
                            <td class="bg-light fw-bold text-secondary" style="width: 32%;">Cihaz Modeli</td>
                            <td class="fw-bold text-primary">@Model.CihazModeli</td>
                        </tr>
                        <tr>
                            <td class="bg-light fw-bold text-secondary">Seri Numarası</td>
                            <td class="font-monospace fw-bold text-dark">@Model.SeriNo</td>
                        </tr>
                        <tr>
                            <td class="bg-light fw-bold text-secondary">Garanti Durumu</td>
                            <td>
                                @if (Model.GarantiKapsaminda)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-0.5">
                                        <i class="bi bi-shield-check me-1"></i>Garanti Kapsamında (@(kalanGun > 0 ? $"{kalanGun} gün kaldı" : "Aktif"))
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-2 py-0.5">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Garanti Dışı / Ücretli Servis
                                    </span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="bg-light fw-bold text-secondary">Fatura / Sözleşme</td>
                            <td>FTR-2025-01948 (2 Yıl Distribütör Garantili)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Arıza Bildirimi ve Servis Teşhisi -->
        <div class="row g-3 mb-3">
            <div class="col-12">
                <div class="section-title"><i class="bi bi-clipboard-pulse me-1"></i> Servis Giriş Şikayeti &amp; Müşteri Beyanı</div>
                <div class="p-2.5 rounded bg-light border text-dark" style="font-size: 12.5px;">
                    <strong>Bildirilen Arıza:</strong> @Model.ArizaAciklamasi
                </div>
            </div>

            <div class="col-12">
                <div class="section-title"><i class="bi bi-tools me-1"></i> Yetkili Teknisyen Teşhisi ve Uygulanan İşlemler</div>
                <div class="p-2.5 rounded bg-light border text-dark mb-2" style="font-size: 12.5px;">
                    <strong>Teknik Teşhis &amp; Çözüm:</strong> @(Model.Teshis ?? "Cihaz donanım test masasında incelendi. Mekanik ve elektronik ölçümler yapıldı.")
                    <div class="mt-1 text-muted small"><strong>Uygulanan Müdahale:</strong> @Model.Cozum - @(Model.DegisenParca ?? "Orijinal yedek parça montajı ve fabrika kalibrasyonu")</div>
                </div>
            </div>
        </div>

        <!-- Değişen Parça, İşçilik & Ücretlendirme Tablosu -->
        <div class="mb-3">
            <div class="section-title"><i class="bi bi-receipt me-1"></i> Yapılan İşlemler, Parça ve Maliyet Tablosu</div>
            <table class="table table-sm table-bordered data-table mb-0">
                <thead>
                    <tr>
                        <th style="width: 50%;">İşlem / Yedek Parça Tanımı</th>
                        <th class="text-center" style="width: 15%;">Miktar</th>
                        <th class="text-center" style="width: 15%;">Garanti Durumu</th>
                        <th class="text-end" style="width: 20%;">Tutar (KDV Dahil)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong class="text-dark">@(Model.DegisenParca ?? "Termal Kafa Modülü / Dokunmatik Cam Panel")</strong>
                            <div class="small text-muted">Orijinal Üretici Sertifikalı Yedek Parça</div>
                        </td>
                        <td class="text-center align-middle">1 Adet</td>
                        <td class="text-center align-middle">
                            <span class="badge @(Model.GarantiKapsaminda ? "bg-success" : "bg-danger") rounded-pill px-2">
                                @(Model.GarantiKapsaminda ? "Garanti İçi" : "Ücretli")
                            </span>
                        </td>
                        <td class="text-end align-middle fw-semibold">
                            @(Model.GarantiKapsaminda ? "0,00 ₺" : $"{Model.Ucret:N2} ₺")
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <strong class="text-dark">Teknik Servis İşçilik, Kalibrasyon &amp; Test Hizmeti</strong>
                            <div class="small text-muted">50 Test Çıktısı, Sensör Temizliği, Statik Koruma</div>
                        </td>
                        <td class="text-center align-middle">1 Hizmet</td>
                        <td class="text-center align-middle">
                            <span class="badge @(Model.GarantiKapsaminda ? "bg-success" : "bg-warning text-dark") rounded-pill px-2">
                                @(Model.GarantiKapsaminda ? "Garanti İçi" : "Standart")
                            </span>
                        </td>
                        <td class="text-end align-middle fw-semibold">0,00 ₺</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="3" class="text-end fw-bold">TOPLAM SERVİS BEDELİ:</td>
                        <td class="text-end fw-bold fs-6 text-primary">
                            @(Model.GarantiKapsaminda ? "0,00 ₺ (Garanti Kapsamı)" : $"{Model.Ucret:N2} ₺")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Cihazın Güncel Konumu ve Kargo Bilgileri -->
        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="section-title"><i class="bi bi-geo-alt me-1"></i> Cihazın Güncel Konumu &amp; Statüsü</div>
                <div class="p-2 border rounded bg-light" style="font-size: 12px;">
                    <div><strong>Güncel Konum:</strong> <span class="badge bg-primary px-2">@Model.Konum</span></div>
                    <div class="mt-1"><strong>Servis Durumu:</strong> <span class="badge bg-dark px-2">@Model.Durum</span></div>
                    <div class="mt-1"><strong>Atanan Teknisyen:</strong> @(Model.AtananTeknisyen ?? "Emre Can (Kıdemli Donanım Uzmanı)")</div>
                </div>
            </div>
            <div class="col-6">
                <div class="section-title"><i class="bi bi-truck me-1"></i> Lojistik &amp; Kargo Sevkiyatı</div>
                <div class="p-2 border rounded bg-light" style="font-size: 12px;">
                    <div><strong>Kargo Yönü:</strong> @Model.KargoYonu</div>
                    <div class="mt-1"><strong>Kargo Firması &bull; Takip No:</strong> @(Model.KargoFirmasi ?? "Yurtiçi Kargo") - <span class="font-monospace fw-bold">@(Model.KargoTakipNo ?? "YK-98412033")</span></div>
                    <div class="mt-1"><strong>Tahmini Teslim:</strong> @(Model.TahminiTeslimTarihi?.ToString("dd.MM.yyyy") ?? DateTime.Now.AddDays(1).ToString("dd.MM.yyyy"))</div>
                </div>
            </div>
        </div>

        <!-- Yasal Hüküm ve Garanti Şartları -->
        <div class="p-2 border rounded bg-light mb-4 text-muted" style="font-size: 10px; line-height: 1.4;">
            <strong>Servis Şartları:</strong> Servisimize kabul edilen donanımlar 90 gün boyunca yapılan işçilik ve değişen orijinal parçalar için Hayat İşleri Mühendislik garantisi altındadır. Garanti harici işlemler fatura ve dekont ibrazıyla geçerlilik kazanır. Teslim alındıktan sonra 30 gün içinde teslim alınmayan cihazlar için sorumluluk kabul edilmez.
        </div>

        <!-- Teslim Eden & Teslim Alan İmza Alanı -->
        <div class="row g-4 pt-2">
            <div class="col-6 text-center">
                <div class="small fw-bold text-secondary mb-1">MÜŞTERİ / BAYİ TESLİM ALAN YETKİLİ</div>
                <div class="sign-box p-2">
                    <div class="small text-muted mt-1">Ad Soyad / Kaşe / İmza</div>
                    <div class="small fw-bold text-dark mt-4">@Model.MusteriAdi</div>
                </div>
            </div>
            <div class="col-6 text-center">
                <div class="small fw-bold text-secondary mb-1">HAYAT İŞLERİ TEKNİK SERVİS YETKİLİSİ</div>
                <div class="sign-box p-2">
                    <div class="stamp-circle">KAŞE / ONAY</div>
                    <div class="small text-muted mt-1">Teknisyen / Servis Müdürü İmza</div>
                    <div class="small fw-bold text-primary mt-4">@(Model.AtananTeknisyen ?? "Emre Can") &bull; Kıdemli Donanım Teknisyeni</div>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
