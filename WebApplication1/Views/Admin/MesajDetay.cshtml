@model WebApplication1.Models.Siniflar.SiteMesaj
@using WebApplication1.Models.Siniflar
@{
    ViewData["Title"] = "CRM Talep Detayı & Yanıtlama";
    var crmDurum = string.IsNullOrEmpty(Model.Durum) ? CrmDurumlari.Yeni : Model.Durum;
}

<div class="container py-3" style="max-width: 980px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--adm-card-border) !important;">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--adm-text-main);"><i class="bi bi-envelope-open-fill text-primary me-2"></i>CRM Talep Detayı (#@Model.Id)</h3>
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 me-1">@Model.FormTipi</span>
            <span class="badge bg-warning text-dark rounded-pill px-3 py-1">Durum: @crmDurum</span>
        </div>
        <a asp-action="MesajListesi" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> CRM Listesine Dön
        </a>
    </div>

    @if (TempData["Mesaj"] is string bilgi)
    {
        <div class="alert alert-success rounded-3 small fw-semibold mb-3"><i class="bi bi-check-circle-fill me-1"></i>@bilgi</div>
    }

    <div class="row g-4">
        <!-- Sol Sütun: Gelen Mesaj İçeriği -->
        <div class="col-lg-6">
            <div class="p-4 rounded-4 shadow-sm h-100" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border);">
                <h5 class="fw-bold mb-3 pb-2 border-bottom" style="color: var(--adm-text-main);">Müşteri / Başvuru Bilgileri</h5>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <small class="text-secondary d-block">Gönderen</small>
                        <strong style="color: var(--adm-text-main);">@Model.AdSoyad</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-secondary d-block">E-Posta</small>
                        <a href="mailto:@Model.Eposta" class="fw-semibold text-primary text-decoration-none">@Model.Eposta</a>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Telefon))
                    {
                        <div class="col-sm-6">
                            <small class="text-secondary d-block">Telefon</small>
                            <span class="font-monospace" style="color: var(--adm-text-main);">@Model.Telefon</span>
                        </div>
                    }
                    <div class="col-sm-6">
                        <small class="text-secondary d-block">Gönderim Tarihi</small>
                        <span class="small text-secondary">@Model.GonderimTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Konu) || !string.IsNullOrEmpty(Model.Pozisyon))
                    {
                        <div class="col-12">
                            <small class="text-secondary d-block">Konu / Başvurulan Pozisyon</small>
                            <strong style="color: var(--adm-text-main);">@(Model.Konu ?? Model.Pozisyon)</strong>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.OnYazi))
                {
                    <div class="mb-3">
                        <small class="text-secondary d-block mb-1">Ön Yazı</small>
                        <div class="p-3 rounded-3 small" style="background: var(--adm-chip-bg); white-space: pre-line;">@Model.OnYazi</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Mesaj))
                {
                    <div class="mb-3">
                        <small class="text-secondary d-block mb-1">Talep / Mesaj Metni</small>
                        <div class="p-3 rounded-3 small" style="background: var(--adm-chip-bg); white-space: pre-line;">@Model.Mesaj</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.CevapMetni))
                {
                    <div class="p-3 rounded-3 border border-success border-opacity-25 mt-3" style="background: rgba(16,185,129,0.08);">
                        <div class="small fw-bold text-success mb-1">
                            <i class="bi bi-check2-all me-1"></i>Gönderilen Son Yanıt (@Model.CevapTarihi?.ToString("dd.MM.yyyy HH:mm"))
                        </div>
                        <div class="small" style="white-space: pre-line;">@Model.CevapMetni</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.DosyaYolu))
                {
                    var ext = System.IO.Path.GetExtension(Model.DosyaYolu).ToLowerInvariant();
                    var isPdf = ext == ".pdf";
                    var isImg = ext is ".jpg" or ".jpeg" or ".png";

                    <div class="mt-4 p-3 rounded-3 border" style="background: var(--adm-chip-bg); border-color: var(--adm-card-border) !important;">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2 pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge @(isPdf ? "bg-danger" : (isImg ? "bg-info" : "bg-primary")) p-2 rounded-circle text-white">
                                    <i class="bi @(isPdf ? "bi-file-earmark-pdf-fill" : (isImg ? "bi-file-earmark-image-fill" : "bi-file-earmark-arrow-down-fill")) fs-5"></i>
                                </span>
                                <div>
                                    <div class="fw-bold" style="color: var(--adm-text-main);">@(Model.DosyaAdi ?? "Ekli Özgeçmiş / CV Dosyası")</div>
                                    <small class="text-secondary">Aday tarafından iletilen başvuru belgesi (@ext.ToUpperInvariant())</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <a asp-action="BasvuruDosyasiGoruntule" asp-route-id="@Model.Id" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Tarayıcıda Aç
                                </a>
                                <a asp-action="BasvuruDosyasiIndir" asp-route-id="@Model.Id" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold shadow-sm">
                                    <i class="bi bi-download me-1"></i> Dosyayı İndir
                                </a>
                            </div>
                        </div>

                        @if (isPdf)
                        {
                            <div class="mt-3 rounded-3 overflow-hidden border" style="height: 480px;">
                                <iframe src="@Url.Action("BasvuruDosyasiGoruntule", "Admin", new { id = Model.Id })" style="width: 100%; height: 100%; border: none;"></iframe>
                            </div>
                        }
                        else if (isImg)
                        {
                            <div class="mt-3 text-center p-2 rounded-3 border bg-white">
                                <a asp-action="BasvuruDosyasiGoruntule" asp-route-id="@Model.Id" target="_blank">
                                    <img src="@Url.Action("BasvuruDosyasiGoruntule", "Admin", new { id = Model.Id })" class="img-fluid rounded shadow-sm" style="max-height: 450px; object-fit: contain;" alt="Başvuru Belgesi" />
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Sağ Sütun: Mini-CRM Statü, Temsilci Atama, Dahili Not ve E-Posta Yanıtlama -->
        <div class="col-lg-6">
            <div class="p-4 rounded-4 shadow-sm h-100" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border);">
                <h5 class="fw-bold mb-3 pb-2 border-bottom" style="color: var(--adm-text-main);">
                    <i class="bi bi-kanban text-primary me-1"></i>Mini-CRM Durum &amp; Yanıt Yönetimi
                </h5>

                <form asp-action="MesajCrmGuncelle" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">CRM Statüsü *</label>
                        <select name="durum" class="form-select">
                            @foreach (var d in CrmDurumlari.Hepsi)
                            {
                                <option value="@d" selected="@(crmDurum == d)">@d</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Atanan Temsilci / Uzman</label>
                        <input type="text" name="atananKisi" class="form-control" value="@(Model.AtananKisi ?? User.Identity?.Name)" placeholder="Örn: temsilci, destek..." />
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold">Dahili CRM Notu (Yalnızca Yöneticiler Görür)</label>
                        <textarea name="dahiliNotlar" rows="3" class="form-control" placeholder="Müşteriyle yapılan telefon görüşmesi, teklif tutarı veya teknik inceleme notu...">@Model.DahiliNotlar</textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold">Müşteriye E-Posta Yanıtı Gönder (Doldurulursa Otomatik İletilir &amp; 'Cevaplandı' Olur)</label>
                        <textarea name="cevapMetni" rows="4" class="form-control" placeholder="Sayın müşterimiz, talebiniz incelenmiş olup..."></textarea>
                    </div>

                    <div class="col-12 d-flex justify-content-between align-items-center pt-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-save2 me-1"></i>CRM Kaydet / Yanıtla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
