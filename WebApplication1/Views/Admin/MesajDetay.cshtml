@model WebApplication1.Models.Siniflar.SiteMesaj
@{
    ViewData["Title"] = "Mesaj Detayı";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-envelope-open-fill text-info me-2"></i>Mesaj Detayı</h3>
            <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-25 px-3 py-1 rounded-pill small">
                @Model.FormTipi
            </span>
        </div>
        <a asp-action="MesajListesi" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Listeye Dön
        </a>
    </div>

    <div class="p-4 p-md-5 rounded-4 shadow-lg" style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255,255,255,0.08);">
        <div class="row g-4 mb-4 pb-4 border-bottom border-white border-opacity-10">
            <div class="col-md-6">
                <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-1">Gönderen</small>
                <h5 class="text-white fw-bold mb-0">@Model.AdSoyad</h5>
            </div>
            <div class="col-md-6">
                <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-1">E-Posta Adresi</small>
                <a href="mailto:@Model.Eposta" class="text-info text-decoration-none fw-semibold fs-6">@Model.Eposta</a>
            </div>

            @if (!string.IsNullOrEmpty(Model.Telefon))
            {
                <div class="col-md-6">
                    <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-1">Telefon</small>
                    <span class="text-white font-monospace">@Model.Telefon</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Pozisyon))
            {
                <div class="col-md-6">
                    <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-1">Başvurulan Pozisyon</small>
                    <div class="d-inline-block px-3 py-2 rounded-3 fw-bold fs-6 text-dark" style="background-color: #f59e0b; border: 1px solid #fbbf24;">
                        <i class="bi bi-briefcase-fill me-1.5"></i> @Model.Pozisyon
                    </div>
                </div>
            }
            else if (Model.FormTipi == "İş Başvurusu")
            {
                <div class="col-md-6">
                    <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-1">Başvurulan Pozisyon</small>
                    <div class="d-inline-block px-3 py-2 rounded-3 fw-bold fs-6 text-dark" style="background-color: #f59e0b; border: 1px solid #fbbf24;">
                        <i class="bi bi-briefcase-fill me-1.5"></i> Genel Başvuru
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Konu))
            {
                <div class="col-md-6">
                    <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-1">Konu</small>
                    <span class="text-white fw-semibold">@Model.Konu</span>
                </div>
            }

            <div class="col-md-6">
                <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-1">Gönderim Tarihi</small>
                <span class="text-light text-opacity-75">@Model.GonderimTarihi.ToString("dd MMMM yyyy HH:mm")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.OnYazi))
        {
            <div class="mb-4">
                <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-2">Ön Yazı / Kendini Tanıtma</small>
                <div class="p-3.5 rounded-3 text-white lh-lg" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); white-space: pre-line; font-size: 0.98rem;">
                    @Model.OnYazi
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Mesaj))
        {
            <div class="mb-4">
                <small class="text-light text-opacity-50 text-uppercase font-monospace d-block mb-2">Mesaj İçeriği</small>
                <div class="p-3.5 rounded-3 text-white lh-lg" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); white-space: pre-line; font-size: 0.98rem;">
                    @Model.Mesaj
                </div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center pt-3">
            <a href="mailto:@Model.Eposta?subject=Re: @(Model.Konu ?? Model.Pozisyon ?? Model.FormTipi)" class="btn btn-primary rounded-pill px-4 fw-semibold">
                <i class="bi bi-reply-fill me-1"></i> E-Posta ile Yanıtla
            </a>

            <form asp-action="MesajSil" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                    <i class="bi bi-trash-fill me-1"></i> Sil
                </button>
            </form>
        </div>
    </div>
</div>
