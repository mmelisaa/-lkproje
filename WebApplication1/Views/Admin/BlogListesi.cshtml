@model IEnumerable<WebApplication1.Models.Siniflar.BlogPost>
@{
    ViewData["Title"] = "Blog Yönetimi";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-journal-richtext text-primary me-2"></i>Blog Yönetimi</h3>
            <p class="text-light text-opacity-60 small mb-0">Web sitenizdeki blog yazılarını ekleyin, düzenleyin veya kaldırın</p>
        </div>
        <div>
            <a asp-action="BlogEkle" class="btn btn-primary btn-sm rounded-pill px-3"><i class="bi bi-plus-lg me-1"></i> Yeni Yazı Ekle</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 ms-2"><i class="bi bi-arrow-left me-1"></i> Panele Dön</a>
        </div>
    </div>

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4 border-0 shadow-lg" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3) !important; color: #34d399;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mesaj"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="p-4 rounded-4 shadow-sm" style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255,255,255,0.08);">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                <thead>
                    <tr class="text-secondary small">
                        <th>#</th>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Tarih</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td class="fw-semibold text-white">@item.Baslik</td>
                                <td><span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-25 px-2.5">@item.Kategori</span></td>
                                <td class="text-light text-opacity-70 small">@item.Tarih</td>
                                <td class="text-end">
                                    <a asp-action="BlogDuzenle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1"><i class="bi bi-pencil me-1"></i> Düzenle</a>
                                    <form asp-action="BlogSil" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu yazıyı silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-trash me-1"></i> Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Henüz blog yazısı eklenmemiş.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
