@model List<WebApplication1.Models.ApplicationUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bayi Portalları & Yetki Yönetimi";
}

<div class="container-fluid px-0">
    <!-- Üst Başlık & Özet -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill px-3 py-1.5" style="background: rgba(16, 185, 129, 0.12); color: #10b981; font-weight: 700; border: 1px solid rgba(16, 185, 129, 0.25);">
                    <i class="bi bi-shield-lock-fill me-1"></i> B2B Portal Yetkilendirme
                </span>
                <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-1">Identity &amp; Claim Bazlı</span>
            </div>
            <h2 class="fw-bold mb-1" style="color: var(--adm-text-main); letter-spacing: -0.5px;">Bayi Portalları &amp; Yetki Yönetimi</h2>
            <p class="text-secondary small mb-0">
                Sisteme kayıtlı bayilere hangi portal görünümünün açılacağını buradan belirleyin. A bayisi için Donanım, B bayisi için Yazılım veya C bayisi için Tam Ekosistem portalını anında atayabilirsiniz.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="BayiIslemLoglari" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-clock-history me-1"></i> Bayi Giriş &amp; İşlem İzi
            </a>
            <a asp-controller="Admin" asp-action="Bayiler" class="btn btn-primary btn-sm rounded-pill px-3.5 py-2 fw-semibold" style="background: #0b57d0; border: none;">
                <i class="bi bi-person-lines-fill me-1"></i> Tüm Bayi Listesi
            </a>
        </div>
    </div>

    <!-- 3 Portal Tipinin Özet Kartları -->
    <div class="row g-3 mb-4">
        <!-- Portal 1 -->
        <div class="col-lg-4 col-md-6">
            <div class="p-3.5 rounded-4 h-100 position-relative overflow-hidden" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
                <div class="position-absolute top-0 start-0 end-0" style="height: 3px; background: #4285F4;"></div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge px-2.5 py-1 rounded-pill" style="background: rgba(66, 133, 244, 0.12); color: #1a73e8; font-weight: 700;">1. Portal Görünümü</span>
                    <i class="bi bi-hdd-network text-primary fs-5"></i>
                </div>
                <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);">Donanım ve POS Bayisi Paneli</h5>
                <p class="text-secondary small mb-3" style="line-height: 1.5;">
                    Zebra, Sunmi, Datalogic ve KodPOS satan bayiler. Fiziksel cihaz yönetimi, seri no takibi, RMA ve sarf malzeme siparişi.
                </p>
                <div class="d-flex flex-wrap gap-1 small">
                    <span class="badge bg-light text-dark border">Seri No (SN) Envanteri</span>
                    <span class="badge bg-light text-dark border">RMA Teknik Servis</span>
                    <span class="badge bg-light text-dark border">Sarf Hızlı Sipariş</span>
                    <span class="badge bg-light text-dark border">Driver &amp; SDK Merkezi</span>
                    <span class="badge bg-light text-dark border">Fırsat / Proje Kaydı</span>
                    <span class="badge bg-light text-dark border">Demo Cihaz Talebi</span>
                </div>
            </div>
        </div>

        <!-- Portal 2 -->
        <div class="col-lg-4 col-md-6">
            <div class="p-3.5 rounded-4 h-100 position-relative overflow-hidden" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
                <div class="position-absolute top-0 start-0 end-0" style="height: 3px; background: #34A853;"></div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge px-2.5 py-1 rounded-pill" style="background: rgba(52, 168, 83, 0.12); color: #34a853; font-weight: 700;">2. Portal Görünümü</span>
                    <i class="bi bi-window-stack text-success fs-5"></i>
                </div>
                <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);">Yazılım ve ERP Bayisi Paneli</h5>
                <p class="text-secondary small mb-3" style="line-height: 1.5;">
                    HiCariTakip Cloud ERP, e-Dönüşüm ve adisyon yazılımları satan bayiler. Tamamen dijital lisanslar, abonelik süreleri ve ticket sistemi.
                </p>
                <div class="d-flex flex-wrap gap-1 small">
                    <span class="badge bg-light text-dark border">Lisans Takip Tablosu</span>
                    <span class="badge bg-light text-dark border">Sürüm Notları (v2.6)</span>
                    <span class="badge bg-light text-dark border">Yazılım Destek (Ticket)</span>
                    <span class="badge bg-light text-dark border">Bulut &amp; Yedekleme</span>
                    <span class="badge bg-light text-dark border">Alt Müşteri Yönetimi</span>
                    <span class="badge bg-light text-dark border">Akademi Sertifika</span>
                </div>
            </div>
        </div>

        <!-- Portal 3 -->
        <div class="col-lg-4 col-md-12">
            <div class="p-3.5 rounded-4 h-100 position-relative overflow-hidden" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
                <div class="position-absolute top-0 start-0 end-0" style="height: 3px; background: linear-gradient(90deg, #4285F4, #EA4335, #FBBC05, #34A853);"></div>
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="badge px-2.5 py-1 rounded-pill" style="background: rgba(234, 67, 53, 0.12); color: #ea4335; font-weight: 700;">3. Portal Görünümü</span>
                    <i class="bi bi-star-fill text-warning fs-5"></i>
                </div>
                <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);">Tam Yetkili Çözüm Ortağı Paneli</h5>
                <p class="text-secondary small mb-3" style="line-height: 1.5;">
                    Hem donanım POS hem de HiCariTakip ERP lisanslarını bir arada satan elit partnerler. Full ekosistem yönetimi.
                </p>
                <div class="d-flex flex-wrap gap-1 small">
                    <span class="badge bg-light text-dark border">1. ve 2. Portalın Tamamı</span>
                    <span class="badge bg-light text-dark border">Cihaz - Yazılım Eşleştirme</span>
                    <span class="badge bg-light text-dark border">Ciro Primi &amp; Hedef Sayacı</span>
                    <span class="badge bg-light text-dark border">Çapraz Satış Raporu</span>
                    <span class="badge bg-light text-dark border">MDF Pazarlama Fonu</span>
                    <span class="badge bg-light text-dark border">Özel İskonto Skalası</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bayi Yetki Atama Tablosu -->
    <div class="p-4 rounded-4 shadow-sm" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border);">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3 pb-3 border-bottom">
            <div>
                <h5 class="fw-bold mb-0" style="color: var(--adm-text-main);">Kayıtlı Bayiler &amp; Atanan Portal Görünümleri</h5>
                <small class="text-secondary">Admin tarafından atanan portal tipi bayinin girişinde otomatik olarak devreye girer.</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary bg-opacity-10 text-primary border rounded-pill px-3 py-1.5 fw-bold">
                    Toplam @Model.Count Kayıtlı Bayi
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="small text-uppercase text-secondary border-bottom">
                        <th>Bayi Firma &amp; Cari Kod</th>
                        <th>Yetkili &amp; İletişim</th>
                        <th>Şehir &amp; İskonto</th>
                        <th>Mevcut Portal Görünümü</th>
                        <th>Portal Yetkisi Değiştir</th>
                        <th class="text-end">Hızlı Görüntüle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                Henüz onaylanmış veya kayıtlı bayi bulunmuyor.
                            </td>
                        </tr>
                    }
                    @foreach (var b in Model)
                    {
                        var pTip = b.BayiPortalTipi;
                        <tr>
                            <td>
                                <strong style="color: var(--adm-text-main); font-size: 0.95rem;">@b.FirmaAdi</strong>
                                <div class="small font-monospace text-primary">@(string.IsNullOrEmpty(b.CariKodu) ? "Cari Kod Bekleniyor" : b.CariKodu)</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@b.AdSoyad</div>
                                <div class="small text-secondary">@b.Email &bull; @b.PhoneNumber</div>
                            </td>
                            <td>
                                <div><i class="bi bi-geo-alt me-1 text-muted"></i>@(string.IsNullOrEmpty(b.Sehir) ? "Belirtilmedi" : b.Sehir)</div>
                                <span class="badge bg-info bg-opacity-10 text-info border small mt-1">İskonto: %@b.IskontoOrani</span>
                            </td>
                            <td>
                                @if (pTip == 1)
                                {
                                    <span class="badge px-3 py-1.5 rounded-pill" style="background: rgba(66, 133, 244, 0.15); color: #1a73e8; font-weight: 700; border: 1px solid rgba(66, 133, 244, 0.3);">
                                        <i class="bi bi-hdd-network me-1"></i> Donanım &amp; POS Bayisi
                                    </span>
                                }
                                else if (pTip == 2)
                                {
                                    <span class="badge px-3 py-1.5 rounded-pill" style="background: rgba(52, 168, 83, 0.15); color: #34a853; font-weight: 700; border: 1px solid rgba(52, 168, 83, 0.3);">
                                        <i class="bi bi-window-stack me-1"></i> Yazılım &amp; ERP Bayisi
                                    </span>
                                }
                                else if (pTip == 3)
                                {
                                    <span class="badge px-3 py-1.5 rounded-pill" style="background: rgba(234, 67, 53, 0.15); color: #ea4335; font-weight: 700; border: 1px solid rgba(234, 67, 53, 0.3);">
                                        <i class="bi bi-star-fill me-1"></i> Tam Yetkili Çözüm Ortağı
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-1">Standart</span>
                                }
                            </td>
                            <td>
                                <form asp-controller="Admin" asp-action="BayiPortalTipiGuncelle" method="post" class="d-flex align-items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@b.Id" />
                                    <select name="portalTipi" class="form-select form-select-sm" style="max-width: 260px; font-weight: 600;">
                                        <option value="1" selected="@(pTip == 1)">1. Donanım ve POS Bayisi</option>
                                        <option value="2" selected="@(pTip == 2)">2. Yazılım ve ERP Bayisi</option>
                                        <option value="3" selected="@(pTip == 3)">3. Tam Yetkili Çözüm Ortağı</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold">
                                        <i class="bi bi-check-lg me-1"></i> Ata
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <a href="/Home/BayiGirisi" target="_blank" class="btn btn-sm btn-light border rounded-pill px-2.5 py-1 text-secondary" title="Bayi girişini test et">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Portala Git
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
