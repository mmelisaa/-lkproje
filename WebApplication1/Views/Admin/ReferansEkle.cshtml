@model WebApplication1.Models.Siniflar.ReferansProje
@{
    ViewData["Title"] = "Referans Ekle";
}

<div class="container py-4" style="max-width: 750px;">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
        <h3 class="fw-bold text-white mb-0"><i class="bi bi-plus-circle text-success me-2"></i>Yeni Referans Proje Ekle</h3>
        <a asp-action="ReferansListesi" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Geri Dön</a>
    </div>

    <div class="p-4 p-md-5 rounded-4 shadow-lg" style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255,255,255,0.08);">
        <form asp-action="ReferansEkle" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Baslik" class="form-label text-white small fw-semibold">Proje Başlığı *</label>
                <input asp-for="Baslik" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" placeholder="Proje adı" required />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Kategori" class="form-label text-white small fw-semibold">Kategori</label>
                    <input asp-for="Kategori" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" placeholder="Örn: E-Ticaret" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Etiketler" class="form-label text-white small fw-semibold">Etiketler</label>
                    <input asp-for="Etiketler" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" placeholder="Örn: ASP.NET Core, React" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label text-white small fw-semibold">Açıklama</label>
                <textarea asp-for="Aciklama" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" rows="3" placeholder="Kısa açıklama..."></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="GorselUrl" class="form-label text-white small fw-semibold">Görsel URL</label>
                <input asp-for="GorselUrl" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" placeholder="https://..." />
            </div>
            <div class="mb-4">
                <label asp-for="ProjeLinki" class="form-label text-white small fw-semibold">Proje Linki</label>
                <input asp-for="ProjeLinki" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" placeholder="https://..." />
            </div>
            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-success rounded-pill px-4"><i class="bi bi-check-lg me-1"></i> Kaydet</button>
                <a asp-action="ReferansListesi" class="btn btn-outline-secondary rounded-pill px-4">İptal</a>
            </div>
        </form>
    </div>
</div>
