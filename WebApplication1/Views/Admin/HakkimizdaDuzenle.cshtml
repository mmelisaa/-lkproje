@model WebApplication1.Models.Siniflar.Kurumsal.Hakkimizda
@{
    ViewData["Title"] = "Hakkımızda Düzenle";
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Hakkımızda Sayfasını Düzenle</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Panele Dön</a>
    </div>
    <form asp-action="HakkimizdaDuzenle" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="HakkimizdaID" />
        <div class="mb-3">
            <label asp-for="Baslik" class="form-label fw-semibold">Başlık</label>
            <input asp-for="Baslik" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Aciklama" class="form-label fw-semibold">Açıklama</label>
            <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="GorselUrl" class="form-label fw-semibold">Görsel URL</label>
            <input asp-for="GorselUrl" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="HizmetAlanlari" class="form-label fw-semibold">Hizmet Alanları</label>
            <textarea asp-for="HizmetAlanlari" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="KurumsalGucumuz" class="form-label fw-semibold">Kurumsal Gücümüz</label>
            <textarea asp-for="KurumsalGucumuz" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="CalismaIlkelerimiz" class="form-label fw-semibold">Çalışma İlkelerimiz</label>
            <textarea asp-for="CalismaIlkelerimiz" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Vizyonumuz" class="form-label fw-semibold">Vizyonumuz</label>
            <textarea asp-for="Vizyonumuz" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Misyonumuz" class="form-label fw-semibold">Misyonumuz</label>
            <textarea asp-for="Misyonumuz" class="form-control" rows="2"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="Onceliklerimiz" class="form-label fw-semibold">Önceliklerimiz</label>
            <textarea asp-for="Onceliklerimiz" class="form-control" rows="2"></textarea>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div>
