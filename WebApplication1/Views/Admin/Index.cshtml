                                            <i class="bi bi-briefcase-fill me-1"></i>İş Başvurusu
                                        </span>
                                    }
                                    else if (m.FormTipi == "Teklif Talebi")
                                    {
                                        <span class="badge px-3 py-1.5 fw-bold rounded-pill shadow-sm" style="background-color: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.25); font-size: 0.8rem; letter-spacing: 0.3px;">
                                            <i class="bi bi-tag-fill me-1"></i>Teklif Talebi
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge px-3 py-1.5 fw-bold rounded-pill shadow-sm" style="background-color: rgba(11, 87, 208, 0.1); color: var(--adm-accent); border: 1px solid rgba(11, 87, 208, 0.2); font-size: 0.8rem; letter-spacing: 0.3px;">
                                            <i class="bi bi-chat-dots-fill me-1"></i>İletişim
