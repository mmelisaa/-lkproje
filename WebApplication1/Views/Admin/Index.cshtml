    <!-- 4. HIZLI ERİŞİM & YÖNETİM MODÜLLERİ -->
    <div class="row g-4 mb-4">
        <!-- Mesaj & Başvurular -->
        <div class="col-md-3">
            <div class="p-4 rounded-4 shadow-sm h-100 admin-glass-card">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="admin-icon-box" style="background: rgba(11, 87, 208, 0.08); border: 1px solid rgba(11, 87, 208, 0.15); color: #0b57d0;">
                        <i class="bi bi-inbox-fill fs-4"></i>
                    </div>
                    <span class="badge px-2.5 py-1 rounded-pill fw-bold" style="background: rgba(11, 87, 208, 0.12); color: var(--adm-accent);">
                        @ViewBag.MesajSayisi Mesaj
