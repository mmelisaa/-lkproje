</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js"><\/script>');
        }
    </script>
    <script>
        let myChart = null;

        function loadChart(periyot, btn) {
            if (btn) {
                document.querySelectorAll('.btn-group .btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }

            fetch('/Admin/ZiyaretciVerileri?periyot=' + periyot)
                .then(res => {
                    if (!res.ok) throw new Error("HTTP error " + res.status);
                    return res.json();
                })
                .then(data => {
                    const canvas = document.getElementById('ziyaretciChart');
                    if (!canvas) return;
                    const ctx = canvas.getContext('2d');
                    
                    if (myChart) {
                        myChart.destroy();
                    }

                    myChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [{
                                label: 'Ziyaretçi Sayısı',
                                data: data.values,
                                borderColor: '#0b57d0',
                                backgroundColor: 'rgba(11, 87, 208, 0.12)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointBackgroundColor: '#0b57d0',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: 'rgba(29, 29, 31, 0.92)',
                                    titleColor: '#ffffff',
                                    bodyColor: '#38bdf8',
                                    borderColor: 'rgba(11, 87, 208, 0.3)',
                                    borderWidth: 1,
                                    padding: 10,
                                    cornerRadius: 8
                                }
                            },
                            scales: {
                                x: {
                                    grid: { color: 'rgba(0, 0, 0, 0.05)' },
                                    ticks: { color: '#64748b', font: { size: 11, weight: '500' } }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: 'rgba(0, 0, 0, 0.05)' },
                                    ticks: { color: '#64748b', stepSize: 1, precision: 0, font: { size: 11, weight: '500' } }
                                }
                            }
                        }
                    });
                })
                .catch(err => console.error("Grafik yükleme hatası:", err));
        }

        function loadKarsilastirma() {
            fetch('/Admin/ZiyaretciKarsilastirma')
                .then(res => {
                    if (!res.ok) throw new Error("HTTP error " + res.status);
                    return res.json();
                })
                .then(d => {
                    // Gün
                    const elGunM = document.getElementById('buGunVal');
                    const elDun = document.getElementById('dunVal');
                    if (elGunM && elDun && d.gun) {
                        elGunM.innerText = d.gun.mevcut;
                        elDun.innerText = d.gun.onceki;
                        setDegisim('gunDegisim', 'gunBar', d.gun.mevcut, d.gun.onceki);
                    }

                    // Hafta
                    const elHaftaM = document.getElementById('buHaftaVal');
                    const elHaftaO = document.getElementById('gecenHaftaVal');
                    if (elHaftaM && elHaftaO && d.hafta) {
                        elHaftaM.innerText = d.hafta.mevcut;
                        elHaftaO.innerText = d.hafta.onceki;
                        setDegisim('haftaDegisim', 'haftaBar', d.hafta.mevcut, d.hafta.onceki);
                    }

                    // Ay
                    const elAyM = document.getElementById('buAyVal');
                    const elAyO = document.getElementById('gecenAyVal');
                    if (elAyM && elAyO && d.ay) {
                        elAyM.innerText = d.ay.mevcut;
                        elAyO.innerText = d.ay.onceki;
                        setDegisim('ayDegisim', 'ayBar', d.ay.mevcut, d.ay.onceki);
                    }

                    // Yıl
                    const elYilM = document.getElementById('buYilVal');
                    const elYilO = document.getElementById('gecenYilVal');
                    if (elYilM && elYilO && d.yil) {
                        elYilM.innerText = d.yil.mevcut;
                        elYilO.innerText = d.yil.onceki;
                        setDegisim('yilDegisim', 'yilBar', d.yil.mevcut, d.yil.onceki);
                    }
                })
                .catch(err => console.error("Karşılaştırma yükleme hatası:", err));
        }

        function setDegisim(badgeId, barId, mevcut, onceki) {
            const badge = document.getElementById(badgeId);
            const bar = document.getElementById(barId);
            if (!badge || !bar) return;

            let pct = 0;
            if (onceki === 0) {
                pct = mevcut > 0 ? 100 : 0;
            } else {
                pct = Math.round(((mevcut - onceki) / onceki) * 100);
            }
            if (pct >= 0) {
                badge.className = "badge bg-success bg-opacity-20 text-success small";
                badge.innerText = "+" + pct + "%";
            } else {
                badge.className = "badge bg-danger bg-opacity-20 text-danger small";
                badge.innerText = pct + "%";
            }

            const total = (mevcut + onceki) || 1;
            const barPct = Math.round((mevcut / total) * 100);
            bar.style.width = Math.max(barPct, 10) + "%";
        }

        // Ciro Donut Chart
        function initCiroDonut() {
            const canvas = document.getElementById('ciroDonutChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['SaaS & Lisans', 'POS & Donanım', 'Saha Kurulum & Bakım'],
                    datasets: [{
                        data: [51, 37, 12],
                        backgroundColor: ['#0b57d0', '#38bdf8', '#f59e0b'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    cutout: '68%'
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadChart('haftalik');
            loadKarsilastirma();
            initCiroDonut();
        });

        // Canlı Parçacık Arka Plan
        (function() {
            const canvas = document.getElementById('adminCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let w, h;
            let particles = [];
            const count = 36;

            function resize() {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            for (let i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * w,
                    y: Math.random() * h,
                    vx: (Math.random() - 0.5) * 0.4,
                    vy: (Math.random() - 0.5) * 0.4,
                    r: Math.random() * 1.6 + 1
                });
            }

            function animate() {
                ctx.clearRect(0, 0, w, h);

                for (let i = 0; i < count; i++) {
                    const p = particles[i];
                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = w;
                    if (p.x > w) p.x = 0;
                    if (p.y < 0) p.y = h;
                    if (p.y > h) p.y = 0;

                    ctx.fillStyle = 'rgba(56, 189, 248, 0.4)';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fill();

                    for (let j = i + 1; j < count; j++) {
                        const p2 = particles[j];
                        const dx = p.x - p2.x;
                        const dy = p.y - p2.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 120) {
                            ctx.strokeStyle = 'rgba(56, 189, 248, ' + (0.12 * (1 - dist / 120)) + ')';
                            ctx.lineWidth = 0.8;
                            ctx.beginPath();
                            ctx.moveTo(p.x, p.y);
                            ctx.lineTo(p2.x, p2.y);
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(animate);
            }
            requestAnimationFrame(animate);
        })();
    </script>
}
