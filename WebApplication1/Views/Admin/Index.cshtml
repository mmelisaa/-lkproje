        <!-- Kurumsal Sayfalar -->
        <div class="col-md-3">
            <div class="p-4 rounded-4 shadow-sm h-100 admin-glass-card">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="admin-icon-box" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.15); color: #d97706;">
                        <i class="bi bi-gear-wide-connected fs-4"></i>
                    </div>
                    <span class="badge px-2.5 py-1 rounded-pill fw-bold" style="background: rgba(245, 158, 11, 0.12); color: #d97706;">
                        Sayfalar
                    </span>
                </div>
                <h5 class="fw-bold mb-2" style="color: var(--adm-text-main);">Kurumsal Sayfalar</h5>
