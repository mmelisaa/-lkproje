@{
    ViewData["Title"] = "Admin Kontrol Paneli";
}

<style>
    .admin-live-bg-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
        background: transparent;
    }
    .admin-glass-card {
        background: var(--adm-card-bg) !important;
        border: 1px solid var(--adm-card-border) !important;
        box-shadow: var(--adm-card-shadow);
        position: relative;
        overflow: hidden;
        border-radius: 1.25rem;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
    }
    .admin-glass-card:hover {
        transform: translateY(-4px);
        border-color: var(--adm-accent) !important;
        box-shadow: 0 16px 36px rgba(11, 87, 208, 0.12) !important;
    }
    .admin-stat-card {
        background: var(--adm-card-bg) !important;
        border: 1px solid var(--adm-card-border) !important;
        box-shadow: var(--adm-card-shadow);
        position: relative;
        overflow: hidden;
        border-radius: 1.25rem;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
    }
    .admin-stat-card:hover {
        transform: translateY(-4px);
        border-color: var(--adm-accent) !important;
        box-shadow: 0 16px 36px rgba(11, 87, 208, 0.12) !important;
    }
    .admin-stat-card::after {
        content: '';
        position: absolute;
        bottom: -24px;
        right: -24px;
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.2) 0%, rgba(11, 87, 208, 0.15) 60%, transparent 100%);
        border: 1px solid rgba(11, 87, 208, 0.12);
        pointer-events: none;
    }
    .admin-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.25s ease;
    }
    .admin-stat-card:hover .admin-icon-box {
        transform: scale(1.08);
    }
    .admin-accent-bottom-line {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
    }
    .admin-chart-btn {
        background: rgba(0, 0, 0, 0.04);
        border: 1px solid var(--adm-card-border);
        color: var(--adm-text-sub);
        font-weight: 600;
        transition: all 0.2s ease;
    }
    .admin-chart-btn:hover {
        background: rgba(11, 87, 208, 0.08);
        color: var(--adm-accent);
    }
    .admin-chart-btn.active {
        background: var(--adm-sidebar-active) !important;
        border-color: var(--adm-sidebar-active) !important;
        color: var(--adm-sidebar-active-text) !important;
        box-shadow: 0 4px 12px rgba(11, 87, 208, 0.25);
    }
    .admin-action-btn {
        background: rgba(11, 87, 208, 0.08);
        border: 1px solid rgba(11, 87, 208, 0.22);
        color: var(--adm-accent);
        font-weight: 600;
        transition: all 0.25s ease;
    }
    .admin-action-btn:hover {
        background: var(--adm-sidebar-active);
        border-color: var(--adm-sidebar-active);
        color: var(--adm-sidebar-active-text) !important;
        transform: translateY(-1px);
    }
    .admin-table tbody tr {
        transition: background-color 0.2s ease;
        border-bottom: 1px solid var(--adm-card-border);
    }
    .admin-table tbody tr:hover {
        background-color: var(--adm-table-hover);
    }
</style>

<div class="admin-live-bg-container">
    <canvas id="adminCanvas"></canvas>
</div>

<div class="container-fluid px-0 position-relative" style="z-index: 1;">
    <!-- Üst Başlık & Hızlı Bilgi -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--adm-card-border) !important;">
        <div>
            <span class="badge px-3 py-1.5 rounded-pill small fw-bold text-uppercase mb-2 d-inline-flex align-items-center" style="background: var(--adm-sidebar-bg); border: 1px solid var(--adm-card-border); color: var(--adm-accent);">
                <i class="bi bi-shield-lock-fill me-1"></i> Admin Yönetim Konsolu &bull; Ekru / Obsidian
            </span>
            <h2 class="fw-bold mb-0" style="color: var(--adm-text-main); letter-spacing: -0.5px;">B2B Yönetim ve İstatistik Paneli</h2>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="GirisLoglari" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-shield-lock-fill me-1"></i> Giriş Logları
            </a>
            <a asp-action="MesajListesi" class="btn btn-sm rounded-pill px-3 position-relative" style="background: var(--adm-sidebar-bg); border: 1px solid var(--adm-card-border); color: var(--adm-accent); font-weight: 600;">
                <i class="bi bi-envelope-fill me-1"></i> Mesajlar
                @if (ViewBag.OkunmamisMesaj > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @ViewBag.OkunmamisMesaj
                    </span>
                }
            </a>
        </div>
    </div>

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4 border-0 shadow-sm" role="alert" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25) !important; color: #059669;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. ZİYARETÇİ İSTATİSTİK KARTLARI (GÜNLÜK, HAFTALIK, AYLIK, YILLIK, TOPLAM) -->
    <div class="row g-3 mb-4">
        <!-- 1. Bugün -->
        <div class="col-6 col-md-4 col-xl">
            <div class="p-3.5 rounded-4 shadow-sm h-100 admin-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold" style="color: var(--adm-text-sub);">Bugünkü Ziyaret</span>
                    <div class="admin-icon-box" style="background: rgba(11, 87, 208, 0.08); border: 1px solid rgba(11, 87, 208, 0.15); color: #0b57d0;">
                        <i class="bi bi-calendar-day fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0" style="color: var(--adm-text-main);">@ViewBag.BugunkuZiyaret</h3>
                <small style="color: #0b57d0; font-weight: 600;"><i class="bi bi-clock-history me-1"></i>Son 24 Saat</small>
                <div class="admin-accent-bottom-line" style="background: linear-gradient(90deg, #0b57d0, #38bdf8);"></div>
            </div>
        </div>

        <!-- 2. Bu Hafta -->
        <div class="col-6 col-md-4 col-xl">
            <div class="p-3.5 rounded-4 shadow-sm h-100 admin-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold" style="color: var(--adm-text-sub);">Haftalık Ziyaret</span>
                    <div class="admin-icon-box" style="background: rgba(79, 70, 229, 0.08); border: 1px solid rgba(79, 70, 229, 0.15); color: #4f46e5;">
                        <i class="bi bi-calendar-week fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0" style="color: var(--adm-text-main);">@ViewBag.HaftalikZiyaret</h3>
                <small style="color: #4f46e5; font-weight: 600;"><i class="bi bi-graph-up me-1"></i>Son 7 Gün</small>
                <div class="admin-accent-bottom-line" style="background: linear-gradient(90deg, #4f46e5, #818cf8);"></div>
            </div>
        </div>

        <!-- 3. Bu Ay -->
        <div class="col-6 col-md-4 col-xl">
            <div class="p-3.5 rounded-4 shadow-sm h-100 admin-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold" style="color: var(--adm-text-sub);">Aylık Ziyaret</span>
                    <div class="admin-icon-box" style="background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.15); color: #8b5cf6;">
                        <i class="bi bi-calendar-month fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0" style="color: var(--adm-text-main);">@ViewBag.AylikZiyaret</h3>
                <small style="color: #8b5cf6; font-weight: 600;"><i class="bi bi-bar-chart me-1"></i>Son 30 Gün</small>
                <div class="admin-accent-bottom-line" style="background: linear-gradient(90deg, #8b5cf6, #c084fc);"></div>
            </div>
        </div>

        <!-- 4. Bu Yıl (YENİ) -->
        <div class="col-6 col-md-6 col-xl">
            <div class="p-3.5 rounded-4 shadow-sm h-100 admin-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold" style="color: var(--adm-text-sub);">Yıllık Ziyaret</span>
                    <div class="admin-icon-box" style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.15); color: #d97706;">
                        <i class="bi bi-calendar-check fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0" style="color: var(--adm-text-main);">@ViewBag.YillikZiyaret</h3>
                <small style="color: #d97706; font-weight: 600;"><i class="bi bi-award me-1"></i>Son 365 Gün</small>
                <div class="admin-accent-bottom-line" style="background: linear-gradient(90deg, #d97706, #fbbf24);"></div>
            </div>
        </div>

        <!-- 5. Toplam Trafik -->
        <div class="col-12 col-md-6 col-xl">
            <div class="p-3.5 rounded-4 shadow-sm h-100 admin-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-semibold" style="color: var(--adm-text-sub);">Toplam Trafik</span>
                    <div class="admin-icon-box" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.15); color: #059669;">
                        <i class="bi bi-activity fs-5"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0" style="color: var(--adm-text-main);">@ViewBag.ToplamZiyaret</h3>
                <small style="color: #059669; font-weight: 600;"><i class="bi bi-infinity me-1"></i>Tüm Zamanlar</small>
                <div class="admin-accent-bottom-line" style="background: linear-gradient(90deg, #059669, #34d399);"></div>
            </div>
        </div>
    </div>

    <!-- 2. GRAFİK VE 4'LÜ DÖNEM KARŞILAŞTIRMASI -->
    <div class="row g-4 mb-4">
        <!-- Ziyaretçi Trend Grafiği -->
        <div class="col-lg-8">
            <div class="p-4 rounded-4 shadow-sm h-100 admin-glass-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);"><i class="bi bi-graph-up-arrow me-2" style="color: var(--adm-accent);"></i>Ziyaretçi Analitiği</h5>
                        <p class="small mb-0" style="color: var(--adm-text-sub);">Dönemsel ziyaretçi hacim ve trend grafiği</p>
                    </div>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn admin-chart-btn" onclick="loadChart('gunluk', this)">Günlük</button>
                        <button type="button" class="btn admin-chart-btn active" onclick="loadChart('haftalik', this)">Haftalık</button>
                        <button type="button" class="btn admin-chart-btn" onclick="loadChart('aylik', this)">Aylık</button>
                        <button type="button" class="btn admin-chart-btn" onclick="loadChart('yillik', this)">Yıllık</button>
                    </div>
                </div>
                <div style="position: relative; height: 280px;">
                    <canvas id="ziyaretciChart"></canvas>
                </div>
            </div>
        </div>

        <!-- 4'lü Dönem Karşılaştırma Kartı (Günlük, Haftalık, Aylık, Yıllık) -->
        <div class="col-lg-4">
            <div class="p-4 rounded-4 shadow-sm h-100 admin-glass-card">
                <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);"><i class="bi bi-arrow-down-up me-2" style="color: #d97706;"></i>Dönem Karşılaştırmaları</h5>
                <p class="small mb-3" style="color: var(--adm-text-sub);">Önceki dönemlere göre ziyaretçi performansı</p>

                <!-- 1. Günlük Kıyaslama (Bugün vs Dün) -->
                <div class="mb-3 pb-2.5 border-bottom" style="border-color: var(--adm-card-border) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small font-monospace" style="color: var(--adm-text-sub);">Günlük (Bugün vs Dün)</span>
                        <span id="gunDegisim" class="badge bg-info bg-opacity-20 text-info small">...</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-6" style="color: var(--adm-text-main);" id="buGunVal">0</span>
                        <span class="small" style="color: var(--adm-text-sub);">vs <span id="dunVal">0</span></span>
                    </div>
                    <div class="progress mt-1.5" style="height: 5px; background: rgba(0, 0, 0, 0.08); border-radius: 999px;">
                        <div id="gunBar" class="progress-bar" role="progressbar" style="width: 50%; background: #38bdf8; border-radius: 999px;"></div>
                    </div>
                </div>

                <!-- 2. Haftalık Kıyaslama -->
                <div class="mb-3 pb-2.5 border-bottom" style="border-color: var(--adm-card-border) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small font-monospace" style="color: var(--adm-text-sub);">Haftalık (Bu Hafta vs Geçen Hafta)</span>
                        <span id="haftaDegisim" class="badge bg-success bg-opacity-20 text-success small">...</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-6" style="color: var(--adm-text-main);" id="buHaftaVal">0</span>
                        <span class="small" style="color: var(--adm-text-sub);">vs <span id="gecenHaftaVal">0</span></span>
                    </div>
                    <div class="progress mt-1.5" style="height: 5px; background: rgba(0, 0, 0, 0.08); border-radius: 999px;">
                        <div id="haftaBar" class="progress-bar" role="progressbar" style="width: 50%; background: #0b57d0; border-radius: 999px;"></div>
                    </div>
                </div>

                <!-- 3. Aylık Kıyaslama -->
                <div class="mb-3 pb-2.5 border-bottom" style="border-color: var(--adm-card-border) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small font-monospace" style="color: var(--adm-text-sub);">Aylık (Bu Ay vs Geçen Ay)</span>
                        <span id="ayDegisim" class="badge bg-primary bg-opacity-20 text-primary small">...</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-6" style="color: var(--adm-text-main);" id="buAyVal">0</span>
                        <span class="small" style="color: var(--adm-text-sub);">vs <span id="gecenAyVal">0</span></span>
                    </div>
                    <div class="progress mt-1.5" style="height: 5px; background: rgba(0, 0, 0, 0.08); border-radius: 999px;">
                        <div id="ayBar" class="progress-bar" role="progressbar" style="width: 50%; background: #8b5cf6; border-radius: 999px;"></div>
                    </div>
                </div>

                <!-- 4. Yıllık Kıyaslama -->
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small font-monospace" style="color: var(--adm-text-sub);">Yıllık (Bu Yıl vs Geçen Yıl)</span>
                        <span id="yilDegisim" class="badge bg-warning bg-opacity-20 text-warning small">...</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-6" style="color: var(--adm-text-main);" id="buYilVal">0</span>
                        <span class="small" style="color: var(--adm-text-sub);">vs <span id="gecenYilVal">0</span></span>
                    </div>
                    <div class="progress mt-1.5" style="height: 5px; background: rgba(0, 0, 0, 0.08); border-radius: 999px;">
                        <div id="yilBar" class="progress-bar" role="progressbar" style="width: 50%; background: #d97706; border-radius: 999px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. KURUMSAL B2B & ERP İNTEL WIDGETLARI (CİRO DAĞILIMI, YAKLAŞAN LİSANSLAR, KRİTİK STOK, SLA PERFORMANSI) -->
    <div class="row g-4 mb-4">
        <!-- A. Ciro Dağılım Grafiği (Donanım vs Yazılım Lisans) -->
        <div class="col-lg-6">
            <div class="p-4 rounded-4 shadow-sm h-100 admin-glass-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);"><i class="bi bi-pie-chart-fill me-2 text-primary"></i>Ciro &amp; Gelir Dağılımı</h5>
                        <p class="small mb-0" style="color: var(--adm-text-sub);">Donanım satışı vs. HiCariTakip SaaS/Lisans gelirleri</p>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-bold">
                        ₺1,842,500 Toplam Hacim
                    </span>
                </div>
                <div class="row align-items-center g-3">
                    <div class="col-sm-5 text-center">
                        <div style="position: relative; width: 140px; height: 140px; margin: 0 auto;">
                            <canvas id="ciroDonutChart"></canvas>
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <div class="d-flex flex-column gap-2.5">
                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span style="color: var(--adm-text-main);"><i class="bi bi-circle-fill text-primary me-1.5 font-size-10"></i>HiCariTakip SaaS &amp; Lisans</span>
                                    <span class="fw-bold" style="color: var(--adm-text-main);">₺940,000 (%51)</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 999px;">
                                    <div class="progress-bar bg-primary" style="width: 51%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span style="color: var(--adm-text-main);"><i class="bi bi-circle-fill text-info me-1.5 font-size-10"></i>POS, El Terminali &amp; Donanım</span>
                                    <span class="fw-bold" style="color: var(--adm-text-main);">₺682,500 (%37)</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 999px;">
                                    <div class="progress-bar bg-info" style="width: 37%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span style="color: var(--adm-text-main);"><i class="bi bi-circle-fill text-warning me-1.5 font-size-10"></i>Saha Kurulum &amp; SLA Bakım</span>
                                    <span class="fw-bold" style="color: var(--adm-text-main);">₺220,000 (%12)</span>
                                </div>
                                <div class="progress" style="height: 6px; border-radius: 999px;">
                                    <div class="progress-bar bg-warning" style="width: 12%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- B. Yaklaşan Süre Dolumları (Önümüzdeki 15 Gün) -->
        <div class="col-lg-6">
            <div class="p-4 rounded-4 shadow-sm h-100 admin-glass-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);"><i class="bi bi-alarm-fill me-2 text-warning"></i>Yaklaşan Lisans Süre Dolumları</h5>
                        <p class="small mb-0" style="color: var(--adm-text-sub);">Önümüzdeki 15 gün içinde yenileme bekleyen müşteriler</p>
                    </div>
                    <span class="badge bg-warning bg-opacity-10 text-warning px-2.5 py-1 rounded-pill">3 Müşteri</span>
                </div>
                <div class="d-flex flex-column gap-2">
                    <div class="p-2.5 rounded-3 d-flex justify-content-between align-items-center" style="background: var(--adm-sidebar-bg); border: 1px solid var(--adm-card-border);">
                        <div>
                            <div class="fw-bold small" style="color: var(--adm-text-main);">Elazığ Akaryakıt &amp; Lojistik Ltd.</div>
                            <small style="color: var(--adm-text-sub);">HiCariTakip ERP Yıllık Bulut Lisansı</small>
                        </div>
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2.5 py-1 rounded-pill small">4 Gün Kaldı</span>
                    </div>
                    <div class="p-2.5 rounded-3 d-flex justify-content-between align-items-center" style="background: var(--adm-sidebar-bg); border: 1px solid var(--adm-card-border);">
                        <div>
                            <div class="fw-bold small" style="color: var(--adm-text-main);">Kaya Toptan Gıda A.Ş.</div>
                            <small style="color: var(--adm-text-sub);">El Terminali Kurumsal Bakım Sözleşmesi</small>
                        </div>
                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2.5 py-1 rounded-pill small">8 Gün Kaldı</span>
                    </div>
                    <div class="p-2.5 rounded-3 d-flex justify-content-between align-items-center" style="background: var(--adm-sidebar-bg); border: 1px solid var(--adm-card-border);">
                        <div>
                            <div class="fw-bold small" style="color: var(--adm-text-main);">Doğu Ecza Deposu</div>
                            <small style="color: var(--adm-text-sub);">E-Fatura &amp; E-İrsaliye Entegrasyon Modülü</small>
                        </div>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2.5 py-1 rounded-pill small">14 Gün Kaldı</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- C. Kritik Stok & Eşik Uyarısı (< 5 Adet) -->
        <div class="col-lg-6">
            <div class="p-4 rounded-4 shadow-sm h-100 admin-glass-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1" style="color: var(--adm-text-main);"><i class="bi bi-box-seam-fill me-2 text-danger"></i>Kritik Stok &amp; Eşik Uyarısı</h5>
