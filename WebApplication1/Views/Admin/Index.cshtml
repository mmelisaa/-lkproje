                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-printer text-warning fs-5"></i>
                            <div>
                                <div class="fw-bold small" style="color: var(--adm-text-main);">Xprinter XP-470B Termal Kargo Yazıcı</div>
