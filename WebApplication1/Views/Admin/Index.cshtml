                                <td style="color: var(--adm-text-sub);">@(m.Konu ?? m.Pozisyon ?? "-")</td>
                                <td class="small" style="color: var(--adm-text-sub);">@m.GonderimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
