                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success px-2.5 py-1 rounded-pill">%99.4 Başarı</span>
                </div>
                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="p-2.5 rounded-3" style="background: var(--adm-sidebar-bg); border: 1px solid var(--adm-card-border);">
                            <div class="fs-5 fw-bold text-primary">18 dk</div>
