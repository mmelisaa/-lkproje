                <div class="d-flex gap-2">
                    <a asp-action="HakkimizdaDuzenle" class="btn btn-sm rounded-pill flex-fill admin-action-btn">Hakkımızda</a>
                    <a asp-action="InsanKaynaklariDuzenle" class="btn btn-sm rounded-pill flex-fill admin-action-btn">İK</a>
