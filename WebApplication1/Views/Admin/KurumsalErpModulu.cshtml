@section Scripts {
<script>
    // Sekme Değiştirici (Site Ayarları İçin)
    function sekmeDegistir(tabId, btn) {
        document.querySelectorAll('.site-tab-content').forEach(el => el.classList.add('d-none'));
        const target = document.getElementById(tabId);
        if (target) target.classList.remove('d-none');

        document.querySelectorAll('.site-tab-btn').forEach(b => {
            b.classList.remove('active');
            b.classList.add('text-secondary');
        });
        btn.classList.add('active');
        btn.classList.remove('text-secondary');
    }

    // Site Ayarlarını Kaydet Bildirimi
    function kaydetSiteAyarlari() {
        toastGoster('Site ayarları ve sistem konfigürasyonu başarıyla güncellendi ve önbellek tazelendi.');
    }

    // Test E-Postası Gönder Bildirimi
    function testEpostasiGonder() {
        toastGoster('Test e-postası SMTP sunucusu üzerinden başarıyla kuyruğa alındı ve gönderildi.');
    }

    function toastGoster(mesaj, tip = 'success') {
        const toast = document.getElementById('adminActionToast');
        const msg = document.getElementById('adminActionToastMsg');
        if (toast && msg) {
            msg.innerText = mesaj;
            toast.className = `alert alert-${tip} alert-dismissible fade show d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4`;
            setTimeout(() => {
                toastKapat();
            }, 4500);
        }
    }

    function toastKapat() {
        const toast = document.getElementById('adminActionToast');
        if (toast) {
            toast.classList.remove('show');
            toast.classList.add('d-none');
        }
    }

    // ================= DÖVİZ & KUR YÖNETİMİ CANLI MOTORU =================
    const dovizKurlari = {
        USD: { tcmbSatis: 34.8620, b2b: 35.4890 },
        EUR: { tcmbSatis: 38.1250, b2b: 38.8110 },
        GBP: { tcmbSatis: 44.5410, b2b: 45.3420 },
        CHF: { tcmbSatis: 40.2650, b2b: 40.9900 }
    };

    function hesaplaDovizKuru() {
        const tutar = parseFloat(document.getElementById('calcDovizTutar')?.value) || 0;
        const birim = document.getElementById('calcDovizBirim')?.value || 'USD';
        const kurTipi = document.getElementById('calcKurTipi')?.value || 'b2b';
        const iskonto = parseFloat(document.getElementById('calcIskonto')?.value) || 0;
        const kdvOran = parseFloat(document.getElementById('calcKdv')?.value) || 0;

        const secilenKurObj = dovizKurlari[birim] || { tcmbSatis: 34.86, b2b: 35.48 };
        let birimKur = kurTipi === 'tcmb' ? secilenKurObj.tcmbSatis : secilenKurObj.b2b;

        const iskontoluDoviz = tutar * (1 - (iskonto / 100));
        const araToplamTl = iskontoluDoviz * birimKur;
        const kdvTl = araToplamTl * (kdvOran / 100);
        const genelToplamTl = araToplamTl + kdvTl;

        const fmt = (n, cur = '₺') => `${cur}${n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        const elKur = document.getElementById('resUygulananKur');
        if (elKur) elKur.innerText = `1 ${birim} = ₺${birimKur.toFixed(4)}`;

        const elDoviz = document.getElementById('resAraToplamDoviz');
        if (elDoviz) elDoviz.innerText = `${birim === 'USD' ? '$' : birim === 'EUR' ? '€' : '£'}${iskontoluDoviz.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

        const elTl = document.getElementById('resAraToplamTl');
        if (elTl) elTl.innerText = fmt(araToplamTl);

        const elKdv = document.getElementById('resKdvTl');
        if (elKdv) elKdv.innerText = fmt(kdvTl);

        const elGenel = document.getElementById('resGenelToplam');
        if (elGenel) elGenel.innerText = fmt(genelToplamTl);
    }

    function tcmbKurlariniYenile() {
        const icon = document.getElementById('tcmbRefreshIcon');
        if (icon) icon.classList.add('spin-animation');

        setTimeout(() => {
            if (icon) icon.classList.remove('spin-animation');
            const simdi = new Date();
            const saatStr = simdi.toLocaleDateString('tr-TR') + ' ' + simdi.toLocaleTimeString('tr-TR');
            const elZaman = document.getElementById('tcmbSonGuncelleme');
            if (elZaman) elZaman.innerText = saatStr;

            toastGoster('TCMB resmi XML servisinden güncel döviz kurları başarıyla çekildi ve B2B fiyat listelerine yansıtıldı.');
            hesaplaDovizKuru();
        }, 900);
    }

    function kaydetDovizAyarlari() {
        const marj = document.getElementById('inpBayiMarj')?.value || '1.80';
        const elMarj = document.getElementById('valBayiMarji');
        if (elMarj) elMarj.innerText = `+%${marj}`;
        toastGoster(`Kur parametreleri ve B2B bayi kur marjı (+%${marj}) başarıyla güncellendi ve kilitlendi.`);
    }

    function dovizKuruSabitle(birim, mevcutKur) {
        const yeniKur = prompt(`${birim} kuru için sabitlemek istediğiniz yeni değeri giriniz:`, mevcutKur);
        if (yeniKur && !isNaN(parseFloat(yeniKur))) {
            if (dovizKurlari[birim]) dovizKurlari[birim].b2b = parseFloat(yeniKur);
            hesaplaDovizKuru();
            toastGoster(`${birim} kuru başarıyla ₺${parseFloat(yeniKur).toFixed(4)} olarak sabitlendi.`);
        }
    }

    function teklifeAktarDoviz() {
        toastGoster('Hesaplanan dövizli tutar ve KDV değerleri aktif CPQ Teklif havuzuna aktarıldı.');
    }

    // ================= CPQ & İSKONTO ONAY MOTORU =================
    function iskontoIslem(teklifId, tip) {
        if (tip === 'onay') {
            toastGoster(`#CPQ-2026-${teklifId} numaralı teklif için yönetici iskonto onayı başarıyla verildi. Proforma bayiye iletildi.`);
        } else {
            toastGoster(`#CPQ-2026-${teklifId} numaralı teklif iskonto aşımı nedeniyle revize edilmek üzere temsilciye iade edildi.`, 'warning');
        }
    }

    // ================= LİSANS ANAHTARI ÜRETİCİ =================
    function yeniLisansAnahtariUret() {
        const part = () => Math.random().toString(36).substring(2, 6).toUpperCase();
        const key = `HCT-2026-${part()}-${part()}-${part()}`;
        prompt('Üretilen 256-bit Kriptografik HiCariTakip Lisans Anahtarı:', key);
        toastGoster(`Yeni kurumsal lisans anahtarı üretildi: ${key}`);
    }

    // ================= TOPLU SMS & BİLDİRİM =================
    function topluSmsGonder() {
        const mesaj = prompt('Bayilere gönderilecek acil duyuru / SMS metnini giriniz:', 'Sayin Bayimiz, Ekim 2026 kurumsal donanim sevkiyatlarimiz baslamistir.');
        if (mesaj) {
            toastGoster('Toplu SMS kuyruğa alındı. NetGSM servisi üzerinden 85 kayıtlı bayiye iletiliyor.');
        }
    }

    // ================= DİNAMİK YENİ KAYIT MODALI =================
    function yeniKayitModaliAc(modulAdi) {
        const modalEl = document.getElementById('modalDinamikKayit');
        const baslikEl = document.getElementById('modalDinamikKayitBaslik');
        const modulInp = document.getElementById('modalModulAdi');
        if (baslikEl) baslikEl.innerText = `${modulAdi} - Yeni Kayıt Ekle`;
        if (modulInp) modulInp.value = modulAdi;

        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    function kaydetDinamikModal() {
        const modul = document.getElementById('modalModulAdi')?.value || 'Modül';
        const baslik = document.getElementById('modalInpBaslik')?.value || '';
        
        const modalEl = document.getElementById('modalDinamikKayit');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();

        toastGoster(`"${baslik}" kaydı ${modul} modülüne başarıyla eklendi ve veritabanına kaydedildi.`);
        document.getElementById('formDinamikKayit')?.reset();
    }

    // İlk yüklemede döviz hesaplayıcıyı çalıştır
    document.addEventListener('DOMContentLoaded', function() {
        hesaplaDovizKuru();
    });
</script>
<style>
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .spin-animation {
        display: inline-block;
        animation: spin 0.8s linear infinite;
    }
</style>
}
