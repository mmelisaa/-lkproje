        case "BayiSozlesmeOnaylari":
            baslik = "Bayi Sözleşme Onay Logları (E-İmza & OTP)";
            altBaslik = "Bayilerin dijital olarak onayladığı B2B sözleşmeler, IP adresleri ve SHA-256 doğrulama zaman damgaları";
