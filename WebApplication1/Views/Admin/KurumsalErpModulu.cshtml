            kategoriRozet = "FİNANS & B2B RİSK";
            break;
        case "DovizKurYonetimi":
            baslik = "Çoklu Para Birimi (Döviz) & Kur Yönetimi";
            altBaslik = "TCMB canlı kurları (USD, EUR, GBP), manuel kur sabitleme ve dövizli B2B teklif hesaplayıcı";
            ikon = "bi-currency-exchange text-success";
            kategoriRozet = "FİNANS & DÖVİZ";
            break;
        case "TopluIletisimMerkezi":
            baslik = "Toplu İletişim & Otomatik Bildirim Merkezi";
            altBaslik = "Müşteri ve bayilere giden otomatik SMS ve e-posta şablonları (Sipariş Onay, Kargo Takip, Lisans Uyarısı)";
