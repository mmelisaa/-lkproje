                    <small class="text-secondary">Cihazın şu an nerede olduğu (Merkez Servis, Üretici, Kargo, Depo), garanti kapsamı ve yapılan işlem (Onarım / Parça Değişimi / Birebir Değişim / İade) canlı takip edilir.</small>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="small text-uppercase text-secondary border-bottom">
                            <th>RMA No &bull; Müşteri</th>
                            <th>Cihaz &bull; Seri No &bull; Arıza</th>
                            <th>Garanti Durumu</th>
                            <th>Yapılan İşlem &bull; Parça</th>
                            <th>Parçanın / Cihazın Konumu</th>
                            <th>Kargo Durumu &bull; Takip No</th>
                            <th>Servis Statüsü</th>
                            <th class="text-end">Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rmaListesi)
                        {
                            var kalanGun = r.GarantiBitisTarihi.HasValue ? (int)(r.GarantiBitisTarihi.Value.Date - DateTime.Now.Date).TotalDays : 0;
                            <tr>
                                <form asp-controller="Admin" asp-action="RmaGuncelle" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <td style="min-width:170px;">
                                        <span class="badge bg-dark font-monospace mb-1">@r.RmaNo</span>
                                        <div class="fw-bold" style="color: var(--adm-text-main);">@r.MusteriAdi</div>
                                        <small class="text-secondary">@r.Telefon</small>
                                    </td>
                                    <td style="min-width:210px;">
                                        <strong style="color: var(--adm-text-main);">@r.CihazModeli</strong>
                                        <div class="small font-monospace text-primary">SN: @r.SeriNo</div>
                                        <div class="small text-secondary" title="@r.ArizaAciklamasi">@r.ArizaAciklamasi</div>
                                    </td>
                                    <td style="min-width:185px;">
                                        <div class="mb-1">
                                            @if (r.GarantiKapsaminda)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2.5 py-1 fw-bold">
                                                    <i class="bi bi-shield-check me-1"></i>Garanti Kapsamında (@(kalanGun > 0 ? $"{kalanGun} gün kaldı" : "Aktif"))
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2.5 py-1 fw-bold">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>Garanti Dışı (@r.Ucret.ToString("N0") ₺)
                                                </span>
                                            }
                                        </div>
                                        <select name="garantiKapsaminda" class="form-select form-select-sm mb-1">
                                            <option value="true" selected="@r.GarantiKapsaminda">Garanti Kapsamında (0 ₺)</option>
                                            <option value="false" selected="@(!r.GarantiKapsaminda)">Garanti Dışı (Ücretli)</option>
                                        </select>
                                        <input type="number" step="50" name="ucret" class="form-control form-control-sm" value="@r.Ucret" placeholder="Ücret (₺)" title="Garanti dışı onarım ücreti" />
                                    </td>
                                    <td style="min-width:190px;">
                                        <select name="cozum" class="form-select form-select-sm fw-semibold mb-1">
                                            @foreach (var cz in RmaSabitleri.Cozumler)
                                            {
                                                <option value="@cz" selected="@(r.Cozum == cz)">@cz</option>
