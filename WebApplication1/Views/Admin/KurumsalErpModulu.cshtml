        case "ApiEntegrasyonLoglari":
            baslik = "API & Entegrasyon Webhook Logları";
            altBaslik = "ERP, Sanal POS, Kargo servisleri ve GİB E-Fatura API çağrıları, webhook istekleri ve yanıt süreleri";
