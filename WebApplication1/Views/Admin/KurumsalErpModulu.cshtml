        case "Menuler":
            baslik = "Menü & Navigasyon Hiyerarşisi Yönetimi";
            altBaslik = "Web sitesi üst menü ve alt bilgi (footer) bağlantı yapısı, sıralama ve yönlendirme linkleri";
