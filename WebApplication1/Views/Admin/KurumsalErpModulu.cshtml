                            <option value="@dr">@dr</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Kargo Durumu / Yönü</label>
                    <select name="kargoYonu" class="form-select">
                        @foreach (var ky in RmaSabitleri.KargoYonleri)
