@using WebApplication1.Models
@using WebApplication1.Models.Siniflar
@{
    var seciliModul = ViewBag.SeciliModul as string ?? "TeklifCpq";
    ViewData["Title"] = seciliModul;

    string baslik = "Kurumsal Modül";
    string altBaslik = "Hayat İşleri B2B Kurumsal ERP Yönetim Modülü";
    string ikon = "bi-cpu";
    string kategoriRozet = "KURUMSAL B2B • OPERASYON YÖNETİMİ";

    switch(seciliModul)
    {
        case "SiteAyarlari":
            baslik = "Genel Site Ayarları & Sistem Konfigürasyonu";
            altBaslik = "Kurumsal kimlik, logolar, iletişim, SMTP sunucusu, SEO meta etiketleri, bakım modu ve güvenlik parametreleri";
            ikon = "bi-gear-wide-connected text-primary";
            kategoriRozet = "SİSTEM & ALTYAPI";
            break;
        case "Slider":
            baslik = "Ana Sayfa Vitrin Slider & Manşet Yönetimi";
            altBaslik = "Ana sayfa karşılama ekranındaki manşet slaytları, görseller, buton yönlendirmeleri ve gösterim sırası";
            ikon = "bi-images text-info";
            kategoriRozet = "ANA SAYFA & VİTRİN";
            break;
        case "AnasayfaAksiyonKarti":
            baslik = "Sabit Aksiyon Kartı (CTA Banner) Yönetimi";
            altBaslik = "Ana sayfada ve teklif sayfalarında yer alan 'Yeni Projenizi Hayata Geçirmeye Hazır mısınız?' aksiyon bloğu";
            ikon = "bi-megaphone-fill text-warning";
            kategoriRozet = "ANA SAYFA & VİTRİN";
            break;
        case "CozumUrunu":
            baslik = "Çözüm Kartları (Vitrin)";
            altBaslik = "ERP, Hızlı Satış POS, Barkodlu Depo ve B2B Portalı için vitrin çözüm kartları";
            ikon = "bi-grid-fill text-primary";
            kategoriRozet = "ANA SAYFA & VİTRİN";
            break;
        case "SirketOlcegi":
            baslik = "Şirket Ölçekleri (KOBİ & Kurumsal Segmentler)";
            altBaslik = "Mikro esnaf, KOBİ, orta ölçekli işletme ve kurumsal holding segmentasyon tanımları";
            ikon = "bi-buildings text-secondary";
            kategoriRozet = "ANA SAYFA & VİTRİN";
            break;
        case "Sektor":
            baslik = "Sektörel Çözüm Yönetimi";
            altBaslik = "Perakende, lojistik, medikal, otomotiv ve üretim sektörlerine özel yazılım/donanım paketleri";
            ikon = "bi-diagram-2 text-indigo";
            kategoriRozet = "ANA SAYFA & VİTRİN";
            break;
        case "YazilimUrunleri":
            baslik = "Yazılım Ürün Kataloğu";
            altBaslik = "HiCariTakip Cloud ERP, Hızlı Satış POS, HiDepo WMS ve B2B Bayi Ağı yazılım sürümleri";
            ikon = "bi-code-slash text-primary";
            kategoriRozet = "E-TİCARET & YAZILIM";
            break;
        case "DonanimUrunleri":
            baslik = "Donanım Ürünleri & POS Donanım Kataloğu";
            altBaslik = "El terminalleri, dokunmatik POS ekranları, endüstriyel termal yazıcılar ve masaüstü barkod okuyucular";
            ikon = "bi-display text-info";
            kategoriRozet = "E-TİCARET & DONANIM";
            break;
        case "Markalar":
            baslik = "Markalar & Donanım Üreticileri";
            altBaslik = "Zebra, Sunmi, Datalogic, Honeywell, Bixolon, Elo ve Epson yetkili donanım iş ortaklıkları";
            ikon = "bi-award text-success";
            kategoriRozet = "E-TİCARET & B2B";
            break;
        case "Kategoriler":
            baslik = "Ürün ve Donanım Kategorileri";
            altBaslik = "Yazılım paketleri, barkod otomasyonu, POS donanımı ve çevre birimleri grup tanımları";
            ikon = "bi-tags text-warning";
            kategoriRozet = "E-TİCARET & B2B";
            break;
        case "Bayiler":
            baslik = "Bayiler & Kurumsal Müşteriler (B2B CRM)";
