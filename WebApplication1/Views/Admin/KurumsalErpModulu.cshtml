        case "IadeMutabakatYonetimi":
            baslik = "İade, İptal & B2B Cari Mutabakat";
            altBaslik = "Dönemsel Ba/Bs mutabakatları, e-Mutabakat bildirimleri ve onay bekleyen B2B iade faturaları";
