            altBaslik = "Merkez Depo, Teknik Servis Deposu, Ar-Ge Test ve Konsinye depolarının raf bazlı stok takibi";
            ikon = "bi-geo-alt-fill text-danger";
            kategoriRozet = "DONANIM & ENVENTER";
            break;
        case "GarantiBakim":
            baslik = "Garanti & Bakım Sözleşmesi Takibi";
