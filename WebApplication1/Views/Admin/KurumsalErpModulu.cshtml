                <div class="col-lg-6">
                    <div class="p-4 rounded-4 shadow-sm h-100" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border);">
                        <h5 class="fw-bold mb-3 pb-2 border-bottom" style="color: var(--adm-text-main); border-color: var(--adm-card-border) !important;">
                            <i class="bi bi-shield-check text-success me-2"></i>Güvenlik &amp; KVKK Parametreleri
