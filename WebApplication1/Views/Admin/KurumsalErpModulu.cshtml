                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="twoFaSwitch" checked />
                            <label class="form-check-label fw-bold" for="twoFaSwitch">Admin Girişlerinde 2FA (İki Adımlı Doğrulama) Zorunluluğu</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="rateLimitSwitch" checked />
                            <label class="form-check-label fw-bold" for="rateLimitSwitch">WAF &amp; Rate Limiting (Dakikada Maks. 100 İstek Koruması)</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="lockoutSwitch" checked />
