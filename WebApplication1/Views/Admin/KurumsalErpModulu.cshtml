<div class="container-fluid px-0">
    <!-- Üst Başlık & Eylem Çubuğu -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom" style="border-color: var(--adm-card-border) !important; gap: 1rem;">
        <div>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: var(--adm-chip-bg); border: 1px solid var(--adm-card-border); font-size: 0.74rem; font-weight: 700; color: var(--adm-text-sub); letter-spacing: 0.5px;">
                <i class="bi @ikon"></i>
                <span>@kategoriRozet</span>
            </div>
            <h2 class="fw-bold mb-1" style="color: var(--adm-text-main); letter-spacing: -0.4px; font-size: 1.55rem;">@baslik</h2>
            <p class="small mb-0" style="color: var(--adm-text-sub);">@altBaslik</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold" onclick="window.print()" style="background: var(--adm-chip-bg); border: 1px solid var(--adm-card-border); color: var(--adm-text-main);">
                <i class="bi bi-printer me-1"></i> Yazdır / PDF
            </button>
            @if(seciliModul == "SiteAyarlari")
            {
                <button type="button" class="btn btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2" onclick="kaydetSiteAyarlari()" style="background: var(--adm-sidebar-active); border: none; color: var(--adm-sidebar-active-text);">
                    <i class="bi bi-floppy-fill"></i> Tüm Ayarları Kaydet
                </button>
            }
            else if(seciliModul == "RmaServis")
            {
                <a href="#yeniRmaFormKart" class="btn btn-sm rounded-pill px-3.5 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2 text-decoration-none" style="background: var(--adm-sidebar-active); border: none; color: var(--adm-sidebar-active-text);">
                    <i class="bi bi-tools"></i> Yeni RMA Servis Kaydı Aç
                </a>
            }
            else
            {
                <button type="button" class="btn btn-sm rounded-pill px-3.5 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2" onclick="yeniKayitModaliAc('@seciliModul')" style="background: var(--adm-sidebar-active); border: none; color: var(--adm-sidebar-active-text);">
                    <i class="bi bi-plus-lg"></i> Yeni Kayıt Ekle
                </button>
            }
        </div>
    </div>

    @if (TempData["Mesaj"] is string sunucuBilgi)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 rounded-3 shadow-sm mb-4">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div class="fw-semibold">@sunucuBilgi</div>
        </div>
    }

    <!-- Bildirim Toast Alanı -->
    <div id="adminActionToast" class="alert alert-success alert-dismissible fade d-none align-items-center gap-2 rounded-3 shadow-sm mb-4" role="alert" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); color: #047857;">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div id="adminActionToastMsg" class="fw-semibold">İşlem başarıyla kaydedildi.</div>
        <button type="button" class="btn-close" onclick="toastKapat()"></button>
    </div>

    @* ========================================================================= *@
    @* 1. GENEL SİTE AYARLARI KONSOLU (6 SEKMELİ KAPSAMLI YÖNETİM)             *@
    @* ========================================================================= *@
    @if(seciliModul == "SiteAyarlari")
    {
        <!-- Sekme Başlıkları -->
        <ul class="nav nav-pills mb-4 p-1.5 rounded-4 gap-1 shadow-sm" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border);">
            <li class="nav-item">
                <button class="nav-link active rounded-pill px-3.5 py-2 fw-bold btn-sm site-tab-btn" onclick="sekmeDegistir('tabKimlik', this)">
                    <i class="bi bi-building me-1.5"></i> 1. Genel Bilgiler &amp; Kimlik
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill px-3.5 py-2 fw-bold btn-sm site-tab-btn text-secondary" onclick="sekmeDegistir('tabIletisim', this)">
                    <i class="bi bi-geo-alt me-1.5"></i> 2. İletişim &amp; Lokasyon
                </button>
