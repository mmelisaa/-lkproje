            kategoriRozet = "SİSTEM & SİTE AYARLARI";
            break;
        case "YasalMetinler":
            baslik = "Yasal Metinler, KVKK & Sözleşmeler";
            altBaslik = "KVKK Aydınlatma Metni, Çerez Politikası, Mesafeli Satış ve B2B Bayilik Sözleşmesi metinleri";
            ikon = "bi-file-earmark-text text-primary";
            kategoriRozet = "HUKUK & KVKK";
