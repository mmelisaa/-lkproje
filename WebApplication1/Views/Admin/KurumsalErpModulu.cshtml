        <!-- Sekme 4: SEO & Analitik (Dinamik Alt Sayfa Meta & Slug Yönetimi) -->
        <div id="tabSeo" class="site-tab-content d-none">
            <div class="p-4 rounded-4 shadow-sm mb-4" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border);">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--adm-card-border) !important;">
                    <div>
                        <h5 class="fw-bold mb-0" style="color: var(--adm-text-main);">
                            <i class="bi bi-search text-primary me-2"></i>Dinamik Alt Sayfa SEO Meta Başlık, Açıklama &amp; URL (Slug) Yönetimi
                        </h5>
                        <small class="text-secondary">Tüm alt sayfaların meta başlıkları, açıklamaları ve SEO dostu URL yapıları veritabanından dinamik yönetilir.</small>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">SeoFilter &amp; SeoSlugMiddleware Aktif</span>
                </div>

                @{
                    var seoListesi = ViewBag.SeoAyarlari as List<SeoAyari> ?? new List<SeoAyari>();
                }
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr class="small text-uppercase text-secondary border-bottom">
                                <th>Sayfa &bull; Route</th>
                                <th>URL Slug (Özel Adres)</th>
                                <th>Meta Başlık (Title)</th>
                                <th>Meta Açıklama (Description)</th>
                                <th>Anahtar Kelimeler</th>
                                <th>İndeks</th>
                                <th class="text-end">Kaydet</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in seoListesi)
                            {
                                <tr>
                                    <form asp-controller="Admin" asp-action="SeoGuncelle" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <td style="min-width:140px;">
                                            <strong style="color: var(--adm-text-main);">@s.SayfaAdi</strong>
                                            <div class="small font-monospace text-secondary">@s.SayfaKodu</div>
                                        </td>
                                        <td style="min-width:150px;">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">/</span>
                                                <input type="text" name="slug" class="form-control font-monospace" value="@s.Slug" placeholder="anasayfa" />
                                            </div>
                                        </td>
                                        <td style="min-width:220px;">
                                            <input type="text" name="metaBaslik" class="form-control form-control-sm" value="@s.MetaBaslik" required />
                                        </td>
                                        <td style="min-width:250px;">
                                            <input type="text" name="metaAciklama" class="form-control form-control-sm" value="@s.MetaAciklama" required />
                                        </td>
                                        <td style="min-width:180px;">
                                            <input type="text" name="anahtarKelimeler" class="form-control form-control-sm" value="@s.AnahtarKelimeler" />
                                        </td>
                                        <td>
                                            <input type="checkbox" name="indexle" value="true" class="form-check-input" checked="@s.Aktif" title="index,follow" />
                                        </td>
                                        <td class="text-end">
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold">Güncelle</button>
                                        </td>
                                    </form>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sekme 5: E-Posta & SMTP -->
