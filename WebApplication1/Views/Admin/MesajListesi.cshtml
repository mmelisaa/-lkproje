@model IEnumerable<WebApplication1.Models.Siniflar.SiteMesaj>
@{
    ViewData["Title"] = "Gelen Mesaj ve Başvurular";
    var seciliFiltre = ViewBag.Filtre as string ?? "Tümü";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
        <div>
            <h3 class="fw-bold text-white mb-1"><i class="bi bi-inbox-fill text-info me-2"></i>Gelen Mesaj ve Başvurular</h3>
            <p class="text-light text-opacity-60 small mb-0">Web sitesi üzerinden iletilen tüm iletişim, iş başvurusu ve teklif mesajları</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Panele Dön
        </a>
    </div>

    <!-- Filtre Butonları -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <a asp-action="MesajListesi" asp-route-filtre="Tümü" class="btn btn-sm rounded-pill @(seciliFiltre == "Tümü" ? "btn-info" : "btn-outline-info")">Tümü</a>
        <a asp-action="MesajListesi" asp-route-filtre="İletişim" class="btn btn-sm rounded-pill @(seciliFiltre == "İletişim" ? "btn-info" : "btn-outline-info")">İletişim Mesajları</a>
        <a asp-action="MesajListesi" asp-route-filtre="İş Başvurusu" class="btn btn-sm rounded-pill @(seciliFiltre == "İş Başvurusu" ? "btn-warning" : "btn-outline-warning")">İş Başvuruları</a>
        <a asp-action="MesajListesi" asp-route-filtre="Teklif Talebi" class="btn btn-sm rounded-pill @(seciliFiltre == "Teklif Talebi" ? "btn-success" : "btn-outline-success")">Teklif Talepleri</a>
    </div>

    <div class="p-4 rounded-4 shadow-sm" style="background: rgba(18, 24, 38, 0.85); border: 1px solid rgba(255,255,255,0.08);">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                <thead>
                    <tr class="text-secondary small">
                        <th>#</th>
                        <th>Gönderen</th>
                        <th>E-Posta</th>
                        <th>Tür</th>
                        <th>Konu / Pozisyon</th>
                        <th>Tarih</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(!item.Okundu ? "fw-bold" : "opacity-75")">
                                <td>@item.Id</td>
                                <td class="text-white">
                                    @item.AdSoyad
                                    @if (!item.Okundu)
                                    {
                                        <span class="badge bg-danger ms-1 small">Yeni</span>
                                    }
                                </td>
                                <td class="text-info opacity-90">@item.Eposta</td>
                                <td>
                                    @if (item.FormTipi == "İş Başvurusu")
                                    {
                                        <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-25 px-2.5">İş Başvurusu</span>
                                    }
                                    else if (item.FormTipi == "Teklif Talebi")
                                    {
                                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25 px-2.5">Teklif Talebi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-25 px-2.5">İletişim</span>
                                    }
                                </td>
                                <td class="text-light">@(item.Konu ?? item.Pozisyon ?? "-")</td>
                                <td class="text-light text-opacity-60 small">@item.GonderimTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="MesajDetay" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill px-3 me-1">Oku</a>
                                    <form asp-action="MesajSil" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Kayıtlı mesaj veya başvuru bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
