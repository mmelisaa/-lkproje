@model WebApplication1.Models.Siniflar.ReferansProje
@{
    ViewData["Title"] = "Referans Düzenle";
}

<div class="container mt-5" style="max-width: 700px;">
    <h3 class="fw-bold mb-4">Referans Projeyi Düzenle</h3>
    <form asp-action="ReferansDuzenle" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Baslik" class="form-label fw-semibold">Proje Başlığı</label>
            <input asp-for="Baslik" class="form-control" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Kategori" class="form-label fw-semibold">Kategori</label>
                <input asp-for="Kategori" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Etiketler" class="form-label fw-semibold">Etiketler</label>
                <input asp-for="Etiketler" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Aciklama" class="form-label fw-semibold">Açıklama</label>
            <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label asp-for="GorselUrl" class="form-label fw-semibold">Görsel URL</label>
            <input asp-for="GorselUrl" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="ProjeLinki" class="form-label fw-semibold">Proje Linki</label>
            <input asp-for="ProjeLinki" class="form-control" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Güncelle</button>
            <a asp-action="ReferansListesi" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div>
