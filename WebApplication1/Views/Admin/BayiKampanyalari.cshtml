@model List<WebApplication1.Models.BayiOzelKampanya>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bayiye Özel Kampanyalar";
    var bayiler = ViewBag.Bayiler as List<WebApplication1.Models.ApplicationUser> ?? new();
}

<div class="container-fluid px-0">
    <!-- Üst Başlık & Butonlar -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill px-3 py-1.5" style="background: rgba(234, 67, 53, 0.12); color: #ea4335; font-weight: 700; border: 1px solid rgba(234, 67, 53, 0.25);">
                    <i class="bi bi-gift-fill me-1"></i> B2B Bayi Özel İskontoları
                </span>
                <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-1">Anlık Bayi Portalı Entegrasyonu</span>
            </div>
            <h2 class="fw-bold mb-1" style="color: var(--adm-text-main); letter-spacing: -0.5px;">Bayiye Özel Kampanya &amp; İndirim Yönetimi</h2>
            <p class="text-secondary small mb-0">
                Bizimle iş birliği yapan bayilere özel donanım ve yazılım indirimleri tanımlayın. Tanımladığınız kampanyalar ilgili bayinin panelindeki <strong>"Size Özel Kampanyalar"</strong> bölümüne anında yansır.
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="MesajListesi" asp-route-filtre="Kampanya Talebi" class="btn btn-outline-primary btn-sm rounded-pill px-3.5 py-2 fw-bold shadow-sm" style="border-color: #7952b3; color: #7952b3;">
                <i class="bi bi-inbox-fill me-1"></i> Gelen Kampanya Talepleri
            </a>
            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm" style="background: #0b57d0; border: none;" data-bs-toggle="modal" data-bs-target="#modalYeniKampanya">
                <i class="bi bi-plus-circle me-1"></i> Yeni Kampanya Tanımla
            </button>
        </div>
    </div>

    <!-- Özet İstatistik Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="p-3.5 rounded-4 h-100" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Toplam Kampanya</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill p-2"><i class="bi bi-tags-fill"></i></span>
                </div>
                <div class="fs-3 fw-bold" style="color: var(--adm-text-main);">@Model.Count</div>
                <small class="text-secondary">Tüm kayıtlı kampanyalar</small>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3.5 rounded-4 h-100" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Aktif Yayında</span>
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill p-2"><i class="bi bi-broadcast"></i></span>
                </div>
                <div class="fs-3 fw-bold text-success">@Model.Count(k => k.GecerliMi)</div>
                <small class="text-secondary">Süresi devam edenler</small>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3.5 rounded-4 h-100" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Donanım İndirimleri</span>
                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill p-2"><i class="bi bi-cpu"></i></span>
                </div>
                <div class="fs-3 fw-bold text-info">@Model.Count(k => k.Kategori == "Donanım")</div>
                <small class="text-secondary">POS, yazıcı, terminal</small>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3.5 rounded-4 h-100" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-semibold">Yazılım İndirimleri</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill p-2"><i class="bi bi-code-slash"></i></span>
                </div>
                <div class="fs-3 fw-bold text-warning">@Model.Count(k => k.Kategori == "Yazılım")</div>
                <small class="text-secondary">ERP, lisans &amp; kontör</small>
            </div>
        </div>
    </div>

    <!-- Kampanyalar Tablosu -->
    <div class="rounded-4 overflow-hidden" style="background: var(--adm-card-bg); border: 1px solid var(--adm-card-border); box-shadow: var(--adm-card-shadow);">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h6 class="fw-bold mb-0" style="color: var(--adm-text-main);"><i class="bi bi-card-checklist me-2 text-primary"></i>Tanımlı Bayi Kampanyaları (@Model.Count)</h6>
            <div class="small text-secondary">
                <i class="bi bi-info-circle me-1"></i> Bayiler bu kampanyaları kendi panellerinde <strong>"Size Özel Kampanyalar"</strong> sekmesinde görür.
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0" style="color: var(--adm-text-main);">
                <thead style="background: var(--adm-bg); border-bottom: 2px solid var(--adm-card-border); font-size: 0.76rem; text-transform: uppercase;">
                    <tr>
                        <th class="ps-3 py-3">Hedef Bayi</th>
                        <th class="py-3">Kategori</th>
                        <th class="py-3">Kampanya Başlığı &amp; Detayı</th>
                        <th class="py-3">Ürün Grubu</th>
                        <th class="py-3">İskonto / Fiyat</th>
                        <th class="py-3">Geçerlilik Tarihleri</th>
                        <th class="py-3">Durum</th>
                        <th class="text-end pe-3 py-3">İşlemler</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.85rem;">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <i class="bi bi-tags display-6 d-block mb-2 text-muted"></i>
                                Henüz tanımlı bir bayi özel kampanyası bulunmuyor.<br />
                                Yukarıdaki <strong>"Yeni Kampanya Tanımla"</strong> butonunu kullanarak bir bayiye donanım veya yazılım kampanyası atayabilirsiniz.
                            </td>
                        </tr>
                    }
                    @foreach (var k in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--adm-card-border);">
                            <td class="ps-3 py-3">
                                @if (string.IsNullOrEmpty(k.BayiId))
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-1 fw-bold">
                                        <i class="bi bi-people-fill me-1"></i> Tüm Bayiler
                                    </span>
                                }
                                else
                                {
                                    <div class="fw-bold text-primary">@k.BayiAdi</div>
                                    <small class="text-secondary font-monospace" style="font-size: 0.72rem;">ID: @(k.BayiId?.Length > 8 ? k.BayiId[..8] + "..." : k.BayiId)</small>
                                }
                            </td>
                            <td>
                                @if (k.Kategori == "Donanım")
                                {
                                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(66, 133, 244, 0.12); color: #1a73e8; border: 1px solid rgba(66, 133, 244, 0.25);">
                                        <i class="bi bi-hdd-network me-1"></i> Donanım
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(52, 168, 83, 0.12); color: #34a853; border: 1px solid rgba(52, 168, 83, 0.25);">
                                        <i class="bi bi-window-stack me-1"></i> Yazılım
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold" style="color: var(--adm-text-main);">@k.Baslik</div>
                                @if (!string.IsNullOrEmpty(k.Aciklama))
                                {
                                    <small class="text-secondary d-block mt-0.5 text-truncate" style="max-width: 320px;" title="@k.Aciklama">@k.Aciklama</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(k.UrunGrubu) ? "Tüm Kategoriler" : k.UrunGrubu)</span>
                            </td>
                            <td>
                                @if (k.IskontoOrani > 0)
                                {
                                    <div class="fw-bold text-danger fs-6">+%@k.IskontoOrani:0.## Ek İskonto</div>
                                }
                                @if (k.OzelFiyatTL.HasValue && k.OzelFiyatTL > 0)
                                {
                                    <small class="text-success fw-bold font-monospace">@k.OzelFiyatTL.Value.ToString("N2") TL</small>
                                }
                            </td>
                            <td>
                                <div><small class="text-secondary">@k.BaslangicTarihi.ToString("dd.MM.yyyy") &bull; @k.BitisTarihi.ToString("dd.MM.yyyy")</small></div>
                                @if (k.GecerliMi)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-0.5 small mt-1">
                                        <i class="bi bi-hourglass-split me-1"></i> @k.KalanGun Gün Kaldı
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-0.5 small mt-1">
                                        Süresi Doldu
                                    </span>
                                }
                            </td>
                            <td>
                                @if (k.Aktif)
                                {
                                    <span class="badge bg-success text-white rounded-pill px-2.5 py-1">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white rounded-pill px-2.5 py-1">Pasif</span>
                                }
                            </td>
                            <td class="text-end pe-3 py-3">
                                <div class="d-inline-flex gap-1.5">
                                    <form asp-controller="Admin" asp-action="BayiKampanyaDurumDegistir" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@k.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" title="@(k.Aktif ? "Pasife Al" : "Aktifleştir")">
                                            <i class="bi @(k.Aktif ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="BayiKampanyaSil" method="post" class="d-inline" onsubmit="return confirm('Bu kampanyayı silmek istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@k.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Yeni Bayi Kampanyası Tanımla -->
<div class="modal fade" id="modalYeniKampanya" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Admin" asp-action="BayiKampanyaEkle" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" style="color: var(--adm-text-main);">
                        <i class="bi bi-gift-fill text-danger me-2"></i>Bayiye Özel Kampanya / İndirim Tanımla
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Hedef Bayi -->
                        <div class="col-md-6">
                            <label class="small fw-bold text-secondary mb-1">Hedef Bayi Seçin:</label>
                            <select name="bayiId" class="form-select" required>
                                <option value="">Tüm Bayiler İçin Genel Kampanya</option>
                                @foreach (var b in bayiler)
                                {
                                    <option value="@b.Id">@b.FirmaAdi (@b.UserName - % @b.IskontoOrani)</option>
                                }
                            </select>
                            <small class="text-secondary" style="font-size: 0.74rem;">Belirli bir bayiyi seçerseniz sadece o bayinin panelinde görünür.</small>
                        </div>

                        <!-- Kategori -->
                        <div class="col-md-6">
                            <label class="small fw-bold text-secondary mb-1">Kampanya Kategorisi:</label>
                            <select name="kategori" class="form-select" required>
                                <option value="Donanım">Donanım Ürünleri (POS, Barkod Yazıcı, Terminal)</option>
                                <option value="Yazılım">Yazılım Ürünleri (ERP, Lisans, Kontör, Ek Modül)</option>
                            </select>
                        </div>

                        <!-- Başlık -->
                        <div class="col-12">
                            <label class="small fw-bold text-secondary mb-1">Kampanya Başlığı:</label>
                            <input type="text" name="baslik" class="form-control" placeholder="Örn: Doğu Lojistik'e Özel Sunmi POS %15 Ekstra Teşvik İndirimi" required />
                        </div>

                        <!-- Ürün Grubu & Süre -->
                        <div class="col-md-6">
                            <label class="small fw-bold text-secondary mb-1">İlgili Ürün Grubu / Modül:</label>
                            <input type="text" name="urunGrubu" class="form-control" placeholder="Örn: Sunmi POS Cihazları veya Bulut ERP Ek Modül" />
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-bold text-secondary mb-1">Geçerlilik Süresi (Gün):</label>
                            <input type="number" name="gecerlilikGun" class="form-control" value="30" min="1" max="365" required />
                            <small class="text-secondary" style="font-size: 0.74rem;">Otomatik olarak bugünden itibaren hesaplanacaktır.</small>
                        </div>

                        <!-- İskonto & Özel Fiyat -->
                        <div class="col-md-6">
                            <label class="small fw-bold text-secondary mb-1">Ek İskonto Oranı (%):</label>
                            <div class="input-group">
                                <span class="input-group-text">%</span>
                                <input type="number" step="0.5" name="iskontoOrani" class="form-control" value="15" min="0" max="100" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="small fw-bold text-secondary mb-1">Özel Net Fiyat (TL - Opsiyonel):</label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input type="number" step="0.01" name="ozelFiyatTL" class="form-control" placeholder="Örn: 2450.00" />
                            </div>
                        </div>

                        <!-- Açıklama -->
                        <div class="col-12">
                            <label class="small fw-bold text-secondary mb-1">Kampanya Açıklaması / Şartlar:</label>
                            <textarea name="aciklama" class="form-control" rows="3" placeholder="Örn: Son çeyrek donanım alımlarınız doğrultusunda yönetim kurulumuzca firmanıza tanımlanmış özel avantajdır."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background: #0b57d0; border: none;">
                        <i class="bi bi-send-check me-1"></i> Kampanyayı Tanımla &amp; Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
