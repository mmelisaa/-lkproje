@model WebApplication1.Models.Siniflar.BlogPost
@{
    ViewData["Title"] = "Blog Yazısı Ekle";
}

<div class="container mt-5" style="max-width: 700px;">
    <h3 class="fw-bold mb-4">Yeni Blog Yazısı Ekle</h3>
    <form asp-action="BlogEkle" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Baslik" class="form-label fw-semibold">Başlık</label>
            <input asp-for="Baslik" class="form-control" placeholder="Yazı başlığı" />
            <span asp-validation-for="Baslik" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Ozet" class="form-label fw-semibold">Özet</label>
            <textarea asp-for="Ozet" class="form-control" rows="3" placeholder="Kısa özet"></textarea>
            <span asp-validation-for="Ozet" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Kategori" class="form-label fw-semibold">Kategori</label>
                <input asp-for="Kategori" class="form-control" placeholder="Örn: Teknoloji" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Tarih" class="form-label fw-semibold">Tarih</label>
                <input asp-for="Tarih" class="form-control" placeholder="Örn: 5 Ekim 2026" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="GorselUrl" class="form-label fw-semibold">Görsel URL</label>
            <input asp-for="GorselUrl" class="form-control" placeholder="https://..." />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
            <a asp-action="BlogListesi" class="btn btn-outline-secondary">İptal</a>
        </div>
    </form>
</div>
