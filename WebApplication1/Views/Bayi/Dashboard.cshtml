                <div class="p-3 rounded-3 text-start mb-3" style="background: #f8fafc; border: 1px solid #e2e8f0; font-size: 0.82rem;">
                    <div class="d-flex justify-content-between mb-1 pb-1 border-bottom">
                        <span class="text-secondary">İşlem / Dekont No:</span>
                        <strong class="font-monospace text-dark" id="successIslemNo">OD-2026-0000</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1 border-bottom">
                        <span class="text-secondary">Banka Provizyon (Auth Code):</span>
                        <strong class="font-monospace text-success" id="successAuthCode">PRV-000000</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1 border-bottom">
                        <span class="text-secondary">RRN Referans No:</span>
                        <span class="font-monospace text-dark" id="successRrn">202610210000</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1 pb-1 border-bottom">
                        <span class="text-secondary">Tahsil Edilen Tutar:</span>
