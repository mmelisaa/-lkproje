    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Portal JavaScript Motoru -->
    <script>
        // Destek Talepleri Filtreleme & Arama Fonksiyonları
        function filterDestekTalepleri(filterType, btn) {
            document.querySelectorAll('.destek-filter-btn').forEach(b => {
                b.classList.remove('active', 'btn-primary');
                b.classList.add('btn-light', 'text-secondary');
            });
            if (btn) {
                btn.classList.remove('btn-light', 'text-secondary');
                btn.classList.add('active', 'btn-primary');
            }
            
            const rows = document.querySelectorAll('#destekTalepleriTable tbody tr');
            rows.forEach(r => {
                const durum = r.getAttribute('data-durum');
                if (filterType === 'all') {
                    r.style.display = '';
                } else if (filterType === 'acik') {
                    r.style.display = (durum !== 'Çözüldü') ? '' : 'none';
                } else if (filterType === 'cozuldu') {
                    r.style.display = (durum === 'Çözüldü') ? '' : 'none';
                }
            });
        }

        function searchDestekTalepleri(term) {
            const q = term.toLowerCase().trim();
            const rows = document.querySelectorAll('#destekTalepleriTable tbody tr');
            rows.forEach(r => {
                const text = r.innerText.toLowerCase();
                r.style.display = text.includes(q) ? '' : 'none';
            });
        }

        function openTicketDetailModal(ticketNo, baslik, modul, durum, oncelik, tarih, mesaj, cevap, dosya) {
            document.getElementById('modalTicketDetayNo').innerText = ticketNo;
            document.getElementById('modalTicketDetayBaslik').innerText = baslik;
            document.getElementById('modalTicketDetayModul').innerText = modul;
            document.getElementById('modalTicketDetayTarih').innerText = tarih;
            document.getElementById('modalTicketDetayMesaj').innerText = mesaj;
            
            const durumEl = document.getElementById('modalTicketDetayDurum');
            if (durum === 'Çözüldü') {
                durumEl.className = 'badge bg-success rounded-pill px-3 py-1';
                durumEl.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Çözüldü';
            } else {
                durumEl.className = 'badge bg-warning text-dark rounded-pill px-3 py-1';
                durumEl.innerHTML = '<i class="bi bi-clock-history me-1"></i>İnceleniyor';
            }

            const oncelikEl = document.getElementById('modalTicketDetayOncelik');
            oncelikEl.innerText = oncelik;

            const fileBox = document.getElementById('modalTicketDetayDosyaBox');
            if (dosya && dosya.trim().length > 0) {
                document.getElementById('modalTicketDetayDosyaAdi').innerText = dosya;
                const fileLink = document.getElementById('modalTicketDetayDosyaLink');
                if (fileLink) {
                    fileLink.href = '/Bayi/SurucuIndir?dosyaAdi=' + encodeURIComponent(dosya.trim());
                }
                fileBox.style.display = 'block';
            } else {
                fileBox.style.display = 'none';
            }

            const cevapBox = document.getElementById('modalTicketDetayCevapBox');
            const cevapText = document.getElementById('modalTicketDetayCevap');
            if (cevap && cevap.trim().length > 0) {
                cevapText.innerText = cevap;
                cevapBox.style.display = 'flex';
            } else {
                cevapBox.style.display = 'none';
            }

            const waBtn = document.getElementById('btnTicketWhatsAppContact');
            if (waBtn) {
                const waMsg = `Merhaba Hayat İşleri Destek Masası, yetkili bayiniz olarak ${ticketNo} nolu destek talebimiz ("${baslik}") hakkında bilgi almak istiyoruz.`;
                waBtn.href = `https://wa.me/905010146623?text=${encodeURIComponent(waMsg)}`;
            }

            const ekMesajInput = document.getElementById('modalTicketEkMesaj');
            if (ekMesajInput) ekMesajInput.value = '';

            const modal = new bootstrap.Modal(document.getElementById('modalTicketDetay'));
            modal.show();
        }

        function ticketEkMesajGonder() {
            const el = document.getElementById('modalTicketEkMesaj');
            const msg = el ? el.value.trim() : '';
            if (!msg) {
                alert('Lütfen destek yetkilisine iletmek istediğiniz ek mesajı yazınız.');
                return;
            }
            alert('Ek mesajınız Hayat İşleri Destek Ekibimize ve yetkili e-posta sistemimize başarıyla iletilmiştir.');
            if (el) el.value = '';
        }

        // Sekme Değiştirici
        function switchBayiTab(tabId, el) {
            document.querySelectorAll('.tab-pane-content').forEach(pane => {
                pane.style.display = 'none';
            });
            const target = document.getElementById('tab-' + tabId);
            if (target) target.style.display = 'block';

            document.querySelectorAll('.b2b-nav-link').forEach(link => {
                link.classList.remove('active');
            });
            if (el) el.classList.add('active');
            else {
                const link = document.querySelector(`.b2b-nav-link[href="#${tabId}"]`);
                if (link) link.classList.add('active');
            }

            // URL Hash Güncelle
            window.location.hash = tabId;

            // Mobilde menüyü kapat
            const sidebar = document.getElementById('b2bSidebar');
            if (sidebar && window.innerWidth < 992) {
                sidebar.classList.remove('show');
            }
        }

        // Açılışta Hash Kontrolü
        (function initTabFromHash() {
            const hash = window.location.hash.replace('#', '');
            if (hash && document.getElementById('tab-' + hash)) {
                switchBayiTab(hash);
            } else {
                switchBayiTab('@aktifTab');
            }
        })();

        // Mobil Sidebar Toggle
        function toggleBayiSidebar() {
            const sidebar = document.getElementById('b2bSidebar');
            if (sidebar) sidebar.classList.toggle('show');
        }

        // Hızlı RMA Modalı Açma (Envanter satırından)
        function hizliRmaModaliAc(sn, model) {
            document.getElementById('rmaModalSn').value = sn;
            document.getElementById('rmaModalModel').value = model;
            const modalEl = new bootstrap.Modal(document.getElementById('modalYeniRma'));
            modalEl.show();
        }

        // Toast Gösterici
        function toastGoster(mesaj) {
            const toast = document.createElement('div');
            toast.className = 'position-fixed bottom-0 end-0 p-3';
            toast.style.zIndex = '9999';
            toast.innerHTML = `
                <div class="toast align-items-center text-white bg-dark border-0 show shadow-lg rounded-4" role="alert">
                    <div class="d-flex">
                        <div class="toast-body small fw-semibold">
                            <i class="bi bi-info-circle-fill text-info me-2"></i> ${mesaj}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        // CSV İndirme Simülasyonu
        function exportTableToCsv(tableId, filename) {
            const table = document.getElementById(tableId);
            if (!table) return;
            let csv = [];
            for (let row of table.rows) {
                let cols = [];
                for (let cell of row.cells) {
                    cols.push('"' + cell.innerText.replace(/"/g, '""').replace(/\n/g, ' ') + '"');
                }
                csv.push(cols.join(','));
            }
            const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = filename;
            link.click();
            toastGoster('Veriler CSV dosyası olarak dışa aktarıldı.');
        }

        // Tema Değiştirici
        function toggleBayiTheme() {
            const html = document.documentElement;
            const current = html.getAttribute('data-theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('hayat_theme', next);
            updateBayiThemeIcon(next);
        }

        function updateBayiThemeIcon(theme) {
            const icon = document.getElementById('bayiThemeIcon');
            if (icon) {
                icon.className = theme === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars';
            }
        }

        (function initTheme() {
            const saved = localStorage.getItem('hayat_theme') || 'light';
            document.documentElement.setAttribute('data-theme', saved);
            updateBayiThemeIcon(saved);
        })();

        // =========================================================================
        // BAYİ ÖZEL KAMPANYA TALEBİ & WHATSAPP İLETİŞİM MOTORU
        // =========================================================================
        function kampanyaBasvurModalAc(btn) {
            const id = btn.getAttribute('data-id') || '';
            const baslik = btn.getAttribute('data-baslik') || 'Kampanya';
            const kategori = btn.getAttribute('data-kategori') || '';
            const iskonto = parseFloat(btn.getAttribute('data-iskonto')) || 0;
            const ozelFiyat = parseFloat(btn.getAttribute('data-ozelfiyat')) || 0;

            document.getElementById('kampanyaModalId').value = id;
            document.getElementById('kampanyaModalBaslikVal').value = baslik;
            document.getElementById('kampanyaModalKategoriVal').value = kategori;
            document.getElementById('kampanyaModalIskontoVal').value = iskonto;
            document.getElementById('kampanyaModalOzelFiyatVal').value = ozelFiyat;
            document.getElementById('kampanyaModalNot').value = '';

            document.getElementById('kampanyaModalBaslik').innerText = baslik;
            document.getElementById('kampanyaModalKategoriBadge').innerText = (kategori ? kategori + ' Kampanyası' : 'Bayi Özel');

            let avantajMetni = '';
            if (iskonto > 0) avantajMetni += '+%' + iskonto + ' Ek İskonto';
            if (ozelFiyat > 0) {
                if (avantajMetni) avantajMetni += ' • ';
                avantajMetni += 'Özel Fiyat: ' + ozelFiyat.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
            }
            document.getElementById('kampanyaModalAvantajBadge').innerText = avantajMetni || 'Özel Fiyat Avantajı';

            let fiyatBilgi = '';
            if (ozelFiyat > 0) {
                fiyatBilgi = 'Özel net bayi alış fiyatı geçerlidir.';
            } else if (iskonto > 0) {
                fiyatBilgi = 'Mevcut bayi iskontonuza ek olarak tanımlanacaktır.';
            }
            document.getElementById('kampanyaModalFiyatBilgisi').innerText = fiyatBilgi;

            const firmaAdi = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Kullanici?.FirmaAdi ?? Model.Kullanici?.AdSoyad ?? "Bayi"))';
            const cariKod = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Model.Kullanici?.CariKodu ?? ""))';
            const waMetin = `Merhaba, ${firmaAdi} (${cariKod}) olarak '${baslik}' kampanyasından yararlanmak istiyoruz. Sipariş ve onay detayları hakkında bilgi alabilir miyiz?`;
            const waUrl = 'https://wa.me/905010146623?text=' + encodeURIComponent(waMetin);

            document.getElementById('btnKampanyaModalWhatsApp').href = waUrl;
            document.getElementById('btnKampanyaModalSuccessWhatsApp').href = waUrl;

            document.getElementById('kampanyaModalFormView').style.display = 'block';
            document.getElementById('kampanyaModalSuccessView').style.display = 'none';
            const btnSubmit = document.getElementById('btnKampanyaTalebiGonder');
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = '<i class="bi bi-send-fill me-1"></i> Kampanyadan Yararlan (Admin & E-Posta)';

            const modal = new bootstrap.Modal(document.getElementById('modalKampanyaTalep'));
            modal.show();
        }

        async function kampanyaTalebiGonder() {
            const btn = document.getElementById('btnKampanyaTalebiGonder');
            const id = document.getElementById('kampanyaModalId').value;
            const baslik = document.getElementById('kampanyaModalBaslikVal').value;
            const kategori = document.getElementById('kampanyaModalKategoriVal').value;
            const iskonto = document.getElementById('kampanyaModalIskontoVal').value;
            const ozelFiyat = document.getElementById('kampanyaModalOzelFiyatVal').value;
            const not = document.getElementById('kampanyaModalNot').value;

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Merkeze İletiliyor...';

            try {
                const formData = new FormData();
                formData.append('kampanyaId', id);
                formData.append('kampanyaBaslik', baslik);
                formData.append('kategori', kategori);
                formData.append('iskontoOrani', iskonto);
                formData.append('ozelFiyatTL', ozelFiyat);
                formData.append('talepNotu', not);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }

                const response = await fetch('/Bayi/KampanyaYararlan', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();
                if (result.success) {
                    if (result.whatsappUrl) {
                        document.getElementById('btnKampanyaModalSuccessWhatsApp').href = result.whatsappUrl;
                    }
                    document.getElementById('kampanyaModalFormView').style.display = 'none';
                    document.getElementById('kampanyaModalSuccessView').style.display = 'block';

                    const cardBtnBox = document.getElementById('kampanya-btn-box-' + id);
                    if (cardBtnBox) {
                        const waHref = result.whatsappUrl || document.getElementById('btnKampanyaModalSuccessWhatsApp').href;
                        cardBtnBox.innerHTML = `
                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background: rgba(40, 167, 69, 0.12); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.25);">
                                    <i class="bi bi-check-circle-fill me-1"></i> Talep İletildi
                                </span>
                                <a href="${waHref}" target="_blank" class="btn btn-sm rounded-pill px-3 py-1.5 fw-semibold text-white d-inline-flex align-items-center gap-1 shadow-xs" style="background: #25D366; border: none;">
                                    <i class="bi bi-whatsapp"></i> İletişime Geçin
                                </a>
                            </div>
                        `;
                    }
                } else {
                    alert(result.message || 'Talebiniz iletilirken bir hata oluştu.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Kampanyadan Yararlan (Admin & E-Posta)';
                }
            } catch (err) {
                console.error(err);
                alert('İşlem sırasında sunucu bağlantı hatası oluştu. Lütfen tekrar deneyin.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Kampanyadan Yararlan (Admin & E-Posta)';
            }
        }

        // =========================================================================
        // B2B MINI SEPET VE TOPLU SİPARİŞ YÖNETİMİ
        // =========================================================================
        let b2bCart = [];

        try {
            const saved = localStorage.getItem('hayat_b2b_cart');
            if (saved) b2bCart = JSON.parse(saved);
        } catch (e) { b2bCart = []; }

        function b2bSaveCart() {
            try {
                localStorage.setItem('hayat_b2b_cart', JSON.stringify(b2bCart));
            } catch (e) {}
            b2bRenderCart();
        }

        function b2bSepeteEkle(id, baslik, kategori, fiyat) {
            const existing = b2bCart.find(x => x.id === id);
            if (existing) {
                existing.adet += 1;
            } else {
                b2bCart.push({
                    id: id,
                    baslik: baslik,
                    kategori: kategori || 'Ürün',
                    fiyat: parseFloat(fiyat) || 0,
                    adet: 1
                });
            }
            b2bSaveCart();
            toastGoster('Sepete eklendi: ' + baslik);

            // Mini sepet drawer'ını aç
            const offcanvasEl = document.getElementById('offcanvasB2BCart');
            if (offcanvasEl) {
                const bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
                bsOffcanvas.show();
            }
        }

        function b2bAdetDegistir(id, delta) {
            const item = b2bCart.find(x => x.id === id);
            if (!item) return;
            item.adet += delta;
            if (item.adet <= 0) {
                b2bCart = b2bCart.filter(x => x.id !== id);
            }
            b2bSaveCart();
        }

        function b2bUrunSil(id) {
            b2bCart = b2bCart.filter(x => x.id !== id);
            b2bSaveCart();
        }

        function b2bSepetiTemizle() {
            if (confirm('Sepetinizdeki tüm ürünleri silmek istediğinizden emin misiniz?')) {
                b2bCart = [];
                b2bSaveCart();
            }
        }

        function b2bRenderCart() {
            const listEl = document.getElementById('b2bCartItemsList');
            const emptyEl = document.getElementById('b2bCartEmptyState');
            const footerEl = document.getElementById('b2bCartFooter');
            const badgeEl = document.getElementById('b2bCartBadgeCount');
            const floatCountEl = document.getElementById('b2bFloatingCartCount');
            const totalEl = document.getElementById('b2bCartTotalAmount');

            const totalKalem = b2bCart.reduce((acc, x) => acc + x.adet, 0);
            const genelToplam = b2bCart.reduce((acc, x) => acc + (x.adet * x.fiyat), 0);

            if (badgeEl) badgeEl.innerText = totalKalem + ' Kalem';
            if (floatCountEl) floatCountEl.innerText = totalKalem;

            const floatBtn = document.getElementById('b2bFloatingCartBtn');
            if (floatBtn) {
                floatBtn.style.display = totalKalem > 0 ? 'inline-flex' : 'none';
            }

            if (!listEl) return;

            if (b2bCart.length === 0) {
                listEl.innerHTML = '';
                if (emptyEl) emptyEl.style.display = 'block';
                if (footerEl) footerEl.style.display = 'none';
                return;
            }

            if (emptyEl) emptyEl.style.display = 'none';
            if (footerEl) footerEl.style.display = 'block';
            if (totalEl) totalEl.innerText = genelToplam.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL';

            let html = '';
            b2bCart.forEach(item => {
                const itemTotal = item.adet * item.fiyat;
                html += `
                    <div class="b2b-cart-item-row d-flex align-items-center justify-content-between gap-2">
                        <div class="flex-grow-1" style="min-width: 0;">
                            <div class="small text-secondary text-truncate" style="font-size: 0.72rem;">${item.kategori}</div>
                            <div class="fw-bold small text-truncate" style="color: var(--b2b-text-main); font-size: 0.85rem;">${item.baslik}</div>
                            <div class="small text-primary fw-semibold">${item.fiyat.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL</div>
                        </div>
                        <div class="d-flex align-items-center gap-1.5 flex-shrink-0">
                            <button type="button" class="b2b-cart-stepper-btn" onclick="b2bAdetDegistir('${item.id}', -1)">&minus;</button>
                            <span class="fw-bold px-1" style="min-width: 18px; text-align: center; font-size: 0.85rem;">${item.adet}</span>
                            <button type="button" class="b2b-cart-stepper-btn" onclick="b2bAdetDegistir('${item.id}', 1)">&plus;</button>
                        </div>
                        <div class="text-end flex-shrink-0" style="min-width: 75px;">
                            <div class="fw-bold small text-primary" style="font-size: 0.85rem;">${itemTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL</div>
                            <button type="button" class="btn btn-link text-danger p-0 border-0" style="font-size: 0.72rem;" onclick="b2bUrunSil('${item.id}')">
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        </div>
                    </div>
                `;
            });
            listEl.innerHTML = html;
        }

        function b2bWhatsAppSiparisVer() {
            if (b2bCart.length === 0) {
                alert('Sepetiniz boş. Lütfen önce ürün ekleyin.');
                return;
            }

            const firmaAdi = '@Html.Raw(Model.Kullanici?.FirmaAdi ?? Model.Kullanici?.AdSoyad ?? "Yetkili Bayi")';
            const cariKodu = '@Html.Raw(Model.Kullanici?.CariKodu ?? "Bayi")';
            const not = document.getElementById('b2bCartNote')?.value?.trim() || '';

            let urunMetinleri = [];
            let genelToplam = 0;

            b2bCart.forEach(item => {
                const itemTotal = item.adet * item.fiyat;
                genelToplam += itemTotal;
                urunMetinleri.push(`• ${item.adet}x ${item.baslik} (${item.fiyat.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL) = ${itemTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL`);
            });

            let msg = `Merhaba, Hayat İşleri Yetkili Bayiniz ${firmaAdi} (${cariKodu}) olarak aşağıdaki sepet siparişlerimizi vermek istiyoruz:\n\n` +
                      `📦 SEPET SİPARİŞ LİSTESİ:\n` +
                      urunMetinleri.join('\n') + `\n\n` +
                      `💰 TOPLAM TUTAR: ${genelToplam.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL\n` +
                      (not ? `📝 Sipariş Notumuz: ${not}\n\n` : '\n') +
                      `Sipariş onayımızı ve sevkiyat detaylarını görüşebilir miyiz?`;

            const url = `https://wa.me/905010146623?text=${encodeURIComponent(msg)}`;
            window.open(url, '_blank');
        }

        async function b2bTopluSiparisGonder() {
            if (b2bCart.length === 0) {
                alert('Sepetiniz boş. Lütfen önce ürün ekleyin.');
                return;
            }

            const btn = document.getElementById('btnB2BCartSubmitAdmin');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> İletiliyor...';
            }

            const not = document.getElementById('b2bCartNote')?.value?.trim() || '';
            const genelToplam = b2bCart.reduce((acc, x) => acc + (x.adet * x.fiyat), 0);

            const payload = {
                urunler: b2bCart.map(x => ({
                    id: x.id,
                    baslik: x.baslik,
                    kategori: x.kategori,
                    adet: x.adet,
                    fiyat: x.fiyat
                })),
                genelToplam: genelToplam,
                siparisNotu: not
            };

            try {
                const response = await fetch('/Bayi/TopluSiparisGonder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (result.success) {
                    alert('Harika! Sepetinizdeki ' + result.kalemSayisi + ' kalem sipariş Hayat İşleri Yönetim Paneline ve yetkili e-posta sistemimize başarıyla iletilmiştir.');
                    b2bCart = [];
                    b2bSaveCart();
                    const offcanvasEl = document.getElementById('offcanvasB2BCart');
                    if (offcanvasEl) {
                        bootstrap.Offcanvas.getInstance(offcanvasEl)?.hide();
                    }
                } else {
                    alert(result.message || 'Sipariş iletilirken bir hata oluştu.');
                }
            } catch (e) {
                console.error(e);
                alert('Sunucu ile iletişim kurulurken bir hata oluştu.');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-send-fill me-1"></i> Merkeze İlet (Admin & E-Posta)';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            b2bRenderCart();
        });

        // =========================================================================
        // 3D SECURE 2.0 SANAL POS MOTORU & İNTERAKTİF KART YÖNETİMİ
        // =========================================================================
        function setPosTutar(val) {
            const input = document.getElementById('posTutar');
            if (input) {
                input.value = parseFloat(val).toFixed(2);
                guncelleTaksitHesabi();
            }
        }

        function updateCardHolderPreview(val) {
            const el = document.getElementById('cardPreviewHolder');
            if (el) {
                el.innerText = val && val.trim().length > 0 ? val.trim().toUpperCase() : 'YETKİLİ BAYİ';
            }
        }

        function updateCardExpiryPreview() {
            const ay = document.getElementById('posAy')?.value || '12';
            const yil = document.getElementById('posYil')?.value || '28';
            const el = document.getElementById('cardPreviewExpiry');
            if (el) {
                el.innerText = (ay.length === 1 ? '0' + ay : ay) + ' / ' + yil;
            }
        }

        function checkLuhn(digits) {
            let sum = 0, alternate = false;
            for (let i = digits.length - 1; i >= 0; i--) {
                let n = parseInt(digits.charAt(i), 10);
                if (alternate) {
                    n *= 2;
                    if (n > 9) n = (n % 10) + 1;
                }
                sum += n;
                alternate = !alternate;
            }
            return (sum % 10 === 0);
        }

        function formatAndValidateCardNo(input) {
            let val = input.value.replace(/\D/g, '');
            if (val.length > 19) val = val.substring(0, 19);

            // 4'erli bloklar halinde boşluk ekleme
            let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
            input.value = formatted;

            // Kart Brand & BIN Tespiti
            let brand = 'MasterCard / Visa';
            let iconHtml = '<i class="bi bi-credit-card"></i>';

            if (val.startsWith('9792')) {
                brand = 'TROY';
                iconHtml = '<span class="badge bg-danger px-2 py-0.5" style="font-size: 0.65rem;">TROY</span>';
            } else if (val.startsWith('4')) {
                brand = 'Visa';
                iconHtml = '<i class="bi bi-credit-card-2-front-fill text-primary fs-5"></i>';
            } else if (/^(5[1-5]|2[2-7])/.test(val)) {
                brand = 'MasterCard';
                iconHtml = '<i class="bi bi-credit-card-fill text-danger fs-5"></i>';
            } else if (val.startsWith('34') || val.startsWith('37')) {
                brand = 'American Express';
                iconHtml = '<i class="bi bi-credit-card-fill text-info fs-5"></i>';
            }

            const brandText = document.getElementById('cardBrandText');
            if (brandText) brandText.innerText = brand;
            const brandIcon = document.getElementById('posCardBrandIcon');
            if (brandIcon) brandIcon.innerHTML = iconHtml;

            // Kart Önizleme Numarasını Güncelle
            const preview = document.getElementById('cardPreviewNumber');
            if (preview) {
                if (val.length === 0) {
                    preview.innerText = '5400 •••• •••• 4242';
                } else {
                    let maskedPreview = formatted;
                    preview.innerText = maskedPreview;
                }
            }

            // Luhn Doğrulama Geri Bildirimi
            const luhnFeedback = document.getElementById('posLuhnFeedback');
            if (luhnFeedback) {
                if (val.length >= 15) {
                    if (checkLuhn(val)) {
                        luhnFeedback.style.display = 'block';
                        luhnFeedback.className = 'small mt-1 text-success fw-semibold';
                        luhnFeedback.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Kart algoritması geçerli (' + brand + ')';
                    } else {
                        luhnFeedback.style.display = 'block';
                        luhnFeedback.className = 'small mt-1 text-danger fw-semibold';
                        luhnFeedback.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Geçersiz kart numarası kontrolü';
                    }
                } else {
                    luhnFeedback.style.display = 'none';
                }
            }
        }

        function guncelleTaksitHesabi() {
            const tutar = parseFloat(document.getElementById('posTutar')?.value) || 0;
            const taksit = parseInt(document.getElementById('posTaksit')?.value, 10) || 1;
            let komisyon = 0;
            switch(taksit) {
                case 1: komisyon = 0.00; break;
                case 2: komisyon = 1.80; break;
                case 3: komisyon = 2.40; break;
                case 6: komisyon = 4.20; break;
                case 9: komisyon = 6.50; break;
                case 12: komisyon = 8.90; break;
            }

            const toplam = tutar * (1 + (komisyon / 100));
            const el = document.getElementById('posToplamCekim');
            if (el) {
                el.innerText = '₺' + toplam.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' TL' + (komisyon > 0 ? ' (+%' + komisyon.toFixed(2) + ')' : ' (Peşin %0)');
            }
        }

        let currentThreeDSSession = null;
        let threeDSTimerInterval = null;

        async function posOdemeBaslat() {
            const tutar = parseFloat(document.getElementById('posTutar')?.value) || 0;
            const kartSahibi = document.getElementById('posKartSahibi')?.value?.trim() || '';
            const kartNo = document.getElementById('posKartNo')?.value?.replace(/\D/g, '') || '';
            const ay = parseInt(document.getElementById('posAy')?.value, 10) || 12;
            const yil = parseInt(document.getElementById('posYil')?.value, 10) || 28;
            const cvv = document.getElementById('posCvv')?.value?.trim() || '';
            const taksit = parseInt(document.getElementById('posTaksit')?.value, 10) || 1;

            if (tutar <= 0) {
                alert('Lütfen geçerli bir ödeme tutarı giriniz.');
                return;
            }
            if (kartSahibi.length < 3) {
                alert('Lütfen kart üzerindeki isim ve soyismi eksiksiz giriniz.');
                return;
            }
            if (kartNo.length < 15 || !checkLuhn(kartNo)) {
                alert('Girdiğiniz kart numarası geçerli değildir. Lütfen kontrol ediniz.');
                return;
            }
            if (cvv.length < 3) {
                alert('Lütfen 3 haneli güvenlik kodunu (CVV) giriniz.');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const btn = document.getElementById('btnPosSubmit');
            const btnText = document.getElementById('btnPosSubmitText');

            if (btn) btn.disabled = true;
            if (btnText) btnText.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Banka 3D Secure Hazırlanıyor...';

            try {
                const response = await fetch('/Bayi/Init3DSecure', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        tutar: tutar,
                        kartSahibi: kartSahibi,
                        kartNo: kartNo,
                        ay: ay,
                        yil: yil,
                        cvv: cvv,
                        taksit: taksit
                    })
                });

                const result = await response.json();
                if (result.success) {
                    currentThreeDSSession = result;
                    document.getElementById('threeDSBankTitle').innerText = (result.bankName || 'Banka') + ' 3D Secure Gateway';
                    document.getElementById('threeDSTutarText').innerText = '₺' + result.toplamTutar.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL' + (result.taksit > 1 ? ' (' + result.taksit + ' Taksit)' : '');
                    document.getElementById('threeDSMaskedCard').innerText = result.maskedCard;
                    document.getElementById('threeDSMaskedPhone').innerText = result.maskedPhone;
                    document.getElementById('threeDSTestOtp').innerText = result.smsOtp;
                    document.getElementById('threeDSOtpInput').value = '';
                    document.getElementById('threeDSErrorBox').style.display = 'none';

                    const modalEl = document.getElementById('modal3DSecureVerification');
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();

                    startThreeDSTimer(180);
                    setTimeout(() => document.getElementById('threeDSOtpInput')?.focus(), 400);
                } else {
                    alert(result.message || 'Ödeme oturumu başlatılamadı. Lütfen bilgilerinizi kontrol ediniz.');
                }
            } catch (err) {
                console.error(err);
                alert('Banka sanal POS gateway bağlantısında bir hata oluştu.');
            } finally {
                if (btn) btn.disabled = false;
                if (btnText) btnText.innerText = '3D Secure ile Güvenli Öde';
            }
        }

        function copyAndFillOtp() {
            if (currentThreeDSSession && currentThreeDSSession.smsOtp) {
                const input = document.getElementById('threeDSOtpInput');
                if (input) {
                    input.value = currentThreeDSSession.smsOtp;
                    input.focus();
                }
            }
        }

        function startThreeDSTimer(seconds) {
            if (threeDSTimerInterval) clearInterval(threeDSTimerInterval);
            let left = seconds;
            const timerEl = document.getElementById('threeDSTimer');

            function updateDisplay() {
                const m = Math.floor(left / 60);
                const s = left % 60;
                if (timerEl) {
                    timerEl.innerText = (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
                }
            }

            updateDisplay();
            threeDSTimerInterval = setInterval(() => {
                left--;
                if (left <= 0) {
                    clearInterval(threeDSTimerInterval);
                    if (timerEl) timerEl.innerText = '00:00';
                    const errBox = document.getElementById('threeDSErrorBox');
                    if (errBox) {
                        errBox.style.display = 'block';
                        errBox.innerText = '3D Secure oturum süresi doldu. Lütfen işlemi iptal edip yeniden başlatınız.';
                    }
                    const btn = document.getElementById('btnThreeDSOnayla');
                    if (btn) btn.disabled = true;
                } else {
                    updateDisplay();
                }
            }, 1000);
        }

        async function threeDSOdemsiniTamamla() {
            if (!currentThreeDSSession) return;
            const otp = document.getElementById('threeDSOtpInput')?.value?.trim() || '';
            const errBox = document.getElementById('threeDSErrorBox');

            if (otp.length < 6) {
                if (errBox) {
                    errBox.style.display = 'block';
                    errBox.innerText = 'Lütfen bankanızdan gelen 6 haneli SMS onay kodunu eksiksiz giriniz.';
                }
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const btn = document.getElementById('btnThreeDSOnayla');
            const btnText = document.getElementById('btnThreeDSText');

            if (btn) btn.disabled = true;
            if (btnText) btnText.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Provizyon Doğrulanıyor...';
            if (errBox) errBox.style.display = 'none';

            try {
                const response = await fetch('/Bayi/Complete3DSecure', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        sessionId: currentThreeDSSession.sessionId,
                        smsKodu: otp,
                        hmacSignature: currentThreeDSSession.hmac
                    })
                });

                const result = await response.json();
                if (result.success) {
                    if (threeDSTimerInterval) clearInterval(threeDSTimerInterval);
                    const vModalEl = document.getElementById('modal3DSecureVerification');
                    bootstrap.Modal.getInstance(vModalEl)?.hide();

                    document.getElementById('successIslemNo').innerText = result.islemNo;
                    document.getElementById('successAuthCode').innerText = result.authCode;
                    document.getElementById('successRrn').innerText = result.rrn;
                    document.getElementById('successTutar').innerText = '₺' + result.tutar.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';
                    document.getElementById('successKalanBakiye').innerText = '₺' + result.kalanBakiye.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) + ' TL';

                    const dekontBtn = document.getElementById('btnDekontPdfIndir');
                    if (dekontBtn) dekontBtn.href = result.dekontUrl;

                    const waBtn = document.getElementById('btnDekontWhatsApp');
                    if (waBtn) {
                        const msg = `*Hayat İşleri B2B 3D Secure Tahsilat Bildirimi*\n\n` +
                                    `Yetkili Bayi: ${currentThreeDSSession.userFirma || 'Bayi'}\n` +
                                    `Tahsilat Tutarı: ₺${result.tutar.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} TL\n` +
                                    `İşlem / Dekont No: ${result.islemNo}\n` +
                                    `Banka Provizyon No: ${result.authCode}\n` +
                                    `RRN Kodu: ${result.rrn}\n` +
                                    `Tarih: ${new Date().toLocaleString('tr-TR')}\n\n` +
                                    `Cari bakiye tahsilatımız 3D Secure ile başarıyla tamamlanmıştır. Resmi dekont sisteme işlenmiştir.`;
                        waBtn.href = `https://wa.me/905010146623?text=${encodeURIComponent(msg)}`;
                    }

                    const sModalEl = document.getElementById('modal3DSecureSuccess');
                    bootstrap.Modal.getOrCreateInstance(sModalEl).show();
                } else {
                    if (errBox) {
                        errBox.style.display = 'block';
                        errBox.innerText = result.message || 'SMS şifresi doğrulanamadı.';
                    }
                }
            } catch (err) {
                console.error(err);
                if (errBox) {
                    errBox.style.display = 'block';
                    errBox.innerText = 'Doğrulama işlemi sırasında sunucu hatası meydana geldi.';
                }
            } finally {
                if (btn) btn.disabled = false;
                if (btnText) btnText.innerText = 'Onayla ve Ödemeyi Tamamla';
            }
        }

        function threeDSIptalEt() {
            if (threeDSTimerInterval) clearInterval(threeDSTimerInterval);
            const vModalEl = document.getElementById('modal3DSecureVerification');
            bootstrap.Modal.getInstance(vModalEl)?.hide();
        }

        // =========================================================================
        // TÜRKÇE & İNGİLİZCE DİL DEĞİŞTİRME MOTORU (TR <-> EN)
        // =========================================================================
        function toggleSiteLanguage() {
            if (window.HayatI18n) {
                window.HayatI18n.toggleLanguage();
            }
        }

        // =========================================================================
        // ALT KULLANICI ŞİFRE YÖNETİMİ YARDIMCILARI
        // =========================================================================
        function toggleSubUserPasswordVisibility() {
            const input = document.getElementById('subUserPasswordInput');
            const icon = document.getElementById('subUserPassEyeIcon');
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        function generateRandomSubUserPassword() {
            const chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!#$";
            let pass = "";
            for (let i = 0; i < 10; i++) {
                pass += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            const input = document.getElementById('subUserPasswordInput');
            if (input) {
                input.type = 'text';
                input.value = pass;
                const icon = document.getElementById('subUserPassEyeIcon');
                if (icon) icon.className = 'bi bi-eye-slash';
            }
        }
    </script>

