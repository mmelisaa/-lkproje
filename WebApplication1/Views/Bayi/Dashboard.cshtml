                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var md in Model.MdfTalepleri)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@md.EtkinlikAdi</td>
                                                <td>@md.TalepTutariTL.ToString("N0") TL</td>
                                                <td class="fw-bold text-success">@md.OnaylananTutarTL.ToString("N0") TL</td>
                                                <td>@md.BasvuruTarihi.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                        @md.Durum
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ÖZEL İSKONTO SKALASI -->
                    <div class="tab-pane-content" id="tab-ozel-iskonto" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <h5 class="fw-bold mb-0">B2B Özel İskonto Seviyesi: Platinum Partner</h5>
                                <small class="text-secondary">Tüm donanım ve yazılım ürünlerinde anlık tanımlanan otomatik B2B iskonto tablonuz.</small>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3.5 rounded-3 border text-center" style="background: var(--b2b-bg);">
                                        <div class="small text-secondary mb-1">POS &amp; Donanım İskontosu</div>
                                        <h3 class="fw-bold text-primary mb-0">%35</h3>
                                        <small class="text-muted">Zebra, Sunmi, KodPOS</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3.5 rounded-3 border text-center" style="background: var(--b2b-bg);">
