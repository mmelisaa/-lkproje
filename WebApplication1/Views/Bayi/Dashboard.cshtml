                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary">Kalan Cari Borç Bakiyesi:</span>
                        <strong class="text-danger" id="successKalanBakiye">₺0,00 TL</strong>
                    </div>
