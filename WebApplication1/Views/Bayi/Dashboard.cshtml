                    <!-- MDF PAZARLAMA FONU -->
                    <div class="tab-pane-content" id="tab-mdf-fonu" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <h5 class="fw-bold mb-0">Ortak Pazarlama Fonu (MDF) Başvuru Alanı</h5>
                                    <small class="text-secondary">Şehrinizdeki bölgesel fuarlar, billboard veya yerel dijital reklamlar için Hayat İşleri'nden bütçe desteği alın.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3.5 py-1.5 fw-bold" data-bs-toggle="modal" data-bs-target="#modalMdfTalep">
                                    <i class="bi bi-megaphone me-1"></i> MDF Talebi Gönder
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
