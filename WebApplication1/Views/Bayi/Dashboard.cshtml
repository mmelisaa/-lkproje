                    <div class="d-grid gap-2">
                        <button type="button" id="btnB2BCartSubmitAdmin" class="btn btn-primary rounded-pill py-2.5 fw-bold shadow-sm" style="background: #0b57d0; border: none;" onclick="b2bTopluSiparisGonder()">
                            <i class="bi bi-send-fill me-1"></i> Merkeze İlet (Admin &amp; E-Posta)
                        </button>
                        <button type="button" class="btn rounded-pill py-2.5 fw-bold text-white shadow-xs d-flex align-items-center justify-content-center gap-2" style="background: #25D366; border: none;" onclick="b2bWhatsAppSiparisVer()">
