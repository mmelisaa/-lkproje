@model WebApplication1.Models.BayiDashboardViewModel
@{
    Layout = null; // Bağımsız tam ekran modern Google One & Apple Bento Bayi Portalı
    var u = Model.Kullanici;
    var pTipi = Model.PortalTipi;
    var aktifTab = (ViewBag.AktifTab as string) ?? "genel-bakis";
    var iskonto = u.IskontoOrani > 0 ? u.IskontoOrani : (pTipi == 3 ? 40m : 30m);
}

<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@u.FirmaAdi - Hayat İşleri B2B Partner Portalı</title>
    <link rel="icon" type="image/svg+xml" href="~/images/hayat-isleri-logo.svg" />

    <!-- Google Fonts & Bootstrap 5 & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Google+Sans+Text:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --b2b-bg: #f8fafc;
            --b2b-sidebar-bg: #ffffff;
            --b2b-sidebar-border: rgba(15, 23, 42, 0.08);
            --b2b-card-bg: #ffffff;
            --b2b-card-border: rgba(15, 23, 42, 0.08);
            --b2b-text-main: #0f172a;
            --b2b-text-sub: #64748b;
            --b2b-accent: #0b57d0;
            --b2b-accent-subtle: rgba(11, 87, 208, 0.08);
            --b2b-radius-lg: 20px;
            --b2b-radius-md: 14px;
            --b2b-radius-sm: 10px;
            --b2b-shadow: 0 4px 20px rgba(11, 87, 208, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
            --b2b-shadow-hover: 0 12px 32px rgba(11, 87, 208, 0.12), 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        html[data-theme="dark"] {
            --b2b-bg: #090d16;
            --b2b-sidebar-bg: #0f1422;
            --b2b-sidebar-border: rgba(255, 255, 255, 0.08);
            --b2b-card-bg: #141a2b;
            --b2b-card-border: rgba(255, 255, 255, 0.08);
            --b2b-text-main: #f1f5f9;
            --b2b-text-sub: #94a3b8;
            --b2b-accent: #38bdf8;
            --b2b-accent-subtle: rgba(56, 189, 248, 0.12);
            --b2b-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
            --b2b-shadow-hover: 0 14px 40px rgba(56, 189, 248, 0.2);
        }

        body {
            font-family: 'Google Sans Text', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--b2b-bg);
            color: var(--b2b-text-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* 4-Color Google One Header Ribbon */
        .g1-rainbow-line {
            height: 3.5px;
            width: 100%;
            background: linear-gradient(90deg, #4285F4 0%, #4285F4 25%, #EA4335 25%, #EA4335 50%, #FBBC05 50%, #FBBC05 75%, #34A853 75%, #34A853 100%);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1060;
        }

        /* Ana Portal Çerçevesi */
        .b2b-layout-wrapper {
            display: flex;
            min-height: 100vh;
            padding-top: 3.5px;
        }

        /* Sol Sabit Modern Menü (Sidebar) */
        .b2b-sidebar {
            width: 295px;
            min-width: 295px;
            max-width: 295px;
            background: var(--b2b-sidebar-bg);
            border-right: 1px solid var(--b2b-sidebar-border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 3.5px;
            bottom: 0;
            left: 0;
            z-index: 1040;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(0, 0, 0, 0.12) transparent;
            transition: transform 0.25s ease;
        }

        .b2b-sidebar-header {
            padding: 1.25rem 1.25rem 1rem;
            border-bottom: 1px solid var(--b2b-sidebar-border);
        }

        .b2b-portal-brand-badge {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            padding: 0.25rem 0.65rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            text-transform: uppercase;
        }

        .b2b-sidebar-nav {
            padding: 0.85rem 0.75rem 3rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .b2b-nav-category-title {
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--b2b-text-sub);
            padding: 0.75rem 0.65rem 0.3rem;
            margin-top: 0.4rem;
        }

        .b2b-nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.55rem 0.85rem;
            border-radius: var(--b2b-radius-sm);
            color: var(--b2b-text-main);
            text-decoration: none;
            font-size: 0.84rem;
            font-weight: 600;
            transition: all 0.2s ease;
            cursor: pointer;
            border: 1px solid transparent;
        }

        .b2b-nav-link-content {
            display: flex;
            align-items: center;
            gap: 0.65rem;
        }

        .b2b-nav-link-icon {
            font-size: 1rem;
            width: 22px;
            text-align: center;
            color: var(--b2b-accent);
            transition: transform 0.2s ease;
        }

        .b2b-nav-link:hover {
            background: var(--b2b-accent-subtle);
            color: var(--b2b-accent);
            transform: translateX(3px);
        }

        .b2b-nav-link.active {
            background: var(--b2b-accent);
            color: #ffffff !important;
            box-shadow: 0 4px 14px rgba(11, 87, 208, 0.3);
        }

        .b2b-nav-link.active .b2b-nav-link-icon {
            color: #ffffff !important;
        }

        .b2b-nav-link.active .b2b-nav-badge {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        .b2b-nav-badge {
            font-size: 0.68rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            background: rgba(15, 23, 42, 0.08);
            color: var(--b2b-text-sub);
        }

        /* Sağ Ana Panel */
        .b2b-main-panel {
            margin-left: 295px;
            flex-grow: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Üst Çubuk (Navbar) */
        .b2b-topbar {
            height: 64px;
            background: var(--b2b-sidebar-bg);
            border-bottom: 1px solid var(--b2b-sidebar-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.75rem;
            position: sticky;
            top: 3.5px;
            z-index: 1030;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Kartlar & Tablolar */
        .b2b-card {
            background: var(--b2b-card-bg);
            border: 1px solid var(--b2b-card-border);
            border-radius: var(--b2b-radius-lg);
            box-shadow: var(--b2b-shadow);
            transition: all 0.25s ease;
        }

        .b2b-card:hover {
            box-shadow: var(--b2b-shadow-hover);
            border-color: rgba(11, 87, 208, 0.25);
        }

        .b2b-stat-widget {
            padding: 1.25rem 1.4rem;
            border-radius: var(--b2b-radius-md);
            background: var(--b2b-card-bg);
            border: 1px solid var(--b2b-card-border);
            box-shadow: var(--b2b-shadow);
        }

        .table-custom {
            color: var(--b2b-text-main);
        }

        .table-custom th {
            font-size: 0.72rem;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--b2b-text-sub);
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--b2b-card-border);
            padding: 0.75rem 1rem;
        }

        .table-custom td {
            font-size: 0.84rem;
            border-bottom: 1px solid var(--b2b-card-border);
            padding: 0.85rem 1rem;
            vertical-align: middle;
        }

        /* Dil Değiştirici Buton */
        .lang-switch-btn {
            background: var(--b2b-card-bg);
            border: 1px solid var(--b2b-card-border);
            border-radius: 999px;
            padding: 0.35rem 0.85rem;
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--b2b-text-main);
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .lang-switch-btn:hover {
            border-color: var(--b2b-accent);
            color: var(--b2b-accent);
        }

        /* Mobil */
        @@media (max-width: 992px) {
            .b2b-sidebar {
                transform: translateX(-100%);
            }
            .b2b-sidebar.show {
                transform: translateX(0);
            }
            .b2b-main-panel {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Google One 4-Color Gradient Çizgi -->
    <div class="g1-rainbow-line"></div>

    <div class="b2b-layout-wrapper">
        <!-- ========================================================================= -->
        <!-- SOL SABİT PROFESYONEL BAYİ MENÜSÜ (SIDEBAR)                               -->
        <!-- ========================================================================= -->
        <aside class="b2b-sidebar" id="b2bSidebar">
            <!-- Sidebar Başlık & Bayi Firma Bilgisi -->
            <div class="b2b-sidebar-header">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <img src="~/images/hayat-isleri-logo.svg" alt="Hayat İşleri Logo" style="height: 28px; width: 28px;" />
                    <div>
                        <h6 class="fw-bold mb-0 text-dark font-sans" style="font-size: 0.96rem; letter-spacing: -0.3px;">Hayat İşleri B2B</h6>
                        <small class="text-secondary" style="font-size: 0.7rem;">Yetkili Partner Portalı</small>
                    </div>
                </div>

                <!-- Admin Tarafından Atanan Portal Tipi Rozeti -->
                <div class="mt-2.5">
                    @if (pTipi == 1)
                    {
                        <div class="b2b-portal-brand-badge w-100 justify-content-between" style="background: rgba(66, 133, 244, 0.12); color: #1a73e8; border: 1px solid rgba(66, 133, 244, 0.25);">
                            <span><i class="bi bi-hdd-network me-1"></i> Donanım &amp; POS Bayisi</span>
                            <span class="badge bg-primary text-white rounded-pill px-1.5 py-0.5" style="font-size: 0.6rem;">P1</span>
                        </div>
                    }
                    else if (pTipi == 2)
                    {
                        <div class="b2b-portal-brand-badge w-100 justify-content-between" style="background: rgba(52, 168, 83, 0.12); color: #34a853; border: 1px solid rgba(52, 168, 83, 0.25);">
                            <span><i class="bi bi-window-stack me-1"></i> Yazılım &amp; ERP Bayisi</span>
                            <span class="badge bg-success text-white rounded-pill px-1.5 py-0.5" style="font-size: 0.6rem;">P2</span>
                        </div>
                    }
                    else if (pTipi == 3)
                    {
                        <div class="b2b-portal-brand-badge w-100 justify-content-between" style="background: linear-gradient(135deg, rgba(66, 133, 244, 0.12), rgba(234, 67, 53, 0.12)); color: #ea4335; border: 1px solid rgba(234, 67, 53, 0.3);">
                            <span><i class="bi bi-star-fill me-1 text-warning"></i> Tam Yetkili Çözüm Ortağı</span>
                            <span class="badge bg-danger text-white rounded-pill px-1.5 py-0.5" style="font-size: 0.6rem;">P3</span>
                        </div>
                    }
                </div>

                <!-- Bayi Firma Kutucuğu -->
                <div class="p-2.5 rounded-3 mt-2" style="background: var(--b2b-bg); border: 1px solid var(--b2b-sidebar-border);">
                    <div class="fw-bold text-truncate" style="font-size: 0.85rem;" title="@u.FirmaAdi">@u.FirmaAdi</div>
                    <div class="d-flex align-items-center justify-content-between small text-secondary mt-1" style="font-size: 0.72rem;">
                        <span class="font-monospace text-primary fw-bold">@(string.IsNullOrEmpty(u.CariKodu) ? "Cari: HYT-9812" : u.CariKodu)</span>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">İskonto: %@iskonto</span>
                    </div>
                </div>
            </div>

            <!-- Menü Listesi -->
            <nav class="b2b-sidebar-nav">
                <!-- 1. GENEL BAKIŞ -->
                <div class="b2b-nav-category-title">Ana Menü</div>
                <a href="#genel-bakis" class="b2b-nav-link @(aktifTab == "genel-bakis" ? "active" : "")" onclick="switchBayiTab('genel-bakis', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-speedometer2 b2b-nav-link-icon"></i>
                        <span>Genel Bakış (Özet)</span>
                    </div>
                    <span class="b2b-nav-badge">Canlı</span>
                </a>
                <a href="#ozel-kampanyalar" class="b2b-nav-link @(aktifTab == "ozel-kampanyalar" ? "active" : "")" onclick="switchBayiTab('ozel-kampanyalar', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-gift-fill b2b-nav-link-icon text-danger"></i>
                        <span class="fw-bold text-danger">Size Özel Kampanyalar</span>
                    </div>
                    <span class="b2b-nav-badge text-danger fw-bold">@Model.OzelKampanyalar.Count(k => k.GecerliMi) Fırsat</span>
                </a>
                <a href="#fiyat-listesi" class="b2b-nav-link @(aktifTab == "fiyat-listesi" ? "active" : "")" onclick="switchBayiTab('fiyat-listesi', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-table b2b-nav-link-icon"></i>
                        <span>B2B Fiyat Listesi</span>
                    </div>
                    <span class="b2b-nav-badge">İskontolu</span>
                </a>
                <a href="#duyurular" class="b2b-nav-link @(aktifTab == "duyurular" ? "active" : "")" onclick="switchBayiTab('duyurular', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-megaphone-fill b2b-nav-link-icon text-warning"></i>
                        <span>Duyurular &amp; Bildirimler</span>
                    </div>
                    <span class="b2b-nav-badge">@Model.Duyurular.Count</span>
                </a>

                <!-- ========================================================= -->
                <!-- 2. DONANIM VE POS BAYİSİ MENÜLERİ (Portal 1 ve Portal 3)  -->
                <!-- ========================================================= -->
                @if (pTipi is 1 or 3)
                {
                    <div class="b2b-nav-category-title">Donanım &amp; POS Operasyonu</div>
                    <a href="#envanter" class="b2b-nav-link @(aktifTab == "envanter" ? "active" : "")" onclick="switchBayiTab('envanter', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-upc-scan b2b-nav-link-icon"></i>
                            <span>Seri No Cihaz Envanteri</span>
                        </div>
                        <span class="b2b-nav-badge">@Model.EnvanterListesi.Count</span>
                    </a>
                    <a href="#rma" class="b2b-nav-link @(aktifTab == "rma" ? "active" : "")" onclick="switchBayiTab('rma', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-tools b2b-nav-link-icon"></i>
                            <span>RMA (Teknik Servis)</span>
                        </div>
                        <span class="b2b-nav-badge">@Model.RmaKayitlari.Count</span>
                    </a>
                    <a href="#sarf-siparis" class="b2b-nav-link @(aktifTab == "sarf-siparis" ? "active" : "")" onclick="switchBayiTab('sarf-siparis', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-cart3 b2b-nav-link-icon"></i>
                            <span>Sarf Malzeme Siparişi</span>
                        </div>
                        <span class="b2b-nav-badge">Hızlı</span>
                    </a>
                    <a href="#drivers" class="b2b-nav-link @(aktifTab == "drivers" ? "active" : "")" onclick="switchBayiTab('drivers', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-download b2b-nav-link-icon"></i>
                            <span>Driver &amp; Sürücü İndir</span>
                        </div>
                        <span class="b2b-nav-badge">SDK</span>
                    </a>
                    <a href="#proje-kaydi" class="b2b-nav-link @(aktifTab == "proje-kaydi" ? "active" : "")" onclick="switchBayiTab('proje-kaydi', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-briefcase b2b-nav-link-icon"></i>
                            <span>Fırsat / Proje Kaydı</span>
                        </div>
                        <span class="b2b-nav-badge">Fiyat Koruması</span>
                    </a>
                    <a href="#demo-talebi" class="b2b-nav-link @(aktifTab == "demo-talebi" ? "active" : "")" onclick="switchBayiTab('demo-talebi', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-box-seam b2b-nav-link-icon"></i>
                            <span>Demo Cihaz Talebi</span>
                        </div>
                        <span class="b2b-nav-badge">15 Gün</span>
                    </a>
                    <a href="#pazarlama" class="b2b-nav-link @(aktifTab == "pazarlama" ? "active" : "")" onclick="switchBayiTab('pazarlama', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-images b2b-nav-link-icon"></i>
                            <span>Pazarlama Materyalleri</span>
                        </div>
                        <span class="b2b-nav-badge">Katalog</span>
                    </a>
                    <a href="#eski-cihaz-degisim" class="b2b-nav-link @(aktifTab == "eski-cihaz-degisim" ? "active" : "")" onclick="switchBayiTab('eski-cihaz-degisim', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-arrow-repeat b2b-nav-link-icon"></i>
                            <span>Eski Cihaz Takas (Refresh)</span>
                        </div>
                        <span class="b2b-nav-badge text-success">İskonto</span>
                    </a>
                }

                <!-- ========================================================= -->
                <!-- 3. YAZILIM VE ERP BAYİSİ MENÜLERİ (Portal 2 ve Portal 3)  -->
                <!-- ========================================================= -->
                @if (pTipi is 2 or 3)
                {
                    <div class="b2b-nav-category-title">Yazılım, ERP &amp; Lisans</div>
                    <a href="#lisanslar" class="b2b-nav-link @(aktifTab == "lisanslar" ? "active" : "")" onclick="switchBayiTab('lisanslar', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-key-fill b2b-nav-link-icon"></i>
                            <span>Lisans &amp; Abonelikler</span>
                        </div>
                        <span class="b2b-nav-badge">@Model.Lisanslar.Count Aktif</span>
                    </a>
                    <a href="#surum-notlari" class="b2b-nav-link @(aktifTab == "surum-notlari" ? "active" : "")" onclick="switchBayiTab('surum-notlari', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-journal-code b2b-nav-link-icon"></i>
                            <span>Sürüm Notları (Release)</span>
                        </div>
                        <span class="b2b-nav-badge">v2.6.2</span>
                    </a>
                    <a href="#destek-ticket" class="b2b-nav-link @(aktifTab == "destek-ticket" ? "active" : "")" onclick="switchBayiTab('destek-ticket', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-chat-left-dots b2b-nav-link-icon"></i>
                            <span>Yazılım Destek (Ticket)</span>
                        </div>
                        <span class="b2b-nav-badge">@Model.DestekTicketlari.Count</span>
                    </a>
                    <a href="#bulut-yedek" class="b2b-nav-link @(aktifTab == "bulut-yedek" ? "active" : "")" onclick="switchBayiTab('bulut-yedek', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-cloud-check b2b-nav-link-icon"></i>
                            <span>Bulut &amp; Yedekleme</span>
                        </div>
                        <span class="b2b-nav-badge text-success">@Model.BulutUptime</span>
                    </a>
                    <a href="#alt-musteriler" class="b2b-nav-link @(aktifTab == "alt-musteriler" ? "active" : "")" onclick="switchBayiTab('alt-musteriler', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-people-fill b2b-nav-link-icon"></i>
                            <span>Alt Müşteri Yönetimi</span>
                        </div>
                        <span class="b2b-nav-badge">@Model.AltMusteriler.Count</span>
                    </a>
                    <a href="#akademi" class="b2b-nav-link @(aktifTab == "akademi" ? "active" : "")" onclick="switchBayiTab('akademi', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-mortarboard-fill b2b-nav-link-icon"></i>
                            <span>Hayat İşleri Akademi</span>
                        </div>
                        <span class="b2b-nav-badge">Sertifika</span>
                    </a>
                    <a href="#upsell" class="b2b-nav-link @(aktifTab == "upsell" ? "active" : "")" onclick="switchBayiTab('upsell', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-lightning-charge-fill b2b-nav-link-icon"></i>
                            <span>Modül &amp; Kontör Ekle</span>
                        </div>
                        <span class="b2b-nav-badge">Anında</span>
                    </a>
                    <a href="#api-sandbox" class="b2b-nav-link @(aktifTab == "api-sandbox" ? "active" : "")" onclick="switchBayiTab('api-sandbox', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-code-slash b2b-nav-link-icon"></i>
                            <span>Geliştirici &amp; API Sandbox</span>
                        </div>
                        <span class="b2b-nav-badge">REST</span>
                    </a>
                }

                <!-- ========================================================= -->
                <!-- 4. TAM YETKİLİ ÇÖZÜM ORTAĞI ÖZEL MODÜLLERİ (Sadece Portal 3)-->
                <!-- ========================================================= -->
                @if (pTipi == 3)
                {
                    <div class="b2b-nav-category-title">Çözüm Ortağı Özel Strateji</div>
                    <a href="#eslestirme" class="b2b-nav-link @(aktifTab == "eslestirme" ? "active" : "")" onclick="switchBayiTab('eslestirme', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-link-45deg b2b-nav-link-icon"></i>
                            <span>Cihaz - Yazılım Eşleştirme</span>
                        </div>
                        <span class="b2b-nav-badge">Sinerji</span>
                    </a>
                    <a href="#ciro-hedef" class="b2b-nav-link @(aktifTab == "ciro-hedef" ? "active" : "")" onclick="switchBayiTab('ciro-hedef', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-trophy-fill b2b-nav-link-icon"></i>
                            <span>Ciro Primi &amp; Hedef Sayacı</span>
                        </div>
                        <span class="b2b-nav-badge text-warning">%85</span>
                    </a>
                    <a href="#capraz-satis" class="b2b-nav-link @(aktifTab == "capraz-satis" ? "active" : "")" onclick="switchBayiTab('capraz-satis', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-diagram-3-fill b2b-nav-link-icon"></i>
                            <span>Çapraz Satış Önerileri</span>
                        </div>
                        <span class="b2b-nav-badge">AI Analiz</span>
                    </a>
                    <a href="#mdf-fonu" class="b2b-nav-link @(aktifTab == "mdf-fonu" ? "active" : "")" onclick="switchBayiTab('mdf-fonu', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-megaphone-fill b2b-nav-link-icon"></i>
                            <span>MDF Pazarlama Fonu</span>
                        </div>
                        <span class="b2b-nav-badge">Destek</span>
                    </a>
                    <a href="#ozel-iskonto" class="b2b-nav-link @(aktifTab == "ozel-iskonto" ? "active" : "")" onclick="switchBayiTab('ozel-iskonto', this)">
                        <div class="b2b-nav-link-content">
                            <i class="bi bi-percent b2b-nav-link-icon"></i>
                            <span>B2B Özel İskonto Skalası</span>
                        </div>
                        <span class="b2b-nav-badge">Platinum</span>
                    </a>
                }

                <!-- ========================================================= -->
                <!-- 5. TÜMÜ İÇİN ORTAK MODÜLLER (B2B Sipariş, Finans & Destek)-->
                <!-- ========================================================= -->
                <div class="b2b-nav-category-title">B2B Sipariş, Finans &amp; Destek</div>
                <a href="#siparis-gecmisi" class="b2b-nav-link @(aktifTab == "siparis-gecmisi" ? "active" : "")" onclick="switchBayiTab('siparis-gecmisi', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-receipt-cutoff b2b-nav-link-icon text-primary"></i>
                        <span>Sipariş Geçmişi &amp; E-Fatura</span>
                    </div>
                    <span class="b2b-nav-badge">@Model.SiparisGecmisi.Count</span>
                </a>
                <a href="#genel-destek" class="b2b-nav-link @(aktifTab == "genel-destek" ? "active" : "")" onclick="switchBayiTab('genel-destek', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-headset b2b-nav-link-icon text-success"></i>
                        <span>Destek Taleplerim (Ticket)</span>
                    </div>
                    <span class="b2b-nav-badge">@Model.DestekTalepleri.Count</span>
                </a>
                <a href="#finans" class="b2b-nav-link @(aktifTab == "finans" ? "active" : "")" onclick="switchBayiTab('finans', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-wallet2 b2b-nav-link-icon"></i>
                        <span>Cari Bakiye &amp; Sanal POS</span>
                    </div>
                    <span class="b2b-nav-badge text-success">3D Secure</span>
                </a>
                <a href="#alt-kullanicilar" class="b2b-nav-link @(aktifTab == "alt-kullanicilar" ? "active" : "")" onclick="switchBayiTab('alt-kullanicilar', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-person-gear b2b-nav-link-icon"></i>
                        <span>Alt Kullanıcılar (Sub-User)</span>
                    </div>
                    <span class="b2b-nav-badge">@Model.AltKullanicilar.Count</span>
                </a>
                <a href="#guvenlik-loglari" class="b2b-nav-link @(aktifTab == "guvenlik-loglari" ? "active" : "")" onclick="switchBayiTab('guvenlik-loglari', this)">
                    <div class="b2b-nav-link-content">
                        <i class="bi bi-shield-lock-fill b2b-nav-link-icon"></i>
                        <span>Giriş &amp; İşlem Denetim İzi</span>
                    </div>
                    <span class="b2b-nav-badge">Audit</span>
                </a>

                <div class="pt-3 mt-auto">
                    <form asp-controller="Bayi" asp-action="Cikis" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill py-2 fw-semibold">
                            <i class="bi bi-box-arrow-right me-1"></i> Güvenli Çıkış Yap
                        </button>
                    </form>
                </div>
            </nav>
        </aside>

        <!-- ========================================================================= -->
        <!-- SAĞ İÇERİK ALANI                                                          -->
        <!-- ========================================================================= -->
        <main class="b2b-main-panel">
            <!-- Üst Çubuk (Topbar) -->
            <header class="b2b-topbar">
                <!-- Mobil Menü Butonu -->
                <button type="button" class="btn btn-light d-lg-none rounded-circle p-2" onclick="toggleBayiSidebar()">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <!-- Canlı Başlık -->
                <div class="d-none d-md-flex align-items-center gap-2">
                    <span class="badge px-3 py-1.5 rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fw-bold small">
                        <i class="bi bi-patch-check-fill me-1"></i> @BayiPortalTipleri.KisaAd(pTipi)
                    </span>
                    <span class="text-secondary small">&bull; Son Giriş: @(u.SonGirisTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "İlk Giriş")</span>
                </div>

                <!-- Sağ Butonlar: Dil Seçici + Tema + Bildirim + Profil -->
                <div class="d-flex align-items-center gap-2.5">
                    <!-- TÜRKÇE & İNGİLİZCE DİL DEĞİŞTİRİCİ -->
                    <button type="button" class="lang-switch-btn" id="bayiLangToggle" onclick="toggleSiteLanguage()" title="Dili Değiştir (TR / EN)">
                        <span id="bayiLangFlag">🇹🇷</span>
                        <span id="bayiLangText">TR</span>
                    </button>

                    <!-- Koyu / Açık Tema Butonu -->
                    <button type="button" class="btn btn-sm btn-light border rounded-circle p-2" id="bayiThemeToggle" onclick="toggleBayiTheme()" title="Açık/Koyu Mod">
                        <i class="bi bi-moon-stars" id="bayiThemeIcon"></i>
                    </button>

                    <!-- Bayi Kullanıcı Hapı -->
                    <div class="d-flex align-items-center gap-2 px-3 py-1.5 rounded-pill border" style="background: var(--b2b-card-bg);">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 32px; height: 32px; background: linear-gradient(135deg, #1d4ed8, #0b57d0); font-size: 0.8rem;">
                            @(string.IsNullOrEmpty(u.AdSoyad) ? "B" : u.AdSoyad.Substring(0, 1).ToUpper())
                        </div>
                        <div class="d-none d-sm-block text-start" style="line-height: 1.2;">
                            <div class="fw-bold small text-truncate" style="max-width: 140px;">@u.AdSoyad</div>
                            <small class="text-secondary" style="font-size: 0.68rem;">@u.UserName</small>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Bildirimler (Alerts) -->
            <div class="container-fluid px-4 pt-3">
                @if (TempData["BayiBasari"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                        <div><strong>İşlem Başarılı:</strong> @TempData["BayiBasari"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["BayiUyari"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
                        <div><strong>Bilgi:</strong> @TempData["BayiUyari"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
            </div>

            <!-- Ana İçerik Gövdesi (Tablar) -->
            <div class="container-fluid px-4 py-3 flex-grow-1">

                <!-- ========================================================================= -->
                <!-- 1. GENEL BAKIŞ (ÖZET PANELİ)                                             -->
                <!-- ========================================================================= -->
                <div class="tab-pane-content" id="tab-genel-bakis">
                    <!-- Karşılama Kartı -->
                    <div class="p-4 rounded-4 mb-4 position-relative overflow-hidden shadow-sm" style="background: linear-gradient(135deg, rgba(11, 87, 208, 0.08) 0%, rgba(248, 250, 252, 0.95) 100%); border: 1px solid rgba(11, 87, 208, 0.18);">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div>
                                <span class="badge bg-primary text-white rounded-pill px-3 py-1 mb-2">Hoş Geldiniz</span>
                                <h3 class="fw-bold mb-1" style="color: var(--b2b-text-main); letter-spacing: -0.5px;">@u.FirmaAdi B2B Partner Masası</h3>
                                <p class="text-secondary small mb-0" style="max-width: 680px;">
                                    Bu portal, Hayat İşleri Kanal Yönetimi tarafından firmanıza özel olarak atanmış <strong>@BayiPortalTipleri.Tanim(pTipi)</strong> yetkileriyle donatılmıştır.
                                </p>
                            </div>
                            <div class="text-end">
                                <div class="text-secondary small">Cari Bakiye Durumu</div>
                                <h4 class="fw-bold mb-0 text-primary">@Model.CariBakiyeTL.ToString("N2") TL</h4>
                                <small class="text-success"><i class="bi bi-shield-check me-1"></i>Risk Limiti: @Model.RiskLimitiTL.ToString("N0") TL</small>
                            </div>
                        </div>
                    </div>

                    <!-- Hızlı Özet Sayaçları -->
                    <div class="row g-3 mb-4">
                        @if (pTipi is 1 or 3)
                        {
                            <div class="col-md-3 col-6">
                                <div class="b2b-stat-widget">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">Kayıtlı Cihaz (SN)</small>
                                        <i class="bi bi-upc-scan text-primary fs-5"></i>
                                    </div>
                                    <h3 class="fw-bold mb-0" style="color: var(--b2b-text-main);">@Model.EnvanterListesi.Count</h3>
                                    <small class="text-success">Tümü Distribütör Garantili</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="b2b-stat-widget">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">Aktif RMA Talepleri</small>
                                        <i class="bi bi-tools text-warning fs-5"></i>
                                    </div>
                                    <h3 class="fw-bold mb-0" style="color: var(--b2b-text-main);">@Model.RmaKayitlari.Count</h3>
                                    <small class="text-secondary">Ortalama Servis: 2.4 Gün</small>
                                </div>
                            </div>
                        }
                        @if (pTipi is 2 or 3)
                        {
                            <div class="col-md-3 col-6">
                                <div class="b2b-stat-widget">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">Aktif SaaS Lisanslar</small>
                                        <i class="bi bi-key-fill text-success fs-5"></i>
                                    </div>
                                    <h3 class="fw-bold mb-0" style="color: var(--b2b-text-main);">@Model.Lisanslar.Count</h3>
                                    <small class="text-success">Bulut Uptime %99.98</small>
                                </div>
                            </div>
                            <div class="col-md-3 col-6">
                                <div class="b2b-stat-widget">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">Alt Müşteri Portföyü</small>
                                        <i class="bi bi-people-fill text-info fs-5"></i>
                                    </div>
                                    <h3 class="fw-bold mb-0" style="color: var(--b2b-text-main);">@Model.AltMusteriler.Count</h3>
                                    <small class="text-secondary">Lisans Dağıtım Ağı</small>
                                </div>
                            </div>
                        }
                        @if (pTipi == 3)
                        {
                            <div class="col-md-6 col-12">
                                <div class="b2b-stat-widget" style="background: linear-gradient(135deg, rgba(234, 67, 53, 0.05), rgba(251, 188, 5, 0.08)); border-color: rgba(234, 67, 53, 0.25);">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="badge bg-danger rounded-pill px-2.5 py-1">2026 Q4 Çeyrek Ciro Primi</span>
                                        <strong class="text-dark">@Model.CeyrekGerceklesenTL.ToString("N0") / @Model.CeyrekHedefTL.ToString("N0") TL</strong>
                                    </div>
                                    <div class="progress my-2" style="height: 10px; border-radius: 999px;">
                                        <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" role="progressbar" style="width: 85%;">85%</div>
                                    </div>
                                    <small class="text-secondary">Hedefe kalan 75.000 TL tamamlandığında <strong>%5 Ekstra Ciro Primi (21.250 TL)</strong> hakedişi hesabınıza tanımlanacaktır.</small>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Son Güvenlik & İşlem Özeti -->
                    <div class="row g-3">
                        <div class="col-lg-6">
                            <div class="b2b-card p-4 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-1 text-primary"></i> Son İşlem ve Değişiklik İzi</h6>
                                    <a href="#guvenlik-loglari" class="small text-decoration-none fw-semibold" onclick="switchBayiTab('guvenlik-loglari')">Tümünü Gör &rarr;</a>
                                </div>
                                <div class="d-flex flex-column gap-2.5">
                                    @foreach (var log in Model.IslemLoglari.Take(4))
                                    {
                                        <div class="p-2.5 rounded-3 border" style="background: var(--b2b-bg);">
                                            <div class="d-flex align-items-center justify-content-between small mb-1">
                                                <span class="badge bg-primary bg-opacity-10 text-primary border fw-bold">@log.IslemTuru</span>
                                                <span class="text-muted font-monospace" style="font-size: 0.72rem;">@log.Zaman.ToString("dd.MM.yyyy HH:mm")</span>
                                            </div>
                                            <div class="small fw-semibold text-truncate">@log.Detay</div>
                                            <div class="small text-secondary" style="font-size: 0.72rem;">
                                                <i class="bi bi-display me-1 text-info"></i>@log.BilgisayarCihaz &bull; IP: @log.IpAdresi
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="b2b-card p-4 h-100">
                                <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-shield-check me-1 text-success"></i> Son Giriş ve Oturum Logları</h6>
                                    <a href="#guvenlik-loglari" class="small text-decoration-none fw-semibold" onclick="switchBayiTab('guvenlik-loglari')">Tümünü Gör &rarr;</a>
                                </div>
                                <div class="d-flex flex-column gap-2.5">
                                    @foreach (var g in Model.GirisLoglari.Take(4))
                                    {
                                        <div class="p-2.5 rounded-3 border d-flex align-items-center justify-content-between" style="background: var(--b2b-bg);">
                                            <div>
                                                <div class="fw-bold small">
                                                    <i class="bi bi-laptop me-1 text-primary"></i>@g.BilgisayarCihaz
                                                </div>
                                                <div class="small text-muted font-monospace" style="font-size: 0.72rem;">IP: @g.IpAdresi &bull; @g.Zaman.ToString("dd.MM.yyyy HH:mm:ss")</div>
                                            </div>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 small">
                                                Başarılı
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================================================= -->
                <!-- 2. DONANIM MODÜLLERİ (Portal 1 & 3)                                       -->
                <!-- ========================================================================= -->
                @if (pTipi is 1 or 3)
                {
                    <!-- SERİ NO ENVANTERİ -->
                    <div class="tab-pane-content" id="tab-envanter" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <h5 class="fw-bold mb-0">Seri Numarası (SN) Bazlı Cihaz Envanteri</h5>
                                    <small class="text-secondary">Hayat İşleri'nden satın aldığınız tüm cihazların garanti durumu ve lokasyon takibi.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="exportTableToCsv('envanterTable', 'cihaz_envanteri.csv')">
                                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Excel'e Aktar
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0" id="envanterTable">
                                    <thead>
                                        <tr>
                                            <th>Seri No (SN)</th>
                                            <th>Cihaz Modeli &amp; Marka</th>
                                            <th>Satış Tarihi</th>
                                            <th>Garanti Bitiş</th>
                                            <th>Kalan Süre</th>
                                            <th>Konum / Şube</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.EnvanterListesi)
                                        {
                                            <tr>
                                                <td class="font-monospace fw-bold text-primary">@c.SeriNo</td>
                                                <td>
                                                    <strong>@c.ModelAdi</strong>
                                                    <div class="small text-secondary">Marka: @c.Marka</div>
                                                </td>
                                                <td>@c.SatisTarihi.ToString("dd.MM.yyyy")</td>
                                                <td>@c.GarantiBitisTarihi.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    @if (c.GarantiDevamEdiyor)
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                            @c.KalanGun Gün Kaldı
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1">
                                                            Süresi Doldu
                                                        </span>
                                                    }
                                                </td>
                                                <td><i class="bi bi-geo-alt me-1 text-muted"></i>@c.Lokasyon</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" onclick="hizliRmaModaliAc('@c.SeriNo', '@c.ModelAdi')">
                                                        <i class="bi bi-tools me-1"></i> RMA Aç
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- RMA TEKNİK SERVİS -->
                    <div class="tab-pane-content" id="tab-rma" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <h5 class="fw-bold mb-0">RMA (Teknik Servis &amp; Onarım) Yönetimi</h5>
                                    <small class="text-secondary">Arızalı yazıcı, POS terminali veya barkod okuyucular için anında servis talebi oluşturun.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3.5 py-1.5 fw-bold" style="background: #0b57d0; border: none;" data-bs-toggle="modal" data-bs-target="#modalYeniRma">
                                    <i class="bi bi-plus-lg me-1"></i> Yeni RMA Talebi Aç
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
                                    <thead>
                                        <tr>
                                            <th>RMA No</th>
                                            <th>Cihaz &amp; Seri No</th>
                                            <th>Arıza Bildirimi</th>
                                            <th>Kabul Tarihi</th>
                                            <th>Servis Durumu</th>
                                            <th>Kargo / Çözüm</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.RmaKayitlari.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-muted">Aktif RMA servis kaydınız bulunmuyor.</td>
                                            </tr>
                                        }
                                        @foreach (var r in Model.RmaKayitlari)
                                        {
                                            <tr>
                                                <td class="font-monospace fw-bold text-primary">@r.RmaNo</td>
                                                <td>
                                                    <strong>@r.CihazModeli</strong>
                                                    <div class="small font-monospace text-secondary">SN: @r.SeriNo</div>
                                                </td>
                                                <td>@r.ArizaAciklamasi</td>
                                                <td>@r.KabulTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>
                                                    <span class="badge rounded-pill px-2.5 py-1 bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 fw-bold">
                                                        @r.Durum
                                                    </span>
                                                </td>
                                                <td>@(string.IsNullOrEmpty(r.KargoTakipNo) ? "Yurtiçi Kargo: 914801" : r.KargoTakipNo)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- SARF SİPARİŞİ -->
