                                    <i class="bi bi-shield-check text-success fs-4"></i>
                                    <div>
                                        <strong class="text-dark">SSL / TLS 1.3 &amp; AES-256 Şifreleme Aktif</strong>
                                        <div class="small text-secondary">Tüm veriler KVKK ve ISO 27001 kurumsal standartlarına uygun olarak Türkiye içi sunucularda saklanmaktadır.</div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-bold" onclick="toastGoster('Manuel bulut yedekleme tetiklendi.')">
                                    <i class="bi bi-cloud-arrow-up me-1"></i> Anlık Yedek Al
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ALT MÜŞTERİ YÖNETİMİ -->
                    <div class="tab-pane-content" id="tab-alt-musteriler" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <h5 class="fw-bold mb-0">Alt Müşteri (Son Kullanıcı) Tanımlama &amp; Lisans Dağıtımı</h5>
                                    <small class="text-secondary">Lisans sattığınız son kullanıcı işletmeleri tanımlayın ve onlara ait lisansları tek ekrandan yönetin.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3.5 py-1.5 fw-bold" data-bs-toggle="modal" data-bs-target="#modalAltMusteri">
                                    <i class="bi bi-person-plus-fill me-1"></i> Yeni Alt Müşteri Ekle
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
                                    <thead>
                                        <tr>
                                            <th>Firma / Müşteri Unvanı</th>
                                            <th>Yetkili Kişi &amp; İletişim</th>
                                            <th>Şehir</th>
                                            <th>Tanımlı Lisans Kodu</th>
                                            <th>Kayıt Tarihi</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var am in Model.AltMusteriler)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@am.Unvan</td>
                                                <td>
                                                    <div>@am.Yetkili</div>
                                                    <div class="small text-secondary">@am.Telefon &bull; @am.Eposta</div>
                                                </td>
                                                <td>@am.Sehir</td>
                                                <td class="font-monospace text-primary fw-bold">@am.AtananLisans</td>
                                                <td>@am.EklenmeTarihi.ToString("dd.MM.yyyy")</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1" onclick="toastGoster('Müşteri lisans paneli açıldı: @am.Unvan')">
                                                        Detay
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- HAYAT İŞLERİ AKADEMİ -->
                    <div class="tab-pane-content" id="tab-akademi" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <h5 class="fw-bold mb-0">Hayat İşleri Akademi &bull; Online Eğitim &amp; Yetkili Sertifikasyon</h5>
                                <small class="text-secondary">Bayi personelinizin teknik yetkinliğini artırın, online sınavları tamamlayarak resmi "Yetkili Satış Uzmanı" sertifikası alın.</small>
                            </div>
                            <div class="row g-3">
                                @foreach (var ak in Model.AkademiEgitimleri)
                                {
                                    <div class="col-md-4">
                                        <div class="p-3.5 rounded-3 border h-100 d-flex flex-column justify-content-between" style="background: var(--b2b-bg);">
                                            <div>
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border small">@ak.Kategori</span>
                                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>@ak.Sure</small>
                                                </div>
                                                <h6 class="fw-bold mb-2">@ak.DersAdi</h6>
                                                <div class="progress mb-2" style="height: 6px;">
                                                    <div class="progress-bar bg-success" style="width: @ak.IlerlemeYuzdesi%;"></div>
                                                </div>
                                                <small class="text-secondary">Tamamlanma Oranı: %@ak.IlerlemeYuzdesi</small>
                                            </div>
                                            <div class="mt-3 pt-2 border-top">
                                                @if (ak.SertifikaVerildi)
                                                {
                                                    <div class="d-flex align-items-center justify-content-between">
                                                        <span class="badge bg-success text-white rounded-pill px-2.5 py-1 small">
                                                            <i class="bi bi-patch-check-fill me-1"></i> Sertifikalı
                                                        </span>
                                                        <span class="font-monospace small text-muted">@ak.SertifikaKodu</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill w-100 fw-bold" onclick="toastGoster('Eğitim modülüne yönlendiriliyorsunuz...')">
                                                        Eğitime Devam Et &rarr;
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- UPSELL & MODÜL YÜKSELTMELERİ -->
                    <div class="tab-pane-content" id="tab-upsell" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <h5 class="fw-bold mb-0">Hızlı Modül &amp; Kontör Yükseltme (Upsell / Cross-Sell)</h5>
                                <small class="text-secondary">Müşterilerinizin mevcut lisanslarına tek tıkla e-Fatura kontörü, SMS paketi veya ek kullanıcı lisansı tanımlayın.</small>
                            </div>
                            <div class="row g-3">
                                @foreach (var up in Model.UpsellPaketleri)
                                {
                                    <div class="col-md-4">
                                        <div class="p-3.5 rounded-3 border h-100 d-flex flex-column justify-content-between" style="background: var(--b2b-bg);">
                                            <div>
                                                <span class="badge bg-warning bg-opacity-25 text-dark fw-bold mb-2">@up.Rozet</span>
                                                <h6 class="fw-bold mb-1">@up.Baslik</h6>
                                                <p class="small text-secondary mb-3">@up.Aciklama</p>
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                                <h5 class="fw-bold text-primary mb-0">@up.FiyatTL.ToString("N0") TL</h5>
                                                <div id="paket-btn-box-@up.Kod" class="d-flex gap-1.5 align-items-center">
                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fw-bold"
                                                            onclick="b2bSepeteEkle('@up.Kod', '@up.Baslik.Replace("'", "\\'")', 'Ek Paket', @up.FiyatTL)">
                                                        <i class="bi bi-cart-plus me-1"></i> Hızlı Ekle
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs" style="background: #0b57d0; border: none;"
                                                            data-box="paket-btn-box-@up.Kod"
                                                            data-id="@up.Kod"
                                                            data-tur="Paket Satın Alma"
                                                            data-baslik="@up.Baslik"
                                                            data-kategori="Ek Paket &amp; Modül"
                                                            data-iskonto="0"
                                                            data-ozelfiyat="@up.FiyatTL"
                                                            data-detay="@up.Aciklama"
                                                            onclick="b2bTalepModalAc(this)">
                                                        Satın Al
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- GELİŞTİRİCİ & API SANDBOX -->
                    <div class="tab-pane-content" id="tab-api-sandbox" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <h5 class="fw-bold mb-0">Geliştirici Araçları &amp; API Sandbox Test Ortamı</h5>
                                <small class="text-secondary">HiCariTakip ERP REST API entegrasyonu, Swagger dökümantasyonu ve canlı test anahtarları.</small>
                            </div>
                            <div class="p-3.5 rounded-3 border mb-3" style="background: var(--b2b-bg);">
                                <label class="small text-secondary fw-bold mb-1">Partner Sandbox API Key:</label>
                                <div class="input-group">
                                    <input type="text" class="form-control font-monospace" value="@Model.ApiKey" id="apiKeyInput" readonly />
                                    <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText('@Model.ApiKey'); toastGoster('API Key panoya kopyalandı.');">
                                        <i class="bi bi-clipboard"></i> Kopyala
                                    </button>
                                </div>
                                <small class="text-muted mt-1 d-block">Base Endpoint: <code>https://api.hayatisleri.com/v2/b2b/</code></small>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="https://localhost:7098/swagger" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-bold">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Swagger API Dokümanı
                                </a>
                                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 py-1.5 fw-bold" onclick="toastGoster('C# ve Node.js SDK kod örnekleri indirildi.')">
                                    <i class="bi bi-file-code me-1"></i> C# SDK İndir
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================================= -->
                <!-- 4. TAM YETKİLİ ÇÖZÜM ORTAĞI STRATEJİSİ (Sadece Portal 3)  -->
                <!-- ========================================================= -->
                @if (pTipi == 3)
                {
                    <!-- CİHAZ - YAZILIM EŞLEŞTİRME -->
                    <div class="tab-pane-content" id="tab-eslestirme" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <h5 class="fw-bold mb-0">Cihaz - Yazılım Eşleştirme (Senkronizasyon) Ekranı</h5>
                                    <small class="text-secondary">Hangi seri numaralı fiziksel donanımın içinde hangi lisans kodlu yazılımın çalıştığını haritalandırın.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3.5 py-1.5 fw-bold" data-bs-toggle="modal" data-bs-target="#modalEslestir">
                                    <i class="bi bi-link-45deg me-1"></i> Yeni Cihaz &amp; Lisans Eşleştir
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
                                    <thead>
                                        <tr>
                                            <th>Fiziksel Donanım (SN)</th>
                                            <th>Cihaz Modeli</th>
                                            <th>Çalışan Yazılım Lisansı</th>
                                            <th>Kurulu Olduğu Şube</th>
                                            <th>Eşleştirme Zamanı</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var es in Model.Eslestirmeler)
                                        {
                                            <tr>
                                                <td class="font-monospace fw-bold text-primary">@es.DonanimSeriNo</td>
                                                <td>@es.DonanimModeli</td>
                                                <td class="font-monospace text-success fw-bold">@es.LisansKodu</td>
                                                <td><i class="bi bi-shop me-1 text-muted"></i>@es.MagazaSube</td>
                                                <td>@es.EslestirmeTarihi.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                        <i class="bi bi-wifi me-1"></i>@es.Durum
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- CİRO PRİMİ VE HEDEF SAYACI -->
                    <div class="tab-pane-content" id="tab-ciro-hedef" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <h5 class="fw-bold mb-0">2026 Q4 Çeyrek Ciro Primi &amp; Performans Göstergesi</h5>
                                <small class="text-secondary">Hedeflenen çeyrek cirosuna ulaştığınızda otomatik hak edeceğiniz ekstra prim ve prim simülasyonu.</small>
                            </div>
                            <div class="p-4 rounded-4 mb-4 border" style="background: linear-gradient(135deg, rgba(234, 67, 53, 0.08), rgba(251, 188, 5, 0.1));">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <h4 class="fw-bold mb-0 text-dark">Dönem Hedefi: @Model.CeyrekHedefTL.ToString("N0") TL</h4>
                                    <h3 class="fw-bold mb-0 text-danger">Gerçekleşen: @Model.CeyrekGerceklesenTL.ToString("N0") TL (%85)</h3>
                                </div>
                                <div class="progress my-3" style="height: 18px; border-radius: 999px;">
                                    <div class="progress-bar bg-danger progress-bar-striped progress-bar-animated" style="width: 85%;">%85 Tamamlandı</div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between small text-secondary">
                                    <span>Hedefe Kalan: <strong>75.000 TL</strong></span>
                                    <span>Hak Edilecek Ekstra Prim: <strong class="text-success fs-6">21.250 TL (%5)</strong></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ÇAPRAZ SATIŞ ÖNERİLERİ -->
                    <div class="tab-pane-content" id="tab-capraz-satis" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <h5 class="fw-bold mb-0">Akıllı Çapraz Satış (Cross-Sell AI) Raporu</h5>
                                <small class="text-secondary">Sistem, müşterilerinizin lisans ve donanım envanterini karşılaştırarak satış fırsatlarını önünüze getirir.</small>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
                                    <thead>
                                        <tr>
                                            <th>Müşteri Unvanı</th>
                                            <th>Mevcut Kullandığı Sistem</th>
                                            <th>Tavsiye Edilen Donanım Teklifi</th>
                                            <th>Tahmini Gelir</th>
                                            <th>Satış Gerekçesi</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cs in Model.CaprazSatisOnerileri)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@cs.MusteriUnvani</td>
                                                <td><span class="badge bg-secondary bg-opacity-10 text-secondary border">@cs.MevcutSistem</span></td>
                                                <td class="fw-bold text-primary">@cs.OnerilenDonanim</td>
                                                <td class="fw-bold text-success">@cs.PotansiyelGelir</td>
                                                <td class="small text-secondary">@cs.Gerekce</td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1" onclick="toastGoster('Teklif şablonu oluşturuldu: @cs.MusteriUnvani')">
                                                        Teklif Hazırla
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- MDF PAZARLAMA FONU -->
                    <div class="tab-pane-content" id="tab-mdf-fonu" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <h5 class="fw-bold mb-0">Ortak Pazarlama Fonu (MDF) Başvuru Alanı</h5>
                                    <small class="text-secondary">Şehrinizdeki bölgesel fuarlar, billboard veya yerel dijital reklamlar için Hayat İşleri'nden bütçe desteği alın.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3.5 py-1.5 fw-bold" data-bs-toggle="modal" data-bs-target="#modalMdfTalep">
                                    <i class="bi bi-megaphone me-1"></i> MDF Talebi Gönder
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
                                    <thead>
                                        <tr>
                                            <th>Fuar / Etkinlik Adı</th>
                                            <th>Talep Edilen Tutar</th>
                                            <th>Onaylanan Fon</th>
                                            <th>Başvuru Tarihi</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var md in Model.MdfTalepleri)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">@md.EtkinlikAdi</td>
                                                <td>@md.TalepTutariTL.ToString("N0") TL</td>
                                                <td class="fw-bold text-success">@md.OnaylananTutarTL.ToString("N0") TL</td>
                                                <td>@md.BasvuruTarihi.ToString("dd.MM.yyyy")</td>
                                                <td>
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                        @md.Durum
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- ÖZEL İSKONTO SKALASI -->
                    <div class="tab-pane-content" id="tab-ozel-iskonto" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="mb-3 pb-3 border-bottom">
                                <h5 class="fw-bold mb-0">B2B Özel İskonto Seviyesi: Platinum Partner</h5>
                                <small class="text-secondary">Tüm donanım ve yazılım ürünlerinde anlık tanımlanan otomatik B2B iskonto tablonuz.</small>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3.5 rounded-3 border text-center" style="background: var(--b2b-bg);">
                                        <div class="small text-secondary mb-1">POS &amp; Donanım İskontosu</div>
                                        <h3 class="fw-bold text-primary mb-0">%35</h3>
                                        <small class="text-muted">Zebra, Sunmi, KodPOS</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3.5 rounded-3 border text-center" style="background: var(--b2b-bg);">
                                        <div class="small text-secondary mb-1">Yazılım &amp; SaaS İskontosu</div>
                                        <h3 class="fw-bold text-success mb-0">%45</h3>
                                        <small class="text-muted">HiCariTakip ERP, e-Dönüşüm</small>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3.5 rounded-3 border text-center" style="background: var(--b2b-bg);">
                                        <div class="small text-secondary mb-1">Sarf &amp; Ribon İskontosu</div>
                                        <h3 class="fw-bold text-warning mb-0">%25</h3>
                                        <small class="text-muted">Rulo, etiket ve şeritler</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================================= -->
                <!-- 5. TÜMÜ İÇİN ORTAK MODÜLLER (Finans, Sub-User, Güvenlik)  -->
                <!-- ========================================================= -->
                <!-- B2B FİNANS VE TAHSİLAT -->
                @if (!Model.IsAltKullanici || u.IzinFinansSanalPos)
                {
                    <div class="tab-pane-content" id="tab-finans" style="display: none;">
                        <div class="row g-3">
                            <div class="col-lg-7">
                                <div class="b2b-card p-4 h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                        <h5 class="fw-bold mb-0">Cari Bakiye &amp; Fatura Ekstresi</h5>
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="exportTableToCsv('faturaTable', 'fatura_ekstresi.csv')">
                                            <i class="bi bi-download me-1"></i> PDF Ekstre
                                        </button>
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <div class="p-3 rounded-3 border" style="background: var(--b2b-bg);">
                                                <small class="text-secondary">Güncel Bakiye (Borç)</small>
                                                <h4 class="fw-bold text-primary mb-0">@Model.CariBakiyeTL.ToString("N2") TL</h4>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-3 rounded-3 border" style="background: var(--b2b-bg);">
                                                <small class="text-secondary">Tanımlı Kredi Limiti</small>
                                                <h4 class="fw-bold text-success mb-0">@Model.RiskLimitiTL.ToString("N0") TL</h4>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-custom mb-0" id="faturaTable">
                                            <thead>
                                                <tr>
                                                    <th>Fatura No</th>
                                                    <th>Tarih</th>
                                                    <th>Vade</th>
                                                    <th>Tutar</th>
                                                    <th>Kalan</th>
                                                    <th>Durum</th>
                                                    <th class="text-end">İndir</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var f in Model.Faturalar)
                                                {
                                                    <tr>
                                                        <td class="fw-bold text-primary">@f.FaturaNo</td>
                                                        <td>@f.Tarih.ToString("dd.MM.yyyy")</td>
                                                        <td>@f.VadeTarihi.ToString("dd.MM.yyyy")</td>
                                                        <td class="fw-bold">@f.TutarTL.ToString("N2") TL</td>
                                                        <td class="fw-bold text-danger">@f.KalanTL.ToString("N2") TL</td>
                                                        <td>
                                                            <span class="badge @(f.KalanTL == 0 ? "bg-success" : "bg-warning") bg-opacity-10 text-@(f.KalanTL == 0 ? "success" : "warning") border rounded-pill px-2.5 py-1">
                                                                @f.Durum
                                                            </span>
                                                        </td>
                                                        <td class="text-end">
                                                            <a href="/Bayi/FaturaPdfIndir?faturaNo=@f.FaturaNo" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5 fw-bold" target="_blank">
                                                                <i class="bi bi-file-earmark-pdf-fill me-1 text-danger"></i> PDF
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- 3D Secure Sanal POS Formu -->
                            <div class="col-lg-5">
                                <div class="b2b-card p-4 h-100">
                                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                        <h5 class="fw-bold mb-0">3D Secure Sanal POS ile Ödeme</h5>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 small">
                                            <i class="bi bi-shield-check me-1"></i> 256-Bit SSL &amp; PCI-DSS
                                        </span>
                                    </div>

                                    <!-- İnteraktif Kredi Kartı Görseli (Live Card Preview) -->
                                    <div class="pos-card-preview mb-3 p-3.5 rounded-4 text-white position-relative shadow" style="background: linear-gradient(135deg, #0b57d0 0%, #1e293b 100%); border: 1px solid rgba(255,255,255,0.15); min-height: 180px; overflow: hidden;">
                                        <div class="position-absolute" style="right: -25px; bottom: -25px; width: 140px; height: 140px; background: rgba(255,255,255,0.04); border-radius: 50%;"></div>
                                        <div class="d-flex align-items-center justify-content-between mb-3 position-relative">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-2 py-0.5 rounded" style="font-size: 0.7rem; font-weight: 700;">
                                                    <i class="bi bi-cpu-fill me-1"></i> EMV CHIP
                                                </span>
                                                <i class="bi bi-reception-4 fs-6 text-white-50" title="Temassız / Contactless"></i>
                                            </div>
                                            <div id="cardBrandBadge" class="fw-bold px-2.5 py-0.5 rounded-pill text-white" style="background: rgba(255,255,255,0.15); font-size: 0.78rem; letter-spacing: 0.5px;">
                                                <i class="bi bi-credit-card-2-front-fill me-1"></i> <span id="cardBrandText">MasterCard / Visa</span>
                                            </div>
                                        </div>
                                        <div class="mb-3 position-relative">
                                            <small class="text-white-50 d-block" style="font-size: 0.65rem; letter-spacing: 1px;">KART NUMARASI</small>
                                            <div id="cardPreviewNumber" class="font-monospace fs-5 fw-bold" style="letter-spacing: 2px;">
                                                5400 •••• •••• 4242
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-end justify-content-between position-relative">
                                            <div>
                                                <small class="text-white-50 d-block" style="font-size: 0.62rem; letter-spacing: 0.8px;">KART SAHİBİ</small>
                                                <div id="cardPreviewHolder" class="fw-bold text-truncate" style="max-width: 190px; font-size: 0.82rem; letter-spacing: 0.5px;">
                                                    @(u?.FirmaAdi?.ToUpper() ?? "YETKİLİ BAYİ")
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <small class="text-white-50 d-block" style="font-size: 0.62rem; letter-spacing: 0.8px;">VALID THRU</small>
                                                <div id="cardPreviewExpiry" class="font-monospace fw-bold" style="font-size: 0.82rem;">
                                                    12 / 28
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Form Alanları -->
                                    <form id="formSanalPos" onsubmit="event.preventDefault(); posOdemeBaslat();">
                                        @Html.AntiForgeryToken()
                                        
                                        <!-- Hızlı Tutar Seçimi -->
                                        <div class="mb-2.5">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <label class="small text-secondary fw-bold">Ödeme Tutarı (TL):</label>
                                                <span class="text-muted" style="font-size: 0.72rem;">Hızlı Tutar:</span>
                                            </div>
                                            <div class="d-flex flex-wrap gap-1 mb-2">
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0.5 px-2" style="font-size: 0.74rem;" onclick="setPosTutar(1000)">₺1.000</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0.5 px-2" style="font-size: 0.74rem;" onclick="setPosTutar(5000)">₺5.000</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0.5 px-2" style="font-size: 0.74rem;" onclick="setPosTutar(15000)">₺15.000</button>
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0.5 px-2 fw-semibold" style="font-size: 0.74rem;" onclick="setPosTutar(@Model.CariBakiyeTL)">Bakiyeyi Kapat (₺@Model.CariBakiyeTL.ToString("N2"))</button>
                                            </div>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light fw-bold text-primary">₺</span>
                                                <input type="number" step="0.01" min="1" id="posTutar" name="tutar" class="form-control fw-bold fs-5 text-primary" value="5000.00" oninput="guncelleTaksitHesabi()" required />
                                            </div>
                                        </div>

                                        <div class="mb-2.5">
                                            <label class="small text-secondary fw-bold mb-1">Kart Üzerindeki İsim:</label>
                                            <input type="text" id="posKartSahibi" name="kartSahibi" class="form-control" placeholder="Örn: AHMET YILMAZ" value="@(u?.AdSoyad ?? u?.FirmaAdi ?? "Yetkili Bayi")" oninput="updateCardHolderPreview(this.value)" required />
                                        </div>

                                        <div class="mb-2.5">
                                            <label class="small text-secondary fw-bold mb-1">Kredi / Banka Kartı Numarası:</label>
                                            <div class="position-relative">
                                                <input type="text" id="posKartNo" name="kartNo" class="form-control font-monospace" placeholder="5400 0000 0000 4242" maxlength="19" oninput="formatAndValidateCardNo(this)" required />
                                                <span id="posCardBrandIcon" class="position-absolute end-0 top-50 translate-middle-y me-3 text-muted">
                                                    <i class="bi bi-credit-card"></i>
                                                </span>
                                            </div>
                                            <div id="posLuhnFeedback" class="small mt-1" style="display: none;"></div>
                                        </div>

                                        <div class="row g-2 mb-2.5">
                                            <div class="col-4">
                                                <label class="small text-secondary fw-bold mb-1">Ay:</label>
                                                <select id="posAy" name="ay" class="form-select font-monospace text-center" onchange="updateCardExpiryPreview()" required>
                                                    @for (int m = 1; m <= 12; m++)
                                                    {
                                                        var str = m.ToString("D2");
                                                        if (m == 12) { <option value="@m" selected>@str</option> }
                                                        else { <option value="@m">@str</option> }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="small text-secondary fw-bold mb-1">Yıl:</label>
                                                <select id="posYil" name="yil" class="form-select font-monospace text-center" onchange="updateCardExpiryPreview()" required>
                                                    @for (int y = DateTime.Now.Year; y <= DateTime.Now.Year + 12; y++)
                                                    {
                                                        var y2 = y % 100;
                                                        if (y == DateTime.Now.Year + 2) { <option value="@y2" selected>@y2</option> }
                                                        else { <option value="@y2">@y2</option> }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-4">
                                                <label class="small text-secondary fw-bold mb-1">CVV / CVC:</label>
                                                <input type="password" id="posCvv" name="cvv" class="form-control text-center font-monospace" placeholder="•••" maxlength="4" required />
                                            </div>
                                        </div>

                                        <!-- Taksit Seçeneği -->
                                        <div class="mb-3">
                                            <label class="small text-secondary fw-bold mb-1">Taksit Seçeneği:</label>
                                            <select id="posTaksit" name="taksit" class="form-select" onchange="guncelleTaksitHesabi()">
                                                <option value="1" selected>Tek Çekim (Peşin - %0 Komisyon)</option>
                                                <option value="2">2 Taksit (+%1.80 Vade Farkı)</option>
                                                <option value="3">3 Taksit (+%2.40 Vade Farkı)</option>
                                                <option value="6">6 Taksit (+%4.20 Vade Farkı)</option>
                                                <option value="9">9 Taksit (+%6.50 Vade Farkı)</option>
                                                <option value="12">12 Taksit (+%8.90 Vade Farkı)</option>
                                            </select>
                                            <div id="posTaksitDetay" class="small text-muted mt-1" style="font-size: 0.75rem;">
                                                Kartınızdan çekilecek toplam tutar: <strong id="posToplamCekim" class="text-primary">₺5.000,00 TL</strong>
                                            </div>
                                        </div>

                                        <!-- Güvenlik Onayı -->
                                        <div class="form-check small text-secondary mb-3">
                                            <input class="form-check-input" type="checkbox" checked id="chk3d" required>
                                            <label class="form-check-label" for="chk3d" style="font-size: 0.78rem;">
                                                <strong>3D Secure 2.0</strong> SMS onay şifresi ile güvenli ödemeyi onaylıyorum.
                                            </label>
                                        </div>

                                        <!-- Buton -->
                                        <button type="submit" id="btnPosSubmit" class="btn btn-primary rounded-pill w-100 py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: #0b57d0; border: none;">
                                            <i class="bi bi-lock-fill"></i>
                                            <span id="btnPosSubmitText">3D Secure ile Güvenli Öde</span>
                                        </button>

                                        <!-- Güvenlik Mühürleri -->
                                        <div class="mt-3 pt-2 border-top text-center text-muted" style="font-size: 0.72rem;">
                                            <div class="d-flex items-center justify-content-center gap-3">
                                                <span><i class="bi bi-shield-lock-fill text-success me-1"></i>256-Bit SSL</span>
                                                <span><i class="bi bi-check-circle-fill text-primary me-1"></i>PCI-DSS Seviye 1</span>
                                                <span><i class="bi bi-patch-check-fill text-info me-1"></i>BKM 3D Secure 2.0</span>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ÇOKLU ALT KULLANICI (SUB-USER) - SADECE ANA BAYİ YÖNETİR -->
                @if (!Model.IsAltKullanici)
                {
                    <div class="tab-pane-content" id="tab-alt-kullanicilar" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; font-weight: 700; border: 1px solid rgba(14, 165, 233, 0.25);">
                                            <i class="bi bi-person-gear me-1"></i> Alt Kullanıcı Yönetimi
                                        </span>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-0.5 small">Yalnızca Ana Bayi Yetkili</span>
                                    </div>
                                    <h5 class="fw-bold mb-0">Alt Kullanıcı (Personel) Tanımlama &amp; Yetki Kısıtlama</h5>
                                    <small class="text-secondary">Şirket personellerinize özel giriş hesapları oluşturun; Cari Bakiye, 3D Sanal POS, Sepet ve Denetim İzi gibi hassas modülleri dilediğiniz gibi açıp kapatın.</small>
                                </div>
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3.5 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-sm" style="background: #0284c7; border: none;" data-bs-toggle="modal" data-bs-target="#modalSubUser">
                                    <i class="bi bi-person-plus-fill"></i> Yeni Alt Kullanıcı Tanımla
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
                                    <thead>
                                        <tr>
                                            <th>Yetkili Personel</th>
                                            <th>Giriş E-Posta &amp; Telefon</th>
                                            <th>Görev / Unvan</th>
                                            <th>Tanımlı Yetkiler (İzinler)</th>
                                            <th>Son Oturum</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.AltKullanicilar.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-secondary">
                                                    <i class="bi bi-people fs-2 d-block mb-1 text-muted"></i>
                                                    Henüz tanımlanmış bir alt kullanıcı hesabınız bulunmamaktadır.
                                                </td>
                                            </tr>
                                        }
                                        @foreach (var su in Model.AltKullanicilar)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 34px; height: 34px; background: #0284c7; font-size: 0.8rem;">
                                                            @(string.IsNullOrWhiteSpace(su.AdSoyad) ? "AK" : (su.AdSoyad.Length > 2 ? su.AdSoyad[..2].ToUpper() : su.AdSoyad.ToUpper()))
                                                        </div>
                                                        <div class="fw-bold text-dark">@su.AdSoyad</div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="font-monospace small"><i class="bi bi-envelope me-1 text-secondary"></i>@su.Eposta</div>
                                                    @if (!string.IsNullOrWhiteSpace(su.Telefon))
                                                    {
                                                        <div class="small text-secondary"><i class="bi bi-telephone me-1 text-secondary"></i>@su.Telefon</div>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-1">@su.Unvan</span>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-wrap gap-1" style="max-width: 300px;">
                                                        @if (su.IzinFinansSanalPos)
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Finans/POS</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.7rem;"><i class="bi bi-lock me-0.5"></i>Finans Yok</span>
                                                        }

                                                        @if (su.IzinSiparisVeSarf)
                                                        {
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Sipariş Açık</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.7rem;"><i class="bi bi-cart-x me-0.5"></i>Sipariş Yok</span>
                                                        }

                                                        @if (su.IzinDenetimIzi)
                                                        {
                                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">İşlem İzi</span>
                                                        }

                                                        @if (su.IzinTeknikServisRma)
                                                        {
                                                            <span class="badge bg-info bg-opacity-10 text-info border rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">RMA</span>
                                                        }
                                                        @if (su.IzinDestekTalepleri)
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Destek</span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="small text-muted">@su.SonGiris.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td class="text-end">
                                                    @if (!string.IsNullOrEmpty(su.Id))
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 me-1" data-bs-toggle="modal" data-bs-target="#modalEditSubUser_@su.Id" title="Yetkileri Düzenle / İzinleri Kaldır">
                                                            <i class="bi bi-pencil-square me-1"></i> İzinleri Düzenle
                                                        </button>
                                                        <form method="post" asp-action="AltKullaniciSil" onsubmit="return confirm('@su.AdSoyad adlı alt kullanıcıyı silmek istediğinize emin misiniz?');" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="subUserId" value="@su.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1">
                                                                <i class="bi bi-trash"></i> Sil
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- ALT KULLANICI İZİN DÜZENLEME MODALLARI -->
                        @foreach (var su in Model.AltKullanicilar)
                        {
                            if (!string.IsNullOrEmpty(su.Id))
                            {
                                <div class="modal fade" id="modalEditSubUser_@su.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content rounded-4 border-0 shadow-lg" style="background: var(--b2b-card-bg);">
                                            <form asp-controller="Bayi" asp-action="AltKullaniciYetkiGuncelle" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="subUserId" value="@su.Id" />
                                                <div class="modal-header border-bottom p-3.5">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                                                            <i class="bi bi-person-gear fs-5"></i>
                                                        </span>
                                                        <div>
                                                            <h5 class="modal-title fw-bold mb-0" style="color: var(--b2b-text-main);">@su.AdSoyad - Yetki ve İzinleri Düzenle</h5>
                                                            <small class="text-secondary">@su.Eposta &bull; Verilen izinleri dilediğiniz zaman kaldırabilir veya yeniden tanımlayabilirsiniz.</small>
                                                        </div>
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <!-- Bilgi Kutusu -->
                                                    <div class="p-3 rounded-3 mb-3 d-flex align-items-start gap-2.5" style="background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.2);">
                                                        <i class="bi bi-info-circle-fill text-info fs-5 flex-shrink-0 mt-0.5"></i>
                                                        <div class="small text-secondary" style="line-height: 1.5;">
                                                            Bu kullanıcının bayilik portalınızdaki erişim haklarını aşağıdan yönetebilirsiniz. Kaldırdığınız izinler anında yürürlüğe girer ve personelin ilgili menülere erişimi derhal kilitlenir.
                                                        </div>
                                                    </div>

                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="small fw-bold text-secondary mb-1">Görev / Unvan:</label>
                                                            <input type="text" name="unvan" class="form-control" value="@su.Unvan" required />
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="small fw-bold text-secondary mb-1">Yeni Şifre Belirle (İsteğe Bağlı):</label>
                                                            <input type="text" name="yeniSifre" class="form-control font-monospace" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                                                        </div>
                                                    </div>

                                                    <!-- Granüler Modül Yetki Matrisi -->
                                                    <div class="border rounded-4 p-3.5" style="background: var(--b2b-bg);">
                                                        <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                                            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-toggles2 text-primary me-1.5"></i> Modül Erişim &amp; İzin Matrisi</h6>
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-0.5 small">Aktif / Pasif Seçimi</span>
                                                        </div>
                                                        <p class="small text-secondary mb-3" style="font-size: 0.78rem;">
                                                            İşaretini kaldırdığınız modüller personelin panelinde <strong>kesinlikle gizlenir</strong> ve erişimi engellenir.
                                                        </p>

                                                        <div class="row g-2">
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinFinans" value="true" id="permFinans_@su.Id" @(su.IzinFinansSanalPos ? "checked" : "")>
                                                                    <label class="form-check-label small fw-bold text-danger d-block" for="permFinans_@su.Id">
                                                                        <i class="bi bi-wallet2 me-1"></i> Cari Bakiye &amp; 3D Sanal POS
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Cari borç görme ve kredi kartıyla ödeme yapabilme yetkisi</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinSiparis" value="true" id="permSiparis_@su.Id" @(su.IzinSiparisVeSarf ? "checked" : "")>
                                                                    <label class="form-check-label small fw-bold text-primary d-block" for="permSiparis_@su.Id">
                                                                        <i class="bi bi-cart3 me-1"></i> Sipariş Verme &amp; Sepet Satın Alımı
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Sarf malzeme ve donanım satın alma yetkisi</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinDenetim" value="true" id="permDenetim_@su.Id" @(su.IzinDenetimIzi ? "checked" : "")>
                                                                    <label class="form-check-label small fw-bold text-warning d-block" for="permDenetim_@su.Id">
                                                                        <i class="bi bi-shield-lock-fill me-1"></i> Giriş &amp; İşlem Denetim İzi (Audit)
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Diğer personellerin giriş IP ve operasyon loglarını görme yetkisi</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinTeknikServis" value="true" id="permRma_@su.Id" @(su.IzinTeknikServisRma ? "checked" : "")>
                                                                    <label class="form-check-label small fw-semibold text-dark d-block" for="permRma_@su.Id">
                                                                        <i class="bi bi-tools me-1 text-primary"></i> RMA (Teknik Servis) Talepleri
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Arızalı cihaz gönderme ve servis takibi</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinDestek" value="true" id="permDestek_@su.Id" @(su.IzinDestekTalepleri ? "checked" : "")>
                                                                    <label class="form-check-label small fw-semibold text-dark d-block" for="permDestek_@su.Id">
                                                                        <i class="bi bi-headset me-1 text-success"></i> Destek Masası (Ticket Sistemi)
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Merkez ekibiyle destek yazışmaları yapabilme</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinFiyat" value="true" id="permFiyat_@su.Id" @(su.IzinFiyatListesi ? "checked" : "")>
                                                                    <label class="form-check-label small fw-semibold text-dark d-block" for="permFiyat_@su.Id">
                                                                        <i class="bi bi-table me-1 text-info"></i> B2B Fiyat Listesi &amp; Katalog
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">İskontolu donanım ve ürün listesini inceleme</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinDriver" value="true" id="permDriver_@su.Id" @(su.IzinKutuphaneDriver ? "checked" : "")>
                                                                    <label class="form-check-label small fw-semibold text-dark d-block" for="permDriver_@su.Id">
                                                                        <i class="bi bi-download me-1 text-secondary"></i> Sürücü (Driver) &amp; SDK Kütüphanesi
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Yazıcı ve POS sürücü dosyalarını indirme</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="izinProje" value="true" id="permProje_@su.Id" @(su.IzinProjeFirsat ? "checked" : "")>
                                                                    <label class="form-check-label small fw-semibold text-dark d-block" for="permProje_@su.Id">
                                                                        <i class="bi bi-briefcase me-1 text-primary"></i> Proje &amp; Fırsat Fiyat Koruması
                                                                        <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Saha projelerini kaydetme</span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top p-3 bg-light">
                                                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                                                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #0284c7; border: none;">
                                                        <i class="bi bi-check2-circle me-1"></i> İzin Değişikliklerini Kaydet
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }

                <!-- GÜVENLİK VE DENETİM İZİ LOGLARI -->
                @if (!Model.IsAltKullanici || u.IzinDenetimIzi)
                {
                    <div class="tab-pane-content" id="tab-guvenlik-loglari" style="display: none;">
                        <div class="row g-3">
                            <!-- İŞLEM DEĞİŞİKLİK DENETİM İZİ -->
                            <div class="col-lg-7">
                                <div class="b2b-card p-4 h-100">
                                    <div class="mb-3 pb-2 border-bottom">
                                        <h5 class="fw-bold mb-0"><i class="bi bi-list-check me-1 text-primary"></i> İşlem &amp; Değişiklik Denetim İzi (Audit Log)</h5>
                                        <small class="text-secondary">Bayi hesabınızda ne zaman, hangi bilgisayar üzerinden neyin değiştiği saniyesi saniyesine kayıt altındadır.</small>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-custom mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Saat &amp; Tarih</th>
                                                    <th>İşlem Türü</th>
                                                    <th>Hangi Bilgisayar &amp; IP</th>
                                                    <th>Değişiklik Özeti</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var log in Model.IslemLoglari)
                                                {
                                                    <tr>
                                                        <td style="white-space: nowrap;">
                                                            <div class="fw-bold small">@log.Zaman.ToString("dd.MM.yyyy HH:mm:ss")</div>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-primary bg-opacity-10 text-primary border small fw-bold">@log.IslemTuru</span>
                                                        </td>
                                                        <td>
                                                            <div class="small fw-semibold"><i class="bi bi-display text-info me-1"></i>@log.BilgisayarCihaz</div>
                                                            <div class="small text-muted font-monospace" style="font-size: 0.7rem;">IP: @log.IpAdresi</div>
                                                        </td>
                                                        <td>
                                                            <div class="small" style="max-width: 280px;">@log.Detay</div>
                                                            @if (!string.IsNullOrEmpty(log.YeniDeger))
                                                            {
                                                                <div class="small text-success font-monospace" style="font-size: 0.7rem;">@log.YeniDeger</div>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- GİRİŞ VE OTURUM GEÇMİŞİ -->
                            <div class="col-lg-5">
                                <div class="b2b-card p-4 h-100">
                                    <div class="mb-3 pb-2 border-bottom">
                                        <h5 class="fw-bold mb-0"><i class="bi bi-shield-lock me-1 text-success"></i> Giriş ve Oturum Logları</h5>
                                        <small class="text-secondary">Hesabınıza yapılan tüm başarılı ve başarısız giriş denemeleri.</small>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-custom mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Giriş Saati</th>
                                                    <th>Bağlanan Bilgisayar</th>
                                                    <th>IP Adresi</th>
                                                    <th class="text-end">Durum</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var g in Model.GirisLoglari)
                                                {
                                                    <tr>
                                                        <td class="small fw-bold">@g.Zaman.ToString("dd.MM.yyyy HH:mm")</td>
                                                        <td>
                                                            <div class="small fw-semibold"><i class="bi bi-laptop me-1 text-primary"></i>@g.BilgisayarCihaz</div>
                                                        </td>
                                                        <td class="font-monospace small text-muted">@g.IpAdresi</td>
                                                        <td class="text-end">
                                                            <span class="badge @(g.Basarili ? "bg-success" : "bg-danger") bg-opacity-10 text-@(g.Basarili ? "success" : "danger") border rounded-pill px-2.5 py-1 small">
                                                                @(g.Basarili ? "Başarılı" : "Hatalı")
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================================= -->
                <!-- 6. YENİ TAB 1: SİZE ÖZEL KAMPANYALAR                      -->
                <!-- ========================================================= -->
                <div class="tab-pane-content" id="tab-ozel-kampanyalar" style="display: none;">
                    <div class="b2b-card p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(234, 67, 53, 0.12); color: #ea4335; font-weight: 700; border: 1px solid rgba(234, 67, 53, 0.25);">
                                        <i class="bi bi-gift-fill me-1"></i> B2B Teşvik Programı
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-0.5 small">Yalnızca Firmanıza Özel</span>
                                </div>
                                <h5 class="fw-bold mb-0">Size Özel Kampanyalar &amp; B2B Avantajları</h5>
                                <small class="text-secondary">Hayat İşleri Kanal Yönetimi tarafından firmanızın alımlarına ve cirosuna özel olarak tanımlanmış ek iskonto ve hediyeli fırsatlar.</small>
                            </div>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1.5 fw-bold fs-6">
                                <i class="bi bi-clock-history me-1"></i> @Model.OzelKampanyalar.Count(k => k.GecerliMi) Aktif Fırsat
                            </span>
                        </div>

                        @if (Model.OzelKampanyalar.Count == 0)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-gift display-4 text-muted mb-3 d-block"></i>
                                <h6 class="fw-bold text-secondary">Şu anda tanımlı özel kampanyanız bulunmuyor.</h6>
                                <p class="small text-muted mb-0">Kanal yöneticiniz firmanıza özel donanım veya yazılım indirimi tanımladığında burada görüntülenecektir.</p>
                            </div>
                        }
                        else
                        {
                            <div class="row g-3">
                                @foreach (var k in Model.OzelKampanyalar)
                                {
                                    <div class="col-lg-6">
                                        <div class="p-3.5 rounded-4 border h-100 d-flex flex-column justify-content-between position-relative overflow-hidden" style="background: var(--b2b-bg); border-left: 4px solid @(k.Kategori == "Donanım" ? "#1a73e8" : "#34a853") !important;">
                                            <div>
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background: @(k.Kategori == "Donanım" ? "rgba(66, 133, 244, 0.12)" : "rgba(52, 168, 83, 0.12)"); color: @(k.Kategori == "Donanım" ? "#1a73e8" : "#34a853"); font-weight: 700;">
                                                        <i class="bi @(k.Kategori == "Donanım" ? "bi-hdd-network" : "bi-window-stack") me-1"></i> @k.Kategori Kampanyası
                                                    </span>
                                                    @if (k.GecerliMi)
                                                    {
                                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1 fw-bold small">
                                                            <i class="bi bi-hourglass-split me-1"></i> @k.KalanGun Gün Kaldı
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-0.5 small">
                                                            Süresi Doldu
                                                        </span>
                                                    }
                                                </div>

                                                <h5 class="fw-bold mb-1" style="color: var(--b2b-text-main);">@k.Baslik</h5>
                                                <div class="small fw-semibold text-primary mb-2">
                                                    <i class="bi bi-tag-fill me-1"></i> Kapsam: @(string.IsNullOrEmpty(k.UrunGrubu) ? "Tüm Ürünler" : k.UrunGrubu)
                                                </div>
                                                <p class="small text-secondary mb-3" style="line-height: 1.55;">@k.Aciklama</p>
                                            </div>

                                            <div class="pt-3 border-top mt-2">
                                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                    <div>
                                                        @if (k.IskontoOrani > 0)
                                                        {
                                                            <div class="fs-4 fw-bold text-danger">+%@k.IskontoOrani:0.## Ek İskonto</div>
                                                        }
                                                        @if (k.OzelFiyatTL.HasValue && k.OzelFiyatTL > 0)
                                                        {
                                                            <div class="fw-bold text-success font-monospace fs-5">Özel Net Fiyat: @k.OzelFiyatTL.Value.ToString("N2") TL</div>
                                                        }
                                                        <small class="text-muted d-block" style="font-size: 0.72rem;">Geçerlilik: @k.BaslangicTarihi.ToString("dd.MM.yyyy") - @k.BitisTarihi.ToString("dd.MM.yyyy")</small>
                                                    </div>
                                                    <div id="kampanya-btn-box-@k.Id" class="d-flex gap-1.5 align-items-center">
                                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1.5 fw-bold"
                                                                onclick="b2bSepeteEkle('KMP-@k.Id', '@k.Baslik.Replace("'", "\\'")', '@k.Kategori', @(k.OzelFiyatTL ?? 0m))">
                                                            <i class="bi bi-cart-plus me-1"></i> Hızlı Ekle
                                                        </button>
                                                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-bold shadow-xs" style="background: #0b57d0; border: none;"
                                                                data-box="kampanya-btn-box-@k.Id"
                                                                data-id="@k.Id"
                                                                data-tur="Kampanya Talebi"
                                                                data-baslik="@k.Baslik"
                                                                data-kategori="@k.Kategori"
                                                                data-iskonto="@k.IskontoOrani"
                                                                data-ozelfiyat="@(k.OzelFiyatTL ?? 0)"
                                                                data-detay="Kapsam: @(string.IsNullOrEmpty(k.UrunGrubu) ? "Tüm Ürünler" : k.UrunGrubu) • Süre: @k.BaslangicTarihi.ToString("dd.MM.yyyy") - @k.BitisTarihi.ToString("dd.MM.yyyy")"
                                                                onclick="b2bTalepModalAc(this)">
                                                            <i class="bi bi-lightning-charge-fill me-1"></i> Yararlan
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- 7. YENİ TAB 2: GÜNCEL B2B FİYAT LİSTESİ / KATALOG          -->
                <!-- ========================================================= -->
                <div class="tab-pane-content" id="tab-fiyat-listesi" style="display: none;">
                    <div class="b2b-card p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(11, 87, 208, 0.12); color: #0b57d0; font-weight: 700; border: 1px solid rgba(11, 87, 208, 0.25);">
                                        <i class="bi bi-tag-fill me-1"></i> Dinamik B2B Donanım Kataloğu
                                    </span>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-0.5 fw-bold">
                                        Bayi İskontonuz: %@iskonto
                                    </span>
                                </div>
                                <h5 class="fw-bold mb-0">Güncel B2B Donanım Fiyat Listesi &amp; Ürün Kataloğu</h5>
                                <small class="text-secondary">Fiyatlar bayilik iskonto oranınız (%@iskonto) üzerinden anlık olarak hesaplanmıştır. Tavsiye edilen son kullanıcı satış ve net alış fiyatları listelenmektedir.</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 py-2 fw-semibold" onclick="exportTableToCsv('tableB2BFiyatListesi', 'Hayat_Isleri_B2B_Donanim_Fiyat_Listesi.csv')">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Excel Olarak İndir
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-semibold" onclick="window.print()">
                                    <i class="bi bi-printer me-1"></i> Yazdır / PDF
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-custom mb-0" id="tableB2BFiyatListesi">
                                <thead>
                                    <tr>
                                        <th>Ürün Kodu</th>
                                        <th>Marka</th>
                                        <th>Ürün &amp; Model Adı</th>
                                        <th>Kategori</th>
                                        <th class="text-end">Tavsiye Satış (TL)</th>
                                        <th class="text-center">İskonto</th>
                                        <th class="text-end">Bayi Alış Fiyatı (TL)</th>
                                        <th>Depo Durumu</th>
                                        <th>Garanti</th>
                                        <th class="text-end">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.B2BFiyatListesi)
                                    {
                                        <tr>
                                            <td class="font-monospace fw-bold text-primary">@item.UrunKodu</td>
                                            <td>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border fw-bold">@item.Marka</span>
                                            </td>
                                            <td>
                                                <div class="fw-bold" style="color: var(--b2b-text-main);">@item.UrunAdi</div>
                                            </td>
                                            <td><small class="text-secondary">@item.Kategori</small></td>
                                            <td class="text-end text-muted font-monospace"><del>@item.TavsiyeEdilenSatisTL.ToString("N2") ₺</del></td>
                                            <td class="text-center">
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-0.5 fw-bold">
                                                    %@item.BayiIskontoOrani:0.##
                                                </span>
                                            </td>
                                            <td class="text-end fw-bold text-primary font-monospace fs-6">@item.BayiAlisFiyatiTL.ToString("N2") ₺</td>
                                            <td>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 fw-bold">
                                                    <i class="bi bi-check-circle-fill me-1"></i> @item.StokDurumu
                                                </span>
                                            </td>
                                            <td><small class="text-secondary">@item.GarantiSuresi</small></td>
                                            <td class="text-end">
                                                <div id="donanim-btn-box-@item.UrunKodu" class="d-flex gap-1.5 justify-content-end align-items-center">
                                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fw-bold"
                                                            onclick="b2bSepeteEkle('@item.UrunKodu', '@item.UrunAdi.Replace("'", "\\'")', '@item.Kategori', @item.BayiAlisFiyatiTL)">
                                                        <i class="bi bi-cart-plus me-1"></i> Hızlı Ekle
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-primary rounded-pill px-2.5 py-1 fw-bold shadow-xs" style="background: #0b57d0; border: none;"
                                                            data-box="donanim-btn-box-@item.UrunKodu"
                                                            data-id="@item.UrunKodu"
                                                            data-tur="Donanım Siparişi"
                                                            data-baslik="@item.UrunAdi"
                                                            data-kategori="@item.Kategori"
                                                            data-iskonto="@item.BayiIskontoOrani"
                                                            data-ozelfiyat="@item.BayiAlisFiyatiTL"
                                                            data-detay="Ürün Kodu: @item.UrunKodu • Garanti: @item.GarantiSuresi • @item.StokDurumu"
                                                            onclick="b2bTalepModalAc(this)">
                                                        Sipariş
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- 8. YENİ TAB 3: DUYURULAR VE BİLDİRİMLER (DAHİLİ İLETİŞİM) -->
                <!-- ========================================================= -->
                <div class="tab-pane-content" id="tab-duyurular" style="display: none;">
                    <div class="b2b-card p-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(245, 158, 11, 0.12); color: #d97706; font-weight: 700; border: 1px solid rgba(245, 158, 11, 0.25);">
                                        <i class="bi bi-megaphone-fill me-1"></i> Dahili İletişim Panosu
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-0.5 small">Merkez &bull; Bayi Bilgi Hattı</span>
                                </div>
                                <h5 class="fw-bold mb-0">Duyurular, Kampanyalar &amp; Operasyonel Bildirimler</h5>
                                <small class="text-secondary">Hayat İşleri merkez yönetiminden yeni ürün girişleri, tatil kargo takvimleri ve sistem bakım bildirimleri.</small>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1.5 fw-bold">
                                @Model.Duyurular.Count Yeni Bildirim
                            </span>
                        </div>

                        <div class="row g-3">
                            @foreach (var d in Model.Duyurular)
                            {
                                <div class="col-12">
                                    <div class="p-3.5 rounded-4 border" style="background: var(--b2b-bg);">
                                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="p-2 rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: @(d.Oncelik == "Acil" ? "#ea4335" : (d.Oncelik == "Önemli" ? "#0b57d0" : "#34a853"));">
                                                    <i class="bi @(d.Ikon ?? "bi-megaphone") fs-6"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-0" style="color: var(--b2b-text-main);">@d.Baslik</h6>
                                                    <small class="text-secondary">@d.Kategori &bull; @d.Tarih.ToString("dd MMMM yyyy HH:mm")</small>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @(d.Oncelik == "Acil" ? "bg-danger" : (d.Oncelik == "Önemli" ? "bg-primary" : "bg-secondary")) rounded-pill px-2.5 py-1">
                                                    @d.Rozet
                                                </span>
                                            </div>
                                        </div>
                                        <p class="small text-secondary mb-0 ms-md-5 ps-md-2" style="line-height: 1.6;">
                                            @d.Icerik
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- ========================================================= -->
                <!-- 9. YENİ TAB 4: SİPARİŞ GEÇMİŞİ VE E-FATURA ARŞİVİ          -->
                <!-- ========================================================= -->
                @if (!Model.IsAltKullanici || u.IzinSiparisVeSarf)
                {
                    <div class="tab-pane-content" id="tab-siparis-gecmisi" style="display: none;">
                        <div class="b2b-card p-4">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(16, 185, 129, 0.12); color: #10b981; font-weight: 700; border: 1px solid rgba(16, 185, 129, 0.25);">
                                            <i class="bi bi-receipt-cutoff me-1"></i> B2B E-Fatura &amp; Lojistik Arşivi
                                        </span>
                                    </div>
                                    <h5 class="fw-bold mb-0">Sipariş Geçmişi &amp; E-Fatura Arşivi</h5>
                                    <small class="text-secondary">Geçmiş donanım, sarf malzeme ve lisans siparişlerinizin kargo durumları ve GİB onaylı e-fatura PDF dökümleri.</small>
                                </div>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-3 py-1.5 fw-bold">
                                    Toplam @Model.SiparisGecmisi.Count Sipariş Kaydı
                                </span>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-custom mb-0">
                                    <thead>
                                        <tr>
                                            <th>Sipariş No</th>
                                            <th>Sipariş Tarihi</th>
                                            <th>Sipariş Türü</th>
                                            <th>Sipariş Kalemleri / Özeti</th>
                                            <th class="text-end">Tutar (TL)</th>
                                            <th>Sipariş Durumu</th>
                                            <th>Kargo &amp; Takip</th>
                                            <th>E-Fatura</th>
                                            <th class="text-end">İşlem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in Model.SiparisGecmisi)
                                        {
                                            <tr>
                                                <td class="font-monospace fw-bold text-primary">@s.SiparisNo</td>
                                                <td class="small fw-semibold">@s.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                                <td>
                                                    <span class="badge bg-light text-dark border small">@s.SiparisTuru</span>
                                                </td>
                                                <td>
                                                    <div class="small fw-semibold" style="max-width: 280px;">@s.UrunOzet</div>
                                                    <small class="text-secondary">(@s.KalemSayisi Kalem)</small>
                                                </td>
                                                <td class="text-end fw-bold font-monospace fs-6 text-primary">@s.TutarTL.ToString("N2") ₺</td>
                                                <td>
                                                    @if (s.Durum == "Tamamlandı")
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                                            <i class="bi bi-check2-all me-1"></i> Tamamlandı
                                                        </span>
                                                    }
                                                    else if (s.Durum == "Kargoya Verildi")
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1">
                                                            <i class="bi bi-truck me-1"></i> Kargoya Verildi
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2.5 py-1">
                                                            @s.Durum
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(s.KargoTakipNo))
                                                    {
                                                        <div class="small fw-bold"><i class="bi bi-box-seam me-1 text-primary"></i>@s.KargoFirmasi</div>
                                                        <span class="font-monospace text-secondary small">@s.KargoTakipNo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(s.FaturaNo))
                                                    {
                                                        <div class="small fw-bold font-monospace text-secondary">@s.FaturaNo</div>
                                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2 py-0.5 small">
                                                            GİB e-Fatura
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Hazırlanıyor</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <a href="/Bayi/FaturaPdfIndir?faturaNo=@s.FaturaNo&siparisNo=@s.SiparisNo" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fw-bold" target="_blank">
                                                        <i class="bi bi-file-earmark-pdf-fill me-1 text-danger"></i> PDF Fatura
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================================= -->
                <!-- 10. YENİ TAB 5: GENEL DESTEK / YARDIM MASASI (TİCKET)     -->
                <!-- ========================================================= -->
                <div class="tab-pane-content" id="tab-genel-destek" style="display: none;">
                    <div class="b2b-card p-4">
                        <!-- Üst Başlık ve Yeni Talep Butonu -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(11, 87, 208, 0.10); color: #0b57d0; font-weight: 700; border: 1px solid rgba(11, 87, 208, 0.22);">
                                        <i class="bi bi-headset me-1"></i> B2B Yardım Masası (Helpdesk)
                                    </span>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-0.5 small">Öncelikli Bayi Desteği</span>
                                </div>
                                <h5 class="fw-bold mb-1" style="color: var(--b2b-text-main);">Destek Taleplerim (Ticket Sistemi)</h5>
                                <small class="text-secondary">Sipariş eksikliği, sanal POS/ödeme aksamaları, e-fatura düzeltmeleri ve idari talepleriniz için doğrudan merkez destek masasıyla yazışın.</small>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="https://wa.me/905010146623?text=@Html.Raw(Uri.EscapeDataString($"Merhaba, {Model.Kullanici?.FirmaAdi ?? "Bayi"} olarak yetkili yardım masası / destek hattı ile görüşmek istiyoruz."))" target="_blank" class="btn btn-sm rounded-pill px-3.5 py-2 fw-bold text-white shadow-xs d-inline-flex align-items-center gap-1.5" style="background: #25D366; border: none;">
                                    <i class="bi bi-whatsapp fs-6"></i>
                                    <span>WhatsApp Destek Hattı</span>
                                </a>
                                <button type="button" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background: #0b57d0; border: none;" data-bs-toggle="modal" data-bs-target="#modalGenelDestek">
                                    <i class="bi bi-plus-circle-fill"></i>
                                    <span>Yeni Destek Talebi Aç</span>
                                </button>
                            </div>
                        </div>

                        <!-- 4'lü KPI Özet Kartları -->
                        <div class="row g-3 mb-4">
                            <div class="col-6 col-lg-3">
                                <div class="p-3.5 rounded-4 border h-100 shadow-xs" style="background: var(--b2b-bg);">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">Toplam Talep</small>
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(11, 87, 208, 0.12); color: #0b57d0;">
                                            <i class="bi bi-ticket-detailed-fill"></i>
                                        </div>
                                    </div>
                                    <h3 class="fw-bold mb-0 text-primary">@Model.DestekTalepleri.Count</h3>
                                    <small class="text-secondary" style="font-size: 0.72rem;">Kayıtlı destek geçmişi</small>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="p-3.5 rounded-4 border h-100 shadow-xs" style="background: var(--b2b-bg);">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">İnceleniyor (Açık)</small>
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(234, 134, 0, 0.12); color: #ea8600;">
                                            <i class="bi bi-clock-history"></i>
                                        </div>
                                    </div>
                                    <h3 class="fw-bold mb-0 text-warning">@Model.DestekTalepleri.Count(x => x.Durum != "Çözüldü")</h3>
                                    <small class="text-warning fw-semibold" style="font-size: 0.72rem;">Uzman incelemesinde</small>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="p-3.5 rounded-4 border h-100 shadow-xs" style="background: var(--b2b-bg);">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">Çözümlenen</small>
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(52, 168, 83, 0.12); color: #34a853;">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>
                                    <h3 class="fw-bold mb-0 text-success">@Model.DestekTalepleri.Count(x => x.Durum == "Çözüldü")</h3>
                                    <small class="text-success fw-semibold" style="font-size: 0.72rem;">Başarıyla sonuçlandı</small>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="p-3.5 rounded-4 border h-100 shadow-xs" style="background: var(--b2b-bg);">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <small class="text-secondary fw-semibold">Ort. Yanıt Hızı</small>
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; background: rgba(147, 51, 234, 0.12); color: #9333ea;">
                                            <i class="bi bi-lightning-charge-fill"></i>
                                        </div>
                                    </div>
                                    <h3 class="fw-bold mb-0" style="color: #9333ea;">< 20 Dk</h3>
                                    <small class="text-secondary" style="font-size: 0.72rem;">B2B VIP SLA süresi</small>
                                </div>
                            </div>
                        </div>

                        <!-- Filtreleme Butonları & Canlı Arama Çubuğu -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                            <div class="btn-group p-1 rounded-pill border shadow-2xs" style="background: var(--b2b-bg);" role="group">
                                <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold destek-filter-btn active btn-primary" onclick="filterDestekTalepleri('all', this)" style="border: none;">
                                    Tümü (@Model.DestekTalepleri.Count)
                                </button>
                                <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold destek-filter-btn btn-light text-secondary" onclick="filterDestekTalepleri('acik', this)" style="border: none;">
                                    <i class="bi bi-circle-fill text-warning me-1" style="font-size: 0.5rem;"></i>İşlemde (@Model.DestekTalepleri.Count(x => x.Durum != "Çözüldü"))
                                </button>
                                <button type="button" class="btn btn-sm rounded-pill px-3 fw-bold destek-filter-btn btn-light text-secondary" onclick="filterDestekTalepleri('cozuldu', this)" style="border: none;">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>Çözülenler (@Model.DestekTalepleri.Count(x => x.Durum == "Çözüldü"))
                                </button>
                            </div>
                            <div class="position-relative" style="min-width: 260px;">
                                <input type="text" class="form-control form-control-sm rounded-pill ps-4" placeholder="Ticket No, konu veya departman ara..." oninput="searchDestekTalepleri(this.value)" style="background: var(--b2b-bg);" />
                                <i class="bi bi-search position-absolute text-secondary" style="left: 12px; top: 50%; transform: translateY(-50%); font-size: 0.8rem;"></i>
                            </div>
                        </div>

                        <!-- Göze Hitap Eden Modern B2B Ticket Tablosu -->
                        <div class="table-responsive rounded-4 border overflow-hidden shadow-xs">
                            <table class="table table-hover align-middle mb-0" id="destekTalepleriTable">
                                <thead style="background: var(--b2b-bg);">
                                    <tr class="small text-uppercase text-secondary border-bottom">
                                        <th style="padding: 1rem;">Ticket ID &bull; Tarih</th>
                                        <th style="padding: 1rem;">Talep Konusu &amp; Departman</th>
                                        <th style="padding: 1rem;">Öncelik</th>
                                        <th style="padding: 1rem;">Durum</th>
                                        <th style="padding: 1rem;">Son Yanıt Durumu</th>
                                        <th class="text-end" style="padding: 1rem;">İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.DestekTalepleri)
                                    {
                                        var isCozuldu = t.Durum == "Çözüldü";
                                        <tr data-durum="@t.Durum" style="transition: background-color 0.15s ease;">
                                            <td style="padding: 0.95rem 1rem;">
                                                <div class="font-monospace fw-bold text-primary mb-0.5">@t.TicketNo</div>
                                                <small class="text-secondary" style="font-size: 0.74rem;">@t.OlusturmaZamani.ToString("dd.MM.yyyy HH:mm")</small>
                                            </td>
                                            <td style="padding: 0.95rem 1rem;">
                                                <div class="fw-bold mb-1" style="color: var(--b2b-text-main); font-size: 0.92rem;">@t.Baslik</div>
                                                <div class="d-flex align-items-center gap-1.5">
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                                        <i class="bi bi-tag me-1"></i>@t.Modul
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(t.DosyaEki))
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">
                                                            <i class="bi bi-paperclip me-1"></i>Ekli Belge
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td style="padding: 0.95rem 1rem;">
                                                @if (t.Oncelik == "Yüksek" || t.Oncelik == "Acil")
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(234, 67, 53, 0.12); color: #ea4335; border: 1px solid rgba(234, 67, 53, 0.28); font-size: 0.75rem; font-weight: 700;">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>@t.Oncelik
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(11, 87, 208, 0.08); color: #0b57d0; border: 1px solid rgba(11, 87, 208, 0.20); font-size: 0.75rem; font-weight: 600;">
                                                        @t.Oncelik
                                                    </span>
                                                }
                                            </td>
                                            <td style="padding: 0.95rem 1rem;">
                                                @if (isCozuldu)
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(52, 168, 83, 0.12); color: #34a853; border: 1px solid rgba(52, 168, 83, 0.30); font-size: 0.75rem; font-weight: 700;">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Çözüldü
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(234, 134, 0, 0.12); color: #ea8600; border: 1px solid rgba(234, 134, 0, 0.30); font-size: 0.75rem; font-weight: 700;">
                                                        <i class="bi bi-clock-history me-1"></i>İnceleniyor
                                                    </span>
                                                }
                                            </td>
                                            <td style="padding: 0.95rem 1rem; max-width: 280px;">
                                                @if (!string.IsNullOrEmpty(t.SonCevap))
                                                {
                                                    <div class="d-flex align-items-start gap-1.5">
                                                        <i class="bi bi-chat-dots-fill text-primary flex-shrink-0 mt-0.5" style="font-size: 0.85rem;"></i>
                                                        <div class="text-truncate small" style="color: var(--b2b-text-main);" title="@t.SonCevap">
                                                            @t.SonCevap
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <small class="text-secondary fst-italic">Yetkili incelemesi bekleniyor...</small>
                                                }
                                            </td>
                                            <td class="text-end" style="padding: 0.95rem 1rem;">
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-bold d-inline-flex align-items-center gap-1.5"
                                                        onclick="openTicketDetailModal('@t.TicketNo', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(t.Baslik))', '@t.Modul', '@t.Durum', '@t.Oncelik', '@t.OlusturmaZamani.ToString("dd.MM.yyyy HH:mm")', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(t.Mesaj ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(t.SonCevap ?? ""))', '@(t.DosyaEki ?? "")')">
                                                    <i class="bi bi-eye-fill"></i>
                                                    <span>Detayı Gör</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- ========================================================================= -->
    <!-- MODALLAR (RMA, Alt Kullanıcı, Proje, Demo, Destek, Eşleştirme, MDF vb.)   -->
    <!-- ========================================================================= -->
    <!-- Modal 1: RMA Talebi -->
    <div class="modal fade" id="modalYeniRma" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form asp-controller="Bayi" asp-action="YeniRmaTalebi" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-bottom">
                        <h5 class="modal-title fw-bold"><i class="bi bi-tools text-primary me-2"></i>Yeni RMA Teknik Servis Talebi</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="small fw-bold text-secondary mb-1">Cihaz Modeli:</label>
                            <input type="text" name="modelAdi" id="rmaModalModel" class="form-control" placeholder="Örn: Zebra ZT411 Barkod Yazıcı" required />
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold text-secondary mb-1">Cihaz Seri Numarası (SN):</label>
                            <input type="text" name="seriNo" id="rmaModalSn" class="form-control font-monospace" placeholder="Örn: ZB-90214-TR" required />
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold text-secondary mb-1">Arıza Detayı &amp; Açıklama:</label>
                            <textarea name="arizaDetayi" class="form-control" rows="3" placeholder="Örn: Termal kafa üzerinde çizgi çıkıyor, kafa değişimi gerekiyor." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" style="background: #0b57d0; border: none;">RMA Talebi Oluştur</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal 2: Yeni Alt Kullanıcı Tanımlama & İzin Matrisi -->
    @if (!Model.IsAltKullanici)
    {
        <div class="modal fade" id="modalSubUser" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow-lg" style="background: var(--b2b-card-bg);">
                    <form asp-controller="Bayi" asp-action="YeniAltKullanici" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header border-bottom p-3.5">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                                    <i class="bi bi-person-plus-fill fs-5"></i>
                                </span>
                                <div>
                                    <h5 class="modal-title fw-bold mb-0" style="color: var(--b2b-text-main);">Yeni Alt Kullanıcı (Personel) Tanımla</h5>
                                    <small class="text-secondary">Şirket personelinize özel giriş ve granüler modül yetkilendirmesi</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                        </div>
                        <div class="modal-body p-4">
                            <!-- Bilgi Rozeti -->
                            <div class="p-3 rounded-3 mb-3 d-flex align-items-start gap-2.5" style="background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.2);">
                                <i class="bi bi-shield-lock-fill text-info fs-5 flex-shrink-0 mt-0.5"></i>
                                <div class="small text-secondary" style="line-height: 1.5;">
                                    Belirlediğiniz kullanıcı şifresi <strong>AES-256 standardıyla</strong> şifrelenerek genel merkez sistemine kaydedilir. Personeliniz şifresini unuttuğunda genel merkez doğrulanmış yetkilinize şifreyi güvenle iletebilir.
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="small fw-bold text-secondary mb-1">Personel Adı Soyadı:</label>
                                    <input type="text" name="adSoyad" class="form-control" placeholder="Örn: Zeynep Aksoy" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="small fw-bold text-secondary mb-1">Kurumsal / Giriş E-Postası:</label>
                                    <input type="email" name="eposta" class="form-control" placeholder="zeynep@bayifirma.com" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="small fw-bold text-secondary mb-1">İletişim / Cep Telefonu:</label>
                                    <input type="tel" name="telefon" class="form-control" placeholder="0532 000 00 00" />
                                </div>
                                <div class="col-md-6">
                                    <label class="small fw-bold text-secondary mb-1">Görev / Departman (Unvan):</label>
                                    <input type="text" name="unvan" class="form-control" placeholder="Örn: Muhasebe Sorumlusu / Saha Teknisyeni" value="Personel" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="small fw-bold text-secondary mb-1">Giriş Şifresi Belirleyin (En az 6 karakter):</label>
                                <div class="input-group">
                                    <input type="password" name="sifre" id="subUserPasswordInput" class="form-control font-monospace" placeholder="••••••••" minlength="6" required />
                                    <button type="button" class="btn btn-outline-secondary" onclick="toggleSubUserPasswordVisibility()">
                                        <i class="bi bi-eye" id="subUserPassEyeIcon"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-primary fw-semibold" onclick="generateRandomSubUserPassword()">
                                        <i class="bi bi-magic me-1"></i> Rastgele Üret
                                    </button>
                                </div>
                                <small class="text-muted" style="font-size: 0.72rem;">Bu şifre personelin bayii portalınıza giriş yapacağı şifredir.</small>
                            </div>

                            <!-- Granüler Modül Yetki Matrisi -->
                            <div class="border rounded-4 p-3.5" style="background: var(--b2b-bg);">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-toggles2 text-primary me-1.5"></i> Modül Erişim &amp; İzin Matrisi</h6>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-0.5 small">Özel İzinler</span>
                                </div>
                                <p class="small text-secondary mb-3" style="font-size: 0.78rem;">
                                    Alt kullanıcının menüsünde görmesini istediğiniz sekmeleri işaretleyin. İşaretlenmeyen finans, sipariş veya denetim sekmeleri personelin menüsünde <strong>kesinlikle görünmeyecek</strong> ve erişimi engellenecektir.
                                </p>

                                <div class="row g-2">
                                    <!-- Hassas / Varsayılan Kapalı Modüller -->
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinFinans" value="true" id="permFinans">
                                            <label class="form-check-label small fw-bold text-danger d-block" for="permFinans">
                                                <i class="bi bi-wallet2 me-1"></i> Cari Bakiye &amp; 3D Sanal POS
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Cari borç, fatura ekstresi ve kartla ödeme yapabilme izni</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinSiparis" value="true" id="permSiparis">
                                            <label class="form-check-label small fw-bold text-primary d-block" for="permSiparis">
                                                <i class="bi bi-cart3 me-1"></i> Sipariş Verme &amp; Sepet Satın Alımı
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Sarf malzeme ve donanım satın alma yetkisi</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinDenetim" value="true" id="permDenetim">
                                            <label class="form-check-label small fw-bold text-warning d-block" for="permDenetim">
                                                <i class="bi bi-shield-lock-fill me-1"></i> Giriş &amp; İşlem Denetim İzi (Audit)
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Diğer personellerin giriş IP ve operasyon loglarını görme</span>
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Operasyonel / Standart Açık Modüller -->
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinTeknikServis" value="true" id="permRma" checked>
                                            <label class="form-check-label small fw-semibold text-dark d-block" for="permRma">
                                                <i class="bi bi-tools me-1 text-primary"></i> RMA (Teknik Servis) Talepleri
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Arızalı cihaz gönderme ve servis takibi</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinDestek" value="true" id="permDestek" checked>
                                            <label class="form-check-label small fw-semibold text-dark d-block" for="permDestek">
                                                <i class="bi bi-headset me-1 text-success"></i> Destek Masası (Ticket Sistemi)
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Merkez ekibiyle destek yazışmaları yapabilme</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinFiyat" value="true" id="permFiyat" checked>
                                            <label class="form-check-label small fw-semibold text-dark d-block" for="permFiyat">
                                                <i class="bi bi-table me-1 text-info"></i> B2B Fiyat Listesi &amp; Katalog
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">İskontolu donanım ve ürün listesini inceleme</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinDriver" value="true" id="permDriver" checked>
                                            <label class="form-check-label small fw-semibold text-dark d-block" for="permDriver">
                                                <i class="bi bi-download me-1 text-secondary"></i> Sürücü (Driver) &amp; SDK Kütüphanesi
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Yazıcı ve POS sürücü dosyalarını indirme</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check p-2.5 rounded-3 border bg-white mb-2">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="izinProje" value="true" id="permProje" checked>
                                            <label class="form-check-label small fw-semibold text-dark d-block" for="permProje">
                                                <i class="bi bi-briefcase me-1 text-primary"></i> Proje &amp; Fırsat Fiyat Koruması
                                                <span class="d-block fw-normal text-muted" style="font-size: 0.7rem;">Saha projelerini kaydetme</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top p-3 bg-light">
                            <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" style="background: #0284c7; border: none;">
                                <i class="bi bi-check2-circle me-1"></i> Alt Kullanıcıyı Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Modal 3: Fırsat Proje Kaydı -->
