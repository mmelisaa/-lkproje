                <div class="d-flex flex-column gap-2">
                    <a id="btnDekontPdfIndir" href="#" target="_blank" class="btn btn-outline-danger rounded-pill py-2.5 fw-bold d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i> Resmi 3D Secure Dekontu İndir (PDF)
                    </a>
                    <a id="btnDekontWhatsApp" href="#" target="_blank" class="btn rounded-pill py-2.5 fw-bold text-white d-flex align-items-center justify-content-center gap-2" style="background: #25D366; border: none;">
                        <i class="bi bi-whatsapp fs-5"></i> WhatsApp ile Muhasebeye Dekont İlet
                    </a>
                    <button type="button" class="btn btn-light rounded-pill py-2 fw-semibold text-secondary" data-bs-dismiss="modal" onclick="location.reload()">
