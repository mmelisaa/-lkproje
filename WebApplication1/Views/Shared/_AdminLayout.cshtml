<!-- Scripts -->
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Akordeon Menü Aç / Kapat Fonksiyonu
    function toggleAdminGroup(groupId) {
        const group = document.getElementById(groupId);
        if (!group) return;
        const isOpen = group.classList.contains('open');
        group.classList.toggle('open', !isOpen);
    }

    (function () {
        // Tema Yönetimi (Modern Ekru Açık vs. Obsidyen Koyu)
        const root = document.documentElement;
        const toggleBtn = document.getElementById('adminThemeToggle');
        const themeIcon = document.getElementById('adminThemeIcon');
        const themeText = document.getElementById('adminThemeText');
        const savedTheme = localStorage.getItem('hayat_admin_theme') || 'light';

        function applyTheme(theme) {
            root.setAttribute('data-theme', theme);
            if (theme === 'dark') {
                themeIcon.className = 'bi bi-moon-stars-fill text-info';
                themeText.innerText = 'Koyu Tema';
            } else {
                themeIcon.className = 'bi bi-sun-fill text-warning';
                themeText.innerText = 'Ekru Tema';
            }
            localStorage.setItem('hayat_admin_theme', theme);
        }

        applyTheme(savedTheme);

        if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
                const current = root.getAttribute('data-theme') || 'light';
                applyTheme(current === 'light' ? 'dark' : 'light');
            });
        }

        // Aktif Alt Menünün Üst Grubunu Otomatik Aç
        const activeSublink = document.querySelector('.admin-sublink.active');
        if (activeSublink) {
            const parentGroup = activeSublink.closest('.admin-menu-group');
            if (parentGroup) {
                parentGroup.classList.add('open');
                const toggle = parentGroup.querySelector('.admin-group-toggle');
                if (toggle) toggle.classList.add('active-parent');
            }
        }

        // Sidebar Arama Filtresi (Menülerde anlık süzme)
        const filterInput = document.getElementById('adminMenuFilterInput');
        if (filterInput) {
            filterInput.addEventListener('input', function (e) {
                const term = e.target.value.toLowerCase().trim();
                const groups = document.querySelectorAll('.admin-menu-group');

                if (!term) {
                    groups.forEach(g => {
                        g.style.display = '';
                        const sublinks = g.querySelectorAll('.admin-sublink');
                        sublinks.forEach(s => s.style.display = '');
                        if (!g.querySelector('.admin-sublink.active')) {
                            g.classList.remove('open');
                        }
                    });
                    return;
                }

                groups.forEach(g => {
                    let hasMatch = false;
                    const groupTitle = g.querySelector('.admin-group-toggle')?.innerText.toLowerCase() || '';
                    const sublinks = g.querySelectorAll('.admin-sublink');

                    sublinks.forEach(s => {
                        const linkText = s.innerText.toLowerCase();
                        if (linkText.includes(term) || groupTitle.includes(term)) {
                            s.style.display = '';
                            hasMatch = true;
                        } else {
                            s.style.display = 'none';
                        }
                    });

                    if (hasMatch) {
                        g.style.display = '';
                        g.classList.add('open');
                    } else {
                        g.style.display = 'none';
                    }
                });
            });
        }

        // Mobil Menü Aç/Kapat
        const sidebar = document.getElementById('adminSidebar');
        const toggleSidebar = document.getElementById('adminSidebarToggle');
        if (toggleSidebar && sidebar) {
            toggleSidebar.addEventListener('click', () => {
                sidebar.classList.toggle('show');
            });
        }
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
<!-- HAYAT İŞLERİ GLOBAL ÇOKLU DİL (I18N) MOTORU -->
<script src="~/js/hayat-i18n.js" asp-append-version="true"></script>
</body>
