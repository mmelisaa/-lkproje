@using Microsoft.AspNetCore.Identity
@using WebApplication1.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-1">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole(Roller.Bayi))
    {
        <li class="nav-item">
            <a class="nav-link text-white-50 px-3 py-2 small fw-medium" asp-controller="Bayi" asp-action="Dashboard">Bayi Portalı</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white-50 px-3 py-2 small fw-medium" asp-controller="Admin" asp-action="Index">Yönetim Paneli</a>
        </li>
    }
    <li class="nav-item">
        <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link btn btn-link text-white-50 px-3 py-2 small fw-medium border-0">Çıkış (@User.Identity?.Name)</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-white-50 px-3 py-2 small fw-medium" asp-controller="Account" asp-action="Login">Yönetici Girişi</a>
    </li>
}
</ul>
