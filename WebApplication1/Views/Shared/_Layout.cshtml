    <!-- LUSION ATLAS MOTION AKIŞKAN İMLEÇ İZİ (Z-Index 99999 + mix-blend-mode multiply: Hero, kartlar ve footer dahil her yerde görünür; metinlerin arkasından akar) -->
    <canvas id="cursorTrailCanvas" style="position:fixed;top:0;left:0;width:100vw;height:100vh;pointer-events:none;z-index:99999;mix-blend-mode:multiply;display:none;"></canvas>
    <script>
        (function() {
            if (window.matchMedia && window.matchMedia('(hover: none)').matches) return;
            const cv = document.getElementById('cursorTrailCanvas');
            if (!cv) return;
            const ctx = cv.getContext('2d');

            let width = window.innerWidth;
            let height = window.innerHeight;

            function resize() {
                width = window.innerWidth;
                height = window.innerHeight;
                cv.width = width;
                cv.height = height;
            }
            resize();
            window.addEventListener('resize', resize, { passive: true });

            // İmleç ve Kuyruk Noktaları
            const points = [];
            const MAX_POINTS = 32;
            const TRAIL_LIFETIME = 520; // ms

            let mouseX = -100, mouseY = -100;
            let prevX = -100, prevY = -100;
            let isMoving = false;
            let animId = null;
            let lastMoveTime = 0;

            function addPoint(x, y, now) {
                points.unshift({ x: x, y: y, time: now, size: 10 });
                if (points.length > MAX_POINTS) points.pop();
            }

            window.addEventListener('mousemove', (e) => {
                const now = performance.now();
                lastMoveTime = now;
                mouseX = e.clientX;
                mouseY = e.clientY;

                if (prevX < 0) {
                    prevX = mouseX;
                    prevY = mouseY;
                    addPoint(mouseX, mouseY, now);
                } else {
                    // Hızlı hareketlerde noktalar arası boşluk kalmaması için interpolasyon
                    const dx = mouseX - prevX;
                    const dy = mouseY - prevY;
                    const dist = Math.hypot(dx, dy);
                    const steps = Math.min(6, Math.max(1, Math.floor(dist / 14)));

                    for (let i = 1; i <= steps; i++) {
                        const stepX = prevX + (dx * (i / steps));
                        const stepY = prevY + (dy * (i / steps));
                        addPoint(stepX, stepY, now);
                    }
                    prevX = mouseX;
                    prevY = mouseY;
                }

                if (!isMoving) {
                    cv.style.display = 'block';
                    isMoving = true;
                    if (!animId) animId = requestAnimationFrame(render);
                }
            }, { passive: true });

            window.addEventListener('mouseleave', () => {
                prevX = -100;
                prevY = -100;
            }, { passive: true });

            function render(now) {
                ctx.clearRect(0, 0, width, height);

                // Eski noktaları temizle
                while (points.length > 0 && (now - points[points.length - 1].time) > TRAIL_LIFETIME) {
                    points.pop();
                }

                if (points.length >= 2) {
                    // 1. Akışkan Tapered Şerit (Ribbon) Çizimi
                    for (let i = 0; i < points.length - 1; i++) {
                        const p0 = points[i];
                        const p1 = points[i + 1];
                        const progress = i / (points.length - 1); // 0 (baş) -> 1 (kuyruk sonu)
                        const age = (now - p0.time) / TRAIL_LIFETIME;
                        const alpha = Math.max(0, (1 - age) * (1 - progress * 0.75));

                        if (alpha <= 0.01) continue;

                        // Akışkan Buz Mavisi (Ice Blue) kalınlık
                        const lineWidth = Math.max(1.2, (1 - progress) * 4.2);

                        ctx.beginPath();
                        ctx.moveTo(p0.x, p0.y);
                        ctx.lineTo(p1.x, p1.y);
                        ctx.lineCap = 'round';
                        ctx.lineJoin = 'round';
                        ctx.lineWidth = lineWidth;

                        // Zarif ve net Buz Mavisi gradyanı (Multiply modu sayesinde siyah yazıları asla kapatmaz)
                        if (progress < 0.45) {
                            ctx.strokeStyle = `rgba(56, 189, 248, ${(alpha * 0.65).toFixed(3)})`;
                        } else if (progress < 0.75) {
                            ctx.strokeStyle = `rgba(14, 165, 233, ${(alpha * 0.50).toFixed(3)})`;
                        } else {
                            ctx.strokeStyle = `rgba(125, 211, 252, ${(alpha * 0.35).toFixed(3)})`;
                        }
                        ctx.stroke();
                    }

                    // 2. Şerit Boyunca İpeksi Buz Parıltısı Damlacıkları
                    const dropletStep = Math.max(2, Math.floor(points.length / 4));
                    for (let i = 0; i < points.length; i += dropletStep) {
                        const p = points[i];
                        const progress = i / points.length;
                        const age = (now - p.time) / TRAIL_LIFETIME;
                        const alpha = Math.max(0, (1 - age) * (1 - progress * 0.85));
                        const radius = Math.max(1.5, (1 - progress) * 4.2);

                        if (alpha > 0.04) {
                            const grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, radius * 1.8);
                            grad.addColorStop(0, `rgba(56, 189, 248, ${(alpha * 0.38).toFixed(3)})`);
                            grad.addColorStop(0.6, `rgba(125, 211, 252, ${(alpha * 0.18).toFixed(3)})`);
                            grad.addColorStop(1, 'rgba(224, 242, 254, 0)');

                            ctx.fillStyle = grad;
                            ctx.beginPath();
                            ctx.arc(p.x, p.y, radius * 1.8, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    }
                }

                // 3. İmleç Konumundaki Minimalist İçi Boş Buz Mavisi Halka (Yazıları kesinlikle örtmez)
                if (mouseX > 0 && mouseY > 0 && (now - lastMoveTime) < 1200) {
                    const focusAlpha = Math.max(0, 1 - (now - lastMoveTime) / 1200);

                    // Zarif dış parlama
                    const glowGrad = ctx.createRadialGradient(mouseX, mouseY, 0, mouseX, mouseY, 12);
                    glowGrad.addColorStop(0, `rgba(56, 189, 248, ${(focusAlpha * 0.25).toFixed(3)})`);
                    glowGrad.addColorStop(1, 'rgba(56, 189, 248, 0)');
                    ctx.fillStyle = glowGrad;
                    ctx.beginPath();
                    ctx.arc(mouseX, mouseY, 12, 0, Math.PI * 2);
                    ctx.fill();

                    // İnce dış halka (İçi boş, harflerin üstünden akarken harf görünür kalır)
                    ctx.beginPath();
                    ctx.arc(mouseX, mouseY, 4.5, 0, Math.PI * 2);
                    ctx.strokeStyle = `rgba(56, 189, 248, ${(focusAlpha * 0.55).toFixed(3)})`;
                    ctx.lineWidth = 1.2;
                    ctx.stroke();
                }

                // Hareketsiz kalındığında ve iz söndüğünde döngüyü durdur (Sıfır CPU tüketimi)
                if (points.length === 0 && (now - lastMoveTime) >= 1400) {
                    ctx.clearRect(0, 0, width, height);
                    cv.style.display = 'none';
                    isMoving = false;
                    animId = null;
                } else {
                    animId = requestAnimationFrame(render);
                }
            }
        })();
    </script>

    <!-- Lusion Menü Çekmecesi Açma/Kapatma Scripti -->
    <script>
        (function() {
            const openBtn = document.getElementById('lusionMenuOpenBtn');
            const closeBtn = document.getElementById('lusionMenuCloseBtn');
            const drawer = document.getElementById('lusionMenuDrawer');
            const backdrop = document.getElementById('lusionMenuBackdrop');
            const stickyBottomBar = document.getElementById('hayatStickyBottomBar');

            function openDrawer() {
                if (drawer && backdrop) {
                    drawer.classList.add('open');
                    backdrop.classList.add('open');
                    if (stickyBottomBar) stickyBottomBar.classList.add('drawer-hidden');
                    document.body.style.overflow = 'hidden';
                    if (window.appLenis) window.appLenis.stop();
                }
            }

            function closeDrawer() {
                if (drawer && backdrop) {
                    drawer.classList.remove('open');
                    backdrop.classList.remove('open');
                    if (stickyBottomBar) stickyBottomBar.classList.remove('drawer-hidden');
                    document.body.style.overflow = '';
                    if (window.appLenis) window.appLenis.start();
                }
            }

            if (openBtn) openBtn.addEventListener('click', openDrawer);
            if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
            if (backdrop) backdrop.addEventListener('click', closeDrawer);

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeDrawer();
            });

            // Ürünler Çok Kademeli Menü Açma/Kapatma
            const urunlerTrigger = document.getElementById('drawerUrunlerTrigger');
            const urunlerToggle = document.getElementById('drawerUrunlerToggle');
            const urunlerSub = document.getElementById('drawerUrunlerSub');
            const urunlerChevron = document.getElementById('drawerUrunlerChevron');

            const markalarToggle = document.getElementById('drawerMarkalarToggle');
            const markalarList = document.getElementById('drawerMarkalarList');
            const markalarChevron = document.getElementById('drawerMarkalarChevron');

            const kategorilerToggle = document.getElementById('drawerKategorilerToggle');
            const kategorilerList = document.getElementById('drawerKategorilerList');
            const kategorilerChevron = document.getElementById('drawerKategorilerChevron');

            function toggleUrunlerSub(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                if (!urunlerSub) return;
                const isOpen = urunlerSub.style.display !== 'none';
                urunlerSub.style.display = isOpen ? 'none' : 'flex';
                if (urunlerChevron) urunlerChevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
                if (urunlerTrigger) urunlerTrigger.setAttribute('aria-expanded', !isOpen);
            }

            if (urunlerTrigger) urunlerTrigger.addEventListener('click', toggleUrunlerSub);
            if (urunlerToggle) urunlerToggle.addEventListener('click', toggleUrunlerSub);

            if (markalarToggle && markalarList) {
                markalarToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const isOpen = markalarList.style.display !== 'none';
                    markalarList.style.display = isOpen ? 'none' : 'flex';
                    if (markalarChevron) markalarChevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            }

            if (kategorilerToggle && kategorilerList) {
                kategorilerToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const isOpen = kategorilerList.style.display !== 'none';
                    kategorilerList.style.display = isOpen ? 'none' : 'flex';
                    if (kategorilerChevron) kategorilerChevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
                });
            }
        })();
    </script>

    <!-- SPLINE 3D ON/OFF TEMA ANAHTARI CONTROLLER (ON = Açık Mod, OFF = Koyu Mod) -->
    <script>
        (function () {
            const toggleBtn = document.getElementById('splineThemeToggle');
            const trailCanvas = document.getElementById('cursorTrailCanvas');

            function applyThemeState(theme) {
                const isLight = (theme !== 'dark'); // ON = Açık Mod ('light'), OFF = Koyu Mod ('dark')
                document.documentElement.setAttribute('data-theme', isLight ? 'light' : 'dark');
                if (toggleBtn) {
                    toggleBtn.setAttribute('aria-checked', isLight ? 'true' : 'false');
                    toggleBtn.setAttribute('data-state', isLight ? 'on' : 'off');
                    toggleBtn.setAttribute('title', isLight ? 'ON: Açık Mod Aktif (Koyu Mod için tıklayın)' : 'OFF: Koyu Mod Aktif (Açık Mod için tıklayın)');
                }
                if (trailCanvas) {
                    trailCanvas.style.mixBlendMode = isLight ? 'multiply' : 'screen';
                }
                window.dispatchEvent(new CustomEvent('hayat-theme-change', { detail: { theme: isLight ? 'light' : 'dark' } }));
            }

            // İlk yüklemede mevcut temayı senkronize et
            const initialTheme = document.documentElement.getAttribute('data-theme') || 'light';
            applyThemeState(initialTheme);

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
                    const nextTheme = (currentTheme === 'dark') ? 'light' : 'dark';
                    try {
                        localStorage.setItem('hayat_theme', nextTheme);
                    } catch (e) { }
                    toggleBtn.classList.add('is-pressing');
                    setTimeout(function () { toggleBtn.classList.remove('is-pressing'); }, 260);
                    applyThemeState(nextTheme);
                });

                // Spline 3D Mikro Perspektif Eğim Efekti
                toggleBtn.addEventListener('mousemove', function (e) {
                    const rect = toggleBtn.getBoundingClientRect();
                    const x = (e.clientX - rect.left) / rect.width - 0.5;
                    const y = (e.clientY - rect.top) / rect.height - 0.5;
                    toggleBtn.style.setProperty('--rx', (-y * 14).toFixed(2) + 'deg');
                    toggleBtn.style.setProperty('--ry', (x * 16).toFixed(2) + 'deg');
                });

                toggleBtn.addEventListener('mouseleave', function () {
                    toggleBtn.style.setProperty('--rx', '0deg');
                    toggleBtn.style.setProperty('--ry', '0deg');
                });
            }
        })();
    </script>

    @if (!isHomeIndex)
    {
        <!-- Three.js Kütüphanesi ve Alt Sayfalar Canlı 3D Arka Plan Motoru -->
        <script src="~/lib/three/three.min.js"></script>
        <script>
            (function() {
                const canvas = document.getElementById('lusionSubpageCanvas');
                if (!canvas || typeof THREE === 'undefined') return;

                const isDarkInit = document.documentElement.getAttribute('data-theme') === 'dark';
                const initBgHex = isDarkInit ? 0x0e1013 : 0xf8fafd;

                const scene = new THREE.Scene();
                scene.background = new THREE.Color(initBgHex);
                scene.fog = new THREE.FogExp2(initBgHex, 0.015);

                const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 1000);
                camera.position.set(0, 0, 16);

                const isMobile = window.innerWidth < 768;

                const renderer = new THREE.WebGLRenderer({
                    canvas: canvas,
                    alpha: true,
                    antialias: false,
                    powerPreference: 'high-performance'
                });
                renderer.setClearColor(initBgHex, 1);
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.0));

                const ambient = new THREE.AmbientLight(0xffffff, 2.4);
                scene.add(ambient);

                const bluePoint = new THREE.PointLight(0x0b57d0, 1.2, 40);
                bluePoint.position.set(8, 8, 8);
                scene.add(bluePoint);

                const cyanPoint = new THREE.PointLight(0x4285f4, 1.0, 35);
                cyanPoint.position.set(-8, -8, 6);
                scene.add(cyanPoint);

                const count = isMobile ? 120 : 250;
                const geo = new THREE.BufferGeometry();
                const pos = new Float32Array(count * 3);
                for (let i = 0; i < count * 3; i += 3) {
                    pos[i] = (Math.random() - 0.5) * 70;
                    pos[i + 1] = (Math.random() - 0.5) * 70;
                    pos[i + 2] = (Math.random() - 0.5) * 50;
                }
                geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
                const mat = new THREE.PointsMaterial({
                    color: isDarkInit ? 0x64748b : 0x94a3b8,
                    size: isMobile ? 0.16 : 0.12,
                    transparent: true,
                    opacity: 0.35
                });
                const points = new THREE.Points(geo, mat);
                scene.add(points);

                const crystalGroup = new THREE.Group();
                scene.add(crystalGroup);
                const crystalCount = isMobile ? 6 : 10;
                const sharedCGeo = new THREE.OctahedronGeometry(0.35, 0);
                const sharedCMat1 = new THREE.MeshLambertMaterial({
                    color: 0x4285f4,
                    wireframe: true,
                    transparent: true,
                    opacity: 0.35
                });
                const sharedCMat2 = new THREE.MeshLambertMaterial({
                    color: 0x34a853,
                    wireframe: true,
                    transparent: true,
                    opacity: 0.35
                });

                for (let i = 0; i < crystalCount; i++) {
                    const cMesh = new THREE.Mesh(sharedCGeo, i % 2 === 0 ? sharedCMat1 : sharedCMat2);
                    cMesh.position.set((Math.random() - 0.5) * 30, (Math.random() - 0.5) * 20, (Math.random() - 0.5) * 14);
                    cMesh.scale.setScalar(0.7 + Math.random() * 0.6);
                    crystalGroup.add(cMesh);
                }

                const subFlowPts = [];
                const subFlowSegments = isMobile ? 50 : 90;
                for (let i = 0; i < subFlowSegments; i++) {
                    const t = i / (subFlowSegments - 1);
                    subFlowPts.push(new THREE.Vector3(
                        Math.sin(t * Math.PI * 3.0) * 12 + Math.cos(t * Math.PI * 1.0) * 5,
                        (t - 0.5) * 50,
                        Math.cos(t * Math.PI * 2.5) * 8 + Math.sin(t * Math.PI * 0.8) * 4
                    ));
                }
                const subFlowCurve = new THREE.CatmullRomCurve3(subFlowPts);
                const subFlowGeo = new THREE.TubeGeometry(subFlowCurve, isMobile ? 60 : 90, 0.035, 4, false);
                const subFlowMat = new THREE.MeshBasicMaterial({
                    color: 0x60a5fa,
                    transparent: true,
                    opacity: 0.45
                });
                const subFlowMesh = new THREE.Mesh(subFlowGeo, subFlowMat);
                scene.add(subFlowMesh);

                window.addEventListener('hayat-theme-change', function (e) {
                    const isDark = e.detail && e.detail.theme === 'dark';
                    const bgHex = isDark ? 0x0e1013 : 0xf8fafd;
                    scene.background.setHex(bgHex);
                    scene.fog.color.setHex(bgHex);
                    renderer.setClearColor(bgHex, 1);
                    mat.color.setHex(isDark ? 0x64748b : 0x94a3b8);
                });

                let mouseX = 0, mouseY = 0;
                window.addEventListener('mousemove', (e) => {
                    mouseX = (e.clientX / window.innerWidth) * 2 - 1;
                    mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
                }, { passive: true });

                window.addEventListener('touchmove', (e) => {
                    if (e.touches && e.touches[0]) {
                        mouseX = (e.touches[0].clientX / window.innerWidth) * 2 - 1;
                        mouseY = -(e.touches[0].clientY / window.innerHeight) * 2 + 1;
                    }
                }, { passive: true });

                function onSubpageResize() {
                    const mobile = window.innerWidth < 768;
                    camera.fov = mobile ? 65 : 55;
                    camera.position.z = mobile ? 22 : 16;
                    camera.aspect = window.innerWidth / window.innerHeight;
                    camera.updateProjectionMatrix();
                    renderer.setSize(window.innerWidth, window.innerHeight);
                    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.0));
                    cachedSubMaxScroll = Math.max(1, (document.documentElement.scrollHeight || 1200) - window.innerHeight);
                }

                let cachedSubMaxScroll = 1200;
                window.addEventListener('resize', onSubpageResize, { passive: true });
                onSubpageResize();

                const clock = new THREE.Clock();
                function anim() {
                    requestAnimationFrame(anim);
                    if (document.hidden) return;
                    
                    const t = clock.getElapsedTime();
                    camera.position.x += ((mouseX * 1.5) - camera.position.x) * 0.05;
                    camera.position.y += ((-mouseY * 1.0) - camera.position.y) * 0.05;

                    cyanPoint.position.x = Math.sin(t * 0.7) * 10 + mouseX * 3;
                    cyanPoint.position.y = Math.cos(t * 0.5) * 8 - mouseY * 2;

                    points.rotation.y = t * 0.015;
                    crystalGroup.rotation.y = t * 0.02;
                    crystalGroup.rotation.x = t * 0.01;

                    const scrollY = window.appLenis ? window.appLenis.scroll : (window.scrollY || 0);
                    const scrollRatio = scrollY / cachedSubMaxScroll;
                    subFlowMesh.position.y = scrollRatio * 22 + Math.sin(t * 0.3) * 1.2;
                    subFlowMesh.rotation.y = t * 0.05 + mouseX * 0.12;
                    subFlowMesh.rotation.x = Math.sin(t * 0.2) * 0.06;

                    renderer.render(scene, camera);
                }
                anim();
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

    <!-- SPLINE 3D PRELOADER CONTROLLER -->
    <script>
        (function() {
            const preloader = document.getElementById('splinePreloader');
            if (!preloader) return;
            const startTime = Date.now();
            const minDisplayTime = 700;

            function dismissLoader() {
                const elapsed = Date.now() - startTime;
                const remaining = Math.max(0, minDisplayTime - elapsed);
                setTimeout(function() {
                    preloader.classList.add('spline-preloader-hidden');
                    setTimeout(function() {
                        if (preloader.parentNode) {
                            preloader.parentNode.removeChild(preloader);
                        }
                    }, 700);
                }, remaining);
            }

            if (document.readyState === 'complete') {
                dismissLoader();
            } else {
                window.addEventListener('load', dismissLoader);
                setTimeout(dismissLoader, 1200);
            }
            // Her ihtimale karşı (ağ gecikmesi, harici CDN vb.) en geç 1.5 saniyede kesinlikle kaldır
            setTimeout(dismissLoader, 1500);
        })();
    </script>

    <!-- KURUMSAL CANLI ARAMA ÇUBUĞU (SEARCH CONTROLLER) -->
    <script>
        (function () {
            const searchInput = document.getElementById('globalHeaderSearchInput');
            const searchWrap = document.getElementById('globalHeaderSearchWrap');
            const quickDrop = document.getElementById('globalSearchQuickDrop');
            const clearBtn = document.getElementById('globalHeaderSearchClear');

            if (searchInput && quickDrop) {
                // Focus olunca aç
                searchInput.addEventListener('focus', function () {
                    quickDrop.style.display = 'block';
                });

                // Input değişimi
                searchInput.addEventListener('input', function () {
                    if (clearBtn) {
                        clearBtn.style.display = this.value.trim().length > 0 ? 'inline-block' : 'none';
                    }
                    quickDrop.style.display = 'block';
                });

                // Temizleme butonu
                if (clearBtn) {
                    clearBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        searchInput.value = '';
                        clearBtn.style.display = 'none';
                        searchInput.focus();
                    });
                }

                // Dışarı tıklayınca kapat
                document.addEventListener('click', function (e) {
                    if (searchWrap && !searchWrap.contains(e.target)) {
                        quickDrop.style.display = 'none';
                    }
                });

                // Klavye Kısayolu (Cmd + K veya Ctrl + K)
                document.addEventListener('keydown', function (e) {
                    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
                        e.preventDefault();
                        searchInput.focus();
                        searchInput.select();
                        quickDrop.style.display = 'block';
                    }
                    if (e.key === 'Escape' && document.activeElement === searchInput) {
                        quickDrop.style.display = 'none';
                        searchInput.blur();
                    }
                });
            }
        })();
    </script>

    <!-- HAYAT İŞLERİ GLOBAL ÇOKLU DİL (I18N) MOTORU -->
    <script src="~/js/hayat-i18n.js" asp-append-version="true"></script>
