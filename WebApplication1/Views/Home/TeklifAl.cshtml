@{
    ViewData["Title"] = "Teklif Alın";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge px-3 py-2 rounded-pill small fw-bold text-uppercase mb-3 d-inline-block shadow-sm" style="background: rgba(255, 255, 255, 0.88); border: 1px solid rgba(11, 87, 208, 0.2); color: #0b57d0;">
            <i class="bi bi-rocket-takeoff-fill me-1"></i> Projenize Başlayın
        </span>
        <h1 class="fw-bold display-5 mb-3" style="letter-spacing: -1px; color: #1f1f1f;">Hızlı Teklif Formu</h1>
        <p class="fs-6 mx-auto mb-0" style="max-width: 600px; color: #444746;">
            Hayalinizdeki projeyi gerçeğe dönüştürmek için detayları paylaşın, 24 saat içinde özel fiyat ve zaman teklifimizi iletelim.
        </p>
    </div>

    @if (TempData["FormMesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4 border-0 shadow-sm mx-auto" style="max-width: 800px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25) !important; color: #065f46;" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["FormMesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mx-auto" style="max-width: 800px;">
        <div class="p-4 p-md-5 rounded-4 shadow-sm" style="background: rgba(255, 255, 255, 0.85); border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 1.5rem;">
            <form asp-controller="Home" asp-action="TeklifAl" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-4">
                    <div class="col-md-6">
                        <label for="adSoyad" class="form-label small fw-semibold" style="color: #1f1f1f;">Adınız Soyadınız / Firma Unvanı *</label>
                        <input type="text" name="adSoyad" class="form-control rounded-3 py-2.5 px-3" style="background: #ffffff; border: 1px solid rgba(0,0,0,0.12); color: #1f1f1f;" id="adSoyad" placeholder="Ad Soyad veya Firma Adı" required>
                    </div>

                    <div class="col-md-6">
                        <label for="eposta" class="form-label small fw-semibold" style="color: #1f1f1f;">E-Posta Adresiniz *</label>
                        <input type="email" name="eposta" class="form-control rounded-3 py-2.5 px-3" style="background: #ffffff; border: 1px solid rgba(0,0,0,0.12); color: #1f1f1f;" id="eposta" placeholder="ornek@firma.com" required>
                    </div>

                    <div class="col-md-6">
                        <label for="telefon" class="form-label small fw-semibold" style="color: #1f1f1f;">Telefon Numarası</label>
                        <input type="tel" name="telefon" class="form-control rounded-3 py-2.5 px-3" style="background: #ffffff; border: 1px solid rgba(0,0,0,0.12); color: #1f1f1f;" id="telefon" placeholder="+90 (5XX) XXX XX XX">
                    </div>

                    <div class="col-md-6">
                        <label for="konu" class="form-label small fw-semibold" style="color: #1f1f1f;">Hizmet Türü / Konu</label>
                        <select name="konu" class="form-select rounded-3 py-2.5 px-3" style="background: #ffffff; border: 1px solid rgba(0,0,0,0.12); color: #1f1f1f;" id="konu">
                            <option value="Kurumsal Web Tasarım">Kurumsal Web Tasarım</option>
                            <option value="Özel Yazılım Geliştirme">Özel Yazılım Geliştirme</option>
                            <option value="E-Ticaret Sistemi">E-Ticaret Sistemi</option>
                            <option value="Mobil Uygulama">Mobil Uygulama</option>
                            <option value="Domain & Hosting Hizmeti">Domain & Hosting Hizmeti</option>
                            <option value="İş Birliği Projesi">İş Birliği Projesi</option>
                            <option value="Diğer">Diğer</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="mesaj" class="form-label small fw-semibold" style="color: #1f1f1f;">Proje Detayları ve Talepleriniz *</label>
                        <textarea name="mesaj" class="form-control rounded-3 py-2.5 px-3" style="background: #ffffff; border: 1px solid rgba(0,0,0,0.12); color: #1f1f1f;" id="mesaj" rows="4" placeholder="Projeniz hakkında detaylar, hedef kitle, bütçe veya zaman beklentileriniz..." required></textarea>
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: #0b57d0; color: #ffffff; border: none; font-size: 1rem;">
                            <i class="bi bi-send-fill"></i>
                            <span>Teklif Talebini Gönder</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
