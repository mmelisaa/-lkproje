@model WebApplication1.Models.Siniflar.HesapNumaralarimiz

@{
    ViewData["Title"] = Model.AnaBaslik;
}

<div class="container my-5">
    <!-- Üst Başlık ve Açıklama Alanı -->
    <div class="row text-center mb-5">
        <div class="col-lg-8 mx-auto">
            <span class="badge bg-light text-primary px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">@Model.UstBaslik</span>
            <h1 class="display-5 fw-bold text-dark mb-3">@Model.AnaBaslik</h1>
            <p class="lead text-muted">@Model.Aciklama</p>
        </div>
    </div>

    <!-- Banka Kartları Alanı -->
    <div class="row g-4 justify-content-center">
        <!-- Ziraat Bankası Örneği -->
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 p-md-5 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h3 class="fw-bold text-dark mb-0">Ziraat Bankası</h3>
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">TL Hesabı</span>
                        </div>
                        <div class="mb-3">
                            <span class="text-muted small d-block mb-1">Hesap Sahibi</span>
                            <h5 class="fw-semibold text-dark">Hayat İşleri Yazılım Teknolojileri</h5>
                        </div>
                        <div class="mb-3">
                            <span class="text-muted small d-block mb-1">Şube / Kod</span>
                            <p class="text-dark fw-medium mb-0">Merkez Şube (1234)</p>
                        </div>
                        <div class="mb-4">
                            <span class="text-muted small d-block mb-1">IBAN Numarası</span>
                            <div class="p-3 bg-light rounded-3 font-monospace fw-bold text-dark user-select-all">
                                TR93 0001 0001 2345 6789 0123 45
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Garanti BBVA Örneği -->
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 h-100 overflow-hidden">
                <div class="card-body p-4 p-md-5 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <h3 class="fw-bold text-dark mb-0">Garanti BBVA</h3>
                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">TL Hesabı</span>
                        </div>
                        <div class="mb-3">
                            <span class="text-muted small d-block mb-1">Hesap Sahibi</span>
                            <h5 class="fw-semibold text-dark">Hayat İşleri Yazılım Teknolojileri</h5>
                        </div>
                        <div class="mb-3">
                            <span class="text-muted small d-block mb-1">Şube / Kod</span>
                            <p class="text-dark fw-medium mb-0">Elazığ Şube (5678)</p>
                        </div>
                        <div class="mb-4">
                            <span class="text-muted small d-block mb-1">IBAN Numarası</span>
                            <div class="p-3 bg-light rounded-3 font-monospace fw-bold text-dark user-select-all">
                                TR62 0006 2001 1234 5678 9012 34
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bilgilendirme Kutusu (Ortalanmış ve Şık Mavi Tonlarında) -->
    <div class="row mt-5">
        <div class="col-lg-8 mx-auto text-center">
            <div class="p-4 rounded-4 shadow-sm border border-primary border-opacity-10" style="background-color: #f0f4f8;">
                <h5 class="fw-bold text-dark mb-2">@Model.UyariBaslik</h5>
                <p class="text-muted mb-0">@Model.UyariMetni</p>
            </div>
        </div>
    </div>
</div>