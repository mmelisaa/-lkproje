@model WebApplication1.Models.Siniflar.Kurumsal.Hakkimizda
@{
    ViewData["Title"] = Model.Baslik;
}

<!-- Sayfanın kenar boşluklarını sıfırlayıp ekranı tam kaplamasını sağlayan sarmal -->
<div style="background-color: #f4f6f9; margin-top: -1.5rem; margin-bottom: -3rem; padding-top: 3rem; padding-bottom: 4rem; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;">
    <div class="container">
        
        <!-- Üst Banner / Giriş Alanı -->
        <div class="row align-items-center mb-5 bg-white p-4 p-lg-5 rounded-4 shadow-sm border border-light">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h1 class="fw-bold display-6 text-dark mb-3">@Model.Baslik</h1>
                <p class="lead text-secondary" style="line-height: 1.8;">
                    @Model.Aciklama
                </p>
            </div>
            <div class="col-lg-6">
                <img src="@Model.GorselUrl" alt="Hayat İşleri Teknoloji" class="img-fluid rounded-4 shadow w-100" style="object-fit: cover; height: 350px;">
            </div>
        </div>

        <!-- Kurumsal Detaylar ve 6 Temel Alan Başlığı -->
        <div class="text-center mb-5">
            <h2 class="fw-bold text-dark">Kurumsal Yapımız ve İlkelerimiz</h2>
            <hr class="w-25 mx-auto mt-3" style="background-color: #3b71ca; height: 3px; opacity: 1;">
        </div>

        <!-- 6 Kutucuk / Kart Alanı -->
        <div class="row g-4">
            <!-- 1. Hizmet Alanları -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3 fs-5" style="color: #3b71ca;">Hizmet Alanlarımız</h4>
                        <p class="card-text text-secondary">@Model.HizmetAlanlari</p>
                    </div>
                </div>
            </div>

            <!-- 2. Kurumsal Gücümüz -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3 fs-5" style="color: #3b71ca;">Kurumsal Gücümüz</h4>
                        <p class="card-text text-secondary">@Model.KurumsalGucumuz</p>
                    </div>
                </div>
            </div>

            <!-- 3. Çalışma İlkelerimiz -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3 fs-5" style="color: #3b71ca;">Çalışma İlkelerimiz</h4>
                        <p class="card-text text-secondary">@Model.CalismaIlkelerimiz</p>
                    </div>
                </div>
            </div>

            <!-- 4. Vizyonumuz -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3 fs-5" style="color: #3b71ca;">Vizyonumuz</h4>
                        <p class="card-text text-secondary">@Model.Vizyonumuz</p>
                    </div>
                </div>
            </div>

            <!-- 5. Misyonumuz -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3 fs-5" style="color: #3b71ca;">Misyonumuz</h4>
                        <p class="card-text text-secondary">@Model.Misyonumuz</p>
                    </div>
                </div>
            </div>

            <!-- 6. Önceliklerimiz -->
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm p-3 rounded-4 bg-white">
                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3 fs-5" style="color: #3b71ca;">Önceliklerimiz</h4>
                        <p class="card-text text-secondary">@Model.Onceliklerimiz</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>