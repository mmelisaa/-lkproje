@{
    ViewData["Title"] = "Hizmetlerimiz";
}

<!-- Üst Başlık / Hero Alanı - Canlı Canvas Animasyonlu -->
<section class="hero-banner-wrapper text-white py-5 position-relative overflow-hidden" id="hizmetHeroBanner" style="background: #050c1a; min-height: 400px; display: flex; align-items: center; margin-bottom: 5rem;">
    <!-- Canvas Animasyonu -->
    <canvas id="hizmetCanvas" class="position-absolute w-100 h-100" style="top:0;left:0;z-index:0;"></canvas>

    <!-- Gradient Perde -->
    <div class="position-absolute w-100 h-100" style="top:0;left:0;z-index:1;background:linear-gradient(135deg,rgba(5,12,26,0.70) 0%,rgba(10,22,55,0.60) 50%,rgba(5,12,26,0.70) 100%);"></div>

    <div class="container position-relative text-center py-5" style="z-index: 2;">
        <div class="col-lg-8 mx-auto">
            <span class="badge bg-white bg-opacity-10 text-info border border-info border-opacity-25 px-4 py-2 rounded-pill fw-bold mb-3 shadow-sm">
                <i class="bi bi-grid-1x2 me-2"></i> UÇTAN UCA TEKNOLOJİ
            </span>
            <h1 class="display-4 fw-bold text-white mb-3">Faaliyet Alanlarımız & Hizmetlerimiz</h1>
            <p class="lead text-light text-opacity-75 fs-5">Donanımdan özel yazılıma, kurumsal web tasarımdan e-ticaret sistemlerine kadar işletmenizin ihtiyaç duyduğu tüm dijital ve fiziksel altyapıyı tek çatı altında sunuyoruz.</p>
        </div>
    </div>
</section>

<div class="container my-5">
    
    <!-- 1. Kategori: Donanım ve Sunucu Çözümleri -->
    <div class="row align-items-center mb-5 pb-5 border-bottom border-light">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="p-5 rounded-4 shadow-sm bg-white border border-light position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-4 text-primary opacity-10 fs-1">
                    <i class="bi bi-hdd-rack"></i>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-3">FİZİKSEL ALTYAPI</span>
                <h3 class="fw-bold text-dark mb-3">Donanım & Sunucu Çözümleri</h3>
                <p class="text-muted mb-4">
                    İşletmenizin kesintisiz çalışması için gereken en dayanıklı ve yüksek performanslı donanım bileşenlerini tedarik ediyor, kurumsal sunucu ve ağ altyapılarınızı güvenle kuruyoruz.
                </p>
                <ul class="list-unstyled text-muted small g-2 d-flex flex-column gap-2">
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Kurumsal Sunucu Kurulumu ve Yönetimi</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Güvenli Ağ (Network) ve Altyapı Tedariği</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Kesintisiz Teknik Destek ve Bakım</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-5 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);">
                <h4 class="fw-bold mb-3">Neden Donanım Altyapısı?</h4>
                <p class="text-light opacity-85 mb-4 small">
                    Yazılımınız ne kadar iyi olursa olsun, üzerinde çalıştığı fiziksel altyapı o kadar güçlü olmalıdır. Hayat İşleri olarak sistemlerinizin darboğaza girmesini önleyen endüstriyel standartlarda donanım çözümleri üretiyoruz.
                </p>
                <div class="d-flex gap-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">%100</h4>
                        <span class="text-muted small text-light opacity-75">Güvenilirlik</span>
                    </div>
                    <div class="border-start border-secondary ps-4">
                        <h4 class="fw-bold text-white mb-1">Kesintisiz</h4>
                        <span class="text-muted small text-light opacity-75">Çalışma Süresi</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Kategori: Yazılım ve Web Geliştirme -->
    <div class="row align-items-center mb-5 pb-5 border-bottom border-light flex-lg-row-reverse">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="p-5 rounded-4 shadow-sm bg-white border border-light position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-4 text-primary opacity-10 fs-1">
                    <i class="bi bi-code-slash"></i>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-3">DİJİTAL ÇÖZÜMLER</span>
                <h3 class="fw-bold text-dark mb-3">Özel Yazılım & Web Geliştirme</h3>
                <p class="text-muted mb-4">
                    Hazır kalıp programlarla vakit kaybetmeyin. İş süreçlerinizi hızlandıran, tamamen sizin ihtiyaçlarınıza göre şekillenen ölçeklenebilir web ve masaüstü yazılımlar geliştiriyoruz.
                </p>
                <ul class="list-unstyled text-muted small g-2 d-flex flex-column gap-2">
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Tamamen İhtiyaca Özel Yazılım Mimarileri</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Modern, Hızlı ve Mobil Uyumlu Web Tasarımlar</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Güvenli API ve Entegrasyon Çözümleri</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-5 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);">
                <h4 class="fw-bold mb-3">Modern Teknoloji Yığını</h4>
                <p class="text-light opacity-85 mb-4 small">
                    En güncel yazılım dilleri ve çerçeveleri (ASP.NET Core MVC, modern web standartları) kullanarak sızdırmaz, performanslı ve geleceğe yatırım yapan projeler inşa ediyoruz.
                </p>
                <div class="d-flex gap-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">Ölçeklenebilir</h4>
                        <span class="text-muted small text-light opacity-75">Mimari Yapı</span>
                    </div>
                    <div class="border-start border-secondary ps-4">
                        <h4 class="fw-bold text-white mb-1">Hızlı & Güvenli</h4>
                        <span class="text-muted small text-light opacity-75">Kod Tabanı</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Kategori: E-Ticaret ve Dijital Satış -->
    <div class="row align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="p-5 rounded-4 shadow-sm bg-white border border-light position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-4 text-primary opacity-10 fs-1">
                    <i class="bi bi-cart-check"></i>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold mb-3">E-TİCARET</span>
                <h3 class="fw-bold text-dark mb-3">E-Ticaret Sistemleri</h3>
                <p class="text-muted mb-4">
                    Ürünlerinizi dijital dünyada güvenle satın. Güçlü ödeme altyapıları, kullanıcı dostu yönetim panelleri ve satış odaklı arayüzlerle e-ticarette bir adım önde olun.
                </p>
                <ul class="list-unstyled text-muted small g-2 d-flex flex-column gap-2">
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Güvenli Sanal Pos Entegrasyonları</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> Kolay Yönetilebilir Ürün ve Stok Paneli</li>
                    <li><i class="bi bi-check-circle-fill text-primary me-2"></i> SEO Uyumlu ve Satış Odaklı Yapı</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="p-5 rounded-4 shadow-sm text-white" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);">
                <h4 class="fw-bold mb-3">Satış Odaklı Deneyim</h4>
                <p class="text-light opacity-85 mb-4 small">
                    Müşterilerinizin alışveriş sepetinden ödeme adımına kadar geçirdiği tüm süreçleri pürüzsüzleştirerek dönüşüm oranlarınızı maksimum seviyeye çıkarıyoruz.
                </p>
                <div class="d-flex gap-4">
                    <div>
                        <h4 class="fw-bold text-white mb-1">7/24</h4>
                        <span class="text-muted small text-light opacity-75">Aktif Satış Mağazası</span>
                    </div>
                    <div class="border-start border-secondary ps-4">
                        <h4 class="fw-bold text-white mb-1">%100</h4>
                        <span class="text-muted small text-light opacity-75">Ödeme Güvenliği</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
(function() {
    const canvas = document.getElementById('hizmetCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const banner = document.getElementById('hizmetHeroBanner');

    function resize() {
        canvas.width = banner.offsetWidth;
        canvas.height = banner.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    const PARTICLE_COUNT = 70;
    const CONNECTION_DIST = 130;
    const colors = ['#38bdf8', '#818cf8', '#c084fc', '#67e8f9'];

    const particles = Array.from({ length: PARTICLE_COUNT }, () => ({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.6,
        vy: (Math.random() - 0.5) * 0.6,
        r: Math.random() * 2.5 + 1,
        color: colors[Math.floor(Math.random() * colors.length)]
    }));

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
                const dx = particles[i].x - particles[j].x;
                const dy = particles[i].y - particles[j].y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < CONNECTION_DIST) {
                    const alpha = 1 - dist / CONNECTION_DIST;
                    ctx.beginPath();
                    ctx.strokeStyle = `rgba(56,189,248,${alpha * 0.35})`;
                    ctx.lineWidth = 0.8;
                    ctx.moveTo(particles[i].x, particles[i].y);
                    ctx.lineTo(particles[j].x, particles[j].y);
                    ctx.stroke();
                }
            }
        }
        for (const p of particles) {
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = p.color;
            ctx.shadowBlur = 8;
            ctx.shadowColor = p.color;
            ctx.fill();
            ctx.shadowBlur = 0;
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        }
        requestAnimationFrame(draw);
    }
    draw();
})();
</script>
}
