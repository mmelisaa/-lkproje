@section Scripts {
    <!-- Three.js Kütüphanesi -->
    <script src="~/lib/three/three.min.js"></script>

    <!-- HİZMETLERİMİZ İNTERAKTİF 3D WEBGL HERO MONUMENT ENGINE -->
    <script>
        (function() {
            const canvas = document.getElementById('hizmetlerHeroCanvas');
            if (!canvas || typeof THREE === 'undefined') return;

            const isMobile = window.innerWidth < 768;

            // 1. Sahne & Kamera & Renderer
            const scene = new THREE.Scene();
            scene.background = null;

            const camera = new THREE.PerspectiveCamera(50, canvas.clientWidth / canvas.clientHeight, 0.1, 100);
            camera.position.set(0, 0, 8.5);

            const renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                alpha: true,
                antialias: !isMobile,
                powerPreference: 'high-performance'
            });
            renderer.setClearColor(0x000000, 0);
            renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.25 : 2));

            // 2. Işıklandırma (Apple Light Yansımaları)
            const ambient = new THREE.AmbientLight(0xffffff, 2.2);
            scene.add(ambient);

            const pLight1 = new THREE.PointLight(0x0071e3, 3.0, 20);
            pLight1.position.set(5, 5, 5);
            scene.add(pLight1);

            const pLight2 = new THREE.PointLight(0x0284c7, 2.5, 20);
            pLight2.position.set(-5, -5, 4);
            scene.add(pLight2);

            // 3. 3D Geometrik Anıt Grubu (İnteraktif Faceted Kristal ve Halkalar)
            const monument = new THREE.Group();
            scene.add(monument);

            // Dış saydam kristal (İcosahedron)
            const icosaGeo = new THREE.IcosahedronGeometry(2.3, 0);
            const icosaMat = new THREE.MeshStandardMaterial({
                color: 0x0071e3,
                roughness: 0.15,
                metalness: 0.2,
                wireframe: true,
                transparent: true,
                opacity: 0.45
            });
            const icosaMesh = new THREE.Mesh(icosaGeo, icosaMat);
            monument.add(icosaMesh);

            // İç Çekirdek (Octahedron Prizma)
            const coreGeo = new THREE.OctahedronGeometry(1.2, 0);
            const coreMat = new THREE.MeshStandardMaterial({
                color: 0x38bdf8,
                emissive: 0x0071e3,
                emissiveIntensity: 0.4,
                roughness: 0.1,
                metalness: 0.8
            });
            const coreMesh = new THREE.Mesh(coreGeo, coreMat);
            monument.add(coreMesh);

            // Giroskopik Halkalar (Software, Design, E-Commerce)
            const ringGroup = new THREE.Group();
            monument.add(ringGroup);

            const ring1Geo = new THREE.TorusGeometry(3.1, 0.03, 8, isMobile ? 32 : 64);
            const ring1Mat = new THREE.MeshBasicMaterial({ color: 0x0071e3, transparent: true, opacity: 0.6 });
            const ring1 = new THREE.Mesh(ring1Geo, ring1Mat);
            ring1.rotation.x = Math.PI * 0.35;
            ringGroup.add(ring1);

            const ring2Geo = new THREE.TorusGeometry(3.4, 0.025, 8, isMobile ? 32 : 64);
            const ring2Mat = new THREE.MeshBasicMaterial({ color: 0x7c3aed, transparent: true, opacity: 0.5 });
            const ring2 = new THREE.Mesh(ring2Geo, ring2Mat);
            ring2.rotation.y = Math.PI * 0.4;
            ringGroup.add(ring2);

            // Yörüngede Dönen 12 Uydusal Veri Noktası
            const satCount = isMobile ? 6 : 12;
            const satGeo = new THREE.SphereGeometry(0.12, 12, 12);
            const satMat = new THREE.MeshBasicMaterial({ color: 0x0284c7 });
            const sats = [];
            for (let i = 0; i < satCount; i++) {
                const s = new THREE.Mesh(satGeo, satMat);
                monument.add(s);
                sats.push({
                    mesh: s,
                    angle: (i / satCount) * Math.PI * 2,
                    radius: 2.8 + (i % 2) * 0.6,
                    speed: 0.6 + (i % 3) * 0.2
                });
            }

            // Fare / Dokunmatik Etkileşimi
            let mouseX = 0, mouseY = 0;
            let targetRotX = 0, targetRotY = 0;

            canvas.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                mouseX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
                mouseY = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
            });

            canvas.addEventListener('touchmove', (e) => {
                if (e.touches && e.touches[0]) {
                    const rect = canvas.getBoundingClientRect();
                    mouseX = ((e.touches[0].clientX - rect.left) / rect.width) * 2 - 1;
                    mouseY = -(((e.touches[0].clientY - rect.top) / rect.height) * 2 - 1);
                }
            }, { passive: true });

            function onResize() {
                if (!canvas.parentElement) return;
                const w = canvas.parentElement.clientWidth;
                const h = canvas.parentElement.clientHeight || 380;
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h);
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.25 : 2));
            }
            window.addEventListener('resize', onResize, { passive: true });
            onResize();

            // 60 FPS Render Döngüsü (Tab arka plandaysa GPU tasarrufu yapar)
            const clock = new THREE.Clock();
            function render() {
                requestAnimationFrame(render);
                if (document.hidden) return;

                const delta = Math.min(clock.getDelta(), 0.1);
                const t = clock.getElapsedTime();

                // İnteraktif Rotasyon
                targetRotY += mouseX * 0.03;
                targetRotX += -mouseY * 0.03;

                monument.rotation.y += (targetRotY - monument.rotation.y) * 0.08 + delta * 0.25;
                monument.rotation.x += (targetRotX - monument.rotation.x) * 0.08 + Math.sin(t * 0.5) * 0.002;

                ring1.rotation.z += delta * 0.5;
                ring2.rotation.z -= delta * 0.4;
                coreMesh.rotation.x = -t * 0.5;
                coreMesh.rotation.y = t * 0.7;

                // Uyduları döndür
                sats.forEach(s => {
                    s.angle += s.speed * delta;
                    s.mesh.position.x = Math.cos(s.angle) * s.radius;
                    s.mesh.position.z = Math.sin(s.angle) * s.radius;
                    s.mesh.position.y = Math.sin(s.angle * 2) * 0.5;
                });

                renderer.render(scene, camera);
            }
            render();
        })();

        // 3D KART MANYETİK EĞİLME & CAM PARILTISI (Hizmetlerimiz Sayfası)
        (function() {
            const cards = document.querySelectorAll('.lusion-work-card');
            cards.forEach(card => {
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    const nx = (x / rect.width - 0.5) * 2;
                    const ny = (y / rect.height - 0.5) * 2;

                    card.style.setProperty('--mouse-x', `${(x / rect.width) * 100}%`);
                    card.style.setProperty('--mouse-y', `${(y / rect.height) * 100}%`);

                    const rotY = nx * 5;
                    const rotX = -ny * 5;
                    card.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateY(-4px)`;
                });

                card.addEventListener('mouseleave', () => {
                    card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
                });
            });
        })();
    </script>
}
