<!-- 4. TEKNOLOJİ EKOSİSTEMİMİZ (3D Pill Badges) -->
<!-- ========================================== -->
<section class="py-5 position-relative overflow-hidden" style="background: transparent; z-index: 2;">
    <div class="container py-2">
        <div class="text-center mb-4 pb-2">
            <span class="badge px-3 py-1 rounded-pill fw-bold text-uppercase mb-2 shadow-sm" style="background: rgba(11, 87, 208, 0.08); color: #0b57d0; border: 1px solid rgba(11, 87, 208, 0.18); font-size: 0.75rem;">
                Altyapı Standartlarımız
            </span>
            <h2 class="display-6 fw-bold" style="color: #1f1f1f; letter-spacing: -0.8px;">Gelişmiş Teknoloji Ekosistemimiz</h2>
            <p class="text-muted mx-auto" style="max-width: 580px; font-size: 0.95rem;">Endüstri standardı modern kütüphaneler, bulut araçları ve yüksek performanslı dillerle çalışıyoruz.</p>
            <div class="mx-auto mt-2" style="width: 60px; height: 3px; background: linear-gradient(90deg, #0b57d0, #38bdf8); border-radius: 99px;"></div>
        </div>
    </div>

    <!-- HiCari Tarzı Kesintisiz Sonsuz Akan Teknoloji Sliderı (Canlı Renkli & Apple Light Tasarım) -->
    <div class="tech-slider">
        <div class="tech-slide-track">
            @{
                var techStack = new[] {
                    new { Name = "C# & .NET 9", Desc = "Kurumsal Backend & Güvenlik", Icon = "bi-filetype-cs", Color = "#0b57d0", Bg = "rgba(11, 87, 208, 0.10)" },
                    new { Name = "Three.js & WebGL", Desc = "60 FPS Donanım Hızlandırma", Icon = "bi-box", Color = "#0284c7", Bg = "rgba(2, 132, 199, 0.10)" },
                    new { Name = "GSAP & Lenis", Desc = "Milimetrik Akıcı Scroll", Icon = "bi-activity", Color = "#10b981", Bg = "rgba(16, 185, 129, 0.10)" },
                    new { Name = "SQL Server 2022", Desc = "Yüksek Hızlı İlişkisel DB", Icon = "bi-database-fill", Color = "#7c3aed", Bg = "rgba(124, 58, 237, 0.10)" },
                    new { Name = "Redis Cache", Desc = "Mikrosaniye Seviyesinde Hız", Icon = "bi-lightning-fill", Color = "#ef4444", Bg = "rgba(239, 68, 68, 0.10)" },
                    new { Name = "Docker & CI/CD", Desc = "Konteyner ve DevOps", Icon = "bi-boxes", Color = "#0284c7", Bg = "rgba(2, 132, 199, 0.10)" },
                    new { Name = "RESTful Web APIs", Desc = "Güvenli Servis Mimarisi", Icon = "bi-diagram-3-fill", Color = "#0b57d0", Bg = "rgba(11, 87, 208, 0.10)" },
                    new { Name = "Sanal POS & 3D Secure", Desc = "Banka Entegrasyonu", Icon = "bi-credit-card-2-front-fill", Color = "#059669", Bg = "rgba(5, 150, 105, 0.10)" },
                    new { Name = "Tailwind & CSS 3D", Desc = "Apple Frosted Glass Tasarım", Icon = "bi-brush-fill", Color = "#8b5cf6", Bg = "rgba(139, 92, 246, 0.10)" },
                    new { Name = "Azure & Cloud Host", Desc = "%99.98 Uptime Garantisi", Icon = "bi-cloud-check-fill", Color = "#0284c7", Bg = "rgba(2, 132, 199, 0.10)" },
                    new { Name = "TypeScript", Desc = "Tip Güvenli Dinamik Arayüz", Icon = "bi-code-square", Color = "#2563eb", Bg = "rgba(37, 99, 235, 0.10)" },
                    new { Name = "Core Web Vitals", Desc = "100/100 Google Puanı", Icon = "bi-speedometer2", Color = "#10b981", Bg = "rgba(16, 185, 129, 0.10)" }
                };
            }

            @* 1. Set (Ön Kısım) *@
            @foreach (var t in techStack)
            {
                <div class="tech-slide">
                    <div class="tech-card-item">
                        <div class="tech-icon-box" style="background: @t.Bg; color: @t.Color; border: 1px solid @(t.Color)33;">
                            <i class="bi @t.Icon"></i>
                        </div>
                        <div class="tech-info">
                            <div class="tech-name">@t.Name</div>
                            <div class="tech-desc">@t.Desc</div>
                        </div>
                    </div>
                </div>
            }

            @* 2. Set (Kesintisiz sonsuz akış için birebir kopya) *@
            @foreach (var t in techStack)
            {
                <div class="tech-slide">
                    <div class="tech-card-item">
                        <div class="tech-icon-box" style="background: @t.Bg; color: @t.Color; border: 1px solid @(t.Color)33;">
                            <i class="bi @t.Icon"></i>
                        </div>
                        <div class="tech-info">
                            <div class="tech-name">@t.Name</div>
                            <div class="tech-desc">@t.Desc</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .tech-slider {
        position: relative;
        width: 100%;
        overflow: hidden;
        padding: 14px 0 26px 0;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    }

    .tech-slide-track {
        display: flex;
        width: max-content;
        animation: techScroll 38s linear infinite;
        will-change: transform;
    }

    .tech-slider:hover .tech-slide-track {
        animation-play-state: paused;
    }

    .tech-slide {
        flex: 0 0 280px;
        width: 280px;
        padding: 0 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tech-card-item {
        width: 100%;
        height: 82px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 1.15rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
        cursor: default;
    }

    .tech-card-item:hover {
        transform: translateY(-4px);
        background: #ffffff;
        border-color: rgba(11, 87, 208, 0.35);
        box-shadow: 0 12px 28px rgba(11, 87, 208, 0.12);
    }

    .tech-icon-box {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .tech-card-item:hover .tech-icon-box {
        transform: scale(1.1) rotate(4deg);
    }

    .tech-info {
        overflow: hidden;
        text-align: left;
    }

    .tech-name {
        font-weight: 700;
        font-size: 0.92rem;
        color: #0f172a;
        line-height: 1.25;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tech-desc {
        font-size: 0.74rem;
        color: #64748b;
        line-height: 1.25;
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@keyframes techScroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    @@media (max-width: 768px) {
        .tech-slide {
            flex: 0 0 240px;
            width: 240px;
            padding: 0 7px;
        }
        .tech-card-item {
            height: 74px;
            padding: 12px 14px;
            gap: 12px;
        }
        .tech-icon-box {
            width: 40px;
            height: 40px;
            font-size: 1.15rem;
        }
        .tech-name {
            font-size: 0.85rem;
        }
        .tech-desc {
            font-size: 0.7rem;
        }
        .tech-slide-track {
            animation-duration: 30s;
        }
    }
</style>

