                                <p class="mb-3 text-muted" style="font-size: 0.88rem; line-height: 1.65;">
                                    @item.Ozet
                                </p>
                                <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-start blog-read-more mt-auto" onclick="openCustomBlogModal('@Html.Raw(Html.Encode(item.Baslik))', '@Html.Raw(Html.Encode(item.Ozet))', '@item.Kategori', '@item.Tarih')">
