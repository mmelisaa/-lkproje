                                <span class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(11, 87, 208, 0.94); color: #fff; font-size: 0.72rem;">
                                    @item.Kategori
                                </span>
                            </div>
                            <div class="p-4 d-flex flex-column flex-grow-1">
                                <div class="small text-muted mb-2"><i class="bi bi-calendar3 me-1"></i> @item.Tarih</div>
                                <h5 class="fw-bold mb-2.5" style="color: #0f172a; letter-spacing: -0.3px; line-height: 1.4;">
                                    @item.Baslik
