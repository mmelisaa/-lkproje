@model IEnumerable<WebApplication1.Models.Siniflar.BlogPost>
@{
    ViewData["Title"] = "Blog & Duyurular";
}

<!-- ========================================== -->
<!-- 1. HERO BANNER & CANLI BİLDİRİM TICKER     -->
<!-- ========================================== -->
<section class="position-relative overflow-hidden py-5" id="blogHeroBanner" style="background: transparent;">
    <div class="container position-relative text-center py-4" style="z-index: 2;">
        
        <!-- Üst Rozet -->
        <div class="d-inline-flex align-items-center gap-2 px-3.5 py-1.5 rounded-pill mb-3 shadow-sm" style="background: rgba(255, 255, 255, 0.9); border: 1px solid rgba(11, 87, 208, 0.2); backdrop-filter: blur(12px);">
            <span class="blog-pulse-dot"></span>
            <span class="small fw-bold text-uppercase" style="color: #0b57d0; letter-spacing: 1.5px; font-size: 0.76rem;">
                <i class="bi bi-broadcast me-1"></i> Hayat İşleri Mühendislik &amp; Bülten
            </span>
        </div>

        <!-- Ana Başlık -->
        <h1 class="display-4 fw-bold mb-3" style="color: #1f1f1f; letter-spacing: -1.4px; line-height: 1.18;">
            Yazılım, Teknoloji ve <span class="blog-gradient-text">Kurumsal Duyurular</span>
        </h1>
        
        <!-- Açıklama -->
        <p class="lead mx-auto mb-4" style="color: #444746; max-width: 680px; line-height: 1.8; font-size: 1.05rem;">
            Özel yazılım mimarilerimiz, modern kurumsal web sistemlerimiz, HiCari ön muhasebe güncellemelerimiz ve dijital mühendislik bültenimiz.
        </p>

        <!-- Canlı Duyuru Bandı (Live Announcement Ticker) -->
        <div class="mx-auto announcement-ticker-bar p-2 px-3 rounded-pill d-inline-flex align-items-center gap-2.5 shadow-sm" style="background: rgba(255, 255, 255, 0.95); border: 1px solid rgba(11, 87, 208, 0.18); max-width: 820px;">
            <span class="badge rounded-pill px-2.5 py-1 fw-bold text-uppercase" style="background: #0b57d0; color: #fff; font-size: 0.7rem; letter-spacing: 0.5px;">Son Duyuru</span>
            <span class="small fw-semibold text-truncate text-start" style="color: #1e293b; font-size: 0.85rem;">
                HiCariTakip B2B cari yönetimi ve ön muhasebe entegrasyonlarında 2026 performans sürümü yayında!
            </span>
            <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none fw-bold ms-auto flex-shrink-0" onclick="openBlogModal('hicari-duyuru')" style="color: #0b57d0; font-size: 0.82rem;">
                İncele &rarr;
            </button>
        </div>

    </div>
</section>

<!-- ========================================== -->
<!-- 2. ÖNE ÇIKAN MANŞET BAŞYAZI (Featured Hero) -->
<!-- ========================================== -->
<section class="position-relative py-3 mb-4" style="z-index: 2;">
    <div class="container">
        <div class="featured-post-card rounded-4 p-4 p-lg-5 position-relative overflow-hidden shadow-sm" style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(240, 247, 255, 0.95) 100%); border: 1px solid rgba(11, 87, 208, 0.22);">
            <div class="row align-items-center g-4">
                
                <!-- Sol Kolon: Görsel ve Rozet -->
                <div class="col-lg-6">
                    <div class="position-relative rounded-3 overflow-hidden shadow-sm" style="height: 280px; background: #f8fafc;">
                        <img src="/images/blog-yazilim.svg" onerror="this.onerror=null; this.src='/images/blog-yazilim.svg';" alt="Kurumsal Yazılım Mimarisi" class="w-100 h-100 object-fit-cover featured-img" />
                        <span class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-1.5 fw-bold shadow-sm" style="background: rgba(11, 87, 208, 0.95); color: #fff; font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="bi bi-star-fill text-warning me-1"></i> ÖNE ÇIKAN BAŞYAZI
                        </span>
                        <span class="position-absolute bottom-0 end-0 m-3 badge rounded-pill px-2.5 py-1.5 shadow-sm" style="background: rgba(255,255,255,0.92); color: #1e293b; backdrop-filter: blur(8px); font-size: 0.72rem;">
                            <i class="bi bi-clock me-1 text-primary"></i> 6 dk okuma
                        </span>
                    </div>
                </div>

                <!-- Sağ Kolon: İçerik Bilgileri -->
                <div class="col-lg-6 text-start">
                    <div class="d-flex align-items-center gap-2 mb-2.5">
                        <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="background: rgba(11, 87, 208, 0.08); color: #0b57d0; border: 1px solid rgba(11, 87, 208, 0.2); font-size: 0.74rem;">
                            <i class="bi bi-cpu-fill me-1"></i> Özel Yazılım &amp; Mimari
                        </span>
                        <span class="small text-muted" style="font-size: 0.8rem;">
                            <i class="bi bi-calendar3 me-1"></i> 15 Ekim 2026
                        </span>
                    </div>

                    <h2 class="h3 fw-bold mb-3" style="color: #0f172a; letter-spacing: -0.6px; line-height: 1.3;">
                        2026 Kurumsal Yazılım Mimarisi: ASP.NET Core 9 ve Yüksek Güvenlikli API Standartları
                    </h2>

                    <p class="text-muted mb-4" style="line-height: 1.7; font-size: 0.92rem;">
                        İşletmelerin operasyonel süreçlerini dijitalleştiren kurumsal sistemlerde mikroservis mimarisi, SQL Server 2022 veri tabanı optimizasyonu ve banka düzeyinde güvenlik protokollerinin önemi.
                    </p>

                    <!-- Etiketler -->
                    <div class="d-flex flex-wrap gap-1.5 mb-4">
                        <span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1" style="font-size: 0.72rem;">#NET9</span>
                        <span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1" style="font-size: 0.72rem;">#Mikroservis</span>
                        <span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1" style="font-size: 0.72rem;">#SQLServer</span>
                        <span class="badge rounded-pill bg-light text-secondary border px-2.5 py-1" style="font-size: 0.72rem;">#RestAPI</span>
                    </div>

                    <!-- Alt Yazar ve Buton -->
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top" style="border-color: rgba(11, 87, 208, 0.12) !important;">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; background: #0b57d0; color: #fff; font-size: 0.95rem;">
                                <i class="bi bi-terminal"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark" style="font-size: 0.84rem;">Hayat İşleri Mühendislik Ekibi</div>
                                <small class="text-muted" style="font-size: 0.74rem;">Kurumsal Çözümler Departmanı</small>
                            </div>
                        </div>

                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm" onclick="openBlogModal('aspnet-mimari')" style="background-color: #0b57d0; border: none; font-size: 0.88rem;">
                            <span>Yazıyı Oku</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- 3. FİLTRELEME & CANLI ARAMA ARAÇ ÇUBUĞU    -->
<!-- ========================================== -->
<section class="position-relative py-4" style="z-index: 2;">
    <div class="container">
        
        <div class="blog-toolbar p-3 rounded-4 mb-4 shadow-sm d-flex justify-content-center" style="background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(16px); border: 1px solid rgba(0, 0, 0, 0.08);">
            
            <!-- Kategori Filtre Butonları -->
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-center" id="categoryFilterGroup">
                <button type="button" class="btn btn-sm blog-filter-btn active rounded-pill px-3 py-1.5 fw-semibold" data-category="all">
                    Tümü <span class="badge rounded-pill bg-light text-dark ms-1" style="font-size: 0.7rem;">Hepsi</span>
                </button>
                <button type="button" class="btn btn-sm blog-filter-btn rounded-pill px-3 py-1.5 fw-semibold" data-category="duyuru">
                    <i class="bi bi-megaphone-fill me-1 text-primary"></i> Duyurular &amp; Güncellemeler
                </button>
                <button type="button" class="btn btn-sm blog-filter-btn rounded-pill px-3 py-1.5 fw-semibold" data-category="yazilim">
                    <i class="bi bi-code-slash me-1 text-info"></i> Özel Yazılım &amp; Mimari
                </button>
                <button type="button" class="btn btn-sm blog-filter-btn rounded-pill px-3 py-1.5 fw-semibold" data-category="web">
                    <i class="bi bi-palette2 me-1 text-purple" style="color: #8b5cf6;"></i> Web &amp; 3D Tasarım
                </button>
                <button type="button" class="btn btn-sm blog-filter-btn rounded-pill px-3 py-1.5 fw-semibold" data-category="eticaret">
                    <i class="bi bi-credit-card-2-front me-1 text-warning"></i> E-Ticaret &amp; POS
                </button>
                <button type="button" class="btn btn-sm blog-filter-btn rounded-pill px-3 py-1.5 fw-semibold" data-category="performans">
                    <i class="bi bi-speedometer2 me-1 text-success"></i> Performans &amp; Güvenlik
                </button>
            </div>

        </div>

        <!-- Sayaç Bilgilendirme -->
        <div class="d-flex justify-content-between align-items-center mb-4 px-1">
            <span class="small text-muted fw-semibold" id="blogResultsCount">Tüm içerikler listeleniyor</span>
            <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i> Doğrulanmış Mühendislik İçerikleri</span>
        </div>

    </div>
</section>

<!-- ========================================== -->
<!-- 4. BLOG & DUYURULAR KART LİSTESİ           -->
<!-- ========================================== -->
<section class="position-relative pb-5" style="z-index: 2;">
    <div class="container">
        <div class="row g-4" id="blogCardsGrid">

            <!-- KART 1: DUYURU - HiCariTakip Güncellemesi -->
            <div class="col-md-6 col-lg-4 blog-item" data-category="duyuru" data-keywords="hicari hicari takip cari muhasebe stok b2b guncelleme sürüm">
                <div class="blog-card rounded-4 overflow-hidden h-100 position-relative d-flex flex-column" style="background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
                    <div style="height: 3px; background: linear-gradient(90deg, #0b57d0, #38bdf8);"></div>
                    <div class="blog-card-img-wrap position-relative overflow-hidden" style="height: 200px; background: #f0f7ff;">
                        <img src="/images/ref-real-1.jpg" onerror="this.onerror=null; this.src='/images/blog-api.svg';" alt="HiCariTakip B2B Cari Yönetimi" class="blog-card-img w-100 h-100 object-fit-cover" />
                        <span class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(11, 87, 208, 0.94); color: #fff; font-size: 0.72rem; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);">
                            <i class="bi bi-megaphone-fill me-1"></i> Kurumsal Duyuru
                        </span>
                        <span class="position-absolute bottom-0 end-0 m-3 badge rounded-pill px-2.5 py-1.5" style="background: rgba(255, 255, 255, 0.92); color: #1e293b; border: 1px solid rgba(0,0,0,0.08); backdrop-filter: blur(8px); font-size: 0.72rem;">
                            <i class="bi bi-clock me-1 text-primary"></i> 4 dk okuma
                        </span>
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <div class="small text-muted mb-2"><i class="bi bi-calendar3 me-1"></i> 12 Ekim 2026</div>
                        <h5 class="fw-bold mb-2.5" style="color: #0f172a; letter-spacing: -0.3px; line-height: 1.4;">
                            <a href="https://www.hicari.com.tr/" target="_blank" rel="noopener noreferrer" class="text-decoration-none" style="color: inherit;" title="Ön Muhasebe Programı ve B2B Cari Yönetimi | HiCariTakip">
                                Duyuru: HiCariTakip B2B Cari ve Ön Muhasebe Entegrasyonlarında Yeni Versiyon
                            </a>
                        </h5>
                        <p class="mb-3 text-muted" style="font-size: 0.88rem; line-height: 1.65;">
                            Müşterilerimizin cari hesap takibi, anlık stok ve çoklu şube yönetimini kolaylaştıran <a href="https://www.hicari.com.tr/" target="_blank" rel="noopener noreferrer" class="fw-semibold text-primary text-decoration-none" title="Ön Muhasebe Programı ve B2B Cari Yönetimi | HiCariTakip">HiCariTakip</a> platformumuzda hız ve raporlama güncellemeleri tamamlandı.
                        </p>
                        <div class="d-flex flex-wrap gap-1.5 mb-3 mt-auto">
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#HiCari</span>
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#OnMuhasebe</span>
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#B2B</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between pt-2 border-top border-black border-opacity-10">
                            <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-start blog-read-more" onclick="openBlogModal('hicari-duyuru')">
                                Detayları İncele <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                            <a href="https://www.hicari.com.tr/" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fw-bold d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;" title="Ön Muhasebe Programı ve B2B Cari Yönetimi | HiCariTakip">
                                <span>hicari.com.tr</span> <i class="bi bi-box-arrow-up-right" style="font-size: 0.7rem;"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KART 2: WEB & 3D - Three.js WebGL -->
            <div class="col-md-6 col-lg-4 blog-item" data-category="web" data-keywords="three.js webgl 3d web tasarim ui ux animasyon gpu lenis scroll">
                <div class="blog-card rounded-4 overflow-hidden h-100 position-relative d-flex flex-column" style="background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
                    <div style="height: 3px; background: linear-gradient(90deg, #8b5cf6, #38bdf8);"></div>
                    <div class="blog-card-img-wrap position-relative overflow-hidden" style="height: 200px; background: #f0f7ff;">
                        <img src="/images/blog-uiux.svg" onerror="this.onerror=null; this.src='/images/blog-uiux.svg';" alt="Three.js WebGL 3D Web Tasarımı" class="blog-card-img w-100 h-100 object-fit-cover" />
                        <span class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(139, 92, 246, 0.94); color: #fff; font-size: 0.72rem; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);">
                            <i class="bi bi-palette2 me-1"></i> Web &amp; 3D Tasarım
                        </span>
                        <span class="position-absolute bottom-0 end-0 m-3 badge rounded-pill px-2.5 py-1.5" style="background: rgba(255, 255, 255, 0.92); color: #1e293b; border: 1px solid rgba(0,0,0,0.08); backdrop-filter: blur(8px); font-size: 0.72rem;">
                            <i class="bi bi-clock me-1 text-primary"></i> 5 dk okuma
                        </span>
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <div class="small text-muted mb-2"><i class="bi bi-calendar3 me-1"></i> 08 Ekim 2026</div>
                        <h5 class="fw-bold mb-2.5" style="color: #0f172a; letter-spacing: -0.3px; line-height: 1.4;">
                            Web Tasarımında 60 FPS Akıcılık: Three.js &amp; WebGL Donanım Hızlandırma
                        </h5>
                        <p class="mb-3 text-muted" style="font-size: 0.88rem; line-height: 1.65;">
                            Durağan sitelerin ötesine geçen interaktif 3D modeller ve GPU optimizasyonlu Lenis scroll mekanizmasıyla markanızın dijital prestijini üst seviyeye taşıyın.
                        </p>
                        <div class="d-flex flex-wrap gap-1.5 mb-3 mt-auto">
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#ThreeJS</span>
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#WebGL</span>
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#UIUX</span>
                        </div>
                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-start blog-read-more" onclick="openBlogModal('threejs-webgl')">
                            Detayları İncele <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- KART 3: E-TİCARET & POS - Sanal POS Entegrasyonu -->
            <div class="col-md-6 col-lg-4 blog-item" data-category="eticaret" data-keywords="eticaret sanal pos 3d secure odeme api banka guvenlik magaza">
                <div class="blog-card rounded-4 overflow-hidden h-100 position-relative d-flex flex-column" style="background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
                    <div style="height: 3px; background: linear-gradient(90deg, #f59e0b, #ef4444);"></div>
                    <div class="blog-card-img-wrap position-relative overflow-hidden" style="height: 200px; background: #fffbeb;">
                        <img src="/images/blog-api.svg" onerror="this.onerror=null; this.src='/images/blog-api.svg';" alt="E-Ticarette Sanal POS ve 3D Secure" class="blog-card-img w-100 h-100 object-fit-cover" />
                        <span class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(217, 119, 6, 0.94); color: #fff; font-size: 0.72rem; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);">
                            <i class="bi bi-credit-card-2-front me-1"></i> E-Ticaret &amp; POS
                        </span>
                        <span class="position-absolute bottom-0 end-0 m-3 badge rounded-pill px-2.5 py-1.5" style="background: rgba(255, 255, 255, 0.92); color: #1e293b; border: 1px solid rgba(0,0,0,0.08); backdrop-filter: blur(8px); font-size: 0.72rem;">
                            <i class="bi bi-clock me-1 text-primary"></i> 7 dk okuma
                        </span>
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <div class="small text-muted mb-2"><i class="bi bi-calendar3 me-1"></i> 03 Ekim 2026</div>
                        <h5 class="fw-bold mb-2.5" style="color: #0f172a; letter-spacing: -0.3px; line-height: 1.4;">
                            E-Ticarette Sanal POS Entegrasyonları ve 3D Secure Güvenlik Mimarisi
                        </h5>
                        <p class="mb-3 text-muted" style="font-size: 0.88rem; line-height: 1.65;">
                            Sepet terk etme oranını minimuma indiren tek tıkla ödeme süreçleri, çoklu banka API mimarisi ve sahtecilik önleyici (fraud) filtreleme teknikleri.
                        </p>
                        <div class="d-flex flex-wrap gap-1.5 mb-3 mt-auto">
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#SanalPOS</span>
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#3DSecure</span>
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#ETicaret</span>
                        </div>
                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold text-start blog-read-more" onclick="openBlogModal('sanal-pos')">
                            Detayları İncele <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- KART 4: PERFORMANS - Core Web Vitals & Redis -->
            <div class="col-md-6 col-lg-4 blog-item" data-category="performans" data-keywords="performans hiz core web vitals redis cache seo google optimizasyon">
                <div class="blog-card rounded-4 overflow-hidden h-100 position-relative d-flex flex-column" style="background: #ffffff; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
                    <div style="height: 3px; background: linear-gradient(90deg, #10b981, #0284c7);"></div>
                    <div class="blog-card-img-wrap position-relative overflow-hidden" style="height: 200px; background: #f0fdf4;">
                        <img src="/images/blog-hiz.svg" onerror="this.onerror=null; this.src='/images/blog-hiz.svg';" alt="Core Web Vitals Hız Optimizasyonu" class="blog-card-img w-100 h-100 object-fit-cover" />
                        <span class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(16, 185, 129, 0.94); color: #fff; font-size: 0.72rem; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);">
                            <i class="bi bi-speedometer2 me-1"></i> Performans &amp; SEO
                        </span>
                        <span class="position-absolute bottom-0 end-0 m-3 badge rounded-pill px-2.5 py-1.5" style="background: rgba(255, 255, 255, 0.92); color: #1e293b; border: 1px solid rgba(0,0,0,0.08); backdrop-filter: blur(8px); font-size: 0.72rem;">
                            <i class="bi bi-clock me-1 text-primary"></i> 5 dk okuma
                        </span>
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <div class="small text-muted mb-2"><i class="bi bi-calendar3 me-1"></i> 28 Eylül 2026</div>
                        <h5 class="fw-bold mb-2.5" style="color: #0f172a; letter-spacing: -0.3px; line-height: 1.4;">
                            Core Web Vitals ve Google 100/100 Performans Puanı Nasıl Sağlanır?
                        </h5>
                        <p class="mb-3 text-muted" style="font-size: 0.88rem; line-height: 1.65;">
                            Gecikmeleri sıfırlayan Redis önbellekleme, WebP/AVIF görsel sıkıştırma ve modern CDN kullanımıyla sitenizi Google'ın zirvesine taşıyın.
                        </p>
                        <div class="d-flex flex-wrap gap-1.5 mb-3 mt-auto">
                            <span class="badge rounded-pill bg-light text-secondary border px-2 py-0.5" style="font-size: 0.7rem;">#CoreWebVitals</span>
