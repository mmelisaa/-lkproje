        // Modalı DOM'da doğrudan <body> altına taşıyarak <main> z-index stacking context çakışmasını çözelim
        function ensureModalInBody() {
            const modalElem = document.getElementById('blogReaderModal');
            if (modalElem && modalElem.parentElement !== document.body) {
                document.body.appendChild(modalElem);
            }
            return modalElem;
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ensureModalInBody);
        } else {
            ensureModalInBody();
        }

        // Modal Açma Fonksiyonu (Kurumsal Apple Editorial Stili)
        function openBlogModal(key) {
            const data = blogArticlesData[key];
            if (!data) return;

            const modalElem = ensureModalInBody();
            if (!modalElem) return;

