                        </button>
                    </div>
                </div>
            </div>

            <!-- Veritabanından gelen ek dinamik içerikler (Varsa) -->
            @if (Model != null)
            {
                foreach (var item in Model.Where(m => m.Id > 2))
                {
                    <div class="col-md-6 col-lg-4 blog-item" data-category="@(item.Kategori?.ToLower().Contains("duyuru") == true ? "duyuru" : "yazilim")" data-keywords="@item.Baslik.ToLower() @item.Ozet.ToLower()">
