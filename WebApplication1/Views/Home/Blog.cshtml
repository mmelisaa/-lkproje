@{
    ViewData["Title"] = "Blog & Duyurular";
}

<div class="container py-5">
    <!-- Başlık (Sitenin genel tasarımıyla tam uyumlu, net okunan renk tonu) -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-6 mb-2" style="color: #E0E6ED !important;">Teknoloji ve Yazılım Blogumuz</h1>
        <p class="fs-6 mb-0" style="color: #94A3B8 !important;">Yazılım dünyasındaki son trendler, web geliştirme ipuçları ve dijital çözümler üzerine güncel içerikler.</p>
    </div>

    <!-- Blog Kartları (Gerçekçi ve İlgili Fotoğraflarla) -->
    <div class="row g-4">
        
        <!-- Blog 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 rounded-4 shadow-sm overflow-hidden" style="background-color: #12141c; border: 1px solid rgba(255,255,255,0.08) !important;">
                <div style="height: 190px; overflow: hidden;">
                    <img src="https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=600&q=80" alt="UI/UX Tasarım" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.9;">
                </div>
                <div class="card-body p-4">
                    <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 rounded-pill small">Web Tasarım</span>
                    <h5 class="card-title text-white fw-bold mb-3 fs-5">Kurumsal Web Sitesinde UI/UX Trendleri 2026</h5>
                    <p class="card-text text-muted small mb-4">Kullanıcı deneyimini artıran modern arayüz tasarımları ve şirketinizin dijital yüzünü güçlendirecek ipuçları.</p>
                    <a href="#" class="text-info text-decoration-none small fw-semibold d-flex align-items-center gap-1">Devamını Oku <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
