@{
    ViewData["Title"] = "Ürünlerimiz • Otomatik Tanıma, Barkod ve POS Donanımları";
}

<!-- GOOGLE FONTS & ÖZEL STİLLER -->
<style>
    .products-portal,
    .products-portal button,
    .products-portal input,
    .product-slide-drawer {
        font-family: 'Google Sans Text', 'Google Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    /* ==================================================================== */
    /* GOOGLE ONE BENTO FILTER CONSOLE                                      */
    /* Ultra-zarif, modern, responsive hap menü ve canlı arama merkezi     */
    /* ==================================================================== */
    .bento-filter-console {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 28px;
        padding: 1.4rem 1.6rem;
        box-shadow: 0 12px 36px rgba(11, 87, 208, 0.06), 0 2px 8px rgba(0, 0, 0, 0.03);
        position: relative;
        overflow: hidden;
        margin-bottom: 2.5rem;
    }

    /* Google One 4-Color Accent Band */
    .bento-console-accent-bar {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3.5px;
        background: linear-gradient(90deg, #4285F4 0%, #4285F4 25%, #EA4335 25%, #EA4335 50%, #FBBC05 50%, #FBBC05 75%, #34A853 75%, #34A853 100%);
    }

    /* Üst Navigasyon Kontrol Şeridi */
    .bento-console-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        padding-bottom: 1.15rem;
        border-bottom: 1px solid rgba(15, 23, 42, 0.07);
        margin-bottom: 1.25rem;
    }

    /* Segmentli Mod Seçici */
    .bento-mode-capsule {
        display: inline-flex;
        background: #f1f5f9;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 999px;
        padding: 4px;
        gap: 4px;
    }

    .bento-mode-btn {
        border: none;
        background: transparent;
        padding: 0.55rem 1.35rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.88rem;
        color: #475569;
        cursor: pointer;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .bento-mode-btn:hover {
        color: #0b57d0;
    }

    .bento-mode-btn.is-active {
        background: linear-gradient(135deg, #1d4ed8 0%, #0b57d0 100%);
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(11, 87, 208, 0.35);
    }

    .bento-mode-badge {
        font-size: 0.72rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.08);
        color: #475569;
    }

    .bento-mode-btn.is-active .bento-mode-badge {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }

    /* Canlı Arama Kutusu */
    .bento-search-box {
        position: relative;
        flex-grow: 1;
        max-width: 380px;
        min-width: 240px;
    }

    .bento-search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 0.95rem;
        pointer-events: none;
    }

    .bento-search-input {
        width: 100%;
        background: #f8fafc;
        border: 1.5px solid rgba(15, 23, 42, 0.1);
        border-radius: 999px;
        padding: 0.6rem 2.4rem 0.6rem 2.5rem;
        font-size: 0.88rem;
        color: #0f172a;
        transition: all 0.25s ease;
    }

    .bento-search-input:focus {
        background: #ffffff;
        border-color: #0b57d0;
        box-shadow: 0 0 0 4px rgba(11, 87, 208, 0.14);
        outline: none;
    }

    .bento-search-clear {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        padding: 0;
        font-size: 1rem;
        display: none;
    }

    .bento-search-clear:hover {
        color: #0f172a;
    }

    /* Durum & Hızlı Sıfırlama */
    .bento-hud-wrap {
        display: flex;
        align-items: center;
        gap: 0.65rem;
    }

    .bento-active-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(11, 87, 208, 0.08);
        border: 1px solid rgba(11, 87, 208, 0.2);
        border-radius: 999px;
        padding: 0.45rem 1rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: #0b57d0;
    }

    .bento-pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #0b57d0;
        box-shadow: 0 0 8px rgba(11, 87, 208, 0.8);
    }

    .bento-reset-btn {
        background: #ffffff;
        border: 1px solid rgba(15, 23, 42, 0.12);
        border-radius: 999px;
        padding: 0.45rem 0.95rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: #334155;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .bento-reset-btn:hover {
        background: #0b57d0;
        color: #ffffff;
        border-color: #0b57d0;
        box-shadow: 0 4px 12px rgba(11, 87, 208, 0.25);
    }

    /* Hap Filtre Izgarası (Bento Pill Flow Wrap) */
    .bento-pills-flow {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .g1-filter-pill {
        border: 1px solid rgba(15, 23, 42, 0.09);
        background: #ffffff;
        border-radius: 999px;
        padding: 0.45rem 0.95rem 0.45rem 0.55rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        white-space: nowrap;
        font-size: 0.83rem;
        font-weight: 600;
        color: #334155;
        transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03);
    }

    .g1-filter-pill:hover {
        border-color: rgba(11, 87, 208, 0.35);
        color: #0b57d0;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(11, 87, 208, 0.12);
    }

    .g1-filter-pill.is-active {
        background: linear-gradient(135deg, #1d4ed8 0%, #0b57d0 100%) !important;
        border-color: #0b57d0 !important;
        color: #ffffff !important;
        box-shadow: 0 6px 20px rgba(11, 87, 208, 0.38) !important;
        transform: translateY(-1px);
    }

    .g1-pill-icon {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(11, 87, 208, 0.08);
        color: #0b57d0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.88rem;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }

    .g1-filter-pill.is-active .g1-pill-icon {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }

    .g1-pill-title {
        letter-spacing: -0.1px;
    }

    .g1-pill-count {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: #f1f5f9;
        color: #64748b;
        transition: all 0.2s ease;
    }

    .g1-filter-pill.is-active .g1-pill-count {
        background: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }

    /* Marka Bilgi Şeridi */
    .bento-brand-ribbon {
        margin-top: 1.25rem;
        padding: 1rem 1.4rem;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(248, 250, 252, 0.95) 0%, rgba(239, 246, 255, 0.9) 100%);
        border: 1px solid rgba(11, 87, 208, 0.15);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    /* ==================================================================== */
    /* ÜRÜN KARTLARI (Apple & Google One Minimalist Estetik)                 */
    /* ==================================================================== */
    .hardware-product-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 1.35rem;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
        position: relative;
    }
    .hardware-product-card:hover {
        transform: translateY(-6px);
        border-color: rgba(11, 87, 208, 0.35);
        box-shadow: 0 20px 45px rgba(11, 87, 208, 0.1);
    }

    .product-photo-wrap {
        position: relative;
        width: 100%;
        height: 230px;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        overflow: hidden;
    }
    .product-real-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hardware-product-card:hover .product-real-img {
        transform: scale(1.08);
    }

    .product-brand-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(15, 23, 42, 0.85);
        color: #ffffff;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.6px;
        padding: 0.25rem 0.65rem;
        border-radius: 6px;
        backdrop-filter: blur(8px);
        z-index: 2;
    }

    .product-cat-tag {
        position: absolute;
        bottom: 12px;
        right: 12px;
        background: rgba(255, 255, 255, 0.9);
        color: #0b57d0;
        border: 1px solid rgba(11, 87, 208, 0.2);
        font-size: 0.68rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
        backdrop-filter: blur(8px);
        z-index: 2;
    }

    .product-card-body {
        padding: 1.35rem 1.4rem 1.4rem 1.4rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .product-model-title {
        font-size: 1.14rem;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.3px;
        margin-bottom: 0.25rem;
    }
    .product-class-subtitle {
        font-size: 0.8rem;
        font-weight: 600;
        color: #0b57d0;
        margin-bottom: 0.75rem;
    }
    .product-short-desc {
        font-size: 0.85rem;
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .product-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.22rem 0.55rem;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 600;
        color: #334155;
    }
    .btn-detail-drawer {
        background: rgba(11, 87, 208, 0.08);
        color: #0b57d0;
        border: 1px solid rgba(11, 87, 208, 0.22);
        font-size: 0.82rem;
        font-weight: 700;
        border-radius: 99px;
        padding: 0.45rem 0.95rem;
        transition: all 0.2s ease;
    }
    .btn-detail-drawer:hover {
        background: #0b57d0;
        color: #ffffff;
        border-color: #0b57d0;
    }

    /* ==================================================================== */
    /* DETAY PANELİ (SLIDE-OVER DRAWER)                                     */
    /* ==================================================================== */
    .product-drawer-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 1080;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .product-drawer-backdrop.active {
        opacity: 1;
        visibility: visible;
    }

    .product-slide-drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 530px;
        max-width: 100vw;
        height: 100vh;
        background: #ffffff;
        z-index: 1090;
        box-shadow: -15px 0 50px rgba(0, 0, 0, 0.25);
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform 0.38s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
    }
    .product-slide-drawer.active {
        transform: translateX(0);
    }

    .drawer-top-bar {
        padding: 1.25rem 1.6rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #ffffff;
        flex-shrink: 0;
    }
    .drawer-close-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f1f5f9;
        border: 1px solid rgba(0, 0, 0, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .drawer-close-btn:hover {
        background: #e2e8f0;
        color: #0f172a;
        transform: rotate(90deg);
    }

    .drawer-scroll-body {
        padding: 1.6rem 1.8rem;
        overflow-y: auto;
        flex-grow: 1;
    }
    .drawer-scroll-body::-webkit-scrollbar {
        width: 6px;
    }
    .drawer-scroll-body::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 99px;
    }

    .drawer-photo-container {
        width: 100%;
        height: 260px;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        border: 1px solid #e2e8f0;
        border-radius: 1.15rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .drawer-photo-container img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .drawer-product-title {
        color: #0f172a;
        font-weight: 800;
        font-size: 1.35rem;
        letter-spacing: -0.3px;
        margin-bottom: 0.25rem;
    }
    .drawer-product-subtitle {
        color: #0b57d0;
        font-weight: 700;
        font-size: 0.88rem;
        margin-bottom: 1rem;
    }
    .drawer-section-heading {
        color: #0f172a;
        font-weight: 700;
        font-size: 0.92rem;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .drawer-overview-text {
        font-size: 0.88rem;
        line-height: 1.7;
        color: #475569;
    }
    .drawer-usecase-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.1rem;
    }

    .drawer-specs-table th {
        width: 40%;
        font-size: 0.8rem;
        font-weight: 700;
        color: #64748b;
        background: #f8fafc;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding: 0.65rem 0.85rem;
        border-color: #e2e8f0;
    }
    .drawer-specs-table td {
        font-size: 0.86rem;
        font-weight: 500;
        color: #1e293b;
        padding: 0.65rem 0.85rem;
        border-color: #e2e8f0;
    }
    .drawer-footer-bar {
        padding: 1.25rem 1.6rem;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        background: #f8fafc;
        flex-shrink: 0;
    }

    /* ==================================================================== */
    /* KOYU MOD (DARK THEME) ZARİF KONTRAST & OKUNABİLİRLİK                 */
    /* ==================================================================== */
    html[data-theme="dark"] .bento-filter-console {
        background: rgba(22, 27, 34, 0.9) !important;
        border-color: rgba(255, 255, 255, 0.12) !important;
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5) !important;
    }
    html[data-theme="dark"] .bento-console-topbar {
        border-bottom-color: rgba(255, 255, 255, 0.1) !important;
    }
    html[data-theme="dark"] .bento-mode-capsule {
        background: rgba(15, 23, 42, 0.85) !important;
        border-color: rgba(255, 255, 255, 0.12) !important;
    }
    html[data-theme="dark"] .bento-mode-btn {
        color: #94a3b8 !important;
    }
    html[data-theme="dark"] .bento-mode-btn:hover {
        color: #38bdf8 !important;
    }
    html[data-theme="dark"] .bento-mode-btn.is-active {
        background: linear-gradient(135deg, #2563eb 0%, #0b57d0 100%) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 16px rgba(37, 99, 235, 0.4) !important;
    }
    html[data-theme="dark"] .bento-search-input {
        background: rgba(15, 23, 42, 0.8) !important;
        color: #ffffff !important;
        border-color: rgba(255, 255, 255, 0.14) !important;
    }
    html[data-theme="dark"] .bento-search-input:focus {
        background: #1e293b !important;
        border-color: #38bdf8 !important;
        box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.2) !important;
    }
    html[data-theme="dark"] .bento-search-input::placeholder {
        color: #64748b !important;
    }
    html[data-theme="dark"] .bento-search-icon {
        color: #94a3b8 !important;
    }
    html[data-theme="dark"] .bento-active-pill {
        background: rgba(56, 189, 248, 0.12) !important;
        border-color: rgba(56, 189, 248, 0.3) !important;
        color: #38bdf8 !important;
    }
    html[data-theme="dark"] .bento-pulse-dot {
        background: #38bdf8 !important;
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.9) !important;
    }
    html[data-theme="dark"] .bento-reset-btn {
        background: rgba(30, 41, 59, 0.8) !important;
        color: #e2e8f0 !important;
        border-color: rgba(255, 255, 255, 0.14) !important;
    }
    html[data-theme="dark"] .bento-reset-btn:hover {
        background: #0284c7 !important;
        color: #ffffff !important;
    }
    html[data-theme="dark"] .g1-filter-pill {
        background: rgba(30, 41, 59, 0.75) !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
        color: #e2e8f0 !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25) !important;
    }
    html[data-theme="dark"] .g1-filter-pill:hover {
        background: #1e293b !important;
        border-color: rgba(56, 189, 248, 0.4) !important;
        color: #38bdf8 !important;
    }
    html[data-theme="dark"] .g1-filter-pill.is-active {
        background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%) !important;
        border-color: #38bdf8 !important;
        color: #ffffff !important;
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5) !important;
    }
    html[data-theme="dark"] .g1-pill-icon {
        background: rgba(255, 255, 255, 0.08) !important;
        color: #93c5fd !important;
    }
    html[data-theme="dark"] .g1-filter-pill.is-active .g1-pill-icon {
        background: rgba(255, 255, 255, 0.25) !important;
        color: #ffffff !important;
    }
    html[data-theme="dark"] .g1-pill-count {
        background: rgba(255, 255, 255, 0.08) !important;
        color: #94a3b8 !important;
    }
    html[data-theme="dark"] .g1-filter-pill.is-active .g1-pill-count {
        background: rgba(255, 255, 255, 0.25) !important;
        color: #ffffff !important;
    }
    html[data-theme="dark"] .bento-brand-ribbon {
        background: rgba(15, 23, 42, 0.8) !important;
        border-color: rgba(255, 255, 255, 0.12) !important;
    }

    /* Ürün Kartları Koyu Mod */
    html[data-theme="dark"] .hardware-product-card {
        background: rgba(22, 27, 34, 0.88) !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3) !important;
    }
    html[data-theme="dark"] .hardware-product-card:hover {
        border-color: rgba(56, 189, 248, 0.4) !important;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.1) !important;
    }
    html[data-theme="dark"] .product-photo-wrap {
        background: linear-gradient(180deg, #161b22 0%, #0d1117 100%) !important;
        border-bottom-color: rgba(255, 255, 255, 0.08) !important;
    }
    html[data-theme="dark"] .product-model-title {
        color: #ffffff !important;
    }
    html[data-theme="dark"] .product-class-subtitle {
        color: #38bdf8 !important;
    }
    html[data-theme="dark"] .product-short-desc {
        color: #94a3b8 !important;
    }
    html[data-theme="dark"] .product-chip {
        background: rgba(255, 255, 255, 0.06) !important;
        border-color: rgba(255, 255, 255, 0.1) !important;
        color: #cbd5e1 !important;
    }
    html[data-theme="dark"] .btn-detail-drawer {
        background: rgba(56, 189, 248, 0.12) !important;
        color: #38bdf8 !important;
        border-color: rgba(56, 189, 248, 0.28) !important;
    }
    html[data-theme="dark"] .btn-detail-drawer:hover {
