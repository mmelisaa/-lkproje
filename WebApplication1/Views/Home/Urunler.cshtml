            'elanda': { name: 'ELANDA POS', badge: 'Dokunmatik Terminal & Kiosk', desc: 'Perakende ve ağırlama sektörü için modern alüminyum gövdeli dokunmatik POS terminalleri.', tag1: 'Alüminyum POS & Kiosk', tag2: 'Fansız Mimari', logo: 'EL' },
            'italora': { name: 'ITALORA', badge: 'Endüstriyel Tartım & Etiketleme', desc: 'Gıda, lojistik ve üretim hatları için çift taraflı etiketleme ve barkod aplikasyon sistemleri.', tag1: 'Çift Taraflı Baskı', tag2: 'Hat Entegrasyonu', logo: 'IT' },
            'bartender': { name: 'SEAGULL SCIENTIFIC BARTENDER', badge: 'Dünya Standardı Barkod Yazılımı', desc: 'Barkod, etiket ve RFID tasarımı ve kurumsal otomasyon yazılımı. ERP, SAP ve SQL entegrasyonu.', tag1: 'Starter & Enterprise', tag2: 'ERP Entegrasyonu', logo: 'BT' },
            'soti': { name: 'SOTI MOBICONTROL', badge: 'Kurumsal Mobil Cihaz Yönetimi (EMM)', desc: 'Tüm Android, iOS ve Windows endüstriyel el terminalleri ve tabletleri uzaktan yönetme platformu.', tag1: 'SOTI ONE Platform', tag2: 'Saha Güvenliği', logo: 'ST' },
            'bluebird': { name: 'BLUEBIRD', badge: 'Kurumsal IoT & El Terminalleri', desc: 'Depo, saha servisleri ve perakende için ergonomik ve dayanımlı akıllı el terminalleri.', tag1: '18 Kurumsal Model', tag2: 'Android Kurumsal', logo: 'BB' },
            'movfast': { name: 'MOVFAST', badge: 'Hızlı Lojistik Donanımları', desc: 'E-ticaret operasyonları ve depo lojistiği için yeni nesil akıllı el terminalleri.', tag1: 'Ranger 2 Serisi', tag2: 'Uzun Pil Ömrü', logo: 'MF' }
        };

        const categoryNames = {
            'all': 'Tüm Kategoriler',
            'yazarkasa-pos': 'Yazarkasa POS & ÖKC',
            'para-cekmecesi': 'Para Çekmeceleri',
            'celik-kasa': 'Elektronik Şifreli Kasalar',
            'pos-standlari': 'POS Standları & Aksesuar',
            'para-sayma': 'Para Sayma Makineleri',
            'el-terminalleri': 'El Terminalleri',
            'dokunmatik-pos-pc': 'Dokunmatik POS PC',
            'barkod-okuyucular': 'Barkod Okuyucular',
            'barkod-yazicilar': 'Barkod Yazıcılar',
            'endustriyel-yazicilar': 'Endüstriyel Yazıcılar',
            'masaustu-yazicilar': 'Masaüstü Yazıcılar',
            'fis-adisyon-yazicilar': 'Fiş/Adisyon Yazıcılar',
            'mobil-yazicilar': 'Mobil Yazıcılar',
            'kart-yazicilar': 'Kart Yazıcılar',
            'endustriyel-pc-tablet': 'Endüstriyel PC-Tablet',
            'giyilebilir-cihazlar': 'Giyilebilir Cihazlar',
            'kiosklar': 'Kiosklar',
            'patlayici-ortamlar': 'Patlayıcı Ortamlar',
            'mobil-cihaz-yonetimi': 'Mobil Cihaz Yönetimi',
            'aksesuarlar': 'Aksesuar & Sarf'
        };

        function getBrandDisplayName(key) {
            return (brandMeta[key] && brandMeta[key].name) ? brandMeta[key].name : key.toUpperCase();
        }

        function getCategoryDisplayName(key) {
            return categoryNames[key] || key;
        }

        // Filtre Durumu
        let currentMode = 'kategoriler';
        let currentCategory = 'all';
        let currentBrand = 'all';
        let searchQuery = '';

        function updateFilterReadout(text) {
            const el = document.getElementById('filterReadoutVal');
            if (el) el.innerText = text;
        }

        function switchBentoMode(mode) {
            currentMode = mode;
            const btnCat = document.getElementById('btnModeCategories');
            const btnBrand = document.getElementById('btnModeBrands');
            const flowCat = document.getElementById('bentoFlowCategories');
            const flowBrand = document.getElementById('bentoFlowBrands');
            const brandRibbon = document.getElementById('bentoBrandRibbon');

            if (mode === 'kategoriler') {
                if (btnCat) btnCat.classList.add('is-active');
                if (btnBrand) btnBrand.classList.remove('is-active');
                if (flowCat) flowCat.style.display = 'flex';
                if (flowBrand) flowBrand.style.display = 'none';
                if (brandRibbon) brandRibbon.style.display = 'none';
            } else {
                if (btnBrand) btnBrand.classList.add('is-active');
                if (btnCat) btnCat.classList.remove('is-active');
                if (flowCat) flowCat.style.display = 'none';
                if (flowBrand) flowBrand.style.display = 'flex';
                if (brandRibbon) brandRibbon.style.display = (currentBrand !== 'all') ? 'flex' : 'none';
            }
            applyProductFilters();
        }

        const switchSpatialMode = switchBentoMode;
        const switchViewMode = switchBentoMode;

        function selectCategory(slug, displayName) {
            currentMode = 'kategoriler';
            currentCategory = slug;
            currentBrand = 'all'; // Kategori tıklandığında marka kısıtını sıfırla
            searchQuery = '';

            const sInput = document.getElementById('productSearchInput');
            if (sInput) sInput.value = '';
            const clearBtn = document.getElementById('bentoSearchClear');
            if (clearBtn) clearBtn.style.display = 'none';

            // Mod butonlarını güncelle
            const btnCat = document.getElementById('btnModeCategories');
            const btnBrand = document.getElementById('btnModeBrands');
            if (btnCat) btnCat.classList.add('is-active');
            if (btnBrand) btnBrand.classList.remove('is-active');

            const flowCat = document.getElementById('bentoFlowCategories');
            const flowBrand = document.getElementById('bentoFlowBrands');
            if (flowCat) flowCat.style.display = 'flex';
            if (flowBrand) flowBrand.style.display = 'none';

            const brandRibbon = document.getElementById('bentoBrandRibbon');
            if (brandRibbon) brandRibbon.style.display = 'none';

            // Kategori haplarını güncelle
            document.querySelectorAll('#bentoFlowCategories .g1-filter-pill').forEach(pill => {
                if (pill.getAttribute('data-cat-slug') === slug) {
                    pill.classList.add('is-active');
                } else {
                    pill.classList.remove('is-active');
                }
            });

            applyProductFilters();

            // Ürünlerin olduğu bölüme kaydır
            if (slug !== 'all') {
                const catalog = document.getElementById('productsCatalogContainer');
                if (catalog) {
                    const topPos = catalog.getBoundingClientRect().top + window.pageYOffset - 150;
                    window.scrollTo({ top: topPos, behavior: 'smooth' });
                }
            }
        }

        const selectSpatialCategory = selectCategory;
        const selectGtCategory = selectCategory;

        function selectBrand(brandKey) {
            currentMode = 'markalar';
            currentBrand = brandKey;
            currentCategory = 'all'; // Marka tıklandığında kategori kısıtını sıfırla
            searchQuery = '';

            const sInput = document.getElementById('productSearchInput');
            if (sInput) sInput.value = '';
            const clearBtn = document.getElementById('bentoSearchClear');
            if (clearBtn) clearBtn.style.display = 'none';

            // Mod butonlarını güncelle
            const btnCat = document.getElementById('btnModeCategories');
            const btnBrand = document.getElementById('btnModeBrands');
            if (btnBrand) btnBrand.classList.add('is-active');
            if (btnCat) btnCat.classList.remove('is-active');

            const flowCat = document.getElementById('bentoFlowCategories');
            const flowBrand = document.getElementById('bentoFlowBrands');
            if (flowCat) flowCat.style.display = 'none';
            if (flowBrand) flowBrand.style.display = 'flex';

            // Marka haplarını güncelle
            document.querySelectorAll('#bentoFlowBrands .g1-filter-pill').forEach(pill => {
                if (pill.getAttribute('data-brand-key') === brandKey) {
                    pill.classList.add('is-active');
                } else {
                    pill.classList.remove('is-active');
                }
            });

            // Marka şeridini güncelle
            const brandRibbon = document.getElementById('bentoBrandRibbon');
            if (brandKey === 'all') {
                if (brandRibbon) brandRibbon.style.display = 'none';
            } else {
                if (brandRibbon) brandRibbon.style.display = 'flex';
                const meta = brandMeta[brandKey] || { name: brandKey.toUpperCase(), badge: 'Yetkili Çözüm Ortağı', desc: 'Resmi ürün portföyü.', tag1: 'Orijinal Model', tag2: '2 Yıl Garanti', logo: brandKey.substring(0,2).toUpperCase() };
                const titleEl = document.getElementById('bentoBrandTitle');
                const badgeEl = document.getElementById('bentoBrandBadge');
                const descEl = document.getElementById('bentoBrandDesc');
                const tag1El = document.getElementById('bentoBrandTag1');
                const tag2El = document.getElementById('bentoBrandTag2');
                const logoTextEl = document.getElementById('bentoBrandLogoText');

                if (titleEl) titleEl.innerText = meta.name;
                if (badgeEl) badgeEl.innerText = meta.badge;
                if (descEl) descEl.innerText = meta.desc;
                if (tag1El) tag1El.innerText = meta.tag1;
                if (tag2El) tag2El.innerText = meta.tag2;
                if (logoTextEl) logoTextEl.innerText = meta.logo;
            }

            applyProductFilters();

            if (brandKey !== 'all') {
                const catalog = document.getElementById('productsCatalogContainer');
                if (catalog) {
                    const topPos = catalog.getBoundingClientRect().top + window.pageYOffset - 150;
                    window.scrollTo({ top: topPos, behavior: 'smooth' });
                }
            }
        }

        const selectSpatialBrand = selectBrand;

        function resetAllProductFilters() {
            currentCategory = 'all';
            currentBrand = 'all';
            searchQuery = '';

            const sInput = document.getElementById('productSearchInput');
            if (sInput) sInput.value = '';
            const clearBtn = document.getElementById('bentoSearchClear');
            if (clearBtn) clearBtn.style.display = 'none';

            document.querySelectorAll('#bentoFlowCategories .g1-filter-pill').forEach(pill => {
                if (pill.getAttribute('data-cat-slug') === 'all') pill.classList.add('is-active');
                else pill.classList.remove('is-active');
            });

            document.querySelectorAll('#bentoFlowBrands .g1-filter-pill').forEach(pill => {
                if (pill.getAttribute('data-brand-key') === 'all') pill.classList.add('is-active');
                else pill.classList.remove('is-active');
            });

            const brandRibbon = document.getElementById('bentoBrandRibbon');
            if (brandRibbon) brandRibbon.style.display = 'none';

            switchBentoMode('kategoriler');
            applyProductFilters();
        }

        function clearProductSearch() {
            const sInput = document.getElementById('productSearchInput');
            if (sInput) sInput.value = '';
            searchQuery = '';
            const clearBtn = document.getElementById('bentoSearchClear');
            if (clearBtn) clearBtn.style.display = 'none';
            applyProductFilters();
        }

        function applyProductFilters() {
            const cards = document.querySelectorAll('.product-card-col');
            const emptyState = document.getElementById('productEmptyState');
            let visibleCount = 0;

            const qNorm = normalizeText(searchQuery);
            const tokens = qNorm.split(/\s+/).filter(Boolean);

            cards.forEach(card => {
                const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
                const cardBrand = (card.getAttribute('data-brand') || '').toLowerCase();
                const cardKeywords = card.getAttribute('data-keywords') || '';

                let matchesMode = true;

                // Eğer canlı arama yapılıyorsa TÜM KATALOG içinde ara (kategori kısıtını esnet)
                if (tokens.length > 0) {
                    matchesMode = true;
                } else if (currentMode === 'markalar') {
                    matchesMode = (currentBrand === 'all' || cardBrand === currentBrand || cardBrand.includes(currentBrand));
                } else {
                    if (currentCategory === 'all') {
                        matchesMode = true;
                    } else {
                        const cats = cardCat.split(/\s+/);
                        const targetCat = currentCategory.toLowerCase();
                        matchesMode = cats.includes(targetCat) || cardCat.includes(targetCat);

                        // Özel kategori takma adları
                        if (!matchesMode) {
                            if (targetCat === 'yazarkasa-pos') {
                                const posBrands = ['pax', 'ingenico', 'inpos', 'beko', 'propay', 'pavo'];
                                if (cardCat.includes('yazarkasa') || cardKeywords.includes('yazarkasa') || posBrands.includes(cardBrand)) {
                                    matchesMode = true;
                                }
                            } else if (targetCat === 'para-cekmecesi') {
                                if (cardCat.includes('para-cekmecesi') || cardKeywords.includes('cekmec') || cardKeywords.includes('para cekmeci') || cardKeywords.includes('para cekmecesi') || cardKeywords.includes('para cekmeceleri') || cardKeywords.includes('drawer')) {
                                    matchesMode = true;
                                }
                            } else if (targetCat === 'celik-kasa') {
                                if (cardCat.includes('celik-kasa') || cardKeywords.includes('celik kasa') || cardBrand === 'mastersafe') {
                                    matchesMode = true;
                                }
                            } else if (targetCat === 'pos-standlari') {
                                if (cardCat.includes('pos-standlari') || cardKeywords.includes('stand')) {
                                    matchesMode = true;
                                }
                            } else if (targetCat === 'para-sayma') {
                                if (cardCat.includes('para-sayma') || cardKeywords.includes('sayma')) {
                                    matchesMode = true;
                                }
                            }
                        }
                    }
                }

                // Akıllı Türkçe Arama Eşleştirme (Tüm kelimeler + eşanlamlılar + kök kontrolü)
                let matchesSearch = true;
                if (tokens.length > 0) {
                    matchesSearch = tokens.every(tok => {
                        if (cardKeywords.includes(tok)) return true;
                        // Eşanlamlı kelime kontrolü (pos -> okc / yazarkasa vb.)
                        if (searchSynonyms[tok]) {
                            if (searchSynonyms[tok].some(syn => cardKeywords.includes(syn))) return true;
                        }
                        // Türkçe çoğul ve yapım eki gövdesi (örn: çekmecesi -> çekmec)
                        if (tok.length > 5) {
                            const stem = tok.substring(0, Math.min(tok.length - 2, 6));
                            if (cardKeywords.includes(stem)) return true;
                        }
                        return false;
                    });
                }

                if (matchesMode && matchesSearch) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // HUD Filtre Başlığını Canlı Sayıyla Güncelle
            if (tokens.length > 0) {
                updateFilterReadout(`ARAMA: "${searchQuery.toUpperCase()}" (${visibleCount} ÜRÜN)`);
            } else if (currentMode === 'markalar') {
                const bName = getBrandDisplayName(currentBrand);
                updateFilterReadout(`${bName.toUpperCase()} (${visibleCount} ÜRÜN)`);
            } else {
                const cName = getCategoryDisplayName(currentCategory);
                updateFilterReadout(`${cName.toUpperCase()} (${visibleCount} ÜRÜN)`);
            }

            if (emptyState) {
                if (visibleCount === 0) {
                    emptyState.style.display = 'block';
                    const emptyTitle = document.getElementById('emptyStateTitle');
                    const emptyDesc = document.getElementById('emptyStateDesc');
                    if (tokens.length > 0) {
                        if (emptyTitle) emptyTitle.innerText = `"${searchQuery}" İçin Ürün Bulunamadı`;
                        if (emptyDesc) emptyDesc.innerText = `Aramanızla tam eşleşen ürün bulunamadı. Özel şartname veya proje tedariği için kurumsal satış ekibimizden teklif isteyebilirsiniz.`;
                    } else if (currentMode === 'markalar') {
                        const bName = getBrandDisplayName(currentBrand);
                        if (emptyTitle) emptyTitle.innerText = `${bName} Distribütör & Proje Tedariği`;
                        if (emptyDesc) emptyDesc.innerText = `${bName} portföyündeki kurumsal modeller doğrudan resmi distribütör garantisiyle tarafımızdan tedarik edilmektedir.`;
                    } else {
                        const cName = getCategoryDisplayName(currentCategory);
                        if (emptyTitle) emptyTitle.innerText = `${cName} Kurumsal Tedarik`;
                        if (emptyDesc) emptyDesc.innerText = `${cName} grubundaki tüm modeller için resmi distribütör güvencesiyle şartnamenize en uygun teklifi hazırlıyoruz.`;
                    }
                } else {
                    emptyState.style.display = 'none';
                }
            }
        }

        // Canlı Arama Olay Dinleyicisi
        const searchInput = document.getElementById('productSearchInput');
        const clearBtn = document.getElementById('bentoSearchClear');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                searchQuery = this.value.trim();
                if (clearBtn) {
                    clearBtn.style.display = searchQuery.length > 0 ? 'block' : 'none';
                }
                // Canlı arama yapıldığında tüm ürünler modunu etkinleştir
                if (searchQuery.length > 0) {
                    currentCategory = 'all';
                    currentBrand = 'all';
                    document.querySelectorAll('#bentoFlowCategories .g1-filter-pill').forEach(pill => {
                        if (pill.getAttribute('data-cat-slug') === 'all') pill.classList.add('is-active');
                        else pill.classList.remove('is-active');
                    });
                }
                applyProductFilters();
            });
        }

        // Kategori takma adı / slug normalizasyonu
        function slugifyCategory(val) {
            if (!val) return 'all';
            const v = normalizeText(val).replace(/\s+/g, '-');
            if (v.includes('para-cekmec') || v.includes('cekmece')) return 'para-cekmecesi';
            if (v.includes('celik-kasa') || v.includes('kasa') || v.includes('safe')) return 'celik-kasa';
            if (v.includes('pos-stand') || v.includes('stand')) return 'pos-standlari';
            if (v.includes('para-sayma') || v.includes('sayma')) return 'para-sayma';
            if (v.includes('yazarkasa') || v.includes('okc')) return 'yazarkasa-pos';
            if (v.includes('el-terminal')) return 'el-terminalleri';
            if (v.includes('dokunmatik') || v.includes('pos-pc')) return 'dokunmatik-pos-pc';
            if (v.includes('barkod-okuyucu') || v.includes('okuyucu')) return 'barkod-okuyucular';
            if (v.includes('barkod-yazici') || v.includes('yazici')) return 'barkod-yazicilar';
            if (v.includes('endustriyel-yazici')) return 'endustriyel-yazicilar';
            if (v.includes('masaustu-yazici')) return 'masaustu-yazicilar';
            if (v.includes('fis') || v.includes('adisyon')) return 'fis-adisyon-yazicilar';
            if (v.includes('mobil-yazici')) return 'mobil-yazicilar';
            if (v.includes('kart-yazici')) return 'kart-yazicilar';
            if (v.includes('endustriyel-tablet') || v.includes('tablet')) return 'endustriyel-tablet';
            if (v.includes('giyilebilir')) return 'giyilebilir-barkod';
            if (v.includes('kiosk')) return 'kiosk-sistemleri';
            if (v.includes('patlayici') || v.includes('atex')) return 'patlayici-ortamlar';
            if (v.includes('cihaz-yonetimi') || v.includes('mdm')) return 'mobil-cihaz-yonetimi';
            if (v.includes('aksesuar') || v.includes('sarf')) return 'aksesuarlar';
            return v;
        }

        // URL Parametrelerine Göre Açılış (Örn: ?q=... veya ?kategori=para-cekmecesi veya ?marka=pax)
        (function initFromUrl() {
            initProductsDatabase();
            renderProductCards();

            const urlParams = new URLSearchParams(window.location.search);
            const paramMarka = urlParams.get('marka');
            const paramKategori = urlParams.get('kategori');
            const paramQ = urlParams.get('q');

            if (paramQ) {
                const sInput = document.getElementById('productSearchInput');
                if (sInput) sInput.value = paramQ;
                searchQuery = paramQ.trim();
                const clearBtn = document.getElementById('bentoSearchClear');
                if (clearBtn) clearBtn.style.display = 'block';
                currentCategory = 'all';
                currentBrand = 'all';
                applyProductFilters();
            } else if (paramKategori) {
                const normCat = slugifyCategory(paramKategori);
                selectCategory(normCat, getCategoryDisplayName(normCat));
            } else if (paramMarka) {
                switchBentoMode('markalar');
                selectBrand(paramMarka);
            } else {
                switchBentoMode('kategoriler');
                selectCategory('all', 'TÜM MODELLER (225)');
            }
        })();

        // ==========================================
        // SAĞDAN KAYAN ŞIK DETAY PANELİ FONKSİYONLARI
        // (Bootstrap Modal Olmadığı İçin ASLA Donmaz)
        // ==========================================
        function openProductDrawer(productKey) {
            const data = productsDatabase[productKey];
            if (!data) return;

            // Fotoğraf & Bilgileri Doldur
            document.getElementById('drawerProductImage').src = data.img;
            document.getElementById('drawerProductImage').alt = data.title;
            document.getElementById('drawerCategoryPill').innerText = data.category;
            document.getElementById('drawerProductTitle').innerText = data.title;
            document.getElementById('drawerProductSubtitle').innerText = data.subtitle;
            document.getElementById('drawerProductOverview').innerText = data.overview;
            document.getElementById('drawerProductUseCases').innerText = data.useCases;
            document.getElementById('drawerOfferLink').href = `/Home/TeklifAl?urun=${encodeURIComponent(data.title)}`;

            // Tedarik / Distribütör Rozeti
            const ozlemBrands = ['pax', 'ingenico', 'inpos', 'beko', 'propay', 'paysis', 'pavo', 'mastersafe', 'samuto', 'ozlem'];
            const originBadge = document.getElementById('drawerOriginBadge');
            if (originBadge) {
                if (ozlemBrands.includes(data.brand)) {
                    originBadge.className = 'badge rounded-pill px-2.5 py-1 bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 small';
                    originBadge.innerHTML = '<i class="bi bi-box-seam me-1"></i> Özlem Ticaret &amp; Yetkili Tedarik';
                } else {
                    originBadge.className = 'badge rounded-pill px-2.5 py-1 bg-success bg-opacity-10 text-success border border-success border-opacity-25 small';
                    originBadge.innerHTML = '<i class="bi bi-shield-check me-1"></i> Orijinal Koddata Distribütör';
                }
            }

            // Tablo Satırları
            let rowsHtml = '';
            if (data.specs && Array.isArray(data.specs)) {
                data.specs.forEach(s => {
                    rowsHtml += `
                        <tr>
                            <th>${s.key}</th>
                            <td>${s.val}</td>
                        </tr>
                    `;
                });
            }
            document.getElementById('drawerSpecsBody').innerHTML = rowsHtml;

            // Paneli ve Perdeyi Aç
            const drawer = document.getElementById('productSlideDrawer');
            const backdrop = document.getElementById('productDrawerBackdrop');
            if (drawer && backdrop) {
                drawer.classList.add('active');
                backdrop.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeProductDrawer() {
            const drawer = document.getElementById('productSlideDrawer');
            const backdrop = document.getElementById('productDrawerBackdrop');
            if (drawer && backdrop) {
                drawer.classList.remove('active');
                backdrop.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        // ESC Tuşu ile Kapatma
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeProductDrawer();
            }
        });
    </script>
}
