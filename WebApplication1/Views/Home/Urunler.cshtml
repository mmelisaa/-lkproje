<!-- 5. İNTERAKTİF FİLTRELEME & DRAWER SCRİPTİ  -->
<!-- ========================================== -->
@section Scripts {
    <script src="~/js/products-data.js" asp-append-version="true"></script>
    <script>
        // Türkçe Karakter Normalizasyonu (Ç, Ğ, İ, I, Ö, Ş, Ü ve noktasız/noktalı harf toleransı)
        function normalizeText(str) {
            if (!str) return '';
            return str
                .replace(/İ/g, 'i')
                .replace(/I/g, 'ı')
                .toLowerCase()
                .replace(/ç/g, 'c')
                .replace(/ğ/g, 'g')
                .replace(/ı/g, 'i')
                .replace(/ö/g, 'o')
                .replace(/ş/g, 's')
                .replace(/ü/g, 'u')
                .replace(/[^a-z0-9]/g, ' ')
                .trim();
        }

        // Akıllı Türkçe Eşanlamlılar & Kök Eşleştirme Sözlüğü
        const searchSynonyms = {
            'pos': ['pos', 'okc', 'yazarkasa', 'terminal', 'odeme'],
            'kasa': ['kasa', 'celik', 'safe', 'mastersafe', 'cekmeci', 'cekmece', 'cekmecesi', 'cekmeceleri', 'okc'],
            'para': ['para', 'banknot', 'madeni', 'sayma', 'cekmeci', 'cekmece', 'cekmecesi', 'cekmeceleri', 'drawer', 'kasa'],
            'cekmeci': ['cekmeci', 'cekmece', 'drawer', 'kasiyer', 'cekmecesi', 'cekmeceleri'],
            'cekmece': ['cekmeci', 'cekmece', 'drawer', 'kasiyer', 'cekmecesi', 'cekmeceleri'],
            'cekmecesi': ['cekmeci', 'cekmece', 'drawer', 'kasiyer', 'cekmecesi', 'cekmeceleri'],
            'cekmeceleri': ['cekmeci', 'cekmece', 'drawer', 'kasiyer', 'cekmecesi', 'cekmeceleri'],
            'yazarkasa': ['yazarkasa', 'yazar', 'okc', 'pos', 'pax', 'ingenico', 'inpos', 'beko', 'propay', 'pavo', 'hugin'],
            'yazar': ['yazarkasa', 'yazar', 'okc', 'pos'],
            'stand': ['stand', 'standi', 'standlari', 'tutucu', 'kolu', 'kol'],
            'standi': ['stand', 'standi', 'standlari', 'tutucu', 'kolu', 'kol'],
            'sayma': ['sayma', 'sayici', 'banknot', 'para sayma', 'paysis', 'samuto'],
            'terminal': ['terminal', 'terminalleri', 'el terminali', 'mobil', 'zebra', 'bluebird', 'newland'],
            'okuyucu': ['okuyucu', 'barkod', 'tarayici', 'karekod', '2d', 'imager', 'scanner'],
            'yazici': ['yazici', 'yazicilar', 'printer', 'ribon', 'termal', 'tsc', 'citizen', 'zebra']
        };

        // Ürün Veritabanı
        const productsDatabase = {};

        function initProductsDatabase() {
            if (!window.KODDATA_PRODUCTS) return;
            window.KODDATA_PRODUCTS.forEach(p => {
                productsDatabase[p.id] = {
                    title: p.title,
                    subtitle: p.subtitle,
                    brand: p.brand,
                    brandDisplay: p.brand_display,
                    category: p.main_cat_name,
                    img: p.image,
                    overview: p.overview,
                    specs: p.specs,
                    useCases: p.use_cases
                };
            });
        }

        function renderProductCards() {
            const container = document.getElementById('productsCatalogContainer');
            const emptyState = document.getElementById('productEmptyState');
            if (!container || !window.KODDATA_PRODUCTS) return;

            const cardsHtml = window.KODDATA_PRODUCTS.map(p => {
                const chipsHtml = (p.chips || []).map(c => `<span class="product-chip">${c}</span>`).join('');
                const catsAttr = (p.categories || []).join(' ');

                // Tüm arama alanlarını Türkçe normalize ederek karta yaz
                const searchableText = normalizeText([
                    p.title,
                    p.subtitle,
                    p.brand,
                    p.brand_display,
                    p.main_cat_name,
                    (p.categories || []).join(' '),
                    (p.chips || []).join(' '),
                    p.overview
                ].join(' '));

                return `
                    <div class="col-lg-4 col-md-6 product-card-col" 
                         data-category="${catsAttr}" 
                         data-brand="${p.brand}" 
                         data-keywords="${searchableText}">
                        <div class="hardware-product-card">
                            <div class="product-photo-wrap">
                                <span class="product-brand-badge">${p.brand_display}</span>
                                <span class="product-cat-tag">${p.main_cat_name}</span>
                                <img src="${p.image}" alt="${p.title}" class="product-real-img" loading="lazy" onerror="this.src='/images/donanim.jpg'" />
                            </div>
                            <div class="product-card-body">
                                <h3 class="product-model-title">${p.title}</h3>
                                <div class="product-class-subtitle">${p.subtitle}</div>
                                <p class="product-short-desc">
                                    ${p.overview}
                                </p>
                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    ${chipsHtml}
                                </div>
                                <div class="mt-auto pt-3 border-top d-flex gap-2">
                                    <button type="button" class="btn btn-detail-drawer flex-grow-1" onclick="openProductDrawer('${p.id}')">
                                        <i class="bi bi-info-circle me-1"></i> Detayları İncele
                                    </button>
                                    <a href="/Home/TeklifAl?urun=${encodeURIComponent(p.title)}" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-bold" style="background-color: #0b57d0; border: none;">
                                        Teklif Al &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            if (emptyState) {
                container.innerHTML = cardsHtml;
                container.appendChild(emptyState);
            } else {
                container.innerHTML = cardsHtml;
            }

            // Rozet sayılarını veritabanındaki gerçek ürünlerle tam senkronize et
            updateDynamicPillCounts();
        }

        function updateDynamicPillCounts() {
            if (!window.KODDATA_PRODUCTS) return;

            // Kategori hapları rozetleri
            document.querySelectorAll('#bentoFlowCategories .g1-filter-pill[data-cat-slug]').forEach(pill => {
                const slug = pill.getAttribute('data-cat-slug');
                const badge = pill.querySelector('.g1-pill-count');
                if (!badge) return;

                if (slug === 'all') {
                    badge.innerText = window.KODDATA_PRODUCTS.length;
                } else {
                    const count = window.KODDATA_PRODUCTS.filter(p => (p.categories || []).includes(slug)).length;
                    badge.innerText = count;
                }
            });

            // Marka hapları rozetleri
            document.querySelectorAll('#bentoFlowBrands .g1-filter-pill[data-brand-key]').forEach(pill => {
                const brandKey = pill.getAttribute('data-brand-key');
                const badge = pill.querySelector('.g1-pill-count');
                if (!badge) return;

                if (brandKey === 'all') {
                    badge.innerText = window.KODDATA_PRODUCTS.length;
                } else {
                    const count = window.KODDATA_PRODUCTS.filter(p => (p.brand || '').toLowerCase() === brandKey.toLowerCase()).length;
                    badge.innerText = count;
                }
            });
        }

        // Marka ve Kategori Sözlükleri
        const brandMeta = {
            'all': { name: 'TÜM ÇÖZÜM ORTAKLARI', badge: '23 Global & Yerli Marka (225 Model)', desc: 'Otomatik Tanıma, Barkod, POS, Kiosk, Yazarkasa ve Nakit Yönetiminde dünya lideri üreticiler ve kurumsal donanım tedariği.', tag1: '225 Resmi Model', tag2: 'Doğrudan Distribütör', logo: 'HI' },
            'koddata': { name: 'KODDATA', badge: 'Yetkili Çözüm Ortağı', desc: 'Otomatik Tanıma ve Veri Toplama (AIDC) sektöründe öncü donanım üreticisi. Barkod etiket yazıcıları, fiş yazıcıları, karekod okuyucuları ve POS sistemleri.', tag1: '37 Resmi Model', tag2: '2 Yıl Garanti', logo: 'KD' },
            'pax': { name: 'PAX GLOBAL TECHNOLOGY', badge: 'Android POS & Yazarkasa Lideri', desc: 'Dünyanın lider güvenli elektronik ödeme terminali üreticisi. Android işletim sistemli, VUK 507 ve GİB onaylı yeni nesil mobil yazarkasa POS çözümleri.', tag1: 'A910SF Android', tag2: 'VUK 507 & GİB Onaylı', logo: 'PAX' },
            'ingenico': { name: 'INGENICO PAYMENT SERVICES', badge: 'Global Ödeme Standardı', desc: 'Dünya genelinde kullanılan İngenico ödeme sistemleri. Telium TETRA mimarisiyle Türkiye ortak POS altyapısına tam uyumlu mobil ÖKC cihazları.', tag1: 'Move 5000F Serisi', tag2: 'Tüm Bankalarla Uyumlu', logo: 'ING' },
            'inpos': { name: 'İNPOS BİLİŞİM', badge: 'Yerli Ödeme Teknolojisi', desc: 'Yerli Ar-Ge gücüyle geliştirilmiş yeni nesil 4G dokunmatik yazarkasa POS cihazları ve mali onaylı çevre birimleri.', tag1: 'M-530 4G Serisi', tag2: 'TÜBİTAK & GİB Onaylı', logo: 'INP' },
            'beko': { name: 'BEKO ÖDEME SİSTEMLERİ', badge: 'Koç Holding Güvencesi', desc: 'Türkiye çapında yaygın servis ağıyla desteklenen Beko yeni nesil yazarkasa POS terminalleri ve perakende satış çözümleri.', tag1: 'X30 TR Modeli', tag2: 'Yaygın Servis Ağı', logo: 'BKO' },
            'propay': { name: 'PROPAY ÖKC TEKNOLOJİSİ', badge: 'Android ECR Çözümleri', desc: 'Dokunmatik Android arayüzü ile mali yazarkasa donanımını buluşturan yenilikçi perakende satış terminalleri.', tag1: 'P1000 ECR', tag2: '5.5" HD Ekran', logo: 'PRP' },
