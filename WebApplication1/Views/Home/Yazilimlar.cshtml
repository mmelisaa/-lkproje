<!-- DEMO TALEP MODALI -->
<div class="modal fade" id="demoRequestModal" tabindex="-1" aria-labelledby="demoRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <div class="modal-header soft-modal-header border-0">
                <div>
                    <h5 class="modal-title fw-bold" id="demoRequestModalLabel" style="font-family: 'Google Sans', sans-serif;">Canlı Demo Talebi</h5>
                    <small class="soft-modal-subtitle" id="modalSubTitle">Sistemi canlı ekranda test edin</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4" style="background: var(--g1-surface, #ffffff); color: var(--g1-text, #1f1f1f);">
                <form asp-controller="Home" asp-action="TeklifAl" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="konu" id="modalFormKonu" value="Yazılım Demo Talebi" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Seçilen Yazılım</label>
                        <input type="text" id="modalSelectedSoft" class="form-control soft-demo-input bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Ad Soyad / Firma Yetkilisi</label>
                        <input type="text" name="adSoyad" class="form-control soft-demo-input" placeholder="Adınız Soyadınız" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Telefon Numarası</label>
                        <input type="tel" name="telefon" class="form-control soft-demo-input" placeholder="05XX XXX XX XX" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">E-Posta Adresi</label>
                        <input type="email" name="eposta" class="form-control soft-demo-input" placeholder="ornek@firma.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Ek Notlar / Beklentileriniz (Opsiyonel)</label>
                        <textarea name="mesaj" class="form-control rounded-3" rows="3" placeholder="İşletmeniz hakkında kısa bilgi veya özel istekleriniz..."></textarea>
                    </div>
                    <div class="d-flex justify-content-end gap-2 pt-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-dark rounded-pill px-4 fw-semibold d-inline-flex align-items-center gap-2" style="background: #1F1F1F; border-color: #1F1F1F;">
                            <span>Talebi Gönder</span>
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // KATEGORİ FİLTRELEME
    (function () {
        const filterBtns = document.querySelectorAll('.yazilimlar-filter-btn');
        const items = document.querySelectorAll('.soft-item');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                filterBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');

                items.forEach(item => {
                    const cat = item.getAttribute('data-category');
                    if (filter === 'all' || cat === filter) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    })();

    // MODAL AÇICI
    function openDemoModal(softwareName) {
        const modalEl = document.getElementById('demoRequestModal');
        const inputSoft = document.getElementById('modalSelectedSoft');
        const inputKonu = document.getElementById('modalFormKonu');
        const subTitle = document.getElementById('modalSubTitle');

        if (inputSoft) inputSoft.value = softwareName;
        if (inputKonu) inputKonu.value = 'Demo Talebi: ' + softwareName;
        if (subTitle) subTitle.textContent = softwareName + ' için canlı sunum randevusu';

        const inlineSelect = document.getElementById('inlineDemoSelect');
        if (inlineSelect) {
            for (let i = 0; i < inlineSelect.options.length; i++) {
                if (inlineSelect.options[i].text.includes(softwareName) || inlineSelect.options[i].value.includes(softwareName)) {
                    inlineSelect.selectedIndex = i;
                    break;
                }
            }
        }

        if (window.bootstrap && bootstrap.Modal) {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        } else {
            // Alternatif olarak forma scroll
            const formSec = document.getElementById('demoFormSection');
            if (formSec) formSec.scrollIntoView({ behavior: 'smooth' });
        }
    }
</script>
