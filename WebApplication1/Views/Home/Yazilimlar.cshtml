<script>
    // ========================================================
    // 🌟 1. LUSION SCROLL-DRIVEN STAGGERED REVEAL (Ana Sayfa ile Birebir Aynı Giriş Fiziği)
    // ========================================================
    (function () {
        const refItems = document.querySelectorAll('#softCardsRow .ref-item');
        if (!refItems.length) return;

        refItems.forEach((item, index) => {
            if (index % 2 === 0) {
                item.classList.add('ref-from-left');
            } else {
                item.classList.add('ref-from-right');
            }
            const colDelay = (index % 2 === 0) ? 0.08 : 0.24;
            item.style.transitionDelay = colDelay + 's';
        });

        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('lusion-card-in-view');
                    revealObserver.unobserve(entry.target);
                }
            });
        }, {
            threshold: 0.08,
            rootMargin: '0px 0px -30px 0px'
        });

        refItems.forEach(item => revealObserver.observe(item));

        // Sayfa doğrudan yüklendiğinde viewport içinde olanları akıcı bir gecikmeyle canlandır
        setTimeout(() => {
            refItems.forEach(item => {
                const rect = item.getBoundingClientRect();
                if (rect.top < window.innerHeight && rect.bottom > 0) {
                    item.classList.add('lusion-card-in-view');
                }
            });
        }, 120);
    })();

    // ========================================================
    // 🌟 2. KATEGORİ FİLTRELEME & AKICI GEÇİŞ
    // ========================================================
    (function () {
        const filterBtns = document.querySelectorAll('.yazilimlar-filter-btn');
        const items = document.querySelectorAll('#softCardsRow .soft-item');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                filterBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');

                items.forEach((item, idx) => {
                    const cat = item.getAttribute('data-category');
                    if (filter === 'all' || cat === filter) {
                        item.style.display = '';
                        setTimeout(() => {
                            item.classList.add('lusion-card-in-view');
                        }, 50 + (idx * 40));
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    })();

    // ========================================================
    // 🌟 3. MODAL YÖNETİMİ & EKRAN KİLİTLENMESİ / DONDURMA KESİN ÇÖZÜMÜ
    // ========================================================
    (function initModalFix() {
        const modalEl = document.getElementById('demoRequestModal');
        if (modalEl) {
            // CSS Stacking Context Düzeltmesi:
            // main elementi 'z-index: 2' taşıdığından, modal'ı doğrudan body'ye taşıyoruz
            // böylece Bootstrap backdrop perdesi modalın üstünü kapatıp ekranı donduramaz.
            if (modalEl.parentNode !== document.body) {
                document.body.appendChild(modalEl);
            }

            // Modal kapandığında arka planı, dondurucu sınıfları ve padding'i temizle
            modalEl.addEventListener('hidden.bs.modal', function () {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('overflow');
                document.body.style.removeProperty('padding-right');
            });
        }
    })();

    function openDemoModal(softwareName, customSubject) {
        const modalEl = document.getElementById('demoRequestModal');
        if (!modalEl) return;

        // Modalı body'de garantiye al
        if (modalEl.parentNode !== document.body) {
            document.body.appendChild(modalEl);
        }

        const inputSoft = document.getElementById('modalSelectedSoft');
        const inputKonu = document.getElementById('modalFormKonu');
        const subTitle = document.getElementById('modalSubTitle');

        const titleText = customSubject ? customSubject : ('Demo Talebi: ' + softwareName);
        if (inputSoft) inputSoft.value = softwareName;
        if (inputKonu) inputKonu.value = titleText;
        if (subTitle) subTitle.textContent = softwareName + ' için canlı sunum randevusu';

        const inlineSelect = document.getElementById('inlineDemoSelect');
        if (inlineSelect) {
            for (let i = 0; i < inlineSelect.options.length; i++) {
                if (inlineSelect.options[i].text.includes(softwareName) || inlineSelect.options[i].value.includes(softwareName)) {
                    inlineSelect.selectedIndex = i;
                    break;
                }
            }
        }

        // Singleton bootstrap modal kontrolü (ekran dondurmasını önler)
        if (window.bootstrap && bootstrap.Modal) {
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl, {
                backdrop: true,
                keyboard: true,
                focus: true
            });
            modalInstance.show();
        } else {
            const formSec = document.getElementById('demoFormSection');
            if (formSec) formSec.scrollIntoView({ behavior: 'smooth' });
        }
    }
</script>
