@{
    ViewData["Title"] = "Bayi Girişi & Çözüm Ortaklığı";
}

<section class="g1-page-section py-5">
    <div class="container py-lg-4">
        <!-- Google One Centered Hero Header -->
        <div class="text-center mx-auto mb-5" style="max-width: 820px;">
            <div class="g1-pill-badge mb-3 d-inline-flex align-items-center gap-2">
                <span class="g1-four-dots">
                    <i style="background:#4285F4"></i>
                    <i style="background:#EA4335"></i>
                    <i style="background:#FBBC05"></i>
                    <i style="background:#34A853"></i>
                </span>
                <span>B2B KANAL & ÇÖZÜM ORTAKLIĞI PLATFORMU</span>
            </div>
            <h1 class="g1-display-title mb-3">
                Hayat İşleri <span class="google-ai-gradient-text">Bayilik ve İş Ortaklığı Programı</span>
            </h1>
            <p class="g1-lead-text mx-auto" style="max-width: 680px;">
                Ticari programlarımız ve kurumsal donanım çözümlerimizde bayilik avantajlarından yararlanın. B2B portalımız üzerinden özel indirimli fiyatlarla sipariş verin ve lisans süreçlerinizi yönetin.
            </p>
        </div>

        @if (TempData["BayiUyari"] != null)
        {
            <div class="alert alert-warning rounded-4 border-0 shadow-sm p-4 mb-5 d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
                <div class="fw-medium">@TempData["BayiUyari"]</div>
            </div>
        }

        @if (TempData["BayiBasari"] != null)
        {
            <div class="alert alert-success rounded-4 border-0 shadow-sm p-4 mb-5 d-flex align-items-center gap-3">
                <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                <div class="fw-medium">@TempData["BayiBasari"]</div>
            </div>
        }

        <div class="row g-4 align-items-stretch mb-5">
            <!-- Left Column: Dealer Portal Login Card -->
            <div class="col-lg-5" id="bayiGiris">
                <div class="g1-surface-card p-4 p-lg-5 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="g1-icon-circle" style="background: rgba(66, 133, 244, 0.1); width: 58px; height: 58px; padding: 6px;">
                                <img src="~/images/hayat-isleri-logo.svg" alt="Hayat İşleri Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                            </div>
                            <div>
                                <span class="text-uppercase small fw-bold" style="color: #0b57d0; letter-spacing: 0.08em;">B2B Portal</span>
                                <h2 class="h4 fw-bold mb-0">Yetkili Bayi Girişi</h2>
                            </div>
                        </div>

                        <p class="small g1-muted-text mb-4">
                            Size tanımlanan Kurumsal Bayi Kodu ve şifreniz ile oturum açarak müşteri lisanslarını, cari ekstrenizi ve teknik eğitim materyallerini görüntüleyebilirsiniz.
                        </p>

                        <div class="p-2 px-3 rounded-3 mb-3 small" style="background: rgba(11, 87, 208, 0.08); border: 1px dashed rgba(11, 87, 208, 0.35);">
                            <i class="bi bi-key-fill me-1" style="color:#0b57d0;"></i>
                            <strong>Hızlı Test Girişi:</strong> Kullanıcı: <code>bayii</code> &bull; Şifre: <code>bayii123</code> <span class="text-muted">(veya <code>bayi</code> / <code>bayi123</code>, Cari Kod: <code>HYT-3401</code>)</span>
                        </div>

                        <form asp-controller="Bayi" asp-action="Giris" method="post" class="row g-3">
                            @Html.AntiForgeryToken()

                            <div class="col-12">
                                <label class="form-label fw-semibold small">Bayi Kodu, Kullanıcı Adı veya Kurumsal E-Posta *</label>
                                <div class="input-group">
                                    <span class="input-group-text g1-input-addon"><i class="bi bi-building"></i></span>
                                    <input type="text" name="bayiKodu" class="form-control g1-input" placeholder="Örn: bayii, HYT-3401 veya bayi@dogulojistik.com" autocomplete="username" required />
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label fw-semibold small">Portal Şifresi *</label>
                                    <a asp-controller="Bayi" asp-action="SifreUnuttum" class="small text-decoration-none fw-medium" style="color: #0b57d0;">Şifremi Unuttum</a>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text g1-input-addon"><i class="bi bi-key"></i></span>
                                    <input type="password" name="sifre" class="form-control g1-input" placeholder="••••••••••••" autocomplete="current-password" required />
                                </div>
                            </div>

                            <div class="col-12 d-flex align-items-center justify-content-between pt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberDealer" name="beniHatirla" value="true" />
                                    <label class="form-check-label small g1-muted-text" for="rememberDealer">
                                        Oturumumu açık tut
                                    </label>
                                </div>
                                <span class="badge rounded-pill" style="background: rgba(52, 168, 83, 0.14); color: #1e8e3e;">Onaylı Bayi Hesabı</span>
                            </div>

                            <div class="col-12 pt-2">
                                <button type="submit" class="g1-btn-primary w-100 py-3">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Bayi Paneline Giriş Yap
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="g1-info-callout p-3 rounded-4 mt-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="small">
                                <span class="fw-bold d-block">Bayi Destek Masası</span>
                                <a href="tel:+905010146623" class="g1-muted-text text-decoration-none fw-semibold">0501 014 6623</a>
                            </div>
                            <a href="https://wa.me/905010146623" target="_blank" rel="noopener" class="g1-btn-tonal btn-sm px-3 py-2 text-decoration-none">
                                <i class="bi bi-whatsapp me-1"></i>0501 014 6623
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Become a Dealer / Solution Partner Application -->
            <div class="col-lg-7" id="bayiBasvuruFormu">
                <div class="g1-surface-card p-4 p-lg-5 h-100">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
                        <div>
                            <span class="text-uppercase small fw-bold" style="color: #1e8e3e; letter-spacing: 0.08em;">Yeni İş Ortaklığı</span>
                            <h2 class="h4 fw-bold mb-0 mt-1">Çözüm Ortağı & Bayilik Başvurusu</h2>
                        </div>
                        <span class="badge rounded-pill px-3 py-2" style="background: rgba(66, 133, 244, 0.12); color: #1a73e8;">
                            Yönetici Onaylı B2B Kayıt
                        </span>
                    </div>

                    <p class="small g1-muted-text mb-4">
                        Bölgenizdeki işletmelere HiCariTakip ERP, barkod/POS otomasyon ve bulut çözümleri sunmak için başvurun. Güvenlik gereği yeni kayıtlar <strong>Beklemede</strong> statüsünde açılır ve <strong>Admin Onayı</strong> sonrasında aktifleşir.
                    </p>

                    <form asp-controller="Bayi" asp-action="Kayit" method="post" class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Yetkili Adı Soyadı *</label>
                            <input type="text" name="AdSoyad" class="form-control g1-input" placeholder="Adınız Soyadınız" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Firma Unvanı *</label>
                            <input type="text" name="FirmaAdi" class="form-control g1-input" placeholder="Şirket / Bilişim Firması Adı" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Vergi Dairesi *</label>
                            <input type="text" name="VergiDairesi" class="form-control g1-input" placeholder="Örn: Harput VD" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Vergi Numarası / TCKN (10-11 Hane) *</label>
                            <input type="text" name="VergiNo" class="form-control g1-input" placeholder="10 veya 11 haneli vergi no" pattern="\d{10,11}" maxlength="11" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Kurumsal E-Posta *</label>
                            <input type="email" name="Eposta" class="form-control g1-input" placeholder="info@firmaniz.com" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">İletişim Telefonu *</label>
                            <input type="tel" name="Telefon" class="form-control g1-input" placeholder="05XX XXX XX XX" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Bulunduğunuz Şehir *</label>
                            <input type="text" name="Sehir" class="form-control g1-input" placeholder="Örn: Elazığ, İstanbul..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Portal Şifresi Belirleyin *</label>
                            <input type="password" name="Sifre" class="form-control g1-input" placeholder="En az 8 karakter (Büyük/küçük harf, rakam, sembol)" minlength="8" autocomplete="new-password" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Şifre Tekrar *</label>
                            <input type="password" name="SifreTekrar" class="form-control g1-input" placeholder="Şifrenizi tekrar girin" minlength="8" autocomplete="new-password" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Faaliyet Alanınız & Notlarınız *</label>
                            <textarea name="Mesaj" rows="3" class="form-control g1-input" placeholder="Mevcut müşteri portföyünüz, uzmanlık alanınız (ERP, Donanım, POS, Danışmanlık vb.) hakkında kısaca bilgi veriniz..." required></textarea>
                        </div>
                        <div class="col-12 pt-2 d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <span class="small g1-muted-text">
                                <i class="bi bi-shield-check me-1 text-success"></i> Başvurunuz Admin onayından sonra aktifleşir.
                            </span>
                            <button type="submit" class="g1-btn-tonal px-4 py-3 fw-bold">
                                <i class="bi bi-send-plus me-2"></i>Bayilik Başvurusu Gönder
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Google One Style 3-Pillar Partner Benefits -->
        <div class="row g-4">
            <div class="col-md-4">
                <div class="g1-surface-card p-4 h-100">
                    <div class="g1-icon-circle mb-3" style="background: rgba(66, 133, 244, 0.12); color: #1a73e8;">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Yüksek Kar Marjı & Sürekli Gelir</h3>
                    <p class="small g1-muted-text mb-0">
                        Yeni lisans satışlarının yanı sıra yıllık bakım, e-Dönüşüm kontör yenileme ve modül geçişleriyle sürdürülebilir gelir ekosistemi.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="g1-surface-card p-4 h-100">
                    <div class="g1-icon-circle mb-3" style="background: rgba(52, 168, 83, 0.12); color: #1e8e3e;">
                        <i class="bi bi-mortarboard-fill fs-4"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Akademi & Teknik Sertifikasyon</h3>
                    <p class="small g1-muted-text mb-0">
                        Teknik ve satış ekipleriniz için uygulamalı ERP, SQL ve sektörel kurulum eğitimleri ile tam donanımlı saha yetkinliği.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="g1-surface-card p-4 h-100">
                    <div class="g1-icon-circle mb-3" style="background: rgba(251, 188, 4, 0.16); color: #e37400;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <h3 class="h5 fw-bold mb-2">Ortak Proje & Demo Desteği</h3>
                    <p class="small g1-muted-text mb-0">
                        Büyük ölçekli kurumsal projelerde kıdemli yazılım danışmanlarımızla birlikte ortak sunum, analiz ve anahtar teslim kurulum desteği.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
