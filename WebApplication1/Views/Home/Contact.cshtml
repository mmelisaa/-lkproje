@{
    ViewData["Title"] = "İletişim";
}

<div class="container py-5">
    <!-- Sayfa Başlığı -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-6 mb-2" style="color: #E0E6ED !important;">Bizimle İletişime Geçin</h1>
        <p class="fs-6 mb-0" style="color: #94A3B8 !important;">Sorularınız, projeleriniz veya iş birliği teklifleriniz için bize her zaman ulaşabilirsiniz.</p>
    </div>

    @if (TempData["FormMesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4 border-0 shadow-lg" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3) !important; color: #34d399;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["FormMesaj"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5">
        <!-- İletişim Bilgileri ve Sosyal Medya -->
        <div class="col-lg-5">
            <div class="p-4 rounded-4 h-100 shadow-sm" style="background-color: #12141c; border: 1px solid rgba(255,255,255,0.08) !important;">
                <h3 class="text-white fw-bold mb-4 fs-4">İletişim Bilgileri</h3>

                <div class="d-flex align-items-start mb-4">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 me-3 fs-5">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-white fw-bold mb-1">Adres</h6>
                        <p class="text-muted small mb-0">İstanbul & Elazığ / Türkiye</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 me-3 fs-5">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-white fw-bold mb-1">Telefon</h6>
                        <p class="text-muted small mb-0">+90 (500) 000 00 00</p>
                    </div>
                </div>

                <div class="d-flex align-items-start mb-4">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 me-3 fs-5">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <div>
                        <h6 class="text-white fw-bold mb-1">E-Posta</h6>
                        <p class="text-muted small mb-0">info@hayatisleri.com</p>
                    </div>
                </div>

                <hr class="border-secondary opacity-25 my-4">

                <h6 class="text-white fw-bold mb-3">Çalışma Saatleri</h6>
                <p class="text-muted small mb-1">Pazartesi - Cuma: 09:00 - 18:00</p>
                <p class="text-muted small mb-0">Cumartesi - Pazar: Kapalı</p>
            </div>
        </div>

        <!-- İletişim Formu -->
        <div class="col-lg-7">
            <div class="p-4 p-md-5 rounded-4 shadow-sm" style="background-color: #12141c; border: 1px solid rgba(255,255,255,0.08) !important;">
                <h3 class="text-white fw-bold mb-4 fs-4">Bize Mesaj Gönderin</h3>

                <form asp-controller="Home" asp-action="Contact" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="adSoyad" class="form-label text-light small fw-semibold">Adınız Soyadınız *</label>
                            <input type="text" name="adSoyad" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" id="adSoyad" placeholder="Adınız Soyadınız" required style="font-size: 0.95rem;">
                        </div>
                        <div class="col-md-6">
                            <label for="eposta" class="form-label text-light small fw-semibold">E-Posta Adresiniz *</label>
                            <input type="email" name="eposta" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" id="eposta" placeholder="ornek@mail.com" required style="font-size: 0.95rem;">
                        </div>
                        <div class="col-12">
                            <label for="konu" class="form-label text-light small fw-semibold">Konu</label>
                            <input type="text" name="konu" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" id="konu" placeholder="Mesajınızın konusu nedir?" style="font-size: 0.95rem;">
                        </div>
                        <div class="col-12">
                            <label for="mesaj" class="form-label text-light small fw-semibold">Mesajınız *</label>
                            <textarea name="mesaj" class="form-control bg-dark text-white border-secondary border-opacity-50 rounded-3 py-2" id="mesaj" rows="4" placeholder="Mesajınızı buraya yazabilirsiniz..." required style="font-size: 0.95rem;"></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-3 rounded-3 fw-bold shadow-sm">Mesajı Gönder</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>