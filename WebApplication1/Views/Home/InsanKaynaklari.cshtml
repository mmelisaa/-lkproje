@model WebApplication1.Models.Siniflar.InsanKaynaklari
@{
    ViewData["Title"] = Model.AnaBaslik;
}

<!-- ========== HERO BANNER - Canvas Animasyonlu ========== -->
<section class="position-relative overflow-hidden text-white w-100" id="ikHeroBanner" style="background:#050c1a; min-height:360px; display:flex; align-items:center;">
    <canvas id="ikCanvas" class="position-absolute w-100 h-100" style="top:0;left:0;z-index:0;"></canvas>
    <div class="position-absolute w-100 h-100" style="top:0;left:0;z-index:1;background:linear-gradient(135deg,rgba(5,12,26,0.75) 0%,rgba(10,22,55,0.65) 60%,rgba(5,12,26,0.75) 100%);"></div>
    <div class="position-absolute ambient-orb-1" style="top:-80px;right:-80px;width:400px;height:400px;background:radial-gradient(circle,rgba(56,189,248,0.2) 0%,transparent 70%);filter:blur(60px);z-index:1;pointer-events:none;"></div>
    <div class="position-absolute ambient-orb-2" style="bottom:-80px;left:-80px;width:380px;height:380px;background:radial-gradient(circle,rgba(99,102,241,0.2) 0%,transparent 70%);filter:blur(55px);z-index:1;pointer-events:none;"></div>

    <div class="container position-relative text-center py-5" style="z-index:2;">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill mb-4 shadow-sm" style="background:rgba(255,255,255,0.06);border:1px solid rgba(56,189,248,0.3);backdrop-filter:blur(12px);">
            <span class="ref-pulse-dot"></span>
            <span class="text-white small fw-bold text-uppercase" style="letter-spacing:2px;">
                <i class="bi bi-people-fill text-info me-1"></i> @Model.UstBaslik
            </span>
        </div>
        <h1 class="display-4 fw-bold text-white mb-3" style="letter-spacing:-1.2px;">@Model.AnaBaslik</h1>
        <p class="lead text-light text-opacity-75 mx-auto" style="max-width:650px; line-height: 1.75;">
            @Model.Aciklama
        </p>
    </div>
</section>

<!-- Veri Akışı Ayracı -->
<div class="tech-divider-stream opacity-40"></div>

<!-- ========== BAŞVURU FORMU ALANI ========== -->
<div class="position-relative w-100 py-5 overflow-hidden" style="background: radial-gradient(circle at 50% 0%, #0a1329 0%, #050b17 100%);">
    <div class="position-absolute w-100 h-100 tech-grid-bg" style="top:0;left:0;opacity:0.5;pointer-events:none;"></div>
    <div class="position-absolute ambient-orb-1" style="top:20%;right:-80px;width:400px;height:400px;background:radial-gradient(circle,rgba(56,189,248,0.12) 0%,transparent 70%);filter:blur(60px);pointer-events:none;"></div>
    <div class="position-absolute ambient-orb-2" style="bottom:10%;left:-80px;width:420px;height:420px;background:radial-gradient(circle,rgba(168,85,247,0.12) 0%,transparent 70%);filter:blur(60px);pointer-events:none;"></div>

    <div class="container position-relative py-4" style="max-width: 920px; z-index:2;">
        
        <!-- Büyük Siber Cam Başvuru Kartı -->
        <div class="tech-card p-4 p-lg-5 position-relative overflow-hidden shadow-lg tech-tilt-card" style="border: 1px solid rgba(56,189,248,0.22); background: rgba(14, 23, 42, 0.88);">
            <div class="scanline-effect"></div>
            
            <div class="mb-4 pb-3 border-bottom border-white border-opacity-10 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="text-uppercase fw-bold font-monospace text-info small" style="letter-spacing: 1.5px;">İş Başvuru Formu</span>
                    <h3 class="fw-bold text-white mt-1 fs-4" style="letter-spacing: -0.3px;">@Model.FormBaslik</h3>
                    <p class="text-light text-opacity-70 small mb-0">@Model.FormAltBaslik</p>
                </div>
                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill small d-inline-flex align-items-center gap-1.5">
                    <span class="server-led" style="background-color: #10b981; width: 6px; height: 6px;"></span> Başvurular Açık
                </span>
            </div>

            @if (TempData["FormMesaj"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4 border-0 shadow-lg" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3) !important; color: #34d399;">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["FormMesaj"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Form Başlangıcı -->
            <form asp-controller="Home" asp-action="InsanKaynaklariBasvuru" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 mb-3">
                    <!-- Ad Soyad -->
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.09);">
                            <label class="form-label fw-semibold text-white small mb-1">
                                <i class="bi bi-person-fill text-info me-1"></i> Adınız Soyadınız *
                            </label>
                            <input type="text" name="adSoyad" class="form-control bg-transparent border-0 text-white shadow-none py-1 px-0" style="font-size: 0.95rem;" placeholder="Örn: Melisa Can" required>
                        </div>
                    </div>
                    <!-- E-Posta -->
                    <div class="col-md-6">
                        <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.09);">
                            <label class="form-label fw-semibold text-white small mb-1">
                                <i class="bi bi-envelope-fill text-info me-1"></i> E-Posta Adresiniz *
                            </label>
                            <input type="email" name="eposta" class="form-control bg-transparent border-0 text-white shadow-none py-1 px-0" style="font-size: 0.95rem;" placeholder="ornek@mail.com" required>
                        </div>
                    </div>
                </div>

                <!-- Pozisyon -->
                <div class="mb-3">
                    <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.09);">
                        <label class="form-label fw-semibold text-white small mb-1">
                            <i class="bi bi-briefcase-fill text-info me-1"></i> Başvurmak İstediğiniz Pozisyon / Alan
                        </label>
                        <input type="text" name="pozisyon" class="form-control bg-transparent border-0 text-white shadow-none py-1 px-0" style="font-size: 0.95rem;" placeholder="Örn: Web Geliştirici, UI/UX Tasarımcı...">
                    </div>
                </div>

                <!-- Ön Yazı -->
                <div class="mb-4">
                    <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.09);">
                        <label class="form-label fw-semibold text-white small mb-1">
                            <i class="bi bi-chat-text-fill text-info me-1"></i> Ön Yazınız / Kendinizden Bahsedin
                        </label>
                        <textarea name="onYazi" class="form-control bg-transparent border-0 text-white shadow-none px-0" rows="3" style="font-size: 0.95rem;" placeholder="Yeteneklerinizi ve kariyer hedeflerinizi kısaca bahsedin..."></textarea>
                    </div>
                </div>

                <div class="d-grid pt-2">
                    <button type="submit" class="btn btn-primary py-3 fw-bold rounded-pill shadow-lg hero-btn-primary d-inline-flex align-items-center justify-content-center gap-2" style="font-size: 1rem;">
                        <i class="bi bi-send-fill text-warning"></i>
                        <span>Başvuruyu Gönder</span>
                    </button>
                </div>
            </form>
            <!-- Form Bitişi -->

        </div>

    </div>
</div>

@section Scripts {
<script>
(function () {
    const canvas = document.getElementById('ikCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const banner = document.getElementById('ikHeroBanner');
    function resize() { canvas.width = banner.offsetWidth; canvas.height = banner.offsetHeight; }
    resize();
    window.addEventListener('resize', resize);

    const mouse = { x: null, y: null, radius: 150 };
    banner.addEventListener('mousemove', function(e) {
        const rect = banner.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
    });
    banner.addEventListener('mouseleave', function() {
        mouse.x = null;
        mouse.y = null;
    });

    const COUNT = 65, DIST = 135;
    const clrs = ['#38bdf8','#818cf8','#c084fc','#67e8f9'];
    const pts = Array.from({ length: COUNT }, () => ({
        x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.55, vy: (Math.random() - 0.5) * 0.55,
        r: Math.random() * 2.2 + 1, c: clrs[Math.floor(Math.random() * clrs.length)]
    }));

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < pts.length; i++) {
            for (let j = i + 1; j < pts.length; j++) {
                const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
                const d = Math.sqrt(dx*dx + dy*dy);
                if (d < DIST) {
                    ctx.beginPath();
                    ctx.strokeStyle = `rgba(56,189,248,${(1-d/DIST)*0.35})`;
                    ctx.lineWidth = 0.8;
                    ctx.moveTo(pts[i].x, pts[i].y);
                    ctx.lineTo(pts[j].x, pts[j].y);
                    ctx.stroke();
                }
            }

            if (mouse.x !== null && mouse.y !== null) {
                const mdx = pts[i].x - mouse.x;
                const mdy = pts[i].y - mouse.y;
                const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
                if (mdist < mouse.radius) {
                    ctx.beginPath();
                    ctx.strokeStyle = `rgba(129, 140, 248, ${(1 - mdist / mouse.radius) * 0.45})`;
                    ctx.lineWidth = 1;
                    ctx.moveTo(pts[i].x, pts[i].y);
                    ctx.lineTo(mouse.x, mouse.y);
                    ctx.stroke();
                }
            }
        }
        for (const p of pts) {
            ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
            ctx.fillStyle = p.c; ctx.shadowBlur = 8; ctx.shadowColor = p.c;
            ctx.fill(); ctx.shadowBlur = 0;
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        }
        requestAnimationFrame(draw);
    }
    draw();

    // 3D Tilt
    const tiltCards = document.querySelectorAll('.tech-tilt-card');
    tiltCards.forEach(card => {
        card.addEventListener('mouseenter', () => { card.style.transition = 'none'; });
        card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            card.style.transform = `perspective(1000px) rotateX(${-y * 5}deg) rotateY(${x * 5}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
            card.style.transition = 'transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease';
            card.style.transform = '';
        });
    });
})();
</script>
}