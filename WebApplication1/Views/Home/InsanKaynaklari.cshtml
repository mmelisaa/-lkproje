@model WebApplication1.Models.Siniflar.InsanKaynaklari
@{
    ViewData["Title"] = Model.AnaBaslik;
}

<!-- ========== HERO BANNER ========== -->
<section class="position-relative overflow-hidden w-100" id="ikHeroBanner" style="background: transparent; min-height:320px; display:flex; align-items:center;">
    <div class="container position-relative text-center py-5" style="z-index:2;">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill mb-4 shadow-sm" style="background:rgba(255,255,255,0.88);border:1px solid rgba(11, 87, 208,0.2);">
            <span class="ref-pulse-dot" style="background-color: #0b57d0;"></span>
            <span class="small fw-bold text-uppercase" style="letter-spacing:2px; color:#1f1f1f;">
                <i class="bi bi-people-fill me-1" style="color:#0b57d0;"></i> @Model.UstBaslik
            </span>
        </div>
        <h1 class="display-4 fw-bold mb-3" style="letter-spacing:-1.2px; color:#1f1f1f;">@Model.AnaBaslik</h1>
        <p class="lead mx-auto" style="max-width:650px; line-height: 1.75; color:#444746;">
            @Model.Aciklama
        </p>
    </div>
</section>

<!-- Veri Akışı Ayracı -->
<div class="tech-divider-stream opacity-40"></div>

<!-- ========== BAŞVURU FORMU ALANI ========== -->
<div class="position-relative w-100 py-5 overflow-hidden" style="background: transparent; position: relative; z-index: 2;">
    <div class="position-absolute ambient-orb-1" style="top:20%;right:-80px;width:400px;height:400px;background:radial-gradient(circle,rgba(11, 87, 208,0.06) 0%,transparent 70%);pointer-events:none;"></div>
    <div class="position-absolute ambient-orb-2" style="bottom:10%;left:-80px;width:420px;height:420px;background:radial-gradient(circle,rgba(79,70,229,0.06) 0%,transparent 70%);pointer-events:none;"></div>

    <div class="container position-relative py-4" style="max-width: 920px; z-index:2;">
        
        <!-- Kurumsal Kariyer & Yetenek Başvuru Kartı (AI Plus Plan Card Estetiği) -->
        <div class="hayat-ai-plus-card hayat-ai-plus-card-wide p-4 p-lg-5 position-relative overflow-hidden">
            <div class="hayat-ai-plus-top-bar"></div>

            <div class="mb-4 pb-3 border-bottom hayat-ai-plus-divider d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="hayat-ai-plus-tier-pill">
                            <i class="bi bi-stars"></i> Kariyer &amp; Yetenek Programı
                        </span>
                        <span class="hayat-ai-plus-subpill">İş Başvuru Formu</span>
                    </div>
                    <h3 class="hayat-ai-plus-title mt-1 fs-3 fw-bold" style="letter-spacing: -0.4px;">@Model.FormBaslik</h3>
                    <div class="hayat-ai-plus-highlight-metric mb-2">
                        Yazılım Geliştirme &bull; Saha Otomasyon &bull; UI/UX &amp; Kurumsal Destek
                    </div>
                    <p class="hayat-ai-plus-desc small mb-0">@Model.FormAltBaslik</p>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 px-3 py-2 rounded-pill small d-inline-flex align-items-center gap-1.5">
                    <span class="server-led" style="background-color: #10b981; width: 6px; height: 6px;"></span> Başvurular Açık
                </span>
            </div>

            <div class="row g-2 mb-4">
                <div class="col-md-6">
                    <div class="hayat-ai-plus-feature-item">
                        <i class="bi bi-stars hayat-ai-plus-sparkle"></i>
                        <span>Gerçek zamanlı kurumsal ERP, POS ve WebGL projelerinde <strong>2x hızlı kariyer gelişimi</strong></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="hayat-ai-plus-feature-item">
                        <i class="bi bi-check2-circle hayat-ai-plus-check"></i>
                        <span>Modern teknoloji yığını, mentorluk ve Elazığ Ar-Ge/Operasyon merkezimizde çalışma imkanı</span>
                    </div>
                </div>
            </div>

            @if (TempData["FormMesaj"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4 border-0 shadow-sm" role="alert" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3) !important; color: #065f46;">
                    <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["FormMesaj"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Form Başlangıcı -->
            <form asp-controller="Home" asp-action="InsanKaynaklariBasvuru" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 mb-3">
                    <!-- Ad Soyad -->
                    <div class="col-md-6">
                        <div class="hayat-ai-plus-input-box p-3 rounded-4">
                            <label class="form-label fw-semibold small mb-1 hayat-ai-plus-label">
                                <i class="bi bi-person-fill me-1 text-primary"></i> Adınız Soyadınız *
                            </label>
                            <input type="text" name="adSoyad" class="form-control bg-transparent border-0 shadow-none py-1 px-0 hayat-ai-plus-input" placeholder="Örn: Melisa Can" required>
                        </div>
                    </div>
                    <!-- E-Posta -->
                    <div class="col-md-6">
                        <div class="hayat-ai-plus-input-box p-3 rounded-4">
                            <label class="form-label fw-semibold small mb-1 hayat-ai-plus-label">
                                <i class="bi bi-envelope-fill me-1 text-primary"></i> E-Posta Adresiniz *
                            </label>
                            <input type="email" name="eposta" class="form-control bg-transparent border-0 shadow-none py-1 px-0 hayat-ai-plus-input" placeholder="ornek@mail.com" required>
                        </div>
                    </div>
                </div>

                <!-- Pozisyon -->
                <div class="mb-3">
                    <div class="hayat-ai-plus-input-box p-3 rounded-4">
                        <label class="form-label fw-semibold small mb-1 hayat-ai-plus-label">
                            <i class="bi bi-briefcase-fill me-1 text-primary"></i> Başvurmak İstediğiniz Pozisyon / Alan
                        </label>
                        <input type="text" name="pozisyon" class="form-control bg-transparent border-0 shadow-none py-1 px-0 hayat-ai-plus-input" placeholder="Örn: Web Geliştirici, UI/UX Tasarımcı, Saha Otomasyon Uzmanı...">
                    </div>
                </div>

                <!-- Ön Yazı -->
                <div class="mb-4">
                    <div class="hayat-ai-plus-input-box p-3 rounded-4">
                        <label class="form-label fw-semibold small mb-1 hayat-ai-plus-label">
                            <i class="bi bi-chat-text-fill me-1 text-primary"></i> Ön Yazınız / Kendinizden Bahsedin
                        </label>
                        <textarea name="onYazi" class="form-control bg-transparent border-0 shadow-none px-0 hayat-ai-plus-input" rows="3" placeholder="Yeteneklerinizi ve kariyer hedeflerinizi kısaca bahsedin..."></textarea>
                    </div>
                </div>

                <div class="d-grid pt-2">
                    <button type="submit" class="hayat-ai-plus-primary-btn py-3 fw-bold rounded-pill shadow-sm d-inline-flex align-items-center justify-content-center gap-2 border-0">
                        <i class="bi bi-stars"></i>
                        <span>Başvuruyu Gönder</span>
                        <i class="bi bi-send-fill ms-1"></i>
                    </button>
                </div>
            </form>
            <!-- Form Bitişi -->

        </div>

    </div>
</div>

@section Scripts {
<script>
(function () {
    const canvas = document.getElementById('ikCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const banner = document.getElementById('ikHeroBanner');
    function resize() { canvas.width = banner.offsetWidth; canvas.height = banner.offsetHeight; }
    resize();
    window.addEventListener('resize', resize);

    const mouse = { x: null, y: null, radius: 150 };
    banner.addEventListener('mousemove', function(e) {
        const rect = banner.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
    });
    banner.addEventListener('mouseleave', function() {
        mouse.x = null;
        mouse.y = null;
    });

    const COUNT = 65, DIST = 135;
    const clrs = ['#38bdf8','#818cf8','#c084fc','#67e8f9'];
    const pts = Array.from({ length: COUNT }, () => ({
        x: Math.random() * canvas.width, y: Math.random() * canvas.height,
        vx: (Math.random() - 0.5) * 0.55, vy: (Math.random() - 0.5) * 0.55,
        r: Math.random() * 2.2 + 1, c: clrs[Math.floor(Math.random() * clrs.length)]
    }));

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < pts.length; i++) {
            for (let j = i + 1; j < pts.length; j++) {
                const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
                const d = Math.sqrt(dx*dx + dy*dy);
                if (d < DIST) {
                    ctx.beginPath();
                    ctx.strokeStyle = `rgba(56,189,248,${(1-d/DIST)*0.35})`;
                    ctx.lineWidth = 0.8;
                    ctx.moveTo(pts[i].x, pts[i].y);
                    ctx.lineTo(pts[j].x, pts[j].y);
                    ctx.stroke();
                }
            }

            if (mouse.x !== null && mouse.y !== null) {
                const mdx = pts[i].x - mouse.x;
                const mdy = pts[i].y - mouse.y;
                const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
                if (mdist < mouse.radius) {
                    ctx.beginPath();
                    ctx.strokeStyle = `rgba(129, 140, 248, ${(1 - mdist / mouse.radius) * 0.45})`;
                    ctx.lineWidth = 1;
                    ctx.moveTo(pts[i].x, pts[i].y);
                    ctx.lineTo(mouse.x, mouse.y);
                    ctx.stroke();
                }
            }
        }
        for (const p of pts) {
            ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
            ctx.fillStyle = p.c; ctx.shadowBlur = 8; ctx.shadowColor = p.c;
            ctx.fill(); ctx.shadowBlur = 0;
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        }
        requestAnimationFrame(draw);
    }
    draw();

    // 3D Tilt
    const tiltCards = document.querySelectorAll('.tech-tilt-card');
    tiltCards.forEach(card => {
        card.addEventListener('mouseenter', () => { card.style.transition = 'none'; });
        card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            card.style.transform = `perspective(1000px) rotateX(${-y * 5}deg) rotateY(${x * 5}deg) translateY(-4px)`;
        });
        card.addEventListener('mouseleave', () => {
            card.style.transition = 'transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease';
            card.style.transform = '';
        });
    });
})();
</script>
}
