@{
    ViewData["Title"] = "Anasayfa";
}

<!-- 1. Tüm Sayfayı (Baştan Başa) Kaplayan Canlı Teknoloji Alanı (Siyah Yok, Ferah ve Kurumsal Renkler) -->
<div class="position-relative overflow-hidden w-100 text-white text-center py-5 mb-5 shadow-sm" style="min-height: 600px; display: flex; align-items: center; justify-content: center; margin-top: -1.5rem;">
    <!-- Arka Planda Akıp Giden Canlı Video -->
    <video autoplay muted loop playsinline class="position-absolute w-100 h-100 object-fit-cover" style="top: 0; left: 0; z-index: -2;">
        <source src="https://assets.mixkit.co/videos/preview/mixkit-digital-animation-of-screens-with-codes-and-numbers-31950-large.mp4" type="video/mp4">
    </video>
    
    <!-- Üzerindeki Perde: Siyah Yerine Şık, Kurumsal Derin Mavi / Lacivert Tonu -->
    <div class="position-absolute w-100 h-100" style="top: 0; left: 0; background: linear-gradient(135deg, rgba(13, 37, 63, 0.88), rgba(30, 58, 138, 0.82)); z-index: -1;"></div>

    <div class="container position-relative py-5" style="z-index: 1;">
        <div class="col-lg-10 mx-auto">
            <span class="badge bg-white text-primary px-4 py-2 rounded-pill fw-bold mb-3 shadow-sm text-uppercase tracking-wider">
                <i class="bi bi-cpu me-2"></i> Donanım & Yazılım Entegrasyonu
            </span>
            <h1 class="display-3 fw-bold mb-4 tracking-tight text-white">Donanımdan Yazılıma Uçtan Uca Teknoloji Çözümleri</h1>
            <p class="lead text-light opacity-90 mb-5 fs-5">Elazığ merkezli gücümüzle; yüksek performanslı donanım altyapıları ve işletmenizi geleceğe taşıyan özel yazılım projelerinde güvenilir çözüm ortağınız.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Hakkimizda" class="btn btn-light text-primary px-5 py-3 rounded-pill fw-bold shadow">Hakkımızda</a>
                <a asp-controller="Home" asp-action="HesapNumaralarimiz" class="btn btn-outline-light px-5 py-3 rounded-pill fw-bold">Finansal İşlemler</a>
            </div>
        </div>
    </div>
</div>

<div class="container my-5 py-4">
    <!-- 2. Hizmet Alanlarımız (Donanım + Yazılım) -->
    <div class="row text-center mb-5">
        <div class="col-lg-8 mx-auto">
            <h2 class="fw-bold text-dark mb-3">Faaliyet Alanlarımız</h2>
            <p class="text-muted fs-5">Güçlü donanım sistemleri ve ölçeklenebilir yazılım mimarilerini tek çatı altında buluşturuyoruz.</p>
        </div>
    </div>

    <div class="row g-4 justify-content-center mb-5">
        <!-- Hizmet 1: Donanım Altyapıları -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white position-relative overflow-hidden transition-hover border-top border-primary border-4">
                <div class="card-body">
                    <div class="mb-4 text-primary bg-primary bg-opacity-10 d-inline-block p-3 rounded-4 fs-4">
                        <i class="bi bi-hdd-rack"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">Donanım Çözümleri</h4>
                    <p class="text-muted mb-0">Sunucu sistemleri, kurumsal donanım tedariği ve kesintisiz teknolojik altyapı kurulumları.</p>
                </div>
            </div>
        </div>

        <!-- Hizmet 2: Özel Yazılım -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white position-relative overflow-hidden transition-hover border-top border-primary border-4">
                <div class="card-body">
                    <div class="mb-4 text-primary bg-primary bg-opacity-10 d-inline-block p-3 rounded-4 fs-4">
                        <i class="bi bi-code-slash"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">Yazılım Geliştirme</h4>
                    <p class="text-muted mb-0">İş süreçlerinizi hızlandıran, tamamen ihtiyaçlarınıza özel güvenli web ve masaüstü yazılımlar.</p>
                </div>
            </div>
        </div>

        <!-- Hizmet 3: Web & E-Ticaret -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white position-relative overflow-hidden transition-hover border-top border-primary border-4">
                <div class="card-body">
                    <div class="mb-4 text-primary bg-primary bg-opacity-10 d-inline-block p-3 rounded-4 fs-4">
                        <i class="bi bi-globe"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">Web & E-Ticaret</h4>
                    <p class="text-muted mb-0">Markanızı dijitalde zirveye taşıyan, modern arayüzlü kurumsal web siteleri ve e-ticaret sistemleri.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Neden Hayat İşleri? (Çift Kanatlı Güç Vurgusu) -->
    <div class="row mt-5 pt-5 align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <div class="p-5 rounded-4 shadow-sm border border-light" style="background-color: #f8fafc;">
                <span class="badge bg-primary text-white px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">ELAZIĞ MERKEZLİ TEKNOLOJİ ÜSSÜ</span>
                <h3 class="fw-bold text-dark mb-3">Donanım ve Yazılımın Mükemmel Uyumu</h3>
                <p class="text-muted mb-4 fs-6">
                    Hayat İşleri olarak sadece kod yazmıyor; aynı zamanda güçlü donanım altyapılarını kurarak sistemlerinizin her katmanında kusursuz performans sağlıyoruz.
                </p>
                <div class="d-flex gap-4">
                    <div>
                        <h3 class="fw-bold text-primary mb-1">%100</h3>
                        <span class="text-muted small fw-semibold">Entegre Çözüm</span>
                    </div>
                    <div class="border-start ps-4">
                        <h3 class="fw-bold text-primary mb-1">7/24</h3>
                        <span class="text-muted small fw-semibold">Teknik Destek</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="row g-3">
                <div class="col-12">
                    <div class="p-4 rounded-4 bg-white shadow-sm border border-light d-flex align-items-center">
                        <div class="fs-3 text-primary me-4 bg-primary bg-opacity-10 p-3 rounded-3">
                            <i class="bi bi-cpu-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Güçlü Donanım Altyapısı</h5>
                            <p class="text-muted small mb-0">İşletmenizin ihtiyaç duyduğu en dayanıklı ve ölçeklenebilir donanım bileşenleri.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="p-4 rounded-4 bg-white shadow-sm border border-light d-flex align-items-center">
                        <div class="fs-3 text-primary me-4 bg-primary bg-opacity-10 p-3 rounded-3">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Uçtan Uca Güvenlik</h5>
                            <p class="text-muted small mb-0">Donanımdan yazılıma kadar sızdırmaz ve koruma altında olan kurumsal mimariler.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>