            </div>
        </div>
    </div>

    <!-- Aşağı kaydırma işareti -->
    <div id="scrollDownHint" aria-hidden="true" style="position:absolute;left:50%;bottom:96px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none;transition:opacity .4s;z-index:10;">
        <span style="font-size:.72rem;letter-spacing:2px;text-transform:uppercase;color:#444746;font-weight:600;">Kaydır</span>
        <span class="scroll-hint-arrow" style="display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:50%;background:#ffffff;border:1px solid rgba(11, 87, 208,.35);color:#0b57d0;font-size:1.4rem;line-height:1;box-shadow:0 6px 18px rgba(11, 87, 208,.18);">&#8628;</span>
    </div>
    <script>
        (function() {
            var h = document.getElementById('scrollDownHint');
            if (!h) return;
            var isHidden = false;
            function chk() {
                var shouldHide = (window.scrollY || window.pageYOffset || 0) > 60;
                if (shouldHide !== isHidden) {
                    isHidden = shouldHide;
                    h.style.opacity = isHidden ? '0' : '1';
                }
            }
            window.addEventListener('scroll', chk, { passive: true });
            chk();
        })();
    </script>
</section>

