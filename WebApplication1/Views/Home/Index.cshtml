<style>
/* 3D SPLINE DROPDOWN STYLES */
.spline-partners-section {
    position: relative;
    z-index: 2;
}

.spline-3d-stage {
    perspective: 1200px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 380px;
    padding: 15px 10px;
    contain: layout style;
}

.spline-3d-backplate {
    position: absolute;
    width: 95%;
    height: 94%;
    top: 3%;
    left: 2%;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 30px;
    transform: rotateX(12deg) rotateY(-18deg) rotateZ(2.5deg) translateZ(-35px) translate3d(0, 0, 0);
    -webkit-transform: rotateX(12deg) rotateY(-18deg) rotateZ(2.5deg) translateZ(-35px) translate3d(0, 0, 0);
    box-shadow: 0 30px 70px rgba(11, 87, 208, 0.12), 0 12px 28px rgba(15, 23, 42, 0.08);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform;
}

.spline-3d-card {
    position: relative;
    width: 100%;
    max-width: 410px;
    background: linear-gradient(135deg, #74b9ff 0%, #a29bfe 36%, #d6a2e8 68%, #fab1a0 100%);
    border-radius: 24px;
    padding: 18px 16px 20px 16px;
    transform: rotateX(12deg) rotateY(-18deg) rotateZ(2.5deg);
    -webkit-transform: rotateX(12deg) rotateY(-18deg) rotateZ(2.5deg);
    transform-style: preserve-3d;
    box-shadow: 
        0 0 0 1px rgba(255, 255, 255, 0.8),
        8px 12px 0px rgba(130, 150, 225, 0.35),
        14px 20px 35px rgba(15, 23, 42, 0.16);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s;
    user-select: none;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform;
}

.spline-card-sheen {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 45%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 100%);
    border-radius: 24px 24px 80px 80px;
    pointer-events: none;
}

.spline-window-dots {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 14px;
    position: relative;
    z-index: 2;
}

.spline-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
}

.spline-dot.dot-red {
    background: radial-gradient(circle at 35% 35%, #ff8579 0%, #ff4b4b 60%, #b91c1c 100%);
    box-shadow: 0 2px 5px rgba(239, 68, 68, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.8);
}
.spline-dot.dot-yellow {
    background: radial-gradient(circle at 35% 35%, #ffe979 0%, #ffb830 60%, #b45309 100%);
    box-shadow: 0 2px 5px rgba(245, 158, 11, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.8);
}
.spline-dot.dot-green {
    background: radial-gradient(circle at 35% 35%, #86efac 0%, #22c55e 60%, #15803d 100%);
    box-shadow: 0 2px 5px rgba(34, 197, 94, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.8);
}

.spline-3d-badge-sub {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: rgba(255, 255, 255, 0.9);
    margin-left: auto;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}

.spline-select-bar {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(180deg, #1b2434 0%, #0d1522 100%);
    border-radius: 15px;
    padding: 10px 12px 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.25), 0 8px 20px rgba(10, 18, 30, 0.38);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.spline-select-bar:hover {
    background: linear-gradient(180deg, #243046 0%, #121c2d 100%);
    border-color: rgba(96, 165, 250, 0.4);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.35), 0 10px 24px rgba(11, 87, 208, 0.28);
}

.spline-select-label-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
}

.spline-select-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(135deg, rgba(11, 87, 208, 0.35) 0%, rgba(99, 102, 241, 0.35) 100%);
    border: 1px solid rgba(96, 165, 250, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #60a5fa;
    font-size: 1.05rem;
}

.spline-select-title {
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.3px;
    line-height: 1.2;
}

.spline-select-subtitle {
    color: #94a3b8;
    font-size: 0.72rem;
    font-weight: 500;
}

.spline-action-btn {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, #c084fc 0%, #e879f9 50%, #f472b6 100%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.7), 0 3px 0 #9333ea, 0 6px 14px rgba(217, 70, 239, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.05rem;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
}

.spline-select-bar:hover .spline-action-btn {
    transform: translateY(-2px);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.8), 0 5px 0 #9333ea, 0 10px 20px rgba(217, 70, 239, 0.5);
}

.spline-chevron-icon {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* OPEN STATE */
.spline-3d-card.is-open .spline-chevron-icon {
    transform: rotate(180deg);
}

.spline-3d-card.is-open .spline-action-btn {
    background: linear-gradient(135deg, #818cf8 0%, #6366f1 100%);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.7), 0 3px 0 #4338ca, 0 6px 14px rgba(79, 70, 229, 0.4);
}

.spline-dropdown-menu {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    margin-top: 0;
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, margin-top 0.3s ease;
    border-radius: 16px;
    background: rgba(13, 20, 35, 0.94);
    backdrop-filter: blur(24px);
