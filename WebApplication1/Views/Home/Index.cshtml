@section Scripts {
    <!-- Three.js 3D WebGL Kütüphanesi -->
    <script src="~/lib/three/three.min.js"></script>

    
    <!-- APPLE LIGHT 3D SLALOM ENGINE: Kod kartları scroll ile slalom çizerek bağımsız aşağı iner -->
    <script>
        (function() {
            const canvas = document.getElementById('lusionWebglCanvas');
            if (!canvas || typeof THREE === 'undefined') return;

            // SAHNE & RENDERER (Google One Dynamic Theme - Ultra Optimize 60 FPS)
            const scene = new THREE.Scene();
            scene.background = null;

            const isMobileDevice = window.innerWidth < 768;

            const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0, 22);

            const renderer = new THREE.WebGLRenderer({
                canvas: canvas,
                antialias: true,
                alpha: true,
                powerPreference: 'high-performance',
                precision: 'highp'
            });
            renderer.setClearColor(0x000000, 0);
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2.0));
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.05;

            // IŞIKLANDIRMA (Google One Ambiyans & Zengin 3D Işıklandırma)
            scene.add(new THREE.AmbientLight(0xffffff, 0.95));
            const keyLight = new THREE.DirectionalLight(0xffffff, 1.45);
            keyLight.position.set(14, 22, 18);
            scene.add(keyLight);

            const fillLight = new THREE.DirectionalLight(0x4285F4, 1.10);
            fillLight.position.set(-16, -12, 15);
            scene.add(fillLight);

            const backLight = new THREE.DirectionalLight(0x9B72CB, 0.85);
            backLight.position.set(4, 18, -16);
            scene.add(backLight);

            // AMBIENT PARÇACIKLAR (Zarif ve hafif uzay tozu)
            const dustCount = isMobileDevice ? 60 : 100;
            const dustGeo = new THREE.BufferGeometry();
            const dustPos = new Float32Array(dustCount * 3);
            for (let i = 0; i < dustCount * 3; i += 3) {
                dustPos[i] = (Math.random() - 0.5) * 80;
                dustPos[i+1] = (Math.random() - 0.5) * 160;
                dustPos[i+2] = (Math.random() - 0.5) * 50;
            }
            dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPos, 3));
            const dustMat = new THREE.PointsMaterial({
                color: 0x60a5fa,
                size: isMobileDevice ? 0.2 : 0.14,
                transparent: true,
                opacity: 0.45
            });
            const dustPts = new THREE.Points(dustGeo, dustMat);
            scene.add(dustPts);

            // ÇİFT SARMAL AKIŞ OTOYOLLARI (Dual Intertwined Fiber Splines)
            const flowPts1 = [], flowPts2 = [];
            const flowCount = 42;
            for (let i = 0; i < flowCount; i++) {
                const t = i / (flowCount - 1);
                const y = (t - 0.5) * 115;
                // Spline 1: Apple Blue Ana Hat
                flowPts1.push(new THREE.Vector3(
                    Math.sin(t * Math.PI * 3.6) * 13 + Math.cos(t * Math.PI * 1.2) * 4,
                    y,
                    Math.cos(t * Math.PI * 2.4) * 8 + Math.sin(t * Math.PI * 0.6) * 3
                ));
                // Spline 2: Buz Mavisi Karşı Hat
                flowPts2.push(new THREE.Vector3(
                    Math.sin(t * Math.PI * 3.6 + Math.PI) * 11 + Math.cos(t * Math.PI * 0.9) * 3,
                    y,
                    Math.cos(t * Math.PI * 2.4 + Math.PI) * 7 - Math.sin(t * Math.PI * 0.5) * 2
                ));
            }
            const flowCurve1 = new THREE.CatmullRomCurve3(flowPts1);
            const flowCurve2 = new THREE.CatmullRomCurve3(flowPts2);
            const flowGeo1 = new THREE.TubeGeometry(flowCurve1, 100, 0.042, 10, false);
            const flowGeo2 = new THREE.TubeGeometry(flowCurve2, 100, 0.028, 8, false);
            const flowMat1 = new THREE.MeshBasicMaterial({ color: 0x0071e3, transparent: true, opacity: 0.55 });
            const flowMat2 = new THREE.MeshBasicMaterial({ color: 0x7dd3fc, transparent: true, opacity: 0.38 });
            const flowMesh1 = new THREE.Mesh(flowGeo1, flowMat1);
            const flowMesh2 = new THREE.Mesh(flowGeo2, flowMat2);
            scene.add(flowMesh1);
            scene.add(flowMesh2);

            // ========================================================
            // 🌟 LUSION ARCHITECTURAL SCI-FI MONOLITH & ASTROLABE
            // (Çok katmanlı kristal geodezik kafes, elmas matrisi, kuantum çekirdek)
            // ========================================================
            const monumentGroup = new THREE.Group();
            monumentGroup.position.set(3.6, 0.2, -1);
            scene.add(monumentGroup);

            // 1. Dış Geodezik Kristal Kafes (Faceted Kristal Üçgen Yüzeyler - Akıcı & Detaylı)
            const outerIcosaGeo = new THREE.IcosahedronGeometry(4.5, 2);
            const glassMat = new THREE.MeshStandardMaterial({
                color: 0xbfdbfe,
                roughness: 0.10,
                metalness: 0.28,
                transparent: true,
                opacity: 0.52,
                flatShading: true
            });
            const outerCrystal = new THREE.Mesh(outerIcosaGeo, glassMat);
            monumentGroup.add(outerCrystal);

            // Dış İnce Geodezik Tel Kafes (Neon Apple Blue)
            const wireGeo = new THREE.WireframeGeometry(outerIcosaGeo);
            const wireMat = new THREE.LineBasicMaterial({
                color: 0x0071e3,
                transparent: true,
                opacity: 0.85,
                linewidth: 1.5
            });
            const wireLines = new THREE.LineSegments(wireGeo, wireMat);
            outerCrystal.add(wireLines);

            // 1.B. İç Ters Dönen Prizmatik Elmas Çekirdek (Dual Faceted Diamond Matrix)
            const diamondGeo = new THREE.OctahedronGeometry(3.2, 2);
            const diamondMat = new THREE.MeshStandardMaterial({
                color: 0x93c5fd,
                roughness: 0.08,
                metalness: 0.35,
                transparent: true,
                opacity: 0.55,
                flatShading: true
            });
            const diamondMesh = new THREE.Mesh(diamondGeo, diamondMat);
            monumentGroup.add(diamondMesh);

            const diamondWire = new THREE.LineSegments(
                new THREE.WireframeGeometry(diamondGeo),
                new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.70 })
            );
            diamondMesh.add(diamondWire);

            // Köşe Veri Matrisi Düğümleri (Luminous Cyan Nodes)
            const nodeGeo = new THREE.SphereGeometry(0.08, 12, 12);
            const nodeMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
            const posAttr = outerIcosaGeo.getAttribute('position');
            const seenVerts = new Set();
            for (let i = 0; i < posAttr.count; i++) {
                const key = `${posAttr.getX(i).toFixed(1)},${posAttr.getY(i).toFixed(1)},${posAttr.getZ(i).toFixed(1)}`;
                if (!seenVerts.has(key)) {
                    seenVerts.add(key);
                    const nodeMesh = new THREE.Mesh(nodeGeo, nodeMat);
                    nodeMesh.position.set(posAttr.getX(i), posAttr.getY(i), posAttr.getZ(i));
                    outerCrystal.add(nodeMesh);
                }
            }

            // 2. Orta Katman: Dönen Dodekahedron Matrisi (Ters Dönüş)
            const midDodecaGeo = new THREE.DodecahedronGeometry(3.1, 0);
            const midDodecaMat = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.70 });
            const midDodecaMesh = new THREE.LineSegments(new THREE.WireframeGeometry(midDodecaGeo), midDodecaMat);
            monumentGroup.add(midDodecaMesh);

            // 3. İç Kuantum Hiper-Çekirdek (Dual Octahedron + Pulsing Sphere + Dinamik Işık)
            const coreGroup = new THREE.Group();
            monumentGroup.add(coreGroup);

            const coreOcta1 = new THREE.Mesh(
                new THREE.OctahedronGeometry(1.8, 1),
                new THREE.MeshBasicMaterial({ color: 0x0071e3, wireframe: true, transparent: true, opacity: 0.85 })
            );
            const coreOcta2 = new THREE.Mesh(
                new THREE.OctahedronGeometry(1.1, 0),
                new THREE.MeshBasicMaterial({ color: 0x818cf8, wireframe: true, transparent: true, opacity: 0.80 })
            );
            const corePulseSphere = new THREE.Mesh(
                new THREE.SphereGeometry(0.55, 32, 32),
                new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.75 })
            );
            const monumentCoreLight = new THREE.PointLight(0x38bdf8, 2.2, 25);
            coreGroup.add(coreOcta1);
            coreGroup.add(coreOcta2);
            coreGroup.add(corePulseSphere);
            coreGroup.add(monumentCoreLight);

            // 4. Dörtlü Detaylı Giroskopik Yörünge Halkaları (Astrolabe Gimbal - Pürüzsüz & Yüksek Poligon)
            const rings = [];
            const ringConfigs = [
                { radius: 5.7, tube: 0.040, rotX: 0.75, rotY: 0.35, speed: 0.34, color: 0x4285F4, opacity: 0.88 },
                { radius: 7.3, tube: 0.035, rotX: -0.68, rotY: 0.92, speed: -0.26, color: 0xEA4335, opacity: 0.82 },
                { radius: 8.8, tube: 0.030, rotX: 0.52, rotY: -0.78, speed: 0.18, color: 0xFBBC04, opacity: 0.85 },
                { radius: 10.4, tube: 0.018, rotX: -0.35, rotY: 0.55, speed: -0.12, color: 0x34A853, opacity: 0.80 }
            ];

            ringConfigs.forEach((cfg) => {
                const ringGroup = new THREE.Group();
                ringGroup.rotation.set(cfg.rotX, cfg.rotY, 0);

                const ringGeo = new THREE.TorusGeometry(cfg.radius, cfg.tube, 16, 128);
                const ringMat = new THREE.MeshBasicMaterial({ color: cfg.color, transparent: true, opacity: cfg.opacity });
                const ringMesh = new THREE.Mesh(ringGeo, ringMat);
                ringGroup.add(ringMesh);

                // Bileşik Siber Uydular (Gövde + Kanatlar + Parlayan Fener)
                const satellites = [];
                for (let s = 0; s < 2; s++) {
                    const satGroup = new THREE.Group();
                    const body = new THREE.Mesh(
                        new THREE.BoxGeometry(0.24, 0.24, 0.24),
                        new THREE.MeshBasicMaterial({ color: 0x0f172a })
                    );
                    const wings = new THREE.Mesh(
                        new THREE.BoxGeometry(0.60, 0.03, 0.15),
                        new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.85 })
                    );
                    const beacon = new THREE.Mesh(
                        new THREE.SphereGeometry(0.08, 8, 8),
                        new THREE.MeshBasicMaterial({ color: 0x60a5fa })
                    );
                    beacon.position.y = 0.18;
                    satGroup.add(body);
                    satGroup.add(wings);
                    satGroup.add(beacon);

                    ringGroup.add(satGroup);
                    satellites.push({ group: satGroup, angle: s * Math.PI, radius: cfg.radius });
                }

                monumentGroup.add(ringGroup);
                rings.push({ group: ringGroup, speed: cfg.speed, satellites: satellites });
            });

            // 5. Yörüngede Dönen 12 Kristal Parçacığı
            const shards = [];
            for (let i = 0; i < 12; i++) {
                const sGeo = new THREE.OctahedronGeometry(0.24 + Math.random() * 0.16, 0);
                const sMat = new THREE.MeshBasicMaterial({
                    color: i % 3 === 0 ? 0x93c5fd : (i % 3 === 1 ? 0x38bdf8 : 0x0071e3),
                    transparent: true,
                    opacity: 0.70
                });
                const sMesh = new THREE.Mesh(sGeo, sMat);
                const orbitRadius = 6.2 + Math.random() * 5.2;
                const theta = (i / 12) * Math.PI * 2;
                const phi = (Math.random() - 0.5) * 0.9;
                sMesh.position.set(
                    orbitRadius * Math.cos(theta) * Math.cos(phi),
                    orbitRadius * Math.sin(phi),
                    orbitRadius * Math.sin(theta) * Math.cos(phi)
                );
                monumentGroup.add(sMesh);
                shards.push({
                    mesh: sMesh,
                    speed: (Math.random() - 0.5) * 0.35,
                    radius: orbitRadius,
                    theta: theta,
                    phi: phi,
                    rotSpeedX: (Math.random() - 0.5) * 1.5,
                    rotSpeedY: (Math.random() - 0.5) * 1.5
                });
            }

            // 6. Siber Takımyıldızı Veri Noktaları (Constellation Network)
            const constCount = 14;
            const constNodes = [];
            const constGroup = new THREE.Group();
            monumentGroup.add(constGroup);

            for (let i = 0; i < constCount; i++) {
                const nMesh = new THREE.Mesh(
                    new THREE.SphereGeometry(0.10, 8, 8),
                    new THREE.MeshBasicMaterial({ color: 0x38bdf8 })
                );
                const r = 5.0 + Math.random() * 4.5;
                const u = Math.random();
                const v = Math.random();
                const th = u * 2.0 * Math.PI;
                const ph = Math.acos(2.0 * v - 1.0);
                nMesh.position.set(
                    r * Math.sin(ph) * Math.cos(th),
                    r * Math.sin(ph) * Math.sin(th),
                    r * Math.cos(ph)
                );
                constGroup.add(nMesh);
                constNodes.push({ mesh: nMesh, basePos: nMesh.position.clone(), seed: Math.random() * 10 });
            }

            // ========================================================
            // 💻 DETAYLI HUD SİBER KOD PENCERESİ MOTORU
            // ========================================================
            function createCodeTex(title, tag, sub1, sub2, isDarkTheme) {
                const c = document.createElement('canvas');
                c.width = 960; c.height = 336;
                const ctx = c.getContext('2d');
                ctx.scale(2, 2);

                // Kart gövdesi (Açık modda #ffffff, Koyu modda #181a1f)
                ctx.fillStyle = isDarkTheme ? '#181a1f' : '#ffffff';
                ctx.beginPath();
                if (ctx.roundRect) ctx.roundRect(4, 4, 472, 160, 16);
                else ctx.rect(4, 4, 472, 160);
                ctx.fill();

                // Google One İnce Zarif Kart Sınırı
                ctx.lineWidth = 2.5;
                ctx.strokeStyle = isDarkTheme ? 'rgba(138, 180, 248, 0.45)' : 'rgba(66, 133, 244, 0.45)';
                ctx.stroke();

                // Google Pencere Butonları (Kırmızı, Sarı, Yeşil)
                ctx.fillStyle = '#EA4335'; ctx.beginPath(); ctx.arc(28, 26, 5.5, 0, Math.PI*2); ctx.fill();
                ctx.fillStyle = '#FBBC04'; ctx.beginPath(); ctx.arc(46, 26, 5.5, 0, Math.PI*2); ctx.fill();
                ctx.fillStyle = '#34A853'; ctx.beginPath(); ctx.arc(64, 26, 5.5, 0, Math.PI*2); ctx.fill();

                // Sağ üst durum etiketi
                if (tag) {
                    ctx.font = 'bold 13px "Google Sans", "SF Mono", Consolas, monospace';
                    ctx.fillStyle = isDarkTheme ? '#8ab4f8' : '#0b57d0';
                    ctx.textAlign = 'right';
                    ctx.fillText('● ' + tag, 452, 28);
                }

                // HUD köşe parantezleri ┌ ┐ └ ┘
                ctx.strokeStyle = isDarkTheme ? 'rgba(138, 180, 248, 0.28)' : 'rgba(66, 133, 244, 0.25)';
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(14, 52); ctx.lineTo(14, 44); ctx.lineTo(24, 44);
                ctx.moveTo(466, 52); ctx.lineTo(466, 44); ctx.lineTo(456, 44);
                ctx.moveTo(14, 136); ctx.lineTo(14, 144); ctx.lineTo(24, 144);
                ctx.moveTo(466, 136); ctx.lineTo(466, 144); ctx.lineTo(456, 144);
                ctx.stroke();

                // Satır 1: Ana kod başlığı
                ctx.font = 'bold 22px "Google Sans", -apple-system, sans-serif';
                ctx.fillStyle = isDarkTheme ? '#f1f3f4' : '#1f1f1f';
                ctx.textAlign = 'left';
                ctx.fillText(title, 28, 76);

                // Satır 2: Alt kod / Fonksiyon imzası
                ctx.font = '500 15px "Google Sans Text", "SF Mono", Consolas, monospace';
                ctx.fillStyle = isDarkTheme ? '#8ab4f8' : '#0b57d0';
                ctx.fillText(sub1 || 'class StudioEngine : IWebGL', 28, 108);

                // Satır 3: Sistem telemetrisi
                ctx.font = '12px "Google Sans Text", "SF Mono", Consolas, monospace';
                ctx.fillStyle = isDarkTheme ? '#9aa0a6' : '#747775';
                ctx.fillText(sub2 || 'latency: 4ms • status: 200 OK • 60 FPS', 28, 138);

                const tex = new THREE.CanvasTexture(c);
                tex.minFilter = THREE.LinearFilter;
                tex.magFilter = THREE.LinearFilter;
                return tex;
            }

            const codeBoxGeo = new THREE.BoxGeometry(2.9, 1.05, 0.06);
            const initDark = document.documentElement.getAttribute('data-theme') === 'dark';

            // A. HERO KOD PENCERELERİ (Açılışta 3D derinlikte süzülür)
            const heroCardDefs = [
                { title: 'Hayat İşleri Çözümleri', tag: 'ELAZIĞ', sub1: 'HiCariTakip.Core()', sub2: 'İşletme Çözümleri • Elazığ Merkez', x: 2.2, y: 3.6, z: 2.2 },
                { title: 'Ön Muhasebe & ERP', tag: 'HİCARİ', sub1: 'CariTakip.Entegrasyon()', sub2: 'Cari • Stok • Fatura • e-Dönüşüm', x: 7.2, y: 1.8, z: 1.2 },
                { title: 'Barkod & Hızlı Satış', tag: 'POS', sub1: 'PosDevice.Connect()', sub2: 'Market • Mağaza • Perakende POS', x: 1.0, y: -2.8, z: 2.6 },
                { title: 'Özel Yazılım & Web', tag: '.NET 9', sub1: 'HayatIsleri.Yazilim()', sub2: 'ASP.NET Core • Kurumsal Çözümler', x: 6.4, y: -3.4, z: 1.5 }
            ];

            const heroCards = [];
            heroCardDefs.forEach((d) => {
                const tex = createCodeTex(d.title, d.tag, d.sub1, d.sub2, initDark);
                const mat = new THREE.MeshBasicMaterial({ map: tex, transparent: true, opacity: 0.96 });
                const mesh = new THREE.Mesh(codeBoxGeo, mat);
                mesh.position.set(d.x, d.y, d.z);
                scene.add(mesh);
                heroCards.push({
                    mesh: mesh,
                    def: d,
                    baseX: d.x,
                    baseY: d.y,
                    baseZ: d.z
                });
            });

            // B. SCROLL SLALOM KOD KARTLARI
            const slalomDefs = [
                { title: 'PDKS & Turnike Takip', tag: 'GEÇİŞ', sub1: 'PdksHardware.Sync()', sub2: 'Parmak İzi • Yüz Tanıma • Kartlı' },
                { title: 'e-Fatura & e-Arşiv', tag: 'GİB', sub1: 'GibEntegrator.SendInvoice()', sub2: 'e-İrsaliye • e-Müstahsil Entegre' },
                { title: 'E-Ticaret & Sanal POS', tag: 'ONLINE', sub1: 'SanalPos.B2B_Order()', sub2: 'B2B & B2C • Pazaryeri Entegrasyon' },
                { title: 'Elazığ Yerel Destek', tag: '7/24', sub1: 'HayatIsleri.YerindeServis()', sub2: 'Kurulum • Eğitim • Teknik Servis' }
            ];

            const slalomBlocks = [];
            const totalBlocks = isMobileDevice ? 2 : slalomDefs.length;

            for (let i = 0; i < totalBlocks; i++) {
                const tex = createCodeTex(slalomDefs[i].title, slalomDefs[i].tag, slalomDefs[i].sub1, slalomDefs[i].sub2, initDark);
                const cardMat = new THREE.MeshBasicMaterial({
                    map: tex,
                    transparent: true,
                    opacity: 0.92
                });
                const mesh = new THREE.Mesh(codeBoxGeo, cardMat);

                const lane = (i % 4) - 1.5;
                const startY = 12 + i * 5.0;
                const depthZ = -1.5 + (i % 3) * 1.5;

                mesh.position.set(lane * 4.2, startY, depthZ);
                scene.add(mesh);

                slalomBlocks.push({
                    mesh: mesh,
                    def: slalomDefs[i],
                    startY: startY,
                    lane: lane,
                    depthZ: depthZ,
                    slalomAmp: 5 + Math.random() * 4,
                    slalomFreq: 0.75 + Math.random() * 0.5,
                    slalomPhase: (i / totalBlocks) * Math.PI * 2,
                    rotSpeed: (Math.random() - 0.5) * 0.28
                });
            }

            window.addEventListener('hayat-theme-change', function (e) {
                const darkNow = e.detail && e.detail.theme === 'dark';
                heroCards.forEach((hc) => {
                    if (hc.mesh.material.map) hc.mesh.material.map.dispose();
                    hc.mesh.material.map = createCodeTex(hc.def.title, hc.def.tag, hc.def.sub1, hc.def.sub2, darkNow);
                    hc.mesh.material.needsUpdate = true;
                });
                slalomBlocks.forEach((sb) => {
                    if (sb.mesh.material.map) sb.mesh.material.map.dispose();
                    sb.mesh.material.map = createCodeTex(sb.def.title, sb.def.tag, sb.def.sub1, sb.def.sub2, darkNow);
                    sb.mesh.material.needsUpdate = true;
                });
            });

            // ========================================================
            // 💥 KOD PARÇALANMA SİSTEMİ (Tek Seferlik, Zarif Dağılım)
            // ========================================================
            const codeShatterGroup = new THREE.Group();
            scene.add(codeShatterGroup);

            const codeShards = [];
            const codeTexts = [
                '</>', '{ code }', 'async', 'C# 9', 'return;',
                '=> {}', '0 1 1 0', 'API', 'WebGL', 'SQL',
                'class', 'await', 'git push', 'LINQ', 'JSON', '<div>'
            ];

            const shardGeos = [
                new THREE.BoxGeometry(0.65, 0.36, 0.04),
                new THREE.BoxGeometry(0.52, 0.28, 0.03),
                new THREE.TetrahedronGeometry(0.24),
                new THREE.OctahedronGeometry(0.22)
            ];

            const subtleColors = [0xffffff, 0xbae6fd, 0xe2e8f0, 0x93c5fd, 0xf1f5f9];

            for (let i = 0; i < codeTexts.length; i++) {
                const sGeo = shardGeos[i % shardGeos.length];
                const sMat = new THREE.MeshBasicMaterial({
                    color: subtleColors[i % subtleColors.length],
                    transparent: true,
                    opacity: 0.85
                });

                const sMesh = new THREE.Mesh(sGeo, sMat);
                sMesh.visible = false;
                codeShatterGroup.add(sMesh);

                codeShards.push({
                    mesh: sMesh,
                    mat: sMat,
                    vx: 0, vy: 0, vz: 0,
                    rx: 0, ry: 0, rz: 0
                });
            }

            // KESİNLİKLE VE SADECE BİR KERE ÇALIŞIR
            let hasShatteredOnce = false;
            let isShatterRunning = false;
            let shatterDuration = 0;

            function triggerCodeShatter() {
                if (hasShatteredOnce) return;
                hasShatteredOnce = true;
                isShatterRunning = true;
                shatterDuration = 0;

                codeShatterGroup.position.set(camera.position.x, camera.position.y - 0.5, camera.position.z - 11);

                codeShards.forEach((sh, idx) => {
                    sh.mesh.visible = true;
                    sh.mesh.position.set(
                        (Math.random() - 0.5) * 0.8,
                        (Math.random() - 0.5) * 0.6,
                        (Math.random() - 0.5) * 0.5
                    );
                    sh.mat.opacity = 0.90;

                    const theta = (idx / codeShards.length) * Math.PI * 2 + (Math.random() - 0.5) * 0.4;
                    const phi = (Math.random() - 0.5) * Math.PI * 0.6;
                    const spd = 3.5 + Math.random() * 4.0;

                    sh.vx = spd * Math.cos(theta) * Math.cos(phi);
                    sh.vy = spd * Math.sin(phi) + 0.5;
                    sh.vz = spd * Math.sin(theta) * Math.cos(phi) - 1.0;

                    sh.rx = (Math.random() - 0.5) * 4;
                    sh.ry = (Math.random() - 0.5) * 4;
                    sh.rz = (Math.random() - 0.5) * 4;
                });
            }

            // RESPONSIVE BOYUTLANDIRMA & CACHED SCROLL
            let scrollProgress = 0;
            let mouseX = 0, mouseY = 0;
            let baseMonumentX = 3.6;
            let baseMonumentY = 0.2;
            let baseScale = 1.0;
            let slalomAmpMultiplier = 1.0;
            let maxScroll = 1200;

            function updateResponsiveLayout() {
                const w = window.innerWidth;
                const isMobile = w < 768;
                const isTablet = w >= 768 && w < 1024;

                if (isMobile) {
                    camera.fov = 58;
                    camera.position.z = 21;
                    baseMonumentX = 0;
                    baseMonumentY = 1.0;
                    baseScale = 0.92;
                    slalomAmpMultiplier = 0.6;
                } else if (isTablet) {
                    camera.fov = 58;
                    camera.position.z = 23;
                    baseMonumentX = 2.4;
                    baseMonumentY = 0.6;
                    baseScale = 0.95;
                    slalomAmpMultiplier = 0.75;
                } else {
                    camera.fov = 55;
                    camera.position.z = 22;
                    baseMonumentX = 3.6;
                    baseMonumentY = 0.2;
                    baseScale = 1.0;
                    slalomAmpMultiplier = 1.0;
                }

                monumentGroup.scale.setScalar(baseScale);
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
                renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));

                maxScroll = Math.max(1, (document.documentElement.scrollHeight || 1200) - window.innerHeight);
                updateRefSectionMetrics();
            }

            const refSec = document.getElementById('referanslarimiz');
            let refSecTop = 0;
            let refSecHeight = 0;
            function updateRefSectionMetrics() {
                if (refSec) {
                    const r = refSec.getBoundingClientRect();
                    refSecTop = r.top + (window.scrollY || window.pageYOffset || 0);
                    refSecHeight = r.height;
                }
            }

            window.addEventListener('resize', updateResponsiveLayout, { passive: true });
            updateResponsiveLayout();
            setTimeout(updateResponsiveLayout, 400);

            // SIFIR REFLOW SCROLL DİNLEYİCİSİ
            let lastFilterVal = '';
            function onScroll() {
                const scrollY = window.scrollY || window.pageYOffset || 0;
                scrollProgress = scrollY / maxScroll;

                if (!hasShatteredOnce && scrollY > 160) {
                    triggerCodeShatter();
                }

                // MOBİLDE: EN BAŞTA NET VE CANLI, AŞAĞI KAYDIRDIKÇA YUMUŞAKÇA BLURLANMA
                if (window.innerWidth < 992) {
                    let nextFilter = 'none';
                    if (scrollY > 50) {
                        const blurVal = Math.min(8.5, (scrollY - 50) / 40);
                        nextFilter = `blur(${blurVal.toFixed(1)}px)`;
                    }
                    if (lastFilterVal !== nextFilter) {
                        lastFilterVal = nextFilter;
                        canvas.style.filter = nextFilter;
                    }
                } else if (lastFilterVal !== 'none') {
                    lastFilterVal = 'none';
                    canvas.style.filter = 'none';
                }
            }
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();

            window.addEventListener('mousemove', (e) => {
                mouseX = (e.clientX / window.innerWidth) * 2 - 1;
                mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
            }, { passive: true });

            window.addEventListener('touchmove', (e) => {
                if (e.touches && e.touches[0]) {
                    mouseX = (e.touches[0].clientX / window.innerWidth) * 2 - 1;
                    mouseY = -(e.touches[0].clientY / window.innerHeight) * 2 + 1;
                }
            }, { passive: true });

            // TEK MERKEZİ RENDER DÖNGÜSÜ (Ultra Akıcı 60 FPS)
            const clock = new THREE.Clock();
            let smoothScroll = 0;

            function renderMainScene(delta, time) {
                const totalDescent = 110;
                const scrollDist = smoothScroll * totalDescent;

                // 🌟 ÖNE ÇIKAN REFERANSLARIMIZ BÖLÜMÜNE GELDİĞİNDE 3D ARKA PLANI SAYDAMLAT / OPAKLAŞTIR (Sıfır Reflow)
                if (refSec && refSecHeight > 0) {
                    const scrollY = window.scrollY || window.pageYOffset || 0;
                    const rectTop = refSecTop - scrollY;
                    const rectBottom = rectTop + refSecHeight;
                    const winH = window.innerHeight;
                    let targetOp = '1';
                    if (rectTop < winH * 0.95 && rectBottom > 0) {
                        const enterProgress = Math.max(0, Math.min(1, (winH * 0.95 - rectTop) / (winH * 0.55)));
                        targetOp = (1.0 - (enterProgress * 0.85)).toFixed(2);
                    } else if (rectTop <= 0 && rectBottom > 0) {
                        targetOp = '0.15';
                    }
                    if (canvas.style.opacity !== targetOp) {
                        canvas.style.opacity = targetOp;
                    }
                }

                // 🌟 Monument Kinetik Hareketi (Çok Katmanlı Dönüş)
                outerCrystal.rotation.x = time * 0.12;
                outerCrystal.rotation.y = time * 0.15;
                if (typeof diamondMesh !== 'undefined' && diamondMesh) {
                    diamondMesh.rotation.x = -time * 0.16;
                    diamondMesh.rotation.y = time * 0.20;
                }
                midDodecaMesh.rotation.x = -time * 0.18;
                midDodecaMesh.rotation.y = -time * 0.22;
                coreOcta1.rotation.x = time * 0.25;
                coreOcta1.rotation.y = time * 0.30;
                coreOcta2.rotation.x = -time * 0.35;
                coreOcta2.rotation.y = time * 0.28;
                corePulseSphere.scale.setScalar(1.0 + Math.sin(time * 3.0) * 0.12);
                if (typeof monumentCoreLight !== 'undefined' && monumentCoreLight) {
                    monumentCoreLight.intensity = 2.2 + Math.sin(time * 3.5) * 0.7;
                }

                // Giroskopik 4'lü Halkalar & Bileşik Uydular
                rings.forEach((r) => {
                    r.group.rotation.z += r.speed * delta;
                    r.satellites.forEach(sat => {
                        sat.angle += r.speed * delta * 1.6;
                        sat.group.position.x = Math.cos(sat.angle) * sat.radius;
                        sat.group.position.y = Math.sin(sat.angle) * sat.radius;
                        sat.group.rotation.z = sat.angle + Math.PI / 2;
                    });
                });

                // Yörüngede Dönen 12 Kristal
                shards.forEach(sh => {
                    sh.theta += sh.speed * delta;
                    sh.mesh.position.x = sh.radius * Math.cos(sh.theta) * Math.cos(sh.phi);
                    sh.mesh.position.z = sh.radius * Math.sin(sh.theta) * Math.cos(sh.phi);
                    sh.mesh.rotation.x += sh.rotSpeedX * delta;
                    sh.mesh.rotation.y += sh.rotSpeedY * delta;
                });

                // Takımyıldızı Düğümleri Salınımı
                constNodes.forEach(cn => {
                    cn.mesh.position.y = cn.basePos.y + Math.sin(time * 1.2 + cn.seed) * 0.25;
                    cn.mesh.position.x = cn.basePos.x + Math.cos(time * 0.9 + cn.seed) * 0.20;
                });

                // Monument Scroll ve Fare Tepkisi
                const scrollOffsetFactor = window.innerWidth < 768 ? 2 : 6;
                monumentGroup.position.y = baseMonumentY + (smoothScroll * 35) + Math.sin(time * 0.4) * 0.5;
                monumentGroup.position.x = baseMonumentX - (smoothScroll * scrollOffsetFactor) + (mouseX * 1.2);
                monumentGroup.rotation.y = (smoothScroll * Math.PI * 1.2) + (mouseX * 0.25);

                // HERO KOD PENCERELERİ (Zarif Yüzme & Scroll Kayması)
                heroCards.forEach((c, idx) => {
                    const y = c.baseY + Math.sin(time * 0.85 + idx * 1.6) * 0.28 - (smoothScroll * 38);
                    c.mesh.position.y = y;
                    c.mesh.position.x = c.baseX + (mouseX * 0.4) + Math.cos(time * 0.65 + idx) * 0.15;
                    c.mesh.position.z = c.baseZ + Math.sin(time * 0.5 + idx) * 0.2;
                    c.mesh.rotation.z = Math.sin(time * 0.6 + idx) * 0.06;
                    c.mesh.rotation.x = -mouseY * 0.08;
                    c.mesh.rotation.y = mouseX * 0.08;

                    c.mesh.visible = Math.abs(y) <= 24;
                });

                // KOD KARTLARI SLALOM (Scroll ile süzülüş)
                for (let i = 0; i < slalomBlocks.length; i++) {
                    const b = slalomBlocks[i];
                    const y = b.startY - scrollDist;
                    const distFromView = Math.abs(y);

                    if (distFromView > 25) {
                        b.mesh.visible = false;
                        continue;
                    }
                    b.mesh.visible = true;

                    const slalomT = smoothScroll * b.slalomFreq * Math.PI * 3.5 + b.slalomPhase;
                    const x = Math.sin(slalomT) * (b.slalomAmp * slalomAmpMultiplier);
                    const z = b.depthZ + Math.cos(slalomT * 0.7) * 1.8;

                    b.mesh.position.set(x, y, z);
                    b.mesh.rotation.z = Math.cos(slalomT) * 0.12;
                    b.mesh.rotation.y += b.rotSpeed * delta;
                }

                // Kamera Fareye Yumuşakça Eğilir
                camera.position.x += ((mouseX * 1.8) - camera.position.x) * 0.04;
                camera.position.y += ((-mouseY * 1.2) - camera.position.y) * 0.04;

                // Çift Sarmal Akış Otoyolları
                flowMesh1.position.y = smoothScroll * 50 + Math.sin(time * 0.2) * 1.2;
                flowMesh1.rotation.y = time * 0.03 + mouseX * 0.08;
                flowMesh2.position.y = smoothScroll * 50 + Math.cos(time * 0.2) * 1.4;
                flowMesh2.rotation.y = -time * 0.025 - mouseX * 0.06;
                dustPts.rotation.y = time * 0.008;

                // KOD PARÇALANMA ANİMASYONU
                if (isShatterRunning) {
                    shatterDuration += delta;
                    let remainingShards = 0;

                    codeShards.forEach(sh => {
                        sh.vx *= 0.95;
                        sh.vy *= 0.95;
                        sh.vz *= 0.95;

                        sh.mesh.position.x += sh.vx * delta;
                        sh.mesh.position.y += sh.vy * delta;
                        sh.mesh.position.z += sh.vz * delta;

                        sh.mesh.rotation.x += sh.rx * delta;
                        sh.mesh.rotation.y += sh.ry * delta;
                        sh.mesh.rotation.z += sh.rz * delta;

                        sh.mat.opacity = Math.max(0, sh.mat.opacity - delta * 0.42);
                        if (sh.mat.opacity > 0.02) {
                            remainingShards++;
                        } else {
                            sh.mesh.visible = false;
                        }
                    });

                    if (shatterDuration > 2.4 || remainingShards === 0) {
                        isShatterRunning = false;
                        codeShards.forEach(sh => { sh.mesh.visible = false; });
                    }
                }

                renderer.render(scene, camera);
            }

            let threeThrottle = 0;
            function tick() {
                requestAnimationFrame(tick);
                if (document.hidden) return;

                const scrollY = window.scrollY || window.pageYOffset || 0;
                // When user scrolls deep into page (past referanslar & into dark immersion section),
                // throttle background Three.js render to free up GPU for 3D dropdown and smooth scrolling
                if (refSec && refSecTop > 0 && scrollY > (refSecTop + 250)) {
                    threeThrottle++;
                    if (threeThrottle % 2 !== 0) {
                        return;
                    }
                }

                const delta = Math.min(clock.getDelta(), 0.1);
                const time = clock.getElapsedTime();

                smoothScroll += (scrollProgress - smoothScroll) * 0.25;

                renderMainScene(delta, time);
            }

            tick();
        })();

        // REFERANSLAR KATEGORİ FİLTRELEME
        (function() {
            const filterBtns = document.querySelectorAll('#refFilterButtons .lusion-filter-btn');
            const refItems = document.querySelectorAll('#refCardsContainer .ref-item');
            if (!filterBtns.length || !refItems.length) return;
            filterBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    const filter = this.getAttribute('data-filter');
                    refItems.forEach(item => {
                        const cat = item.getAttribute('data-category');
                        if (filter === 'all' || cat === filter) {
                            item.style.display = '';
                            item.classList.add('lusion-card-in-view');
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });
        })();

        // ========================================================
        // 🌟 LUSION SCROLL-DRIVEN STAGGERED REVEAL (Ultra Hafif GPU)
        // (Aşağı kaydırdıkça öne çıkan eserlerin kenarlardan süzülerek gelişi)
        // ========================================================
        (function() {
            const refItems = document.querySelectorAll('#refCardsContainer .ref-item');
            if (!refItems.length) return;

            refItems.forEach((item, index) => {
                if (!item.classList.contains('ref-from-left') && !item.classList.contains('ref-from-right')) {
                    if (index % 2 === 0) item.classList.add('ref-from-left');
                    else item.classList.add('ref-from-right');
                }
                const colDelay = (index % 2 === 0) ? 0.08 : 0.28;
                item.style.transitionDelay = colDelay + 's';
            });

            // IntersectionObserver: Kart bir kez ekrana girdiğinde yerine oturur ve observer durdurulur
            const revealObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('lusion-card-in-view');
                        revealObserver.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.12,
                rootMargin: '0px 0px -40px 0px'
            });

            refItems.forEach(item => revealObserver.observe(item));
        })();

        // ========================================================
        // 🌟 HİZMETLER & ÇÖZÜMLER KADEMELİ GİRİŞ DİNAMİĞİ (Smooth Entrance)
        // ========================================================
        (function() {
            const serviceItems = document.querySelectorAll('#servicesCardsContainer .service-item');
            if (!serviceItems.length) return;

            serviceItems.forEach((card, idx) => {
                const delay = (idx * 0.12);
                card.style.transitionDelay = delay + 's';
            });

            const serviceObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('service-in-view');
                        serviceObserver.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.10,
                rootMargin: '0px 0px -30px 0px'
            });

            serviceItems.forEach(item => serviceObserver.observe(item));
        })();


        // ADIM 3: Draco & Meshoptimizer ile 3D Model Optimizasyon Yükleyici Şablonu
        // (Harici .glb / .gltf modeller yüklendiğinde GPU ve CPU yükünü %80 azaltır)
        window.getDracoGLTFLoader = function() {
            if (typeof THREE.GLTFLoader === 'undefined') return null;
            const loader = new THREE.GLTFLoader();
            if (typeof THREE.DRACOLoader !== 'undefined') {
                const draco = new THREE.DRACOLoader();
                draco.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.6/');
                draco.setDecoderConfig({ type: 'js' });
                loader.setDRACOLoader(draco);
            }
            return loader;
        };
        // ========================================================
        // ⚡ STARK DEFENCE TYPEWRITER ENGINE
        // (Soldan sağa daktilo tarzı harf harf ortaya çıkış)
        // ========================================================
        (function() {
            const heading = document.getElementById('starkTypewriterHeading');
            if (!heading) return;

            const lines = heading.querySelectorAll('.stark-line');
            const cursor = document.getElementById('starkCursor');
            const charSpans = [];

            // 1. Her satırı tek tek harf span'lerine ayrıştır
            lines.forEach((lineEl, lineIndex) => {
                const isAccent = lineIndex === 1 || lineEl.classList.contains('stark-line-2');
                const rawText = lineEl.getAttribute('data-stark-text') || lineEl.textContent.trim();
                lineEl.innerHTML = '';

                for (let i = 0; i < rawText.length; i++) {
                    const ch = rawText[i];
                    const span = document.createElement('span');
                    span.className = 'stark-char' + (isAccent ? ' stark-accent' : '');
                    if (ch === ' ') {
                        span.innerHTML = '&nbsp;';
                    } else {
                        span.textContent = ch;
                    }
                    lineEl.appendChild(span);
                    charSpans.push({ span: span, line: lineEl, isSpace: ch === ' ' });
                }
            });

            // İlk satırın sonuna imleci koy
            if (cursor && lines.length > 0) {
                lines[0].appendChild(cursor);
            }

            let currentIndex = 0;
            let isTyping = false;

            function typeNext() {
                if (currentIndex >= charSpans.length) {
                    if (cursor && lines.length > 1) {
                        lines[lines.length - 1].appendChild(cursor);
                    }
                    return;
                }

                const item = charSpans[currentIndex];
                item.span.classList.add('revealed');

                // İmleci yazılan harften hemen sonraya yerleştir
                if (cursor) {
                    item.span.insertAdjacentElement('afterend', cursor);
                }

                currentIndex++;
                // Daktilo hızı (STARK Defence ritminde: akıcı 50ms harfler, 90ms boşluklar)
                const delay = item.isSpace ? 90 : 50;
                setTimeout(typeNext, delay);
            }

            // Sayfa yüklendiğinde hemen başlasın
            setTimeout(() => {
                if (!isTyping) {
                    isTyping = true;
                    typeNext();
                }
            }, 100);

            function onTypewriterScroll() {
                if (!isTyping && (window.scrollY || window.pageYOffset || 0) < 200) {
                    isTyping = true;
                    typeNext();
                    window.removeEventListener('scroll', onTypewriterScroll);
                }
            }
            window.addEventListener('scroll', onTypewriterScroll, { passive: true });
        })();
    </script>

    <!-- SPLINE 3D DROPDOWN WIDGET INTERACTION SCRIPT -->
    <script>
        (function() {
            const stage = document.getElementById('spline3dStage');
            const card = document.getElementById('spline3dCard');
            const selectBar = document.getElementById('splineSelectBar');
            const actionBtn = document.getElementById('splineActionBtn');
            if (!stage || !card || !selectBar) return;

            let isOpen = false;

            function toggleDropdown(e) {
                if (e) {
                    e.stopPropagation();
                    e.preventDefault();
                }
                isOpen = !isOpen;
                card.classList.toggle('is-open', isOpen);
                selectBar.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }

            selectBar.addEventListener('click', toggleDropdown);
            if (actionBtn) {
                actionBtn.addEventListener('click', toggleDropdown);
            }

            // 3D Mousemove Parallax Tilt (Ultra Akıcı 60-120 FPS)
            let isHovering = false;
            let targetRotX = 12;
            let targetRotY = -18;
            let currentRotX = 12;
            let currentRotY = -18;
            let rafId = null;

            function updateTilt() {
                currentRotX += (targetRotX - currentRotX) * 0.16;
                currentRotY += (targetRotY - currentRotY) * 0.16;

                if (window.innerWidth >= 992) {
                    card.style.transform = `rotateX(${currentRotX.toFixed(2)}deg) rotateY(${currentRotY.toFixed(2)}deg) rotateZ(2.5deg)`;
                }

                if (isHovering || Math.abs(currentRotX - 12) > 0.04 || Math.abs(currentRotY - (-18)) > 0.04) {
                    rafId = requestAnimationFrame(updateTilt);
                } else {
                    rafId = null;
                    card.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s';
                }
            }

            stage.addEventListener('mouseenter', function() {
                if (window.innerWidth < 992) return;
                isHovering = true;
                card.style.transition = 'box-shadow 0.25s'; // CSS animasyon çakışmasını engelle
                if (!rafId) {
                    rafId = requestAnimationFrame(updateTilt);
                }
            });

            stage.addEventListener('mousemove', function(e) {
                if (window.innerWidth < 992) return;
                isHovering = true;
                const rect = stage.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;

                const maxTilt = 10;
                targetRotX = 12 - (y / (rect.height / 2)) * maxTilt;
                targetRotY = -18 + (x / (rect.width / 2)) * maxTilt;

                if (!rafId) {
                    rafId = requestAnimationFrame(updateTilt);
                }
            }, { passive: true });

            stage.addEventListener('mouseleave', function() {
                isHovering = false;
                targetRotX = 12;
                targetRotY = -18;
                card.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s';
                if (!rafId) {
                    rafId = requestAnimationFrame(updateTilt);
                }
            });

            // Partner satırına tıklandığında hafif parıltı & seçim efekti
            const rows = card.querySelectorAll('.spline-partner-row');
            rows.forEach(r => {
                r.addEventListener('click', function(e) {
                    e.stopPropagation();
                    rows.forEach(item => item.style.borderColor = '');
                    this.style.borderColor = '#38bdf8';
                    this.style.boxShadow = '0 0 15px rgba(56, 189, 248, 0.4)';
                    setTimeout(() => {
                        this.style.boxShadow = '';
                    }, 600);
                });
            });
        })();

        // GOOGLE ONE SCROLL-DRIVEN DARK IMMERSION TRANSITION (Akıcı 60 FPS)
        (function() {
            const darkStage = document.getElementById('g1DarkScrollStage');
            const darkSection = document.getElementById('isbirliklerimiz');
            if (!darkStage || !darkSection) return;

            let ticking = false;
            let stageTop = 0;
            let stageHeight = 0;
            let lastScale = null;
            let lastRadius = null;
            let lastProg = null;

            function updateStageMetrics() {
                const r = darkStage.getBoundingClientRect();
                stageTop = r.top + (window.scrollY || window.pageYOffset || 0);
                stageHeight = r.height;
            }

            function updateDarkImmersionScroll() {
                const scrollY = window.scrollY || window.pageYOffset || 0;
                const rectTop = stageTop - scrollY;
                const vh = window.innerHeight || document.documentElement.clientHeight;

                // Calculate how centered/immersed the section is in the viewport (0 to 1)
                const enterStart = vh * 0.92;
                const fullEnter = vh * 0.28;
                const exitStart = -stageHeight * 0.25;
                const fullExit = -stageHeight * 0.78;

                let progress = 0;
                if (rectTop <= enterStart && rectTop >= fullEnter) {
                    progress = (enterStart - rectTop) / (enterStart - fullEnter);
                } else if (rectTop < fullEnter && rectTop >= exitStart) {
                    progress = 1;
                } else if (rectTop < exitStart && rectTop >= fullExit) {
                    progress = 1 - ((exitStart - rectTop) / (exitStart - fullExit));
                }
                progress = Math.max(0, Math.min(1, progress));

                const scale = (0.92 + (progress * 0.08)).toFixed(4);
                const radius = Math.round(48 - (progress * 20));
                const progStr = progress.toFixed(3);

                if (scale !== lastScale) {
                    lastScale = scale;
                    darkSection.style.setProperty('--g1-dark-scale', scale);
                }
                if (radius !== lastRadius) {
                    lastRadius = radius;
                    darkSection.style.setProperty('--g1-dark-radius', radius + 'px');
                }
                if (progStr !== lastProg) {
                    lastProg = progStr;
                    darkStage.style.setProperty('--g1-stage-progress', progStr);
                }

                if (progress > 0.38) {
                    if (!document.body.classList.contains('g1-dark-scroll-active')) {
                        document.body.classList.add('g1-dark-scroll-active');
                    }
                } else {
                    if (document.body.classList.contains('g1-dark-scroll-active')) {
                        document.body.classList.remove('g1-dark-scroll-active');
                    }
                }
                ticking = false;
            }

            window.addEventListener('scroll', function() {
                if (!ticking) {
                    window.requestAnimationFrame(updateDarkImmersionScroll);
                    ticking = true;
                }
            }, { passive: true });

            window.addEventListener('resize', function() {
                updateStageMetrics();
                updateDarkImmersionScroll();
            }, { passive: true });

            updateStageMetrics();
            updateDarkImmersionScroll();
        })();
    </script>
}
